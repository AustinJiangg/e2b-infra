diff --git a/packages/orchestrator/internal/sandbox/uffd/sinceboot.go b/packages/orchestrator/internal/sandbox/uffd/sinceboot.go
new file mode 100644
index 000000000..2d2e8fe08
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/uffd/sinceboot.go
@@ -0,0 +1,223 @@
+package uffd
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+
+	"github.com/bits-and-blooms/bitset"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/fc"
+)
+
+// ErrDirtySinceBootUntrusted is what UnionInto answers with once something
+// could not be folded into the set: the pages it holds are still a subset of
+// the truth, but the caller may no longer treat them as all of it.
+var ErrDirtySinceBootUntrusted = errors.New("the since-boot dirty set is incomplete")
+
+// DirtySinceBoot is the set of guest pages written since the VM started,
+// accumulated by this process because Firecracker cannot be asked for it.
+//
+// Firecracker's write-tracking bitmap holds the pages written since the last
+// snapshot or rollback, not since boot: creating a checkpoint clears it
+// (vstate/memory.rs, reset_dirty after dump_dirty) and so does an in-place
+// rollback (rollback.rs, phase 9), which on top of that writes the revert set
+// into guest memory through a VMM mapping KVM never logs. A native pause
+// exports its memory diff against the *template* memfile, so on a sandbox that
+// has checkpointed, exporting that bitmap alone drops every page written
+// before the last checkpoint. Such a snapshot resumes into a guest whose
+// memory is stitched together from two moments and whose kernel panics within
+// milliseconds -- while the pause itself reported success.
+//
+// The gap is closed by folding each bitmap into this set at the moment
+// Firecracker is about to clear it: those bitmaps are exactly the pages that
+// are about to be forgotten. Anything that cannot be folded in makes the set
+// untrusted, and the pause path then falls back to the residency criterion.
+// Exporting too much is slow; exporting too little is silent corruption.
+//
+// The zero value is an empty, trusted set, which is the state of every sandbox
+// that never checkpoints: nothing is merged, nothing is added at pause, and
+// the exported diff is bit for bit the one this orchestrator exported before
+// the set existed.
+type DirtySinceBoot struct {
+	mu sync.Mutex
+
+	pages    *bitset.BitSet
+	pageSize int64
+	numPages uint
+
+	// merges counts the bitmaps offered, successfully or not. It is the
+	// number of times Firecracker's own bitmap was cleared under us, which
+	// is what tells "this sandbox never checkpointed" from "this sandbox
+	// checkpointed and nothing happened to be dirty".
+	merges int
+
+	untrusted bool
+	reason    string
+}
+
+// DirtySinceBootStats is a reading of the set, for logging and for the pause
+// path's decision.
+type DirtySinceBootStats struct {
+	Pages    uint
+	PageSize int64
+	Merges   int
+	Trusted  bool
+	Reason   string
+}
+
+// MergeFile folds a Firecracker dirty bitmap sidecar (the FCDB format both
+// the snapshot endpoint and save-dirty-bitmap write) into the set.
+//
+// A sidecar that cannot be read is not a missed optimization but a hole in the
+// set, so the failure both returns and makes the set untrusted.
+func (d *DirtySinceBoot) MergeFile(path string) error {
+	pages, pageSize, err := fc.ReadDirtyBitmapFile(path)
+	if err != nil {
+		d.MarkUntrusted(fmt.Sprintf("dirty bitmap %s could not be read: %s", path, err))
+
+		return fmt.Errorf("failed to read dirty bitmap %s: %w", path, err)
+	}
+
+	return d.MergeBitmap(pages, pageSize)
+}
+
+// MergeBitmap folds one bitmap into the set.
+//
+// A bitmap of coarser pages is expanded: one bit standing for a block that was
+// written somewhere becomes every tracked page of that block, which overstates
+// the set and never understates it. Anything else -- a finer page size, a
+// geometry that is not a multiple, a different page count for the same guest
+// -- means the two bitmaps do not describe the same memory the same way, and
+// guessing which pages they have in common is exactly the kind of reasoning
+// that produced the bug this set exists for. The bits are still taken, and the
+// set is marked untrusted.
+func (d *DirtySinceBoot) MergeBitmap(pages *bitset.BitSet, pageSize int64) error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	d.merges++
+
+	if pages == nil || pageSize <= 0 {
+		d.markUntrustedLocked(fmt.Sprintf("dirty bitmap with page size %d is unusable", pageSize))
+
+		return fmt.Errorf("unusable dirty bitmap: page size %d", pageSize)
+	}
+
+	if d.pages == nil {
+		d.pages = pages.Clone()
+		d.pageSize = pageSize
+		d.numPages = pages.Len()
+
+		return nil
+	}
+
+	var mergeErr error
+
+	if pageSize != d.pageSize {
+		if pageSize < d.pageSize || pageSize%d.pageSize != 0 {
+			d.markUntrustedLocked(fmt.Sprintf(
+				"dirty bitmap of %d-byte pages cannot be expanded onto the %d-byte pages accumulated so far",
+				pageSize, d.pageSize))
+			mergeErr = fmt.Errorf("dirty bitmap page size %d does not match %d", pageSize, d.pageSize)
+		}
+
+		pages = expandBitmap(pages, uint(pageSize/d.pageSize))
+	}
+
+	if pages.Len() != d.numPages {
+		d.markUntrustedLocked(fmt.Sprintf(
+			"dirty bitmap describes %d pages, %d accumulated so far", pages.Len(), d.numPages))
+		mergeErr = errors.Join(mergeErr, fmt.Errorf("dirty bitmap covers %d pages, expected %d", pages.Len(), d.numPages))
+	}
+
+	d.pages.InPlaceUnion(pages)
+	if d.pages.Len() > d.numPages {
+		d.numPages = d.pages.Len()
+	}
+
+	return mergeErr
+}
+
+// expandBitmap restates a bitmap of coarse blocks as one of ratio-times-finer
+// pages: every page of a block that was written anywhere counts as written.
+func expandBitmap(coarse *bitset.BitSet, ratio uint) *bitset.BitSet {
+	if ratio <= 1 {
+		return coarse
+	}
+
+	fine := bitset.New(coarse.Len() * ratio)
+	for i, ok := coarse.NextSet(0); ok; i, ok = coarse.NextSet(i + 1) {
+		for j := uint(0); j < ratio; j++ {
+			fine.Set(i*ratio + j)
+		}
+	}
+
+	return fine
+}
+
+// MarkUntrusted records that pages may be missing from the set without any
+// bitmap being at fault -- a step that should have produced one and did not.
+func (d *DirtySinceBoot) MarkUntrusted(reason string) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	d.markUntrustedLocked(reason)
+}
+
+// markUntrustedLocked keeps the first reason: it is the one that explains how
+// the set lost its meaning, and every later complaint is a consequence.
+func (d *DirtySinceBoot) markUntrustedLocked(reason string) {
+	if d.untrusted {
+		return
+	}
+
+	d.untrusted = true
+	d.reason = reason
+}
+
+// UnionInto adds the accumulated pages to dst, which must be a bitmap of the
+// same pages. An untrusted set refuses: its caller has a correct, if
+// expensive, alternative and must take it.
+func (d *DirtySinceBoot) UnionInto(dst *bitset.BitSet, pageSize int64) error {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	if d.untrusted {
+		return fmt.Errorf("%w: %s", ErrDirtySinceBootUntrusted, d.reason)
+	}
+
+	if d.pages == nil || dst == nil {
+		return nil
+	}
+
+	if pageSize != d.pageSize {
+		d.markUntrustedLocked(fmt.Sprintf(
+			"pages accumulated at %d bytes cannot be added to a %d-byte page diff", d.pageSize, pageSize))
+
+		return fmt.Errorf("%w: %s", ErrDirtySinceBootUntrusted, d.reason)
+	}
+
+	dst.InPlaceUnion(d.pages)
+
+	return nil
+}
+
+// Stats reads the set.
+func (d *DirtySinceBoot) Stats() DirtySinceBootStats {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+
+	s := DirtySinceBootStats{
+		PageSize: d.pageSize,
+		Merges:   d.merges,
+		Trusted:  !d.untrusted,
+		Reason:   d.reason,
+	}
+
+	if d.pages != nil {
+		s.Pages = d.pages.Count()
+	}
+
+	return s
+}
