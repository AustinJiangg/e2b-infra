diff --git a/packages/orchestrator/internal/sandbox/block/page.go b/packages/orchestrator/internal/sandbox/block/page.go
new file mode 100644
index 000000000..66c886098
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/page.go
@@ -0,0 +1,110 @@
+package block
+
+import (
+	"context"
+	"fmt"
+	"sync"
+)
+
+// ContiguousSlicer is a source that can say whether one stored range covers
+// a whole request and, if so, hand it out zero-copy.
+type ContiguousSlicer interface {
+	// SliceContiguous returns the bytes at [off, off+length) when a single
+	// mapping covers them, or ok=false when the range spans mappings.
+	SliceContiguous(ctx context.Context, off, length int64) (b []byte, ok bool, err error)
+}
+
+// ContextReaderAt assembles an arbitrary range, crossing block and build
+// boundaries, into a caller-provided buffer.
+type ContextReaderAt interface {
+	ReadAt(ctx context.Context, p []byte, off int64) (int, error)
+}
+
+// pageBuffers pools assembly buffers per page size, so a fault that has to
+// assemble a page from several blocks does not allocate and zero a fresh
+// page each time.
+var pageBuffers sync.Map // int64 -> *sync.Pool
+
+// The lookup is a plain Load first: Go evaluates arguments eagerly, so
+// calling LoadOrStore straight away builds a sync.Pool and a closure over
+// length on every fault, both of which escape to the heap, only to throw
+// them away because the pool for that size is already there. The set of
+// sizes is one entry deep in practice -- the guest page size -- so the Load
+// hits every time after the first fault.
+func getPageBuffer(length int64) []byte {
+	p, ok := pageBuffers.Load(length)
+	if !ok {
+		p, _ = pageBuffers.LoadOrStore(length, &sync.Pool{New: func() any {
+			b := make([]byte, length)
+
+			return &b
+		}})
+	}
+
+	return *p.(*sync.Pool).Get().(*[]byte)
+}
+
+func putPageBuffer(b []byte) {
+	if p, ok := pageBuffers.Load(int64(cap(b))); ok {
+		b = b[:cap(b)]
+		p.(*sync.Pool).Put(&b)
+	}
+}
+
+// ReadPage returns length bytes at off from src, where length is the unit the
+// caller will hand to the guest in one go (a uffd page), and a release the
+// caller runs once the bytes have been copied out.
+//
+// When the source's block size equals the page the block is returned as is,
+// zero-copy. When the source is finer — a memfile stored in 4 KiB pages
+// under a 2 MiB huge-page guest — the page is still zero-copy if one mapping
+// covers it, and otherwise assembled into a pooled buffer through the
+// source's ReadAt, which walks the mapping chain page by page.
+func ReadPage(ctx context.Context, src Slicer, off, length int64) (b []byte, release func(), err error) {
+	noop := func() {}
+
+	blockSize := src.BlockSize()
+	if blockSize == length {
+		b, err = src.Slice(ctx, off, length)
+
+		return b, noop, err
+	}
+
+	if blockSize <= 0 || length%blockSize != 0 {
+		return nil, nil, fmt.Errorf("page size %d is not a multiple of source block size %d", length, blockSize)
+	}
+
+	if cs, ok := src.(ContiguousSlicer); ok {
+		b, ok, err := cs.SliceContiguous(ctx, off, length)
+		if err != nil {
+			return nil, nil, err
+		}
+		if ok {
+			if int64(len(b)) != length {
+				return nil, nil, fmt.Errorf("source %T returned %d bytes for a %d-byte page at %d", src, len(b), length, off)
+			}
+
+			return b, noop, nil
+		}
+	}
+
+	reader, ok := src.(ContextReaderAt)
+	if !ok {
+		return nil, nil, fmt.Errorf("source %T cannot assemble %d-byte pages from %d-byte blocks", src, length, blockSize)
+	}
+
+	buf := getPageBuffer(length)
+	n, err := reader.ReadAt(ctx, buf, off)
+	if err != nil {
+		putPageBuffer(buf)
+
+		return nil, nil, fmt.Errorf("failed to assemble page at %d: %w", off, err)
+	}
+	if int64(n) != length {
+		putPageBuffer(buf)
+
+		return nil, nil, fmt.Errorf("short page read at %d: %d of %d bytes", off, n, length)
+	}
+
+	return buf, func() { putPageBuffer(buf) }, nil
+}
diff --git a/packages/orchestrator/internal/sandbox/block/populate.go b/packages/orchestrator/internal/sandbox/block/populate.go
new file mode 100644
index 000000000..b785088ab
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/populate.go
@@ -0,0 +1,139 @@
+package block
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"runtime"
+	"sync"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// Faulting in a mapping ahead of the copy that touches it.
+//
+// A goroutine that copies to or from one of these MAP_SHARED file mappings
+// takes its page faults in user mode, and the page fault is where the page
+// is charged to the memory cgroup -- the one the orchestrator shares with
+// every Firecracker it runs, which the page cache keeps full. A charge over
+// the limit reclaims inside the fault, and reclaim sleeps (reclaim_throttle).
+// For all that time the goroutine's P is _Prunning: nothing can preempt a
+// thread that is asleep in the kernel on a fault, so a stop-the-world waits
+// for it to come back. The long runs measured exactly that: every long GC
+// pause spent in its "stopping" half, with orchestrator threads in D state
+// in reclaim_throttle the whole time.
+//
+// MADV_POPULATE_READ / MADV_POPULATE_WRITE (Linux 5.14) take the same faults
+// -- page allocation, the memcg charge and whatever reclaim it needs,
+// page_mkwrite and block allocation for a write -- inside a system call. A
+// goroutine in a system call has its P in _Psyscall, which a stop-the-world
+// does not wait for. The copy that follows then finds its pages mapped.
+//
+// It is an optimisation, not a guarantee: a populated clean page can still
+// be reclaimed before the copy reaches it, and then the copy faults the way
+// it always did. The fault guards stay where they were.
+
+// populateChunk bounds one madvise call, so that a large copy does not hold
+// one system call (and one mmap_lock read hold) for its whole length.
+const populateChunk = 1 << 20
+
+const (
+	populateRead  = unix.MADV_POPULATE_READ
+	populateWrite = unix.MADV_POPULATE_WRITE
+)
+
+var pageSize = uintptr(os.Getpagesize())
+
+// madvise is the system call, a variable so the tests can make it fail. It
+// must stay a Syscall, not a RawSyscall: entering the scheduler's syscall
+// state is the whole point.
+var madvise = func(addr, length uintptr, advice int) error {
+	_, _, errno := unix.Syscall(unix.SYS_MADVISE, addr, length, uintptr(advice))
+	if errno != 0 {
+		return errno
+	}
+
+	return nil
+}
+
+// populateSupported says whether this kernel knows the two advice values. It
+// is probed once, on an anonymous page of its own; a kernel older than 5.14
+// answers EINVAL, and from then on every copy goes straight to the mapping,
+// as it did before this existed. A variable so the tests can probe again.
+var populateSupported = sync.OnceValue(probePopulate)
+
+func probePopulate() bool {
+	page, err := unix.Mmap(-1, 0, int(pageSize), unix.PROT_READ|unix.PROT_WRITE, unix.MAP_PRIVATE|unix.MAP_ANONYMOUS)
+	if err != nil {
+		return false
+	}
+	defer unix.Munmap(page)
+
+	return !errors.Is(madvise(uintptr(unsafe.Pointer(&page[0])), pageSize, populateRead), unix.EINVAL)
+}
+
+// errMappingFault says that populating the mapping failed the way touching
+// it would have: the kernel would have sent SIGBUS (or found a poisoned
+// page). It wraps the errno.
+var errMappingFault = errors.New("the mapping cannot be faulted in")
+
+// populateMapped faults in the pages under b, which must lie inside one
+// mapping, for reading or for writing (populateRead, populateWrite), in
+// chunks of at most populateChunk.
+//
+// It returns an error only when the copy itself would have faulted fatally,
+// and then one that wraps errMappingFault and the errno:
+//
+//	EFAULT     the access would raise SIGBUS or SIGSEGV: no block for a write
+//	           (the filesystem is full, ENOSPC in page_mkwrite), a read error
+//	           (EIO), or a page past the end of the file -- what the fault
+//	           guard turns into an error today;
+//	EHWPOISON  a hardware-poisoned page, SIGBUS as well.
+//
+// Everything else leaves the copy to fault as it always has, under the
+// guard, and returns nil:
+//
+//	EINVAL     advice unknown to this kernel (the probe normally catches that
+//	           first) or a mapping the kernel will not populate;
+//	ENOMEM     the range is not fully mapped, or the kernel could not get
+//	           memory for it -- a direct access takes the memcg OOM path
+//	           rather than failing, so the direct access decides;
+//	EINTR      a fatal signal is pending; the process is going away anyway;
+//	anything else, for the same reason: never fail an I/O over an
+//	optimisation.
+func populateMapped(b []byte, advice int) error {
+	if len(b) == 0 || !populateSupported() {
+		return nil
+	}
+
+	start := uintptr(unsafe.Pointer(&b[0]))
+	end := start + uintptr(len(b))
+
+	start &^= pageSize - 1
+	end = (end + pageSize - 1) &^ (pageSize - 1)
+
+	for chunk := start; chunk < end; chunk += populateChunk {
+		length := min(populateChunk, end-chunk)
+
+		err := madvise(chunk, length, advice)
+		switch {
+		case err == nil:
+		case errors.Is(err, unix.EFAULT), errors.Is(err, unix.EHWPOISON):
+			return fmt.Errorf("%w: %w", errMappingFault, err)
+		default:
+			return nil
+		}
+	}
+
+	runtime.KeepAlive(b)
+
+	return nil
+}
+
+// mappingFaultError is the error a copy returns when its mapping cannot be
+// touched, worded the way guardMmapFault words the same failure caught as a
+// signal, so that the two read the same in a log.
+func mappingFaultError(op string, off int64, length int, cause error) error {
+	return fmt.Errorf("%s: mmap fault (disk full?) at offset %d, len %d: %w", op, off, length, cause)
+}
