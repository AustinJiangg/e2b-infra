index 2630a5adf..bfbf2a80a 100644
--- a/packages/orchestrator/internal/sandbox/fc/memory.go
+++ b/packages/orchestrator/internal/sandbox/fc/memory.go
@@ -2,7 +2,10 @@ package fc
 
 import (
