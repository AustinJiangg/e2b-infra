diff --git a/packages/orchestrator/internal/checkpoint/bitmap.go b/packages/orchestrator/internal/checkpoint/bitmap.go
new file mode 100644
index 000000000..78d59ffa9
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/bitmap.go
@@ -0,0 +1,96 @@
+package checkpoint
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+)
+
+// The FCDB sidecar format, shared with the forked Firecracker (see
+// serialize_dirty_bitmap there): magic "FCDB", version u32 LE, page_size u64
+// LE, num_pages u64 LE, then ceil(num_pages/64) u64 LE words, bit i of word w
+// covering the page at file offset (w*64+i)*page_size of the memory file.
+const (
+	fcdbMagic   = "FCDB"
+	fcdbVersion = 1
+)
+
+// dirtyBitmap is one parsed sidecar, or the running union of several.
+type dirtyBitmap struct {
+	pageSize uint64
+	numPages uint64
+	words    []uint64
+}
+
+func readDirtyBitmap(path string) (*dirtyBitmap, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(data) < 24 || string(data[0:4]) != fcdbMagic {
+		return nil, fmt.Errorf("malformed dirty bitmap file %s", path)
+	}
+	if v := binary.LittleEndian.Uint32(data[4:8]); v != fcdbVersion {
+		return nil, fmt.Errorf("unsupported dirty bitmap version %d", v)
+	}
+
+	b := &dirtyBitmap{
+		pageSize: binary.LittleEndian.Uint64(data[8:16]),
+		numPages: binary.LittleEndian.Uint64(data[16:24]),
+	}
+
+	numWords := (b.numPages + 63) / 64
+	if uint64(len(data)) != 24+numWords*8 {
+		return nil, fmt.Errorf("truncated dirty bitmap file %s", path)
+	}
+
+	b.words = make([]uint64, numWords)
+	for i := range b.words {
+		b.words[i] = binary.LittleEndian.Uint64(data[24+i*8:])
+	}
+
+	return b, nil
+}
+
+// merge unions another bitmap into this one. Geometry must match — both
+// describe the same guest memory.
+func (b *dirtyBitmap) merge(other *dirtyBitmap) error {
+	if b.pageSize != other.pageSize || b.numPages != other.numPages {
+		return fmt.Errorf(
+			"bitmap geometry mismatch: %d pages of %d vs %d pages of %d",
+			b.numPages, b.pageSize, other.numPages, other.pageSize,
+		)
+	}
+
+	for i := range b.words {
+		b.words[i] |= other.words[i]
+	}
+
+	return nil
+}
+
+func (b *dirtyBitmap) clone() *dirtyBitmap {
+	words := make([]uint64, len(b.words))
+	copy(words, b.words)
+
+	return &dirtyBitmap{pageSize: b.pageSize, numPages: b.numPages, words: words}
+}
+
+// writeTo serializes the bitmap into the sidecar format at path, fsynced.
+func (b *dirtyBitmap) writeTo(path string) error {
+	data := make([]byte, 24+len(b.words)*8)
+	copy(data[0:4], fcdbMagic)
+	binary.LittleEndian.PutUint32(data[4:8], fcdbVersion)
+	binary.LittleEndian.PutUint64(data[8:16], b.pageSize)
+	binary.LittleEndian.PutUint64(data[16:24], b.numPages)
+	for i, w := range b.words {
+		binary.LittleEndian.PutUint64(data[24+i*8:], w)
+	}
+
+	if err := os.WriteFile(path, data, 0o644); err != nil {
+		return err
+	}
+
+	return syncFile(path)
+}
diff --git a/packages/orchestrator/internal/checkpoint/bitmap_test.go b/packages/orchestrator/internal/checkpoint/bitmap_test.go
new file mode 100644
index 000000000..75b7024aa
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/bitmap_test.go
@@ -0,0 +1,148 @@
+package checkpoint
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// TestBitmapWireFormat pins the sidecar bytes against the format the forked
+// Firecracker writes (serialize_dirty_bitmap): any drift on either side must
+// fail a test, not a rollback.
+func TestBitmapWireFormat(t *testing.T) {
+	b := &dirtyBitmap{pageSize: 4096, numPages: 4, words: []uint64{0b1001}}
+
+	path := filepath.Join(t.TempDir(), "bm")
+	require.NoError(t, b.writeTo(path))
+
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+
+	golden := []byte{
+		'F', 'C', 'D', 'B', // magic
+		1, 0, 0, 0, // version u32 LE
+		0x00, 0x10, 0, 0, 0, 0, 0, 0, // page_size 4096 u64 LE
+		4, 0, 0, 0, 0, 0, 0, 0, // num_pages u64 LE
+		0b1001, 0, 0, 0, 0, 0, 0, 0, // one word u64 LE
+	}
+	assert.Equal(t, golden, data)
+
+	back, err := readDirtyBitmap(path)
+	require.NoError(t, err)
+	assert.Equal(t, b, back)
+}
+
+func TestBitmapRejectsMalformed(t *testing.T) {
+	dir := t.TempDir()
+
+	write := func(name string, data []byte) string {
+		p := filepath.Join(dir, name)
+		require.NoError(t, os.WriteFile(p, data, 0o644))
+
+		return p
+	}
+
+	good := &dirtyBitmap{pageSize: 4096, numPages: 64, words: []uint64{0}}
+	goodPath := filepath.Join(dir, "good")
+	require.NoError(t, good.writeTo(goodPath))
+	goodData, _ := os.ReadFile(goodPath)
+
+	_, err := readDirtyBitmap(write("short", goodData[:10]))
+	assert.Error(t, err)
+
+	bad := append([]byte{}, goodData...)
+	bad[0] = 'X'
+	_, err = readDirtyBitmap(write("magic", bad))
+	assert.Error(t, err)
+
+	_, err = readDirtyBitmap(write("truncated", goodData[:len(goodData)-4]))
+	assert.Error(t, err)
+}
+
+func TestBitmapMergeIsUnion(t *testing.T) {
+	a := &dirtyBitmap{pageSize: 4096, numPages: 128, words: []uint64{0b0011, 0}}
+	b := &dirtyBitmap{pageSize: 4096, numPages: 128, words: []uint64{0b0101, 1}}
+
+	require.NoError(t, a.merge(b))
+	assert.Equal(t, []uint64{0b0111, 1}, a.words)
+
+	mismatched := &dirtyBitmap{pageSize: 16384, numPages: 128, words: []uint64{0, 0}}
+	assert.Error(t, a.merge(mismatched), "geometry mismatch must refuse, not corrupt")
+}
+
+func TestRevertBitmapCoversTreePath(t *testing.T) {
+	s := newTestStore(t)
+	out := filepath.Join(t.TempDir(), "revert")
+
+	union := func(targetID string) []uint64 {
+		t.Helper()
+
+		wrote, err := s.RevertBitmapForTarget("sbx", targetID, out)
+		require.NoError(t, err)
+		require.True(t, wrote)
+
+		got, err := readDirtyBitmap(out)
+		require.NoError(t, err)
+
+		return got.words
+	}
+
+	// A chain e1 ← e2 ← e3; e1 is Full with an all-ones sidecar, the way a
+	// real first checkpoint looks.
+	e1 := prepareWithFiles(t, s, "sbx", "one", 1)
+	writeEpoch(t, e1, []uint64{^uint64(0)})
+	require.NoError(t, s.Commit(e1, MemModeFull, nil))
+
+	e2 := prepareWithFiles(t, s, "sbx", "two", 2)
+	writeEpoch(t, e2, []uint64{0b0100})
+	require.NoError(t, s.Commit(e2, MemModeIncremental, nil))
+
+	e3 := prepareWithFiles(t, s, "sbx", "three", 3)
+	writeEpoch(t, e3, []uint64{0b1000})
+	require.NoError(t, s.Commit(e3, MemModeIncremental, nil))
+
+	// Base is e3 (the last commit). Rolling back to the base itself needs no
+	// file: the live dirty set alone is the revert set.
+	wrote, err := s.RevertBitmapForTarget("sbx", e3.ID, out)
+	require.NoError(t, err)
+	assert.False(t, wrote)
+
+	// e3 → e1 walks e3, e2 down to the common ancestor e1, which is excluded:
+	// e1's all-ones sidecar is never read, or every rollback to the root
+	// would degenerate to rewriting all of guest memory.
+	assert.Equal(t, []uint64{0b1100}, union(e1.ID))
+
+	// A fork: restored to e1, a new checkpoint e4 branches off it.
+	s.SetBaseToEntry(e1)
+	e4 := prepareWithFiles(t, s, "sbx", "four", 4)
+	writeEpoch(t, e4, []uint64{0b10000})
+	require.NoError(t, s.Commit(e4, MemModeIncremental, nil))
+	require.Equal(t, e1.ID, e4.ParentID)
+
+	// e4 → e1 is e4's epoch alone: e2 and e3 are beside it, not between.
+	assert.Equal(t, []uint64{0b10000}, union(e1.ID))
+
+	// e4 → e3 crosses the fork: both branches down to e1. A time-ordered
+	// interval (e3..e4] would have missed e2 and e3 entirely — the exact
+	// mistake that let a guest Oops after a cross-branch restore.
+	assert.Equal(t, []uint64{0b11100}, union(e3.ID))
+	assert.Equal(t, []uint64{0b10100}, union(e2.ID))
+
+	// A deleted checkpoint inside the path keeps contributing its epoch.
+	require.NoError(t, s.Delete("sbx", e2.ID))
+	assert.Equal(t, []uint64{0b11100}, union(e3.ID))
+
+	// A hidden entry is not a target.
+	_, err = s.RevertBitmapForTarget("sbx", e2.ID, out)
+	assert.Error(t, err)
+
+	// A sidecar lost from disk on the path refuses the rollback instead of
+	// producing a smaller set; paths that avoid it are unaffected.
+	require.NoError(t, os.Remove(e2.MemBitmap))
+	_, err = s.RevertBitmapForTarget("sbx", e3.ID, out)
+	assert.Error(t, err, "an unreadable epoch must refuse, never shrink the revert set")
+	assert.Equal(t, []uint64{0b10000}, union(e1.ID))
+}
diff --git a/packages/orchestrator/internal/checkpoint/clone.go b/packages/orchestrator/internal/checkpoint/clone.go
new file mode 100644
index 000000000..0fca67798
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/clone.go
@@ -0,0 +1,156 @@
+package checkpoint
+
+import (
+	"fmt"
+	"io"
+	"os"
+
+	"golang.org/x/sys/unix"
+)
+
+// CloneOrCopy makes dst an independent full copy of src, preferring a
+// filesystem reflink clone (FICLONE — metadata-only, instant, extents shared
+// copy-on-write) and falling back to a sparse-preserving byte copy. It
+// reports whether the fast path was taken so degradation shows up in logs and
+// metrics rather than only in latency.
+//
+// src must be immutable while this runs; the store's per-sandbox operation
+// lock guarantees that for base files.
+func CloneOrCopy(src string, dst string) (cloned bool, err error) {
+	in, err := os.Open(src)
+	if err != nil {
+		return false, fmt.Errorf("failed to open clone source: %w", err)
+	}
+	defer in.Close()
+
+	out, err := os.OpenFile(dst, os.O_RDWR|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err != nil {
+		return false, fmt.Errorf("failed to create clone target: %w", err)
+	}
+	defer func() {
+		if closeErr := out.Close(); err == nil && closeErr != nil {
+			err = fmt.Errorf("failed to close clone target: %w", closeErr)
+		}
+	}()
+
+	if err := unix.IoctlFileClone(int(out.Fd()), int(in.Fd())); err == nil {
+		return true, nil
+	}
+	// Not supported (ext4, cross-device, …) — fall through to a real copy.
+
+	if err := copySparse(in, out); err != nil {
+		return false, fmt.Errorf("failed to copy clone source: %w", err)
+	}
+
+	return false, nil
+}
+
+// copySparse copies only the data extents of in, leaving holes as holes, so a
+// mostly-empty memory file does not balloon into its logical size.
+func copySparse(in *os.File, out *os.File) error {
+	st, err := in.Stat()
+	if err != nil {
+		return err
+	}
+	size := st.Size()
+
+	var off int64
+	for off < size {
+		dataStart, err := in.Seek(off, unix.SEEK_DATA)
+		if err != nil {
+			if errno, ok := err.(*os.PathError); ok {
+				if errno.Err == unix.ENXIO {
+					// No more data before EOF.
+					break
+				}
+				if errno.Err == unix.EINVAL || errno.Err == unix.EOPNOTSUPP {
+					// Filesystem cannot enumerate holes; copy everything.
+					return copyDense(in, out, size)
+				}
+			}
+
+			return err
+		}
+
+		holeStart, err := in.Seek(dataStart, unix.SEEK_HOLE)
+		if err != nil {
+			return err
+		}
+
+		if err := copyRange(in, out, dataStart, holeStart-dataStart); err != nil {
+			return err
+		}
+
+		off = holeStart
+	}
+
+	return out.Truncate(size)
+}
+
+func copyDense(in *os.File, out *os.File, size int64) error {
+	if _, err := in.Seek(0, io.SeekStart); err != nil {
+		return err
+	}
+	if _, err := out.Seek(0, io.SeekStart); err != nil {
+		return err
+	}
+
+	_, err := io.Copy(out, in)
+
+	return err
+}
+
+// copyRange copies [off, off+length) from in to out at the same offset,
+// preferring in-kernel copy_file_range and falling back to buffered pread/
+// pwrite when the filesystem refuses.
+func copyRange(in *os.File, out *os.File, off int64, length int64) error {
+	roff, woff := off, off
+	remaining := length
+
+	for remaining > 0 {
+		chunk := remaining
+		if chunk > 1<<30 {
+			chunk = 1 << 30
+		}
+
+		n, err := unix.CopyFileRange(int(in.Fd()), &roff, int(out.Fd()), &woff, int(chunk), 0)
+		if err != nil {
+			return copyRangeBuffered(in, out, roff, off+length-roff)
+		}
+		if n == 0 {
+			break
+		}
+
+		remaining -= int64(n)
+	}
+
+	return nil
+}
+
+func copyRangeBuffered(in *os.File, out *os.File, off int64, length int64) error {
+	buf := make([]byte, 1<<20)
+
+	for length > 0 {
+		chunk := int64(len(buf))
+		if chunk > length {
+			chunk = length
+		}
+
+		n, err := in.ReadAt(buf[:chunk], off)
+		if err != nil && err != io.EOF {
+			return err
+		}
+		if n == 0 {
+			break
+		}
+
+		if _, err := out.WriteAt(buf[:n], off); err != nil {
+			return err
+		}
+
+		off += int64(n)
+		length -= int64(n)
+	}
+
+	return nil
+}
diff --git a/packages/orchestrator/internal/checkpoint/clone_test.go b/packages/orchestrator/internal/checkpoint/clone_test.go
new file mode 100644
index 000000000..d7202f6a7
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/clone_test.go
@@ -0,0 +1,59 @@
+package checkpoint
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestCloneOrCopyPreservesContentAndSize(t *testing.T) {
+	dir := t.TempDir()
+	src := filepath.Join(dir, "src")
+	dst := filepath.Join(dir, "dst")
+
+	// A sparse file: data at the start, a hole, data in the middle, and a
+	// hole running to EOF — the shape of a diff-overwritten memory clone.
+	f, err := os.Create(src)
+	require.NoError(t, err)
+	_, err = f.WriteAt([]byte("head"), 0)
+	require.NoError(t, err)
+	_, err = f.WriteAt([]byte("middle"), 1<<20)
+	require.NoError(t, err)
+	require.NoError(t, f.Truncate(4<<20))
+	require.NoError(t, f.Close())
+
+	_, err = CloneOrCopy(src, dst)
+	require.NoError(t, err)
+
+	want, err := os.ReadFile(src)
+	require.NoError(t, err)
+	got, err := os.ReadFile(dst)
+	require.NoError(t, err)
+	assert.Equal(t, want, got)
+
+	st, err := os.Stat(dst)
+	require.NoError(t, err)
+	assert.Equal(t, int64(4<<20), st.Size())
+}
+
+func TestCloneOrCopyTargetIsIndependent(t *testing.T) {
+	dir := t.TempDir()
+	src := filepath.Join(dir, "src")
+	dst := filepath.Join(dir, "dst")
+
+	require.NoError(t, os.WriteFile(src, []byte("original"), 0o644))
+
+	_, err := CloneOrCopy(src, dst)
+	require.NoError(t, err)
+
+	// Overwriting the clone must not touch the source: checkpoint targets
+	// are written into while the base stays immutable.
+	require.NoError(t, os.WriteFile(dst, []byte("modified"), 0o644))
+
+	data, err := os.ReadFile(src)
+	require.NoError(t, err)
+	assert.Equal(t, "original", string(data))
+}
diff --git a/packages/orchestrator/internal/checkpoint/header_agreement_test.go b/packages/orchestrator/internal/checkpoint/header_agreement_test.go
new file mode 100644
index 000000000..7c795ce61
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/header_agreement_test.go
@@ -0,0 +1,163 @@
+package checkpoint
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/block"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// baseDevice stands in for the template rootfs at the bottom of the stack.
+// Every block reads as the same byte, so a read that reaches it is
+// recognizable.
+type baseDevice struct{ fill byte }
+
+func (b baseDevice) ReadAt(_ context.Context, p []byte, _ int64) (int, error) {
+	for i := range p {
+		p[i] = b.fill
+	}
+
+	return len(p), nil
+}
+
+func (b baseDevice) Size(context.Context) (int64, error)                 { return testDevSize, nil }
+func (b baseDevice) BlockSize() int64                                    { return testBlockSize }
+func (b baseDevice) Slice(context.Context, int64, int64) ([]byte, error) { return nil, nil }
+func (b baseDevice) Header() *header.Header                              { return nil }
+func (b baseDevice) Close() error                                        { return nil }
+
+// TestMergedHeaderAgreesWithLayerStackReads checks the invariant the whole
+// disk design rests on: for every block, the layer the merged header names is
+// the layer the stack actually serves that block from.
+//
+// The two are produced by entirely separate code — the header by merging
+// mappings, the read by walking sealed layers — and only one of them is used
+// at a time: a live sandbox reads through the stack, while a restore assembles
+// its view from the header. If they ever disagree, a restored sandbox reads
+// different bytes than the sandbox that was checkpointed, which no test of
+// either half alone would catch.
+func TestMergedHeaderAgreesWithLayerStackReads(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	const baseFill = byte('B')
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+
+	// What each layer writes, and where. The overlaps are the interesting
+	// part: block 1 is written by all three, block 3 by the first and last.
+	generations := []struct {
+		fill   byte
+		blocks []int64
+	}{
+		{'1', []int64{0, 1, 3}},
+		{'2', []int64{1, 2}},
+		{'3', []int64{1, 3, 7}},
+	}
+
+	fillOf := map[uuid.UUID]byte{baseID: baseFill}
+
+	dir := t.TempDir()
+	write, err := block.NewCache(testDevSize, testBlockSize, filepath.Join(dir, "write-0"), false)
+	require.NoError(t, err)
+
+	overlay := block.NewOverlay(baseDevice{fill: baseFill}, write)
+	defer overlay.Close()
+
+	var view *RootfsView
+
+	for gen, g := range generations {
+		buf := make([]byte, testBlockSize)
+		for i := range buf {
+			buf[i] = g.fill
+		}
+
+		for _, b := range g.blocks {
+			_, err := overlay.WriteAt(buf, b*testBlockSize)
+			require.NoError(t, err)
+		}
+
+		// Seal, exactly as a checkpoint does: freeze the write layer into a
+		// file and hand the sandbox an empty one.
+		next, err := block.NewCache(testDevSize, testBlockSize, filepath.Join(dir, fmt.Sprintf("write-%d", gen+1)), false)
+		require.NoError(t, err)
+
+		sealed, err := overlay.Seal(next)
+		require.NoError(t, err)
+		require.NoError(t, sealed.Sync())
+
+		layerID := uuid.New()
+		fillOf[layerID] = g.fill
+
+		path := filepath.Join(layersDir, "layer-"+layerID.String())
+		require.NoError(t, sealed.MoveFile(path))
+
+		view, err = s.AppendLayer("sbx", base, layerID, &rootfs.SealedLayer{
+			Path:         path,
+			DirtyOffsets: sealed.DirtyOffsets(),
+			Size:         testDevSize,
+			BlockSize:    testBlockSize,
+		}, filepath.Join(t.TempDir(), fmt.Sprintf("header-%d", gen)))
+		require.NoError(t, err)
+	}
+
+	// The restore side: assemble the view from the layer files alone, the way
+	// switchRootfsView does.
+	restored, err := s.DiskViewForEntry(&Entry{ID: "ckpt", SandboxID: "sbx", Rootfs: view})
+	require.NoError(t, err)
+	require.Len(t, restored, len(generations))
+
+	var device block.ReadonlyDevice = baseDevice{fill: baseFill}
+	for _, l := range restored {
+		cache, err := block.NewCache(testDevSize, testBlockSize, l.Path, false)
+		require.NoError(t, err)
+		defer cache.CloseKeepFile()
+
+		cache.MarkCached(l.DirtyOffsets)
+		device = block.NewSealedView(device, cache)
+	}
+
+	// And the header side, read back from what the checkpoint recorded.
+	merged := readHeader(t, view.HeaderPath)
+
+	buf := make([]byte, testBlockSize)
+	for blockIdx := int64(0); blockIdx < testDevSize/testBlockSize; blockIdx++ {
+		off := blockIdx * testBlockSize
+
+		_, _, buildID, err := merged.GetShiftedMapping(t.Context(), off)
+		require.NoError(t, err)
+
+		wantFill, known := fillOf[*buildID]
+		require.True(t, known, "header names an unknown layer for block %d", blockIdx)
+
+		_, err = device.ReadAt(t.Context(), buf, off)
+		require.NoError(t, err)
+
+		assert.Equal(t, wantFill, buf[0],
+			"block %d: header says it comes from the layer holding %q, stack served %q",
+			blockIdx, wantFill, buf[0])
+	}
+}
+
+func readHeader(t *testing.T, path string) *header.Header {
+	t.Helper()
+
+	data, err := os.ReadFile(path)
+	require.NoError(t, err)
+
+	h, err := header.DeserializeBytes(data)
+	require.NoError(t, err)
+
+	return h
+}
diff --git a/packages/orchestrator/internal/checkpoint/metrics.go b/packages/orchestrator/internal/checkpoint/metrics.go
new file mode 100644
index 000000000..4cbebff40
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/metrics.go
@@ -0,0 +1,56 @@
+package checkpoint
+
+import (
+	"context"
+	"time"
+
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/metric"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/telemetry"
+	"github.com/e2b-dev/infra/packages/shared/pkg/utils"
+)
+
+var (
+	meter = otel.GetMeterProvider().Meter("orchestrator.internal.checkpoint")
+
+	checkpointCalls    = utils.Must(telemetry.GetCounter(meter, telemetry.SandboxCheckpointCalls))
+	checkpointDuration = utils.Must(telemetry.GetHistogram(meter, telemetry.SandboxCheckpointDurationHistogramName))
+)
+
+// callStats carries what only the handler knows about how an operation went,
+// so the caller that times it can report it in the same place.
+//
+// It exists for the degradation paths. A checkpoint that had to capture full
+// memory, or a clone that fell back to copying the base byte by byte, costs
+// orders of magnitude more than the intended path while still succeeding —
+// exactly the kind of regression that hides in a latency average until
+// somebody reads the logs. Reporting it as an attribute makes it answerable
+// from a dashboard.
+type callStats struct {
+	attrs []attribute.KeyValue
+}
+
+func (c *callStats) set(key string, value string) {
+	c.attrs = append(c.attrs, attribute.String(key, value))
+}
+
+func (c *callStats) setBool(key string, value bool) {
+	c.attrs = append(c.attrs, attribute.Bool(key, value))
+}
+
+// record reports the outcome and cost of one checkpoint operation.
+func record(ctx context.Context, operation string, start time.Time, err error, stats *callStats) {
+	attrs := make([]attribute.KeyValue, 0, len(stats.attrs)+2)
+	attrs = append(attrs,
+		attribute.String("operation", operation),
+		attribute.Bool("success", err == nil),
+	)
+	attrs = append(attrs, stats.attrs...)
+
+	set := metric.WithAttributes(attrs...)
+
+	checkpointCalls.Add(ctx, 1, set)
+	checkpointDuration.Record(ctx, time.Since(start).Milliseconds(), set)
+}
diff --git a/packages/orchestrator/internal/checkpoint/rootfs.go b/packages/orchestrator/internal/checkpoint/rootfs.go
new file mode 100644
index 000000000..2fab3a683
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/rootfs.go
@@ -0,0 +1,250 @@
+package checkpoint
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// rootfsState is the sandbox's live disk-view bookkeeping: the merged header
+// describing "template base + every sealed layer so far" and the layer files
+// backing it. It is the disk-side sibling of the memory base — internal,
+// per-sandbox, and reset by restores.
+type rootfsState struct {
+	meta    *header.Metadata
+	mapping []*header.BuildMap
+	layers  []RootfsLayer
+
+	// poisoned is set when the in-memory stack and the bookkeeping can no
+	// longer be proven to agree (a merge failed validation). Further
+	// checkpoints must fail loudly rather than record wrong views.
+	poisoned bool
+}
+
+// AppendLayer folds a sealed write layer into the sandbox's disk view and
+// writes the merged header for the checkpoint being created. base seeds the
+// bookkeeping on the first layer — it is the template rootfs header the
+// sandbox started on.
+//
+// The in-memory view advances even if writing the header file fails: the
+// layer is part of the live stack the moment it was sealed, and bookkeeping
+// must follow the stack, not the RPC's fate.
+func (s *Store) AppendLayer(sandboxID string, base *header.Header, layerID uuid.UUID, layer *rootfs.SealedLayer, headerOutPath string) (view *RootfsView, err error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	st, ok := s.rootfs[sandboxID]
+	if !ok {
+		// The layer is already sealed into the live stack by the time this
+		// runs, so a sandbox whose stack cannot be described must be marked
+		// as such rather than left looking healthy.
+		st = &rootfsState{}
+		s.rootfs[sandboxID] = st
+
+		if base == nil {
+			st.poisoned = true
+
+			return nil, fmt.Errorf("no rootfs bookkeeping for sandbox %s and no base header to seed it", sandboxID)
+		}
+
+		st.meta = base.Metadata
+		st.mapping = base.Mapping
+	}
+
+	if st.poisoned {
+		return nil, fmt.Errorf("rootfs bookkeeping for sandbox %s is poisoned; refusing to record a view that may be wrong", sandboxID)
+	}
+
+	// Past this point the stack has advanced and the bookkeeping has to keep
+	// up with it. Any failure means it no longer can, and every later view
+	// built from it would be missing this layer — silently serving stale
+	// blocks. Refuse to be trusted again instead; a restore reseeds the
+	// bookkeeping from a checkpoint's own header and clears this.
+	defer func() {
+		if err != nil {
+			st.poisoned = true
+		}
+	}()
+
+	if int64(st.meta.Size) != layer.Size {
+		return nil, fmt.Errorf("sealed layer size %d does not match device size %d", layer.Size, st.meta.Size)
+	}
+
+	layerMaps := identityMappings(layerID, layer.DirtyOffsets, layer.BlockSize)
+	merged := header.NormalizeMappings(header.MergeMappings(st.mapping, layerMaps))
+
+	if err := header.ValidateMappings(merged, st.meta.Size, st.meta.BlockSize); err != nil {
+		return nil, fmt.Errorf("merged rootfs mappings failed validation: %w", err)
+	}
+
+	st.meta = st.meta.NextGeneration(layerID)
+	st.mapping = merged
+	st.layers = append(st.layers, RootfsLayer{BuildID: layerID.String(), Path: layer.Path})
+
+	// The sidecar records which blocks the layer holds, so a restore can
+	// reopen the raw layer file with the same knowledge the live cache had.
+	if err := writeLayerMeta(layer.Path, layer.DirtyOffsets); err != nil {
+		return nil, fmt.Errorf("failed to write layer sidecar: %w", err)
+	}
+
+	data, err := header.Serialize(st.meta, st.mapping)
+	if err != nil {
+		return nil, fmt.Errorf("failed to serialize rootfs header: %w", err)
+	}
+
+	if err := os.WriteFile(headerOutPath, data, 0o644); err != nil {
+		return nil, fmt.Errorf("failed to write rootfs header: %w", err)
+	}
+
+	if err := syncFile(headerOutPath); err != nil {
+		return nil, fmt.Errorf("failed to sync rootfs header: %w", err)
+	}
+
+	layers := make([]RootfsLayer, len(st.layers))
+	copy(layers, st.layers)
+
+	return &RootfsView{
+		HeaderPath: headerOutPath,
+		Layers:     layers,
+	}, nil
+}
+
+// SetRootfsToEntry resets the sandbox's disk-view bookkeeping to a restored
+// checkpoint's view: the next sealed layer stacks on top of exactly what the
+// sandbox now reads.
+func (s *Store) SetRootfsToEntry(e *Entry) error {
+	if e.Rootfs == nil {
+		return fmt.Errorf("checkpoint %s has no rootfs view", e.ID)
+	}
+
+	data, err := os.ReadFile(e.Rootfs.HeaderPath)
+	if err != nil {
+		return fmt.Errorf("failed to read rootfs header: %w", err)
+	}
+
+	h, err := header.DeserializeBytes(data)
+	if err != nil {
+		return fmt.Errorf("failed to deserialize rootfs header: %w", err)
+	}
+
+	layers := make([]RootfsLayer, len(e.Rootfs.Layers))
+	copy(layers, e.Rootfs.Layers)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.rootfs[e.SandboxID] = &rootfsState{
+		meta:    h.Metadata,
+		mapping: h.Mapping,
+		layers:  layers,
+	}
+
+	return nil
+}
+
+// DiskViewForEntry loads the restore-side disk view of a checkpoint: its
+// sealed layers bottom to top, each with the block offsets it holds (from the
+// layer sidecars written at seal time).
+func (s *Store) DiskViewForEntry(e *Entry) ([]sandbox.RestoreLayer, error) {
+	if e.Rootfs == nil {
+		return nil, nil
+	}
+
+	layers := make([]sandbox.RestoreLayer, 0, len(e.Rootfs.Layers))
+	for _, l := range e.Rootfs.Layers {
+		offsets, err := readLayerMeta(l.Path)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read sidecar of layer %s: %w", l.Path, err)
+		}
+
+		layers = append(layers, sandbox.RestoreLayer{
+			Path:         l.Path,
+			DirtyOffsets: offsets,
+		})
+	}
+
+	return layers, nil
+}
+
+const layerMetaSuffix = ".meta"
+
+// writeLayerMeta persists a layer's block offsets next to it, 8 bytes
+// little-endian each, via temp file and atomic rename.
+func writeLayerMeta(layerPath string, offsets []int64) error {
+	data := make([]byte, 8*len(offsets))
+	for i, off := range offsets {
+		binary.LittleEndian.PutUint64(data[8*i:], uint64(off))
+	}
+
+	path := layerPath + layerMetaSuffix
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return err
+	}
+
+	if err := syncFile(tmp); err != nil {
+		return err
+	}
+
+	return os.Rename(tmp, path)
+}
+
+func readLayerMeta(layerPath string) ([]int64, error) {
+	data, err := os.ReadFile(layerPath + layerMetaSuffix)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(data)%8 != 0 {
+		return nil, fmt.Errorf("sidecar has truncated content (%d bytes)", len(data))
+	}
+
+	offsets := make([]int64, len(data)/8)
+	for i := range offsets {
+		offsets[i] = int64(binary.LittleEndian.Uint64(data[8*i:]))
+	}
+
+	return offsets, nil
+}
+
+// identityMappings builds the header mappings a sealed layer contributes:
+// runs of consecutive dirty blocks, each mapping a device range to the same
+// offsets inside the layer file. Storage offset equals device offset because
+// the layer is the raw write-layer file, sealed in place — no compaction.
+func identityMappings(layerID uuid.UUID, dirtyOffsets []int64, blockSize int64) []*header.BuildMap {
+	var mappings []*header.BuildMap
+
+	var runStart, runLength int64
+	flush := func() {
+		if runLength == 0 {
+			return
+		}
+
+		mappings = append(mappings, &header.BuildMap{
+			Offset:             uint64(runStart),
+			Length:             uint64(runLength),
+			BuildId:            layerID,
+			BuildStorageOffset: uint64(runStart),
+		})
+	}
+
+	for _, off := range dirtyOffsets {
+		if runLength > 0 && off == runStart+runLength {
+			runLength += blockSize
+
+			continue
+		}
+
+		flush()
+		runStart, runLength = off, blockSize
+	}
+	flush()
+
+	return mappings
+}
diff --git a/packages/orchestrator/internal/checkpoint/rootfs_test.go b/packages/orchestrator/internal/checkpoint/rootfs_test.go
new file mode 100644
index 000000000..4f306aeb0
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/rootfs_test.go
@@ -0,0 +1,293 @@
+package checkpoint
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/google/uuid"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+const (
+	testBlockSize = int64(4096)
+	testDevSize   = int64(64 * 4096)
+)
+
+func testBaseHeader(t *testing.T, baseID uuid.UUID) *header.Header {
+	t.Helper()
+
+	meta := header.NewTemplateMetadata(baseID, uint64(testBlockSize), uint64(testDevSize))
+	h, err := header.NewHeader(meta, []*header.BuildMap{{
+		Offset:             0,
+		Length:             uint64(testDevSize),
+		BuildId:            baseID,
+		BuildStorageOffset: 0,
+	}})
+	require.NoError(t, err)
+
+	return h
+}
+
+func TestIdentityMappingsBuildsRuns(t *testing.T) {
+	layerID := uuid.New()
+
+	maps := identityMappings(layerID, []int64{0, 4096, 8192, 20480}, 4096)
+
+	require.Len(t, maps, 2)
+
+	assert.Equal(t, uint64(0), maps[0].Offset)
+	assert.Equal(t, uint64(3*4096), maps[0].Length)
+	assert.Equal(t, uint64(0), maps[0].BuildStorageOffset, "storage offset is the device offset")
+
+	assert.Equal(t, uint64(20480), maps[1].Offset)
+	assert.Equal(t, uint64(4096), maps[1].Length)
+	assert.Equal(t, uint64(20480), maps[1].BuildStorageOffset)
+
+	assert.Empty(t, identityMappings(layerID, nil, 4096))
+}
+
+func fakeSealedLayer(t *testing.T, dir string, name string, offsets []int64) *rootfs.SealedLayer {
+	t.Helper()
+
+	path := filepath.Join(dir, name)
+	require.NoError(t, os.WriteFile(path, []byte{}, 0o644))
+
+	return &rootfs.SealedLayer{
+		Path:         path,
+		DirtyOffsets: offsets,
+		Size:         testDevSize,
+		BlockSize:    testBlockSize,
+	}
+}
+
+func TestAppendLayerMergesAndPersists(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+
+	layer1ID := uuid.New()
+	layer1 := fakeSealedLayer(t, layersDir, "layer-"+layer1ID.String(), []int64{0, 4096})
+
+	headerPath := filepath.Join(t.TempDir(), "rootfs.header")
+	view, err := s.AppendLayer("sbx", base, layer1ID, layer1, headerPath)
+	require.NoError(t, err)
+
+	require.Len(t, view.Layers, 1)
+	assert.Equal(t, layer1ID.String(), view.Layers[0].BuildID)
+	assert.Equal(t, headerPath, view.HeaderPath)
+
+	// The written header must deserialize into a view where the layer's
+	// blocks map to the layer and everything else still maps to the base.
+	data, err := os.ReadFile(headerPath)
+	require.NoError(t, err)
+	h, err := header.DeserializeBytes(data)
+	require.NoError(t, err)
+
+	assertMapsTo(t, h, 0, layer1ID)
+	assertMapsTo(t, h, 4096, layer1ID)
+	assertMapsTo(t, h, 8192, baseID)
+	assertMapsTo(t, h, testDevSize-testBlockSize, baseID)
+}
+
+func TestAppendLayerStacksNewestOnTop(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+	headerDir := t.TempDir()
+
+	layer1ID := uuid.New()
+	layer1 := fakeSealedLayer(t, layersDir, "layer-"+layer1ID.String(), []int64{0, 4096, 8192})
+	_, err = s.AppendLayer("sbx", base, layer1ID, layer1, filepath.Join(headerDir, "h1"))
+	require.NoError(t, err)
+
+	// The second layer overwrites the middle of the first one.
+	layer2ID := uuid.New()
+	layer2 := fakeSealedLayer(t, layersDir, "layer-"+layer2ID.String(), []int64{4096, 12288})
+	view2, err := s.AppendLayer("sbx", nil, layer2ID, layer2, filepath.Join(headerDir, "h2"))
+	require.NoError(t, err)
+
+	require.Len(t, view2.Layers, 2)
+
+	data, err := os.ReadFile(filepath.Join(headerDir, "h2"))
+	require.NoError(t, err)
+	h, err := header.DeserializeBytes(data)
+	require.NoError(t, err)
+
+	assertMapsTo(t, h, 0, layer1ID)
+	assertMapsTo(t, h, 4096, layer2ID, "the newer layer wins where both wrote")
+	assertMapsTo(t, h, 8192, layer1ID)
+	assertMapsTo(t, h, 12288, layer2ID)
+	assertMapsTo(t, h, 16384, baseID)
+
+	// The first checkpoint's view is untouched by the second seal.
+	data, err = os.ReadFile(filepath.Join(headerDir, "h1"))
+	require.NoError(t, err)
+	h1, err := header.DeserializeBytes(data)
+	require.NoError(t, err)
+	assertMapsTo(t, h1, 4096, layer1ID)
+	assertMapsTo(t, h1, 12288, baseID)
+}
+
+func TestSetRootfsToEntryResetsBookkeeping(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+	headerDir := t.TempDir()
+
+	layer1ID := uuid.New()
+	layer1 := fakeSealedLayer(t, layersDir, "layer-"+layer1ID.String(), []int64{0})
+	h1Path := filepath.Join(headerDir, "h1")
+	view1, err := s.AppendLayer("sbx", base, layer1ID, layer1, h1Path)
+	require.NoError(t, err)
+
+	layer2ID := uuid.New()
+	layer2 := fakeSealedLayer(t, layersDir, "layer-"+layer2ID.String(), []int64{4096})
+	_, err = s.AppendLayer("sbx", nil, layer2ID, layer2, filepath.Join(headerDir, "h2"))
+	require.NoError(t, err)
+
+	// Restore back to checkpoint 1: bookkeeping returns to its view, and the
+	// next layer stacks on checkpoint 1, not on the discarded timeline.
+	entry1 := &Entry{ID: "ckpt1", SandboxID: "sbx", Rootfs: view1}
+	require.NoError(t, s.SetRootfsToEntry(entry1))
+
+	layer3ID := uuid.New()
+	layer3 := fakeSealedLayer(t, layersDir, "layer-"+layer3ID.String(), []int64{8192})
+	view3, err := s.AppendLayer("sbx", nil, layer3ID, layer3, filepath.Join(headerDir, "h3"))
+	require.NoError(t, err)
+
+	require.Len(t, view3.Layers, 2, "the discarded timeline's layer is not in the view")
+	assert.Equal(t, layer1ID.String(), view3.Layers[0].BuildID)
+	assert.Equal(t, layer3ID.String(), view3.Layers[1].BuildID)
+
+	data, err := os.ReadFile(filepath.Join(headerDir, "h3"))
+	require.NoError(t, err)
+	h, err := header.DeserializeBytes(data)
+	require.NoError(t, err)
+
+	assertMapsTo(t, h, 0, layer1ID)
+	assertMapsTo(t, h, 4096, baseID, "the discarded layer's block reads from base again")
+	assertMapsTo(t, h, 8192, layer3ID)
+}
+
+func TestDiskViewForEntryRoundTripsSidecars(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+
+	offsets := []int64{0, 8192, 12288}
+	layerID := uuid.New()
+	layer := fakeSealedLayer(t, layersDir, "layer-"+layerID.String(), offsets)
+	view, err := s.AppendLayer("sbx", base, layerID, layer, filepath.Join(t.TempDir(), "h"))
+	require.NoError(t, err)
+
+	entry := &Entry{ID: "ckpt", SandboxID: "sbx", Rootfs: view}
+	restoreLayers, err := s.DiskViewForEntry(entry)
+	require.NoError(t, err)
+
+	require.Len(t, restoreLayers, 1)
+	assert.Equal(t, layer.Path, restoreLayers[0].Path)
+	assert.Equal(t, offsets, restoreLayers[0].DirtyOffsets)
+
+	// An entry without a rootfs view means a deliberate memory-only restore.
+	none, err := s.DiskViewForEntry(&Entry{ID: "x", SandboxID: "sbx"})
+	require.NoError(t, err)
+	assert.Nil(t, none)
+}
+
+func assertMapsTo(t *testing.T, h *header.Header, off int64, want uuid.UUID, msgAndArgs ...any) {
+	t.Helper()
+
+	_, _, buildID, err := h.GetShiftedMapping(t.Context(), off)
+	require.NoError(t, err)
+	assert.Equal(t, want, *buildID, msgAndArgs...)
+}
+
+func TestAppendLayerPoisonsOnFailure(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+	headerDir := t.TempDir()
+
+	good := fakeSealedLayer(t, layersDir, "layer-good", []int64{0})
+	_, err = s.AppendLayer("sbx", base, uuid.New(), good, filepath.Join(headerDir, "h1"))
+	require.NoError(t, err)
+
+	// A layer whose size disagrees with the device cannot be described, but
+	// it is already sealed into the live stack by the time we find out.
+	bad := fakeSealedLayer(t, layersDir, "layer-bad", []int64{4096})
+	bad.Size = testDevSize / 2
+	_, err = s.AppendLayer("sbx", nil, uuid.New(), bad, filepath.Join(headerDir, "h2"))
+	require.Error(t, err)
+
+	// Every later checkpoint must fail loudly rather than record a view that
+	// silently omits the layer the stack actually has.
+	next := fakeSealedLayer(t, layersDir, "layer-next", []int64{8192})
+	_, err = s.AppendLayer("sbx", nil, uuid.New(), next, filepath.Join(headerDir, "h3"))
+	require.ErrorContains(t, err, "poisoned")
+}
+
+func TestRestoreClearsPoisonedBookkeeping(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	baseID := uuid.New()
+	base := testBaseHeader(t, baseID)
+	headerDir := t.TempDir()
+
+	layer1ID := uuid.New()
+	layer1 := fakeSealedLayer(t, layersDir, "layer-"+layer1ID.String(), []int64{0})
+	view1, err := s.AppendLayer("sbx", base, layer1ID, layer1, filepath.Join(headerDir, "h1"))
+	require.NoError(t, err)
+
+	bad := fakeSealedLayer(t, layersDir, "layer-bad", []int64{4096})
+	bad.Size = testDevSize / 2
+	_, err = s.AppendLayer("sbx", nil, uuid.New(), bad, filepath.Join(headerDir, "h2"))
+	require.Error(t, err)
+
+	// A restore rebuilds the bookkeeping from the checkpoint's own header, so
+	// it describes the stack again and checkpoints can resume.
+	require.NoError(t, s.SetRootfsToEntry(&Entry{ID: "ckpt1", SandboxID: "sbx", Rootfs: view1}))
+
+	layer3ID := uuid.New()
+	layer3 := fakeSealedLayer(t, layersDir, "layer-"+layer3ID.String(), []int64{8192})
+	view3, err := s.AppendLayer("sbx", nil, layer3ID, layer3, filepath.Join(headerDir, "h3"))
+	require.NoError(t, err)
+	assert.Len(t, view3.Layers, 2)
+}
+
+func TestAppendLayerWithoutBaseOrBookkeepingPoisons(t *testing.T) {
+	s := newTestStore(t)
+	layersDir, err := s.LayersDir("sbx")
+	require.NoError(t, err)
+
+	orphan := fakeSealedLayer(t, layersDir, "layer-orphan", []int64{0})
+	_, err = s.AppendLayer("sbx", nil, uuid.New(), orphan, filepath.Join(t.TempDir(), "h"))
+	require.Error(t, err)
+
+	// The layer is in the live stack even though it could not be recorded.
+	base := testBaseHeader(t, uuid.New())
+	next := fakeSealedLayer(t, layersDir, "layer-next", []int64{4096})
+	_, err = s.AppendLayer("sbx", base, uuid.New(), next, filepath.Join(t.TempDir(), "h2"))
+	require.ErrorContains(t, err, "poisoned")
+}
