diff --git a/packages/orchestrator/internal/checkpoint/bitmap.go b/packages/orchestrator/internal/checkpoint/bitmap.go
new file mode 100644
index 000000000..1c38b6a8c
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/bitmap.go
@@ -0,0 +1,120 @@
+package checkpoint
+
+import (
+	"encoding/binary"
+	"fmt"
+	"os"
+)
+
+// The FCDB sidecar format, shared with the forked Firecracker (see
+// serialize_dirty_bitmap there): magic "FCDB", version u32 LE, page_size u64
+// LE, num_pages u64 LE, then ceil(num_pages/64) u64 LE words, bit i of word w
+// covering the page at file offset (w*64+i)*page_size of the memory file.
+const (
+	fcdbMagic   = "FCDB"
+	fcdbVersion = 1
+)
+
+// dirtyBitmap is one parsed sidecar, or the running union of several.
+type dirtyBitmap struct {
+	pageSize uint64
+	numPages uint64
+	words    []uint64
+}
+
+// dirtyBitmapHeaderSize is the fixed part of a bitmap file ahead of its
+// words: magic, version, page size and page count.
+const dirtyBitmapHeaderSize = 24
+
+func readDirtyBitmap(path string) (*dirtyBitmap, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(data) < 24 || string(data[0:4]) != fcdbMagic {
+		return nil, fmt.Errorf("malformed dirty bitmap file %s", path)
+	}
+	if v := binary.LittleEndian.Uint32(data[4:8]); v != fcdbVersion {
+		return nil, fmt.Errorf("unsupported dirty bitmap version %d", v)
+	}
+
+	b := &dirtyBitmap{
+		pageSize: binary.LittleEndian.Uint64(data[8:16]),
+		numPages: binary.LittleEndian.Uint64(data[16:24]),
+	}
+
+	numWords := (b.numPages + 63) / 64
+	if uint64(len(data)) != 24+numWords*8 {
+		return nil, fmt.Errorf("truncated dirty bitmap file %s", path)
+	}
+
+	b.words = make([]uint64, numWords)
+	for i := range b.words {
+		b.words[i] = binary.LittleEndian.Uint64(data[24+i*8:])
+	}
+
+	return b, nil
+}
+
+// merge unions another bitmap into this one. Geometry must match — both
+// describe the same guest memory.
+func (b *dirtyBitmap) merge(other *dirtyBitmap) error {
+	if b.pageSize != other.pageSize || b.numPages != other.numPages {
+		return fmt.Errorf(
+			"bitmap geometry mismatch: %d pages of %d vs %d pages of %d",
+			b.numPages, b.pageSize, other.numPages, other.pageSize,
+		)
+	}
+
+	for i := range b.words {
+		b.words[i] |= other.words[i]
+	}
+
+	return nil
+}
+
+func (b *dirtyBitmap) clone() *dirtyBitmap {
+	words := make([]uint64, len(b.words))
+	copy(words, b.words)
+
+	return &dirtyBitmap{pageSize: b.pageSize, numPages: b.numPages, words: words}
+}
+
+// writeTo serializes the bitmap into the sidecar format at path.
+func (b *dirtyBitmap) writeTo(path string) error {
+	data := make([]byte, 24+len(b.words)*8)
+	copy(data[0:4], fcdbMagic)
+	binary.LittleEndian.PutUint32(data[4:8], fcdbVersion)
+	binary.LittleEndian.PutUint64(data[8:16], b.pageSize)
+	binary.LittleEndian.PutUint64(data[16:24], b.numPages)
+	for i, w := range b.words {
+		binary.LittleEndian.PutUint64(data[24+i*8:], w)
+	}
+
+	// No fsync: the revert bitmap this writes on the restore path is deleted
+	// again as soon as the rollback returns, and it is written inside the
+	// guest freeze window -- fsyncing a file nobody will ever read after a
+	// crash, while the guest is stopped, buys nothing and costs whatever
+	// the filesystem journal is busy with.
+	return os.WriteFile(path, data, 0o644)
+}
+
+// contains reports whether the page's bit is set.
+func (b *dirtyBitmap) contains(page uint64) bool {
+	return b.words[page/64]&(1<<(page%64)) != 0
+}
+
+// allOnesBitmap is the implicit epoch bitmap of a full capture: every page.
+// Bits past numPages stay clear so unions with real sidecars agree.
+func allOnesBitmap(pageSize uint64, numPages uint64) *dirtyBitmap {
+	words := make([]uint64, (numPages+63)/64)
+	for i := range words {
+		words[i] = ^uint64(0)
+	}
+	if r := numPages % 64; r != 0 {
+		words[len(words)-1] = (uint64(1) << r) - 1
+	}
+
+	return &dirtyBitmap{pageSize: pageSize, numPages: numPages, words: words}
+}
diff --git a/packages/orchestrator/internal/checkpoint/capabilities.go b/packages/orchestrator/internal/checkpoint/capabilities.go
new file mode 100644
index 000000000..4d4b958ee
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/capabilities.go
@@ -0,0 +1,139 @@
+package checkpoint
+
+import (
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/fc"
+)
+
+// sourceEnv and sourceDefault say where a setting got the value the node is
+// actually running with. A timeout printed without its source answers the
+// wrong half of the question an operator is asking: seeing "60s" does not
+// say whether the environment was read at all, and a typo in a unit file
+// looks exactly like the default.
+const (
+	sourceEnv     = "env"
+	sourceDefault = "default"
+)
+
+// Capabilities is what this node's checkpoint stack will do before anyone
+// asks it to do anything: where its store is, whether checkpoints are
+// incremental, the two bounds that decide how long a stuck operation is
+// allowed to look alive, and whichever faults are armed. All of it is
+// otherwise invisible until the failure it explains has already happened.
+type Capabilities struct {
+	Store                 string
+	TrackDirtyPages       bool
+	TrackDirtyPagesReason string
+
+	// LockWaitTimeout bounds queueing behind another operation on the same
+	// sandbox; LockWaitSource is sourceEnv or sourceDefault.
+	LockWaitTimeout time.Duration
+	LockWaitSource  string
+
+	// FCCallTimeout bounds one Firecracker API call; FCCallSource is
+	// sourceEnv or sourceDefault.
+	FCCallTimeout time.Duration
+	FCCallSource  string
+
+	// MinFreeBytes is the room the store's filesystem must still have for a
+	// checkpoint to start, reported without a sandbox in hand, so it is the
+	// floor; a sandbox with more than 2 GiB of guest memory is held to more
+	// than this. MinFreeSource is sourceEnv or sourceDefault.
+	MinFreeBytes  int64
+	MinFreeSource string
+
+	// MaxPerSandbox is the per-sandbox checkpoint limit, 0 for none;
+	// MaxPerSandboxSource is sourceEnv or sourceDefault.
+	MaxPerSandbox       int
+	MaxPerSandboxSource string
+
+	// MaxBytesPerSandbox is the per-sandbox limit on the bytes checkpoints
+	// occupy, 0 for none; MaxBytesPerSandboxSource is sourceEnv or
+	// sourceDefault. See quota.go.
+	MaxBytesPerSandbox       int64
+	MaxBytesPerSandboxSource string
+
+	// DebugIndex says whether the store writes a per-sandbox index.json;
+	// DebugIndexSource is sourceEnv or sourceDefault.
+	DebugIndex       bool
+	DebugIndexSource string
+
+	// Compact says whether hidden checkpoints are folded into their only
+	// child, and CompactMaxPerOp how many folds one delete performs at most;
+	// the sources are sourceEnv or sourceDefault. See compact.go.
+	Compact               bool
+	CompactSource         string
+	CompactMaxPerOp       int
+	CompactMaxPerOpSource string
+
+	// FaultInject is the armed fault list, empty on every node that is not
+	// running a failure test.
+	FaultInject []string
+}
+
+// DescribeCapabilities reads the same functions the running code reads, so a
+// reported timeout is the one an operation will really wait out rather than
+// a second parse of the environment that could disagree with it.
+func DescribeCapabilities(storeDir string) Capabilities {
+	lockWait, lockWaitSource := LockWaitTimeout()
+	fcCall, fcCallSource := sandbox.FCCallTimeout()
+	minFree, minFreeSource := minFreeBytes(0)
+	maxPerSandbox, maxPerSandboxSource := MaxPerSandbox()
+	maxBytesPerSandbox, maxBytesPerSandboxSource := MaxBytesPerSandbox()
+	debugIndex, debugIndexSource := DebugIndex()
+	compact, compactSource := Compaction()
+	compactMaxPerOp, compactMaxPerOpSource := CompactMaxPerOp()
+
+	return Capabilities{
+		Store:                    storeDir,
+		TrackDirtyPages:          fc.TrackDirtyPagesEnabled(),
+		TrackDirtyPagesReason:    fc.TrackDirtyPagesReason(),
+		LockWaitTimeout:          lockWait,
+		LockWaitSource:           lockWaitSource,
+		FCCallTimeout:            fcCall,
+		FCCallSource:             fcCallSource,
+		MinFreeBytes:             minFree,
+		MinFreeSource:            minFreeSource,
+		MaxPerSandbox:            maxPerSandbox,
+		MaxPerSandboxSource:      maxPerSandboxSource,
+		MaxBytesPerSandbox:       maxBytesPerSandbox,
+		MaxBytesPerSandboxSource: maxBytesPerSandboxSource,
+		DebugIndex:               debugIndex,
+		DebugIndexSource:         debugIndexSource,
+		Compact:                  compact,
+		CompactSource:            compactSource,
+		CompactMaxPerOp:          compactMaxPerOp,
+		CompactMaxPerOpSource:    compactMaxPerOpSource,
+		FaultInject:              faultsEnabled().armed(),
+	}
+}
+
+// Fields is the capabilities as one log line's worth of fields.
+func (c Capabilities) Fields() []zap.Field {
+	return []zap.Field{
+		zap.String("store", c.Store),
+		zap.Bool("track_dirty_pages", c.TrackDirtyPages),
+		zap.String("track_dirty_pages_reason", c.TrackDirtyPagesReason),
+		zap.Duration("lock_wait_timeout", c.LockWaitTimeout),
+		zap.String("lock_wait_timeout_source", c.LockWaitSource),
+		zap.Duration("fc_call_timeout", c.FCCallTimeout),
+		zap.String("fc_call_timeout_source", c.FCCallSource),
+		zap.Int64("min_free_bytes", c.MinFreeBytes),
+		zap.String("min_free_bytes_source", c.MinFreeSource),
+		zap.Int("max_checkpoints_per_sandbox", c.MaxPerSandbox),
+		zap.String("max_checkpoints_per_sandbox_source", c.MaxPerSandboxSource),
+		zap.Int64("max_checkpoint_bytes_per_sandbox", c.MaxBytesPerSandbox),
+		zap.String("max_checkpoint_bytes_per_sandbox_source", c.MaxBytesPerSandboxSource),
+		zap.Bool("debug_index", c.DebugIndex),
+		zap.String("debug_index_source", c.DebugIndexSource),
+		zap.Bool("compact", c.Compact),
+		zap.String("compact_source", c.CompactSource),
+		zap.Int("compact_max_per_op", c.CompactMaxPerOp),
+		zap.String("compact_max_per_op_source", c.CompactMaxPerOpSource),
+		zap.Strings("fault_inject", c.FaultInject),
+	}
+}
diff --git a/packages/orchestrator/internal/checkpoint/capabilities_file.go b/packages/orchestrator/internal/checkpoint/capabilities_file.go
new file mode 100644
index 000000000..67d534a33
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/capabilities_file.go
@@ -0,0 +1,123 @@
+package checkpoint
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"go.uber.org/zap/zapcore"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// CapabilitiesFileName is the file the startup capabilities are also
+// written to, next to the store root rather than in it: NewStore clears the
+// root on every start.
+//
+// The log line says the same thing, once, at startup, and on a busy node the
+// alloc's log rotation drops it within minutes -- which is exactly when an
+// operator or a smoke run goes looking for it. The file stays until the next
+// start overwrites it.
+const CapabilitiesFileName = "checkpoint-capabilities.json"
+
+// CapabilitiesProcess is what the file carries besides the capabilities:
+// which process wrote it, when that process started, and what it was built
+// from, so a reader can tell a file left by an earlier run from the running
+// node's.
+type CapabilitiesProcess struct {
+	PID       int
+	StartedAt time.Time
+	Version   string
+	Commit    string
+}
+
+// capabilitiesJSON renders the capabilities' log fields with the encoder
+// settings of the log line itself, so each key carries the value the log line
+// shows (a duration as "1m0s", not nanoseconds), and adds the process keys.
+func capabilitiesJSON(c Capabilities, p CapabilitiesProcess) ([]byte, error) {
+	cfg := logger.GetConsoleEncoderConfig()
+	cfg.TimeKey = zapcore.OmitKey
+	cfg.LevelKey = zapcore.OmitKey
+	cfg.NameKey = zapcore.OmitKey
+	cfg.CallerKey = zapcore.OmitKey
+	cfg.FunctionKey = zapcore.OmitKey
+	cfg.MessageKey = zapcore.OmitKey
+	cfg.StacktraceKey = zapcore.OmitKey
+
+	buf, err := zapcore.NewJSONEncoder(cfg).EncodeEntry(zapcore.Entry{}, c.Fields())
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode capabilities: %w", err)
+	}
+	defer buf.Free()
+
+	var doc map[string]any
+	if err := json.Unmarshal(buf.Bytes(), &doc); err != nil {
+		return nil, fmt.Errorf("failed to decode capabilities: %w", err)
+	}
+
+	doc["pid"] = p.PID
+	doc["started_at"] = p.StartedAt.Format(time.RFC3339)
+	doc["version"] = p.Version
+	doc["commit"] = p.Commit
+
+	out, err := json.MarshalIndent(doc, "", "  ")
+	if err != nil {
+		return nil, fmt.Errorf("failed to encode capabilities file: %w", err)
+	}
+
+	return append(out, '\n'), nil
+}
+
+// WriteCapabilitiesFile writes the capabilities to dir/CapabilitiesFileName
+// and returns the path. The file is replaced atomically -- written under a
+// temporary name in the same directory and renamed over the old one -- so a
+// reader sees either the previous start's file or this one, never half of
+// either.
+func WriteCapabilitiesFile(dir string, c Capabilities, p CapabilitiesProcess) (string, error) {
+	data, err := capabilitiesJSON(c, p)
+	if err != nil {
+		return "", err
+	}
+
+	path := filepath.Join(dir, CapabilitiesFileName)
+
+	tmp, err := os.CreateTemp(dir, CapabilitiesFileName+".tmp-*")
+	if err != nil {
+		return "", fmt.Errorf("failed to create %s: %w", path, err)
+	}
+
+	tmpPath := tmp.Name()
+	committed := false
+
+	defer func() {
+		if !committed {
+			_ = os.Remove(tmpPath)
+		}
+	}()
+
+	if _, err := tmp.Write(data); err != nil {
+		_ = tmp.Close()
+
+		return "", fmt.Errorf("failed to write %s: %w", tmpPath, err)
+	}
+
+	if err := tmp.Close(); err != nil {
+		return "", fmt.Errorf("failed to write %s: %w", tmpPath, err)
+	}
+
+	// CreateTemp makes the file 0600; the file is for whoever operates the
+	// node, not only root.
+	if err := os.Chmod(tmpPath, 0o644); err != nil {
+		return "", fmt.Errorf("failed to chmod %s: %w", tmpPath, err)
+	}
+
+	if err := os.Rename(tmpPath, path); err != nil {
+		return "", fmt.Errorf("failed to replace %s: %w", path, err)
+	}
+
+	committed = true
+
+	return path, nil
+}
diff --git a/packages/orchestrator/internal/checkpoint/compact.go b/packages/orchestrator/internal/checkpoint/compact.go
new file mode 100644
index 000000000..c103226c8
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/compact.go
@@ -0,0 +1,1075 @@
+package checkpoint
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/bits"
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// Folding a hidden checkpoint into its only child ("compaction").
+//
+// Deleting a checkpoint that still has children hides it (deleteLocked), and a
+// hidden entry used to go only once it became a childless non-base leaf
+// (pruneLocked). A client that keeps its newest N checkpoints and deletes the
+// oldest never produces such a leaf: every entry it deletes is the parent of
+// the next one. The hidden entries then pile up without bound -- the long runs
+// measured ~1300 per sandbox after 12 hours, chains ~1100 deep -- and so does
+// the disk, and a restore's materialize walks the whole chain. The limit on
+// checkpoints per sandbox counts only visible ones, so it does not stop it.
+//
+// Compaction folds such an entry into its child instead of keeping it. A
+// candidate H is hidden, is not the base, and has exactly one child C (the
+// children table answers that). It is never the target of a restore: a hidden
+// entry cannot be one (Get does not return it), and every operation on a
+// sandbox holds the sandbox's gate, so no restore is running while a delete
+// folds.
+//
+// # Why folding H into C changes no restore
+//
+// A restore reads two things out of the tree: the revert set, the union of the
+// epoch bitmaps on the path from the current base B to the target T minus
+// their lowest common ancestor (revertPathLocked), and each reverted page's
+// content, resolved newest first down T's ancestor chain (writeRevertMem).
+//
+//   - Every chain and every revert path through H also passes through C, right
+//     next to H. A content chain starts at T, which is never H; if it reaches H
+//     it came up from H's subtree, and H's only child is C. A revert path runs
+//     from B and from T up to their LCA, excluding it; if H is on it, the
+//     branch it is on started below H (neither B nor T is H), so it passed
+//     through C just before. H is never the LCA itself: that takes two
+//     different children of H on the two branches, or H as one endpoint. So H
+//     is on a path exactly when C is, and that holds across trees too (LCA
+//     "", where both branches run to their roots).
+//
+//   - Revert sets: since H and C always come together, replacing both with one
+//     entry whose epoch bitmap is rev(H) | rev(C) leaves every union as it was.
+//
+//   - Content: on a chain through H, C is consulted first. A page C holds is
+//     served by C with or without H behind it. A page C lacks and H holds was
+//     served by H, and is now served by the merged C, whose file holds H's
+//     copy at the same offset. A page neither holds falls through to H's
+//     parent either way. So the merged content bitmap is cont(H) | cont(C),
+//     C's page winning where both hold one.
+//
+//   - A full H (a root: a full capture always is one) holds every page, so the
+//     merged C holds every page too: it becomes a full root, which is what it
+//     already was in effect -- nothing below H was ever read through it.
+//
+// The merged C keeps C's id, snapshot and view and takes H's parent. The
+// children table does not change for H's parent (C takes H's place under it);
+// H's own row goes with H. H's view went when H was hidden; the layer it
+// sealed is folded into C's by the rootfs half of the fold when every view
+// that lists the one lists the other right on top of it (compact_layers.go),
+// and otherwise stays listed in C's view, as it was.
+//
+// # Order and failure
+//
+// Nothing a restore reads changes until the switch. The file work either
+// writes bytes no reader looks at, or creates files under new names nothing
+// references yet:
+//
+//  1. Pages are copied into places nothing reads: H's pages into the holes of
+//     C's diff (C's sidecar does not claim them), or -- when C's pages are
+//     fewer -- C's pages over H's diff, in place, where every chain reaching
+//     H has already been answered by C for exactly those pages. In the second
+//     case H's file is then linked into C's directory under a new name.
+//  2. The union sidecar is written under a new name.
+//  3. The layer half, when the layers fold: the merged layer, its sidecar
+//     and each rewritten header under new names (compact_layers.go).
+//  4. Under the store lock, and only there: C takes H's parent and the new
+//     file names, every view listing the layer pair takes its new view, the
+//     live bookkeeping its new list, H leaves the entries and the children
+//     table, and H's directory and every replaced file go to the reclaim.
+//
+// A failure before 4 removes the new names and leaves the tree exactly as it
+// was -- the bytes written into the holes stay unread -- and the candidate is
+// tried again by a later delete. New names rather than renames over the old
+// ones are deliberate: a rename that became visible before a failed switch
+// would leave H and C sharing one file, and the next fold writing into either
+// would be writing into the other.
+//
+// The store is not crash-consistent and does not need to be (NewStore empties
+// its root), so none of this is fsynced, as nothing else in the store is.
+//
+// # Locking
+//
+// All file work happens outside the store lock and inside the sandbox's gate,
+// which every caller of Delete holds: MaterializeRevert releases the lock
+// before it reads a single file and AssembleView never takes it, so the lock
+// never protected file contents, and the gate is what keeps this sandbox's
+// restores away. The lock is taken twice per fold: once to pick the candidate
+// and snapshot what the fold reads (one scan of the sandbox's entries, to find
+// the child), and once to switch the tree, which checks that nothing moved in
+// between and costs a few map updates.
+//
+// Folding runs at the end of Delete, a few entries at a time (see
+// CompactMaxPerOp); candidates are queued where they appear -- a delete that
+// hides or removes, a prune, a base move -- and what is left over waits for
+// the next delete.
+
+const (
+	// compactEnv turns folding on or off; see Compaction.
+	compactEnv = "CHECKPOINT_COMPACT"
+
+	// compactMaxPerOpEnv caps the folds one delete performs; see
+	// CompactMaxPerOp.
+	compactMaxPerOpEnv     = "CHECKPOINT_COMPACT_MAX_PER_OP"
+	defaultCompactMaxPerOp = 8
+
+	// compactMaxAttempts is how many times a candidate whose fold failed is
+	// tried again before it is left alone for good. A failure costs one
+	// attempt per delete, and a hidden entry that is kept is no worse than
+	// before folding existed.
+	compactMaxAttempts = 3
+)
+
+// Compaction reports whether hidden checkpoints are folded into their only
+// child, with the value's provenance attached for the startup line. On by
+// default; CHECKPOINT_COMPACT=false keeps every hidden entry the way the
+// store did before folding existed. Read like FC_TRACK_DIRTY_PAGES
+// (strconv.ParseBool); anything else is reported and ignored.
+func Compaction() (bool, string) {
+	raw, set := os.LookupEnv(compactEnv)
+	if !set {
+		return true, sourceDefault
+	}
+
+	enabled, err := strconv.ParseBool(raw)
+	if err != nil {
+		logger.L().Warn(context.Background(), "ignoring a checkpoint compaction setting that is not a boolean",
+			zap.String("env", compactEnv),
+			zap.String("value", raw))
+
+		return true, sourceDefault
+	}
+
+	return enabled, sourceEnv
+}
+
+// CompactMaxPerOp is how many folds one delete performs at most, with the
+// value's provenance. A fold copies pages -- whichever is fewer of the pages H
+// holds and C lacks, or C's own -- and the same for disk blocks of the two
+// layers, and it runs inside the delete call; the cap keeps one delete from
+// paying for a backlog. What is left waits for the
+// next delete. It must be at least 1: turning folding off is
+// CHECKPOINT_COMPACT's job.
+func CompactMaxPerOp() (int, string) {
+	raw := os.Getenv(compactMaxPerOpEnv)
+	if raw == "" {
+		return defaultCompactMaxPerOp, sourceDefault
+	}
+
+	n, err := strconv.Atoi(raw)
+	if err != nil || n < 1 {
+		logger.L().Warn(context.Background(), "ignoring unusable checkpoint compaction budget in the environment",
+			zap.String("env", compactMaxPerOpEnv),
+			zap.String("value", raw))
+
+		return defaultCompactMaxPerOp, sourceDefault
+	}
+
+	return n, sourceEnv
+}
+
+// compactQueue is one sandbox's pending candidates, oldest first, without
+// duplicates. A queued id is only a hint: it is checked again when it is
+// taken, since the entry can have gained a child, lost one or gone since.
+type compactQueue struct {
+	order    []string
+	queued   map[string]struct{}
+	failures map[string]int
+
+	// abandoned are candidates whose fold failed compactMaxAttempts times.
+	// They stay hidden, as every hidden entry did before folding, until
+	// something about them changes and queues them again.
+	abandoned map[string]struct{}
+}
+
+func newCompactQueue() *compactQueue {
+	return &compactQueue{
+		queued:    make(map[string]struct{}),
+		failures:  make(map[string]int),
+		abandoned: make(map[string]struct{}),
+	}
+}
+
+// queueCompactLocked records id as a fold candidate if it is one right now.
+// Called wherever an entry can become one; the caller holds the store lock.
+func (s *Store) queueCompactLocked(sandboxID string, id string) {
+	if !s.compact || id == "" || !s.compactCandidateLocked(sandboxID, id) {
+		return
+	}
+
+	q, ok := s.compactPending[sandboxID]
+	if !ok {
+		q = newCompactQueue()
+		s.compactPending[sandboxID] = q
+	}
+
+	if _, dup := q.queued[id]; dup {
+		return
+	}
+
+	delete(q.abandoned, id)
+
+	q.queued[id] = struct{}{}
+	q.order = append(q.order, id)
+}
+
+// compactCandidateLocked: hidden, committed, not the base, exactly one child.
+func (s *Store) compactCandidateLocked(sandboxID string, id string) bool {
+	e, ok := s.bySandbox[sandboxID][id]
+	if !ok || !e.Hidden || e.State != StateCommitted {
+		return false
+	}
+
+	if s.bases[sandboxID].entryID == id {
+		return false
+	}
+
+	return s.children[sandboxID][id] == 1
+}
+
+// pendingCompactions is how many candidates are queued for a sandbox. For the
+// tests' bounds.
+func (s *Store) pendingCompactions(sandboxID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if q, ok := s.compactPending[sandboxID]; ok {
+		return len(q.order)
+	}
+
+	return 0
+}
+
+// abandonedCompactions is how many candidates of a sandbox have been given
+// up on and are still in its tree. For the tests' bounds.
+func (s *Store) abandonedCompactions(sandboxID string) int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	q, ok := s.compactPending[sandboxID]
+	if !ok {
+		return 0
+	}
+
+	n := 0
+	for id := range q.abandoned {
+		if _, ok := s.bySandbox[sandboxID][id]; ok {
+			n++
+		}
+	}
+
+	return n
+}
+
+// compactPlan is what a fold reads, copied out under the store lock so the
+// file work can run without it. The entry pointers are what the switch checks
+// the tree against: if either entry was replaced or moved, the fold is off.
+type compactPlan struct {
+	sandboxID string
+
+	h, c *Entry
+
+	hID, cID string
+	hParent  string
+	hDir     string
+	cDir     string
+
+	hMem memSide
+	cMem memSide
+
+	layers layerPlanSnapshot
+}
+
+// memSide is the memory half of one entry: its diff, its sidecar ("" for a
+// full capture written without one) and its mode.
+type memSide struct {
+	id     string
+	diff   string
+	bitmap string
+	mode   string
+}
+
+func memSideOf(e *Entry) memSide {
+	return memSide{id: e.ID, diff: e.MemDiff, bitmap: e.MemBitmap, mode: e.MemMode}
+}
+
+// nextCompactLocked takes the oldest queued id that is still a candidate and
+// returns the plan for folding it. Finding the child is a scan of the
+// sandbox's entries -- the children table counts children, it does not name
+// them -- which with folding on stays bounded by about twice the visible
+// count (see the property test).
+func (s *Store) nextCompactLocked(sandboxID string) (*compactPlan, bool) {
+	q, ok := s.compactPending[sandboxID]
+	if !ok {
+		return nil, false
+	}
+
+	for len(q.order) > 0 {
+		id := q.order[0]
+		q.order = q.order[1:]
+		delete(q.queued, id)
+
+		if !s.compactCandidateLocked(sandboxID, id) {
+			delete(q.failures, id)
+
+			continue
+		}
+
+		entries := s.bySandbox[sandboxID]
+		h := entries[id]
+
+		var c *Entry
+		for _, e := range entries {
+			if e.ParentID == id {
+				c = e
+
+				break
+			}
+		}
+
+		if c == nil || c.State != StateCommitted {
+			// The children table says one child and the entries say
+			// otherwise: a bookkeeping bug, not a state to fold through.
+			logger.L().Error(context.Background(), "a fold candidate's child is missing from the entries; leaving it alone",
+				logger.WithSandboxID(sandboxID),
+				zap.String("checkpoint_id", id))
+			delete(q.failures, id)
+
+			continue
+		}
+
+		p := &compactPlan{
+			sandboxID: sandboxID,
+			h:         h,
+			c:         c,
+			hID:       h.ID,
+			cID:       c.ID,
+			hParent:   h.ParentID,
+			hDir:      h.Dir,
+			cDir:      c.Dir,
+			hMem:      memSideOf(h),
+			cMem:      memSideOf(c),
+		}
+
+		s.snapshotLayersLocked(p)
+
+		return p, true
+	}
+
+	return nil, false
+}
+
+// retryCompactLocked puts a candidate whose fold failed back at the end of
+// the queue, unless it has failed often enough to be left alone.
+func (s *Store) retryCompactLocked(p *compactPlan) bool {
+	q, ok := s.compactPending[p.sandboxID]
+	if !ok {
+		q = newCompactQueue()
+		s.compactPending[p.sandboxID] = q
+	}
+
+	q.failures[p.hID]++
+	if q.failures[p.hID] >= compactMaxAttempts {
+		delete(q.failures, p.hID)
+
+		// Forget the abandoned entries that have left the tree since, so the
+		// set only ever holds entries that are still there.
+		entries := s.bySandbox[p.sandboxID]
+		for id := range q.abandoned {
+			if _, ok := entries[id]; !ok {
+				delete(q.abandoned, id)
+			}
+		}
+
+		q.abandoned[p.hID] = struct{}{}
+
+		return false
+	}
+
+	if _, dup := q.queued[p.hID]; !dup {
+		q.queued[p.hID] = struct{}{}
+		q.order = append(q.order, p.hID)
+	}
+
+	return true
+}
+
+// compactResult is what one delete's folding did, for its timings.
+type compactResult struct {
+	attempted int
+	merged    int
+	// layers is how many of the folds also folded the rootfs layer pair.
+	layers int
+	bytes  int64
+}
+
+// runCompaction folds up to CompactMaxPerOp queued candidates of one
+// sandbox. The caller holds the sandbox's gate and not the store lock. A fold
+// that fails leaves the tree as it was (see the package comment above) and
+// ends this round: the candidate is retried by a later delete.
+func (s *Store) runCompaction(sandboxID string, timings sandbox.PhaseTimings) compactResult {
+	var res compactResult
+
+	if !s.compact {
+		return res
+	}
+
+	start := time.Now()
+
+	for res.merged < s.compactMaxPerOp {
+		s.mu.Lock()
+		p, ok := s.nextCompactLocked(sandboxID)
+		s.mu.Unlock()
+
+		if !ok {
+			break
+		}
+
+		res.attempted++
+
+		n, layered, err := s.fold(p)
+		res.bytes += n
+
+		if err != nil {
+			s.mu.Lock()
+			retried := s.retryCompactLocked(p)
+			s.mu.Unlock()
+
+			logger.L().Warn(context.Background(), "failed to fold a hidden checkpoint into its only child; the tree is unchanged",
+				logger.WithSandboxID(sandboxID),
+				zap.String("hidden_id", p.hID),
+				zap.String("child_id", p.cID),
+				zap.Bool("will_retry", retried),
+				zap.Error(err))
+
+			recordCompaction(false, n)
+
+			break
+		}
+
+		recordCompaction(true, n)
+		res.merged++
+
+		if layered {
+			res.layers++
+		}
+	}
+
+	if res.attempted > 0 {
+		const mib = 1024 * 1024
+
+		timings.Mark("compact", start)
+		timings.SetMB("compact_mb", float64(res.bytes)/mib)
+		timings.SetCount("compact_count", uint64(res.merged))
+		timings.SetCount("compact_layers_count", uint64(res.layers))
+	}
+
+	return res
+}
+
+// errFoldRaced is a fold whose switch found the tree not as the plan left
+// it. Nothing produces that while the sandbox's gate is held; it is checked
+// because the price of being wrong is a restore reading the wrong pages.
+var errFoldRaced = errors.New("the checkpoint tree changed while the fold was prepared")
+
+// fold carries out one plan: the file work outside the lock, then the switch.
+// It reports the bytes it copied, which a failed fold spent too, and whether
+// the rootfs layers were folded along with the memory.
+func (s *Store) fold(p *compactPlan) (int64, bool, error) {
+	mem, err := foldMemory(p)
+	if err != nil {
+		s.recountAfterFailedFold(p, nil)
+
+		return mem.bytes, false, fmt.Errorf("fold %s into %s: %w", p.hID, p.cID, err)
+	}
+
+	mem.occupied = allocatedBytes(mem.diff) + allocatedBytes(mem.bitmap)
+
+	layers, err := foldLayers(p)
+	if err != nil {
+		mem.cleanup()
+		s.recountAfterFailedFold(p, &layers)
+
+		return mem.bytes + layers.bytes, false, fmt.Errorf("fold %s into %s: layers: %w", p.hID, p.cID, err)
+	}
+
+	var rc reclaim
+
+	s.mu.Lock()
+	manifest, err := s.switchFoldLocked(p, mem, &layers, &rc)
+	s.mu.Unlock()
+
+	rc.runLogged(p.sandboxID)
+
+	if err != nil {
+		mem.cleanup()
+		layers.cleanup()
+		s.recountAfterFailedFold(p, &layers)
+
+		return mem.bytes + layers.bytes, false, fmt.Errorf("fold %s into %s: %w", p.hID, p.cID, err)
+	}
+
+	if layers.skip != "" {
+		logger.L().Debug(context.Background(), "folded a hidden checkpoint's memory but not its rootfs layer",
+			logger.WithSandboxID(p.sandboxID),
+			zap.String("hidden_id", p.hID),
+			zap.String("child_id", p.cID),
+			zap.String("reason", layers.skip))
+	}
+
+	// Like a hidden entry's, the manifest is a debugging aid rewritten from a
+	// copy taken under the lock.
+	if err := writeManifest(manifest); err != nil {
+		logger.L().Warn(context.Background(), "failed to rewrite the manifest of a checkpoint that absorbed its parent",
+			logger.WithSandboxID(p.sandboxID),
+			zap.String("checkpoint_id", p.cID),
+			zap.Error(err))
+	}
+
+	return mem.bytes + layers.bytes, layers.skip == "", nil
+}
+
+// switchFoldLocked makes the fold visible: C takes H's parent and H leaves
+// the tree. Everything it changes is bookkeeping; it checks first that the
+// tree is still the one the plan was made from. It returns a copy of C for
+// the manifest.
+func (s *Store) switchFoldLocked(p *compactPlan, mem memFold, layers *layerFold, rc *reclaim) (*Entry, error) {
+	entries := s.bySandbox[p.sandboxID]
+
+	if entries == nil || entries[p.hID] != p.h || entries[p.cID] != p.c ||
+		p.c.ParentID != p.hID || !s.compactCandidateLocked(p.sandboxID, p.hID) ||
+		p.c.MemDiff != p.cMem.diff || p.c.MemBitmap != p.cMem.bitmap || p.c.MemMode != p.cMem.mode {
+		return nil, errFoldRaced
+	}
+
+	if layers.skip == "" && !s.layerHoldersUnchangedLocked(p, layers) {
+		return nil, errFoldRaced
+	}
+
+	if faultInjected(faultCompactSwitch) {
+		return nil, injectedError(faultCompactSwitch, "the fold's switch found the tree moved")
+	}
+
+	if layers.skip == "" {
+		s.switchLayersLocked(p, layers, rc)
+	}
+
+	c := p.c
+
+	c.ParentID = p.hParent
+
+	// The mode the API shows stays the one the checkpoint was taken with; see
+	// Entry.ListedMemMode.
+	if mem.mode != c.MemMode {
+		if c.ListedMemMode == "" {
+			c.ListedMemMode = c.MemMode
+		}
+
+		c.MemMode = mem.mode
+	}
+
+	// The files the new names replace. The old diff goes only when H's file
+	// took its place; filled in place, it is still C's diff.
+	if mem.diff != c.MemDiff {
+		rc.file(c.MemDiff)
+		c.MemDiff = mem.diff
+	}
+
+	if mem.bitmap != c.MemBitmap {
+		rc.file(c.MemBitmap)
+		c.MemBitmap = mem.bitmap
+	}
+
+	delete(entries, p.hID)
+	s.dropChildRowLocked(p.sandboxID, p.hID)
+
+	s.chargeLocked(p.sandboxID, -p.h.bytes.total())
+	s.chargeLocked(p.sandboxID, mem.occupied-c.bytes.mem)
+	c.bytes.mem = mem.occupied
+
+	// A hidden entry holds no view, so this is for the one that somehow
+	// still does, like pruneLocked's.
+	if p.h.Rootfs != nil {
+		s.unrefLayersLocked(p.sandboxID, p.h.Rootfs.Layers, rc)
+	}
+
+	rc.dir(p.hDir)
+	s.markIndexLocked(p.sandboxID)
+
+	if q, ok := s.compactPending[p.sandboxID]; ok {
+		delete(q.failures, p.hID)
+	}
+
+	manifest := *c
+
+	return &manifest, nil
+}
+
+// dropChildRowLocked removes an entry's row from the children table, for an
+// entry that leaves the tree while its children stay (a fold hands its only
+// child to its parent, whose count does not change).
+func (s *Store) dropChildRowLocked(sandboxID string, id string) {
+	counts, ok := s.children[sandboxID]
+	if !ok {
+		return
+	}
+
+	delete(counts, id)
+
+	if len(counts) == 0 {
+		delete(s.children, sandboxID)
+	}
+}
+
+// memFold is what the memory half of a fold produced: C's memory files and
+// mode after the fold, and what they replace.
+type memFold struct {
+	// mode is full if either side was.
+	mode string
+	// diff is C's diff after the fold: its own file with H's pages filled
+	// into its holes, or H's file with C's pages copied over it, linked into
+	// C's directory under a new name.
+	diff string
+	// bitmap is C's sidecar after the fold: the union under a new name, or ""
+	// when the union is every page (a full side written without a sidecar),
+	// which entryBitmap reads as all ones for a full entry.
+	bitmap string
+	// created are the new names, removed if the fold does not happen.
+	created []string
+	// bytes is what was copied between the diffs.
+	bytes int64
+	// occupied is what C's memory files occupy after the fold, for the
+	// byte count (quota.go).
+	occupied int64
+}
+
+// cleanup removes what a fold that did not happen created.
+func (m *memFold) cleanup() {
+	for _, p := range m.created {
+		os.Remove(p)
+	}
+
+	m.created = nil
+}
+
+// Faults for each step of a fold; see foldMemory and switchFoldLocked. Each
+// fires after its step has done its work.
+const (
+	// faultCompactMemCopy: the pages are copied.
+	faultCompactMemCopy = "compact_mem_copy"
+	// faultCompactMemLink: H's diff is linked into C's directory.
+	faultCompactMemLink = "compact_mem_link"
+	// faultCompactMemBitmap: the union sidecar is written.
+	faultCompactMemBitmap = "compact_mem_bitmap"
+	// faultCompactSwitch: the switch refuses, as it does when the tree moved.
+	faultCompactSwitch = "compact_switch"
+)
+
+// compactCopyHook is called once per extent a fold copies. nil outside the
+// tests, which use it to hold a fold in the middle of its file work.
+var compactCopyHook func()
+
+// foldMemory does the memory half of a fold's file work, steps 1 and 2 of the
+// order above. It changes nothing a restore reads; on failure it has removed
+// whatever it created.
+func foldMemory(p *compactPlan) (res memFold, e error) {
+	h, c := p.hMem, p.cMem
+
+	defer func() {
+		if e != nil {
+			res.cleanup()
+		}
+	}()
+
+	res.mode = MemModeIncremental
+	if h.mode == MemModeFull || c.mode == MemModeFull {
+		res.mode = MemModeFull
+	}
+
+	res.diff = c.diff
+
+	revH, err := readSidecar(h)
+	if err != nil {
+		return res, err
+	}
+
+	revC, err := readSidecar(c)
+	if err != nil {
+		return res, err
+	}
+
+	if revH != nil && revC != nil && (revH.pageSize != revC.pageSize || revH.numPages != revC.numPages) {
+		return res, fmt.Errorf("sidecars describe different guests: %d pages of %d vs %d pages of %d",
+			revH.numPages, revH.pageSize, revC.numPages, revC.pageSize)
+	}
+
+	// Content. A full C serves every page itself and H adds nothing to it; an
+	// incremental C always has its sidecar (commitFiles insists), which is
+	// also its content bitmap.
+	if c.mode != MemModeFull {
+		if revC == nil {
+			return res, fmt.Errorf("incremental checkpoint %s has no sidecar", c.id)
+		}
+
+		contC := revC
+
+		contH := revH
+		if h.mode == MemModeFull || contH == nil {
+			contH = allOnesBitmap(revC.pageSize, revC.numPages)
+		}
+
+		fill := contH.clone()
+		for i := range fill.words {
+			fill.words[i] &^= contC.words[i]
+		}
+
+		if fill.count() <= contC.count() {
+			// H's pages into the holes of C's diff, which C's sidecar does not
+			// claim.
+			n, err := copyPages(h.diff, c.diff, fill)
+			res.bytes += n
+			if err != nil {
+				return res, err
+			}
+
+			if faultInjected(faultCompactMemCopy) {
+				return res, injectedError(faultCompactMemCopy, "failed after copying the pages")
+			}
+		} else {
+			// C's pages over H's diff, in place: every chain that reaches H
+			// was answered by C for exactly these pages, so H's copies of
+			// them are never read. H's file then becomes C's diff.
+			n, err := copyPages(c.diff, h.diff, contC)
+			res.bytes += n
+			if err != nil {
+				return res, err
+			}
+
+			if faultInjected(faultCompactMemCopy) {
+				return res, injectedError(faultCompactMemCopy, "failed after copying the pages")
+			}
+
+			diff := filepath.Join(p.cDir, memDiffFileName+"."+h.id)
+			os.Remove(diff)
+
+			if err := os.Link(h.diff, diff); err != nil {
+				return res, fmt.Errorf("failed to link %s's diff into %s: %w", h.id, c.id, err)
+			}
+
+			res.created = append(res.created, diff)
+			res.diff = diff
+
+			if faultInjected(faultCompactMemLink) {
+				return res, injectedError(faultCompactMemLink, "failed after linking the diff")
+			}
+		}
+	}
+
+	// Revert bitmap. An implicit all-ones side makes the union every page,
+	// which a full entry without a sidecar already says.
+	if revH == nil || revC == nil {
+		res.bitmap = ""
+
+		return res, nil
+	}
+
+	union := revC.clone()
+	if err := union.merge(revH); err != nil {
+		return res, err
+	}
+
+	bitmap := filepath.Join(p.cDir, memBitmapFileName+"."+h.id)
+	res.created = append(res.created, bitmap)
+
+	if err := union.writeTo(bitmap); err != nil {
+		return res, fmt.Errorf("failed to write the merged sidecar: %w", err)
+	}
+
+	res.bitmap = bitmap
+
+	if faultInjected(faultCompactMemBitmap) {
+		return res, injectedError(faultCompactMemBitmap, "failed after writing the merged sidecar")
+	}
+
+	return res, nil
+}
+
+// readSidecar reads a memory side's sidecar, or returns nil for a full
+// capture written without one (implicitly every page).
+func readSidecar(m memSide) (*dirtyBitmap, error) {
+	if m.bitmap == "" {
+		if m.mode == MemModeFull {
+			return nil, nil
+		}
+
+		return nil, fmt.Errorf("checkpoint %s has no dirty bitmap sidecar", m.id)
+	}
+
+	bm, err := readDirtyBitmap(m.bitmap)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read sidecar of checkpoint %s: %w", m.id, err)
+	}
+
+	return bm, nil
+}
+
+// count is the number of pages set, bits past the last page ignored.
+func (b *dirtyBitmap) count() int {
+	n := 0
+
+	for w, word := range b.words {
+		if tail := b.numPages % 64; tail != 0 && w == len(b.words)-1 {
+			word &= (uint64(1) << tail) - 1
+		}
+
+		n += bits.OnesCount64(word)
+	}
+
+	return n
+}
+
+// forEachRun calls fn for each maximal run of set pages, in page order, bits
+// past the last page ignored.
+func (b *dirtyBitmap) forEachRun(fn func(start uint64, end uint64) error) error {
+	var (
+		runStart, runEnd uint64
+		inRun            bool
+	)
+
+	tail := b.numPages % 64
+
+	for w, word := range b.words {
+		if tail != 0 && w == len(b.words)-1 {
+			word &= (uint64(1) << tail) - 1
+		}
+
+		for m := word; m != 0; m &= m - 1 {
+			page := uint64(w)*64 + uint64(bits.TrailingZeros64(m))
+
+			if inRun && page == runEnd {
+				runEnd++
+
+				continue
+			}
+
+			if inRun {
+				if err := fn(runStart, runEnd); err != nil {
+					return err
+				}
+			}
+
+			runStart, runEnd, inRun = page, page+1, true
+		}
+	}
+
+	if inRun {
+		return fn(runStart, runEnd)
+	}
+
+	return nil
+}
+
+// copyPages copies the pages set in pages from src to dst, each at its own
+// offset, and reports the bytes copied. A source that ends before a page it
+// is asked for disagrees with its own sidecar, exactly as writeRevertMem
+// treats it: an error, not zeros.
+func copyPages(srcPath string, dstPath string, pages *dirtyBitmap) (int64, error) {
+	if pages.count() == 0 {
+		return 0, nil
+	}
+
+	src, err := os.Open(srcPath)
+	if err != nil {
+		return 0, fmt.Errorf("failed to open %s: %w", srcPath, err)
+	}
+	defer src.Close()
+
+	dst, err := os.OpenFile(dstPath, os.O_RDWR, 0)
+	if err != nil {
+		return 0, fmt.Errorf("failed to open %s: %w", dstPath, err)
+	}
+
+	var copied int64
+
+	pageSize := pages.pageSize
+	buf := make([]byte, revertExtentPages*pageSize)
+
+	err = pages.forEachRun(func(start uint64, end uint64) error {
+		for page := start; page < end; page += revertExtentPages {
+			n := min(end-page, revertExtentPages)
+			b := buf[:n*pageSize]
+			off := int64(page * pageSize)
+
+			if compactCopyHook != nil {
+				compactCopyHook()
+			}
+
+			got, err := src.ReadAt(b, off)
+			if got < len(b) {
+				if err == nil {
+					err = fmt.Errorf("short read")
+				}
+
+				return fmt.Errorf("page %d of %s: read %d/%d: %w", page+uint64(got)/pageSize, srcPath, got, len(b), err)
+			}
+
+			if _, err := dst.WriteAt(b, off); err != nil {
+				return fmt.Errorf("failed to write page %d of %s: %w", page, dstPath, err)
+			}
+
+			copied += int64(len(b))
+		}
+
+		return nil
+	})
+
+	if closeErr := dst.Close(); err == nil && closeErr != nil {
+		err = fmt.Errorf("failed to close %s: %w", dstPath, closeErr)
+	}
+
+	return copied, err
+}
+
+// layerHoldersUnchangedLocked checks the layer half of a plan still describes
+// the store: every view the plan saw is still its entry's, the live
+// bookkeeping lists what it listed, and A and B are counted exactly once per
+// holder the plan found listing them -- a holder added since would show in
+// the counts.
+func (s *Store) layerHoldersUnchangedLocked(p *compactPlan, layers *layerFold) bool {
+	entries := s.bySandbox[p.sandboxID]
+
+	for _, v := range p.layers.views {
+		if entries[v.e.ID] != v.e || v.e.Rootfs != v.view {
+			return false
+		}
+	}
+
+	st := s.rootfs[p.sandboxID]
+	if st != p.layers.live {
+		return false
+	}
+
+	if st != nil {
+		if len(st.layers) != len(p.layers.liveLayers) || len(st.mapping) != len(p.layers.liveMapping) {
+			return false
+		}
+
+		for i, l := range st.layers {
+			if l != p.layers.liveLayers[i] {
+				return false
+			}
+		}
+
+		if len(st.mapping) > 0 && st.mapping[0] != p.layers.liveMapping[0] {
+			return false
+		}
+	}
+
+	refs := s.layerRefs[p.sandboxID]
+
+	return refs[layers.a.Path] == layers.holders && refs[layers.b.Path] == layers.holders
+}
+
+// switchLayersLocked makes the layer half visible: every holder of the pair
+// lists the merged layer instead, the counts follow, and A, B and the headers
+// they replace go to the reclaim.
+func (s *Store) switchLayersLocked(p *compactPlan, layers *layerFold, rc *reclaim) {
+	// New views rather than changed ones: a view is never mutated once
+	// published, so whoever copied an entry keeps a view that stays as it
+	// was (the files it names go only after the lock, like every reclaim).
+	for e, view := range layers.views {
+		e.Rootfs = view
+
+		occupied := layers.headerBytes[e]
+		s.chargeLocked(p.sandboxID, occupied-e.bytes.header)
+		e.bytes.header = occupied
+	}
+
+	for _, h := range layers.oldHeaders {
+		rc.file(h)
+	}
+
+	if layers.live {
+		st := s.rootfs[p.sandboxID]
+		st.layers = layers.liveLayers
+		st.mapping = layers.liveMapping
+	}
+
+	refs := s.layerRefs[p.sandboxID]
+	delete(refs, layers.a.Path)
+	delete(refs, layers.b.Path)
+	refs[layers.merged.Path] = layers.holders
+
+	s.releaseLayerLocked(p.sandboxID, layers.a.Path)
+	s.releaseLayerLocked(p.sandboxID, layers.b.Path)
+	s.chargeLayerLocked(p.sandboxID, layers.merged.Path, layers.mergedBytes)
+
+	rc.layer(layers.a.Path)
+	rc.layer(layers.b.Path)
+
+	// B was C's own layer, and the merged layer takes its place. An entry
+	// whose own layer was A -- a hidden one, since no view may end at A --
+	// no longer has one on record.
+	for _, e := range s.bySandbox[p.sandboxID] {
+		switch e.layer {
+		case layers.b.Path:
+			e.layer = layers.merged.Path
+		case layers.a.Path:
+			e.layer = ""
+		}
+	}
+}
+
+// recountAfterFailedFold brings the byte count (quota.go) back in line with
+// the files a failed fold wrote into: the bytes it copied into holes are
+// unread, but they are allocated, so the files it touched -- both diffs and,
+// if it got that far, both layers -- occupy more than they were charged.
+// Measured outside the lock, charged under it, for entries and layers that
+// are still the plan's.
+func (s *Store) recountAfterFailedFold(p *compactPlan, layers *layerFold) {
+	hMem := allocatedBytes(p.hMem.diff) + allocatedBytes(p.hMem.bitmap)
+	cMem := allocatedBytes(p.cMem.diff) + allocatedBytes(p.cMem.bitmap)
+
+	measured := make(map[string]int64)
+	if layers != nil && layers.a.Path != "" {
+		for _, path := range []string{layers.a.Path, layers.b.Path} {
+			measured[path] = layerBytesOf(path)
+		}
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	entries := s.bySandbox[p.sandboxID]
+
+	if entries[p.hID] == p.h && p.h.MemDiff == p.hMem.diff && p.h.MemBitmap == p.hMem.bitmap {
+		s.chargeLocked(p.sandboxID, hMem-p.h.bytes.mem)
+		p.h.bytes.mem = hMem
+	}
+
+	if entries[p.cID] == p.c && p.c.MemDiff == p.cMem.diff && p.c.MemBitmap == p.cMem.bitmap {
+		s.chargeLocked(p.sandboxID, cMem-p.c.bytes.mem)
+		p.c.bytes.mem = cMem
+	}
+
+	charged := s.layerBytes[p.sandboxID]
+	for path, bytes := range measured {
+		if old, ok := charged[path]; ok {
+			charged[path] = bytes
+			s.chargeLocked(p.sandboxID, bytes-old)
+		}
+	}
+}
diff --git a/packages/orchestrator/internal/checkpoint/compact_layers.go b/packages/orchestrator/internal/checkpoint/compact_layers.go
new file mode 100644
index 000000000..be28c4a8d
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/compact_layers.go
@@ -0,0 +1,555 @@
+package checkpoint
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// The rootfs half of a fold: folding the layer below C's own into it.
+//
+// Every view lists the layers its disk is stacked from, bottom to top, and a
+// restore serves each block from the topmost listed layer whose sidecar
+// claims it (Sandbox.AssembleView, block.LayerStack). A hidden H's layer stays
+// listed by C's view and every view built on it, so without this the stacks
+// grow by one layer per checkpoint for as long as the sandbox lives, folded
+// memory or not -- and so does the layers directory.
+//
+// Which layer pairs can be folded is a question about the holders of the
+// layers, not about the checkpoint tree (see layer_refs.go for why the two
+// differ): the views of the entries, and the live bookkeeping, whose layer
+// list the next view is copied from. Let B be the layer C sealed (the last one
+// of C's view when it was published) and A the layer right below it. If every
+// holder that lists A lists B right above it, and every holder that lists B
+// lists A right below it, then A and B always appear as the adjacent pair
+// [.., A, B, ..], and replacing the pair with one layer holding B's blocks
+// over A's changes no block any holder reads:
+//
+//   - a block B holds is served by B (or something above it) before and after;
+//   - a block A holds and B does not was served by A, and is now served by the
+//     merged layer, which holds A's copy at the same offset (layer files are
+//     sealed in place: storage offset = device offset, identityMappings);
+//   - a block neither holds falls through to whatever is below, as before.
+//
+// Headers follow: a mapping that named A names the merged layer (same
+// offsets, identity storage), and nothing else changes. The check is made on
+// the holders as they are when the fold is planned and verified again, through
+// the reference counts, when it is switched in; a pair that fails it -- a
+// restore to H followed by a full capture lists A under another layer, say --
+// is simply not folded, and the memory half goes ahead alone.
+//
+// The merged layer takes a new name, and so does every rewritten header, for
+// the reason the memory half uses new names: nothing a restore reads changes
+// until the switch. Its bytes are made the cheaper way round, like the memory
+// half's: A's blocks into B's holes, or B's blocks over A's file in place
+// (every holder reads A only where B has nothing), and the file that received
+// them is then linked in under the new name.
+//
+// The live stack is not rebuilt. It keeps reading A and B through the mappings
+// it made when each joined it: the unlinks the switch schedules do not disturb
+// them, and the bytes the fold wrote into either file are at blocks the stack
+// never reads from that file. The space goes when a restore replaces the
+// stack. The live bookkeeping is switched with the views, so the next view is
+// copied from a list that names the merged layer.
+
+// Faults for the layer steps, each firing after its step has done its work.
+const (
+	// faultCompactLayerCopy: the blocks are copied.
+	faultCompactLayerCopy = "compact_layer_copy"
+	// faultCompactLayerLink: the merged layer is linked in under its new name.
+	faultCompactLayerLink = "compact_layer_link"
+	// faultCompactLayerMeta: the merged layer's sidecar is written.
+	faultCompactLayerMeta = "compact_layer_meta"
+	// faultCompactLayerHeader: the first rewritten header is written.
+	faultCompactLayerHeader = "compact_layer_header"
+)
+
+// viewHolder is one entry's view as the plan saw it.
+type viewHolder struct {
+	e    *Entry
+	view *RootfsView
+}
+
+// layerPlanSnapshot is what the layer half reads, copied under the store lock.
+type layerPlanSnapshot struct {
+	// b is C's own layer, "" if C has none on record (a rescued epoch).
+	b string
+
+	views []viewHolder
+
+	live        *rootfsState
+	liveLayers  []RootfsLayer
+	liveMapping []*header.BuildMap
+}
+
+// snapshotLayersLocked fills in the layer half of a plan. O(entries) plus the
+// live layer list's length, under the store lock.
+func (s *Store) snapshotLayersLocked(p *compactPlan) {
+	p.layers.b = p.c.layer
+	if p.layers.b == "" {
+		return
+	}
+
+	for _, e := range s.bySandbox[p.sandboxID] {
+		if e.Rootfs != nil {
+			p.layers.views = append(p.layers.views, viewHolder{e: e, view: e.Rootfs})
+		}
+	}
+
+	if st, ok := s.rootfs[p.sandboxID]; ok {
+		p.layers.live = st
+		p.layers.liveLayers = append([]RootfsLayer(nil), st.layers...)
+		p.layers.liveMapping = st.mapping
+	}
+}
+
+// layerFold is the layer half of a fold, planned and then carried out.
+type layerFold struct {
+	// skip says why the layers are not folded; "" when they are.
+	skip string
+
+	a, b   RootfsLayer
+	merged RootfsLayer
+
+	// holders is how many holders list the pair, which is also what each of
+	// A and B is counted at.
+	holders int
+
+	// views are the new views, by entry; oldHeaders the headers they
+	// replace.
+	views      map[*Entry]*RootfsView
+	oldHeaders []string
+
+	// live is whether the live bookkeeping lists the pair, and its new
+	// layers and mapping if so.
+	live        bool
+	liveLayers  []RootfsLayer
+	liveMapping []*header.BuildMap
+
+	created []string
+	bytes   int64
+
+	// mergedBytes and headerBytes are what the merged layer and each new
+	// header occupy, for the byte count (quota.go).
+	mergedBytes int64
+	headerBytes map[*Entry]int64
+}
+
+func (l *layerFold) cleanup() {
+	for _, p := range l.created {
+		os.Remove(p)
+	}
+
+	l.created = nil
+}
+
+// planLayerFold decides whether A and B can be folded, from the snapshot
+// alone. It reads no file.
+func planLayerFold(snap *layerPlanSnapshot) layerFold {
+	var lf layerFold
+
+	if snap.b == "" {
+		lf.skip = "the child has no layer of its own on record"
+
+		return lf
+	}
+
+	lists := make([][]RootfsLayer, 0, len(snap.views)+1)
+	for _, v := range snap.views {
+		lists = append(lists, v.view.Layers)
+	}
+
+	if snap.live != nil {
+		lists = append(lists, snap.liveLayers)
+	}
+
+	// A is the layer right below B, the same in every list that has B.
+	found := false
+	for _, layers := range lists {
+		i := layerIndex(layers, snap.b)
+		if i < 0 {
+			continue
+		}
+
+		if i == 0 {
+			lf.skip = "the child's layer is the bottom of a view"
+
+			return lf
+		}
+
+		if !found {
+			lf.a, lf.b, found = layers[i-1], layers[i], true
+		} else if layers[i-1].Path != lf.a.Path {
+			lf.skip = "the child's layer sits on different layers in different views"
+
+			return lf
+		}
+	}
+
+	if !found {
+		lf.skip = "no view lists the child's layer"
+
+		return lf
+	}
+
+	// And B right above A in every list that has A.
+	withA, withB := 0, 0
+	for _, layers := range lists {
+		if i := layerIndex(layers, lf.a.Path); i >= 0 {
+			withA++
+
+			if i+1 >= len(layers) || layers[i+1].Path != lf.b.Path {
+				lf.skip = "a view or the live stack lists the layer below without the child's on top"
+
+				return lf
+			}
+		}
+
+		if layerIndex(layers, lf.b.Path) >= 0 {
+			withB++
+		}
+	}
+
+	if withA != withB {
+		lf.skip = "the two layers are not always listed together"
+
+		return lf
+	}
+
+	lf.holders = withA
+
+	return lf
+}
+
+func layerIndex(layers []RootfsLayer, path string) int {
+	for i, l := range layers {
+		if l.Path == path {
+			return i
+		}
+	}
+
+	return -1
+}
+
+// withoutLower is a layer list with the pair [A, B] replaced by merged.
+func withoutLower(layers []RootfsLayer, a string, merged RootfsLayer) []RootfsLayer {
+	out := make([]RootfsLayer, 0, len(layers)-1)
+
+	for i := 0; i < len(layers); i++ {
+		if layers[i].Path == a {
+			out = append(out, merged)
+			i++ // B, right above
+
+			continue
+		}
+
+		out = append(out, layers[i])
+	}
+
+	return out
+}
+
+// renamedMapping is a header mapping with every range that named A naming the
+// merged layer, normalized and validated against the device.
+func renamedMapping(mapping []*header.BuildMap, a uuid.UUID, merged uuid.UUID, meta *header.Metadata) ([]*header.BuildMap, error) {
+	out := make([]*header.BuildMap, len(mapping))
+
+	for i, m := range mapping {
+		cp := m.Copy()
+
+		if cp.BuildId == a {
+			// The merged layer is stored in place like every sealed layer:
+			// a range can only be renamed if A's was too.
+			if cp.BuildStorageOffset != cp.Offset {
+				return nil, fmt.Errorf("layer %s is mapped at storage offset %d for device offset %d", a, cp.BuildStorageOffset, cp.Offset)
+			}
+
+			cp.BuildId = merged
+		}
+
+		out[i] = cp
+	}
+
+	out = header.NormalizeMappings(out)
+
+	if err := header.ValidateMappings(out, meta.Size, meta.BlockSize); err != nil {
+		return nil, fmt.Errorf("renamed mappings failed validation: %w", err)
+	}
+
+	return out, nil
+}
+
+// foldLayers does the layer half's file work. It changes nothing a restore
+// reads; on failure it has removed whatever it created.
+func foldLayers(p *compactPlan) (lf layerFold, e error) {
+	lf = planLayerFold(&p.layers)
+	if lf.skip != "" {
+		return lf, nil
+	}
+
+	defer func() {
+		if e != nil {
+			lf.cleanup()
+		}
+	}()
+
+	aID, err := uuid.Parse(lf.a.BuildID)
+	if err != nil {
+		return lf, fmt.Errorf("layer %s: %w", lf.a.Path, err)
+	}
+
+	bID, err := uuid.Parse(lf.b.BuildID)
+	if err != nil {
+		return lf, fmt.Errorf("layer %s: %w", lf.b.Path, err)
+	}
+
+	aBlocks, err := readLayerMeta(lf.a.Path)
+	if err != nil {
+		return lf, fmt.Errorf("failed to read sidecar of layer %s: %w", lf.a.Path, err)
+	}
+
+	bBlocks, err := readLayerMeta(lf.b.Path)
+	if err != nil {
+		return lf, fmt.Errorf("failed to read sidecar of layer %s: %w", lf.b.Path, err)
+	}
+
+	blockSize, err := foldBlockSize(p)
+	if err != nil {
+		return lf, err
+	}
+
+	inB := make(map[int64]bool, len(bBlocks))
+	for _, off := range bBlocks {
+		inB[off] = true
+	}
+
+	var fill []int64
+	for _, off := range aBlocks {
+		if !inB[off] {
+			fill = append(fill, off)
+		}
+	}
+
+	// The bytes: A's blocks into B's holes, or B's blocks over A's file.
+	// Either way the receiving file is only ever read at its own blocks
+	// until the switch, and the ones written are not among them.
+	target := lf.b.Path
+	if len(fill) <= len(bBlocks) {
+		n, err := copyBlocks(lf.a.Path, lf.b.Path, fill, blockSize)
+		lf.bytes += n
+		if err != nil {
+			return lf, err
+		}
+	} else {
+		n, err := copyBlocks(lf.b.Path, lf.a.Path, bBlocks, blockSize)
+		lf.bytes += n
+		if err != nil {
+			return lf, err
+		}
+
+		target = lf.a.Path
+	}
+
+	if faultInjected(faultCompactLayerCopy) {
+		return lf, injectedError(faultCompactLayerCopy, "failed after copying the blocks")
+	}
+
+	lf.merged = RootfsLayer{
+		BuildID: lf.b.BuildID,
+		Path:    filepath.Join(filepath.Dir(lf.b.Path), "layer-"+lf.b.BuildID+"."+p.hID),
+	}
+
+	os.Remove(lf.merged.Path)
+
+	if err := os.Link(target, lf.merged.Path); err != nil {
+		return lf, fmt.Errorf("failed to link the merged layer: %w", err)
+	}
+
+	lf.created = append(lf.created, lf.merged.Path)
+
+	if faultInjected(faultCompactLayerLink) {
+		return lf, injectedError(faultCompactLayerLink, "failed after linking the merged layer")
+	}
+
+	union := append(append([]int64(nil), bBlocks...), fill...)
+	sort.Slice(union, func(i, j int) bool { return union[i] < union[j] })
+
+	lf.created = append(lf.created, lf.merged.Path+layerMetaSuffix)
+
+	if err := writeLayerMeta(lf.merged.Path, union); err != nil {
+		return lf, fmt.Errorf("failed to write the merged layer's sidecar: %w", err)
+	}
+
+	if faultInjected(faultCompactLayerMeta) {
+		return lf, injectedError(faultCompactLayerMeta, "failed after writing the merged layer's sidecar")
+	}
+
+	lf.mergedBytes = layerBytesOf(lf.merged.Path)
+
+	// The views: each listing the pair gets a new header under a new name.
+	lf.views = make(map[*Entry]*RootfsView)
+	lf.headerBytes = make(map[*Entry]int64)
+
+	for _, v := range p.layers.views {
+		if layerIndex(v.view.Layers, lf.a.Path) < 0 {
+			continue
+		}
+
+		// Named after the entry and the fold, not after the old header, so
+		// successive folds do not grow the name; the entry's id keeps two
+		// views whose headers share a directory apart.
+		headerPath := filepath.Join(filepath.Dir(v.view.HeaderPath), rootfsHeaderName+"."+v.e.ID+"."+p.hID)
+
+		if err := rewriteHeader(v.view.HeaderPath, headerPath, aID, bID); err != nil {
+			return lf, err
+		}
+
+		lf.created = append(lf.created, headerPath)
+
+		if faultInjected(faultCompactLayerHeader) {
+			return lf, injectedError(faultCompactLayerHeader, "failed after rewriting a header")
+		}
+
+		lf.views[v.e] = &RootfsView{
+			HeaderPath: headerPath,
+			Layers:     withoutLower(v.view.Layers, lf.a.Path, lf.merged),
+		}
+		lf.headerBytes[v.e] = allocatedBytes(headerPath)
+		lf.oldHeaders = append(lf.oldHeaders, v.view.HeaderPath)
+	}
+
+	if p.layers.live != nil && layerIndex(p.layers.liveLayers, lf.a.Path) >= 0 {
+		mapping, err := renamedMapping(p.layers.liveMapping, aID, bID, p.layers.live.meta)
+		if err != nil {
+			return lf, fmt.Errorf("live bookkeeping: %w", err)
+		}
+
+		lf.live = true
+		lf.liveLayers = withoutLower(p.layers.liveLayers, lf.a.Path, lf.merged)
+		lf.liveMapping = mapping
+	}
+
+	return lf, nil
+}
+
+// foldBlockSize is the rootfs block size, from the header of a view listing
+// the pair, or from the live bookkeeping.
+func foldBlockSize(p *compactPlan) (int64, error) {
+	if p.layers.live != nil && p.layers.live.meta != nil {
+		return int64(p.layers.live.meta.BlockSize), nil
+	}
+
+	for _, v := range p.layers.views {
+		data, err := os.ReadFile(v.view.HeaderPath)
+		if err != nil {
+			return 0, fmt.Errorf("failed to read rootfs header: %w", err)
+		}
+
+		h, err := header.DeserializeBytes(data)
+		if err != nil {
+			return 0, fmt.Errorf("failed to deserialize rootfs header: %w", err)
+		}
+
+		return int64(h.Metadata.BlockSize), nil
+	}
+
+	return 0, errors.New("no header to take the block size from")
+}
+
+// rewriteHeader writes the header at from, with A renamed to the merged
+// layer, to a new file at to.
+func rewriteHeader(from string, to string, a uuid.UUID, merged uuid.UUID) error {
+	data, err := os.ReadFile(from)
+	if err != nil {
+		return fmt.Errorf("failed to read rootfs header: %w", err)
+	}
+
+	h, err := header.DeserializeBytes(data)
+	if err != nil {
+		return fmt.Errorf("failed to deserialize rootfs header %s: %w", from, err)
+	}
+
+	mapping, err := renamedMapping(h.Mapping, a, merged, h.Metadata)
+	if err != nil {
+		return fmt.Errorf("header %s: %w", from, err)
+	}
+
+	out, err := header.Serialize(h.Metadata, mapping)
+	if err != nil {
+		return fmt.Errorf("failed to serialize rootfs header: %w", err)
+	}
+
+	// Removed first: a file of that name can only be a left-over of an
+	// earlier attempt at the same fold, which nothing references.
+	os.Remove(to)
+
+	if err := os.WriteFile(to, out, 0o644); err != nil {
+		os.Remove(to)
+
+		return fmt.Errorf("failed to write rootfs header: %w", err)
+	}
+
+	return nil
+}
+
+// copyBlocks copies the given blocks of a sealed layer file into another,
+// each at its own offset, and reports the bytes copied. A layer file shorter
+// than a block it claims reads as zeros there, which is what the layer serves
+// for it: a sealed layer is reopened at the device's size (block.NewCache
+// truncates it up), so its tail is a hole.
+func copyBlocks(srcPath string, dstPath string, offsets []int64, blockSize int64) (int64, error) {
+	if len(offsets) == 0 {
+		return 0, nil
+	}
+
+	src, err := os.Open(srcPath)
+	if err != nil {
+		return 0, fmt.Errorf("failed to open %s: %w", srcPath, err)
+	}
+	defer src.Close()
+
+	dst, err := os.OpenFile(dstPath, os.O_RDWR, 0)
+	if err != nil {
+		return 0, fmt.Errorf("failed to open %s: %w", dstPath, err)
+	}
+
+	var copied int64
+
+	buf := make([]byte, blockSize)
+
+	for _, off := range offsets {
+		if compactCopyHook != nil {
+			compactCopyHook()
+		}
+
+		n, err := src.ReadAt(buf, off)
+		if err != nil && !errors.Is(err, io.EOF) {
+			dst.Close()
+
+			return copied, fmt.Errorf("failed to read block at %d of %s: %w", off, srcPath, err)
+		}
+
+		clear(buf[n:])
+
+		if _, err := dst.WriteAt(buf, off); err != nil {
+			dst.Close()
+
+			return copied, fmt.Errorf("failed to write block at %d of %s: %w", off, dstPath, err)
+		}
+
+		copied += blockSize
+	}
+
+	if err := dst.Close(); err != nil {
+		return copied, fmt.Errorf("failed to close %s: %w", dstPath, err)
+	}
+
+	return copied, nil
+}
diff --git a/packages/orchestrator/internal/checkpoint/faults.go b/packages/orchestrator/internal/checkpoint/faults.go
new file mode 100644
index 000000000..bcfb11741
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/faults.go
@@ -0,0 +1,171 @@
+package checkpoint
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"sync/atomic"
+)
+
+// faultEnv turns on fault injection. It holds a comma-separated list of the
+// fault names below, each optionally followed by ":once", and is read once,
+// at startup; unset -- the only way a deployment ever runs -- costs a nil
+// check on the paths that consult it.
+//
+// The faults exist because the failure paths worth trusting are the ones
+// nobody can reach by hand: a guest that never answers after a rollback, a
+// disk view that cannot be reassembled past the rollback's commit point, a
+// layer that cannot be moved into the store after the epoch advanced, a
+// commit that dies between renaming the artifacts and recording them. Each
+// of those leaves the tree in a state with its own recovery rule, and the
+// rules are only as good as the tests that trigger them.
+const faultEnv = "CHECKPOINT_FAULT_INJECT"
+
+// faultOnceSuffix arms a fault for a single call. Armed for every call, the
+// failure is all a test can see: seal_move and commit_late both fail before
+// anything is published, so a node running them never holds a checkpoint to
+// restore from, and torn_assemble would fail the restore that is supposed to
+// clear the torn flag. What those states are worth testing for is what comes
+// after them -- the restore that reseeds the tree, the create that commits
+// over the artifacts of a failed one -- and that needs the path to heal once
+// the fault has fired.
+const faultOnceSuffix = "once"
+
+const (
+	// faultEnvdTimeout: the guest never answers after a successful rollback.
+	// The bookkeeping must still have moved to the target (A1/F4).
+	faultEnvdTimeout = "envd_timeout"
+	// faultTornAssemble: the disk half of a rollback fails after the memory
+	// rollback committed, which is the torn sandbox (F2). The view itself is
+	// assembled before the pause now, so this is injected at the first
+	// moment past the commit point rather than at a layer file.
+	faultTornAssemble = "torn_assemble"
+	// faultSealMove: the sealed layer never reaches the store although the
+	// snapshot was written, so the live stack has a layer the bookkeeping
+	// does not (A2/F4): checkpoints must be refused until a restore reseeds.
+	faultSealMove = "seal_move"
+	// faultCommitLate: Commit fails after the artifacts are in their final
+	// names, which is the second-commit path CommitHidden has to survive
+	// (A3/F5).
+	faultCommitLate = "commit_late"
+)
+
+// fault is one armed injection point. A once fault carries the only mutable
+// state in here: whether it has already fired, consumed by whichever caller
+// wins the compare-and-swap.
+type fault struct {
+	once  bool
+	fired atomic.Bool
+}
+
+// spec is the fault as the env spelled it: the name, carrying its modifier
+// when one is armed. It is the one place the modifier is written back, so a
+// startup log and an injected error say the mode the same way.
+func (f *fault) spec(name string) string {
+	if !f.once {
+		return name
+	}
+
+	return name + ":" + faultOnceSuffix
+}
+
+// faultSet is the parsed env: what is armed, plus whatever the operator got
+// wrong spelling it, kept so startup can say so.
+type faultSet struct {
+	faults   map[string]*fault
+	warnings []string
+}
+
+// armed lists the armed faults in a stable order, each name carrying its
+// modifier back, so a log line says whether a fault fires once or forever.
+func (s *faultSet) armed() []string {
+	names := make([]string, 0, len(s.faults))
+	for name, f := range s.faults {
+		names = append(names, f.spec(name))
+	}
+
+	sort.Strings(names)
+
+	return names
+}
+
+// injectedFaults caches the parsed env. A nil pointer means "not read yet";
+// tests swap it directly.
+var injectedFaults atomic.Pointer[faultSet]
+
+func faultsEnabled() *faultSet {
+	if p := injectedFaults.Load(); p != nil {
+		return p
+	}
+
+	injectedFaults.CompareAndSwap(nil, parseFaults(os.Getenv(faultEnv)))
+
+	return injectedFaults.Load()
+}
+
+func parseFaults(spec string) *faultSet {
+	set := &faultSet{faults: make(map[string]*fault)}
+
+	for _, field := range strings.Split(spec, ",") {
+		name, modifier, hasModifier := strings.Cut(strings.TrimSpace(field), ":")
+
+		name = strings.TrimSpace(name)
+		if name == "" {
+			continue
+		}
+
+		f := &fault{}
+		if hasModifier {
+			// An unknown modifier leaves the fault armed for every call,
+			// which is the louder of the two mistakes: a test expecting one
+			// failure sees it fail again rather than silently not at all.
+			if modifier = strings.TrimSpace(modifier); modifier == faultOnceSuffix {
+				f.once = true
+			} else {
+				set.warnings = append(set.warnings, fmt.Sprintf("%s: unknown modifier %q, ignored; the fault stays armed for every call", name, modifier))
+			}
+		}
+
+		set.faults[name] = f
+	}
+
+	return set
+}
+
+// faultInjected reports whether this call is the one that fails at name. A
+// once fault answers true to a single caller and false to everyone after,
+// leaving the path it guards working for the rest of the process.
+func faultInjected(name string) bool {
+	f, ok := faultsEnabled().faults[name]
+	if !ok {
+		return false
+	}
+
+	if !f.once {
+		return true
+	}
+
+	return f.fired.CompareAndSwap(false, true)
+}
+
+// injectedError is what an injected fault returns, prefixed so no reader of
+// a log or a client error mistakes it for a real one. The name arrives bare
+// from the injection point and leaves carrying its modifier: a test driving
+// the failure from outside reads the mode off the message rather than off
+// what it believes the node was started with, which is how it knows whether
+// the next call fails again or heals.
+func injectedError(name string, what string) error {
+	return fmt.Errorf("fault injected: %s (%s=%s)", what, faultEnv, faultSpec(name))
+}
+
+// faultSpec spells name the way the env armed it. A name nobody armed -- no
+// injection point reaches here without firing first -- is its own spelling.
+func faultSpec(name string) string {
+	f, ok := faultsEnabled().faults[name]
+	if !ok {
+		return name
+	}
+
+	return f.spec(name)
+}
diff --git a/packages/orchestrator/internal/checkpoint/layer_refs.go b/packages/orchestrator/internal/checkpoint/layer_refs.go
new file mode 100644
index 000000000..92d5f52d2
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/layer_refs.go
@@ -0,0 +1,160 @@
+package checkpoint
+
+import (
+	"context"
+	"fmt"
+	"sort"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// Sealed rootfs layers are reference counted per sandbox, by path.
+//
+// Every checkpoint seals exactly one layer, and it used to be kept until the
+// sandbox went: nothing could tell when a layer stopped being read, so
+// deleting a checkpoint never deleted one. A sandbox that checkpoints in a
+// loop under a checkpoint limit held its limit's worth of checkpoints and
+// every layer it had ever sealed -- tens of thousands of them, most belonging
+// to checkpoints deleted long before.
+//
+// Who reads a layer is exactly who lists it:
+//
+//   - a committed checkpoint's view (Entry.Rootfs), which a restore
+//     reassembles the disk from; and
+//   - the live bookkeeping (rootfsState.layers), which the next checkpoint's
+//     view is copied from and which describes the stack the sandbox reads.
+//
+// Both are counted, one reference per listing, and a layer is reclaimed with
+// its sidecar when its count reaches zero. The checkpoint tree cannot answer
+// the question instead: a full-memory capture roots a new tree (ParentID "")
+// while its view still stacks on every layer sealed before it, so a leaf of
+// the tree can own a layer that a checkpoint outside its subtree reads. That
+// is every checkpoint with dirty tracking off, and the first one after the
+// chain broke with it on.
+//
+// Where references are taken and given back, all under the store lock:
+//
+//	appendLocked      +1 the new layer, now in st.layers
+//	publishLocked     +1 each layer of the view being published (Commit);
+//	                  CommitHidden publishes no view and takes none
+//	SetRootfsToEntry  +1 each layer of the restored view, then -1 each
+//	                  layer of the replaced st.layers
+//	deleteLocked      -1 each layer of the entry's view, whether the entry is
+//	                  removed or hidden (a hidden entry keeps no view)
+//	pruneLocked       -1 each layer of the view of an entry it removes, which
+//	                  for a hidden entry is none
+//	switchLayersLocked a fold replaces the pair [A, B] with one merged layer
+//	                  in every holder: A and B drop to zero, the merged layer
+//	                  takes their count (compact_layers.go)
+//	dropStateLocked   the counts go with the sandbox's whole tree
+//
+// PoisonRootfs and InvalidateBase give nothing back: the live stack still
+// reads what st.layers lists. Layers the live stack reads that st.layers never
+// took are tracked apart; see rootfsState.unrecorded.
+//
+// The cost is one map update per layer of a view on publish, hide, delete and
+// restore, under the store lock: the same order as the view copy appendLocked
+// already makes.
+
+// refLayersLocked takes one reference on each layer. The caller holds the
+// store lock.
+func (s *Store) refLayersLocked(sandboxID string, layers []RootfsLayer) {
+	if len(layers) == 0 {
+		return
+	}
+
+	refs, ok := s.layerRefs[sandboxID]
+	if !ok {
+		refs = make(map[string]int)
+		s.layerRefs[sandboxID] = refs
+	}
+
+	for _, l := range layers {
+		refs[l.Path]++
+	}
+}
+
+// unrefLayersLocked gives back one reference on each layer and leaves every
+// layer that lost its last one in rc, for the caller to delete without the
+// lock. The caller holds the store lock.
+//
+// A layer with no reference to give back is a bookkeeping bug. It is logged
+// and the layer left alone: a file kept by mistake costs disk space, a file
+// deleted by mistake costs a checkpoint.
+func (s *Store) unrefLayersLocked(sandboxID string, layers []RootfsLayer, rc *reclaim) {
+	refs := s.layerRefs[sandboxID]
+
+	for _, l := range layers {
+		n := refs[l.Path]
+
+		switch {
+		case n <= 0:
+			logger.L().Error(context.Background(), "releasing a rootfs layer reference that was never taken; keeping the layer",
+				logger.WithSandboxID(sandboxID),
+				zap.String("layer", l.Path))
+		case n == 1:
+			delete(refs, l.Path)
+			s.releaseLayerLocked(sandboxID, l.Path)
+			rc.layer(l.Path)
+		default:
+			refs[l.Path] = n - 1
+		}
+	}
+
+	if refs != nil && len(refs) == 0 {
+		delete(s.layerRefs, sandboxID)
+	}
+}
+
+// checkLayerRefs recounts a sandbox's layer references from what holds them
+// -- every committed entry's view and the live bookkeeping -- and reports how
+// the counts kept by the store differ from that, or nil when they agree. It
+// is a debugging assertion for the tests, which call it after every step.
+func (s *Store) checkLayerRefs(sandboxID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	want := make(map[string]int)
+
+	for _, e := range s.bySandbox[sandboxID] {
+		if e.Rootfs == nil {
+			continue
+		}
+
+		for _, l := range e.Rootfs.Layers {
+			want[l.Path]++
+		}
+	}
+
+	if st, ok := s.rootfs[sandboxID]; ok {
+		for _, l := range st.layers {
+			want[l.Path]++
+		}
+	}
+
+	got := s.layerRefs[sandboxID]
+
+	var diffs []string
+
+	for p, n := range want {
+		if got[p] != n {
+			diffs = append(diffs, fmt.Sprintf("%s: counted %d, referenced %d", p, got[p], n))
+		}
+	}
+
+	for p, n := range got {
+		if _, ok := want[p]; !ok {
+			diffs = append(diffs, fmt.Sprintf("%s: counted %d, referenced 0", p, n))
+		}
+	}
+
+	if len(diffs) == 0 {
+		return nil
+	}
+
+	sort.Strings(diffs)
+
+	return fmt.Errorf("layer reference counts of sandbox %s disagree with the views: %v", sandboxID, diffs)
+}
diff --git a/packages/orchestrator/internal/checkpoint/metrics.go b/packages/orchestrator/internal/checkpoint/metrics.go
new file mode 100644
index 000000000..5e4248e54
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/metrics.go
@@ -0,0 +1,177 @@
+package checkpoint
+
+import (
+	"context"
+	"math"
+	"time"
+
+	"go.opentelemetry.io/otel"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/metric"
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/shared/pkg/telemetry"
+	"github.com/e2b-dev/infra/packages/shared/pkg/utils"
+)
+
+var (
+	meter = otel.GetMeterProvider().Meter("orchestrator.internal.checkpoint")
+
+	checkpointCalls    = utils.Must(telemetry.GetCounter(meter, telemetry.SandboxCheckpointCalls))
+	checkpointDuration = utils.Must(telemetry.GetHistogram(meter, telemetry.SandboxCheckpointDurationHistogramName))
+
+	// The vCPU half of a rollback, as the forked Firecracker counts it. The
+	// two instruments are declared here rather than in shared/pkg/telemetry's
+	// registry because that registry is shared with services that have no
+	// Firecracker under them; nothing else in the fleet can produce these.
+	//
+	// Draining an in-flight MMIO access is normal and only interesting as a
+	// rate; a drain that failed or a register that read back wrong is not
+	// supposed to happen at all, which is why they are the same instrument
+	// split by an attribute: one panel, and the series that should stay flat
+	// at zero sits next to the one that does not.
+	checkpointVcpuEvents = utils.Must(meter.Int64Counter(
+		"orchestrator.sandbox.checkpoint.vcpu.events",
+		metric.WithDescription("vCPU events Firecracker reported while rewinding a sandbox, by operation and event"),
+		metric.WithUnit("1"),
+	))
+
+	// The pause-drain total is the Firecracker process's own running count,
+	// not this rollback's, so it is a gauge: adding it to a counter would
+	// count every earlier pause again on every restore.
+	// Folding hidden checkpoints into their only child (compact.go): how
+	// many folds ran, split by whether they took effect, and how many bytes
+	// they copied to do it -- the price of keeping the tree short, which a
+	// delete pays and which shows up nowhere else but in the delete's
+	// timings.
+	checkpointCompactions = utils.Must(meter.Int64Counter(
+		"orchestrator.sandbox.checkpoint.compact.folds",
+		metric.WithDescription("hidden checkpoints folded into their only child, by outcome"),
+		metric.WithUnit("1"),
+	))
+	checkpointCompactBytes = utils.Must(meter.Int64Counter(
+		"orchestrator.sandbox.checkpoint.compact.bytes",
+		metric.WithDescription("bytes copied between checkpoint files to fold hidden checkpoints, by outcome"),
+		metric.WithUnit("By"),
+	))
+
+	checkpointVcpuPauseDrains = utils.Must(meter.Int64Gauge(
+		"orchestrator.sandbox.checkpoint.vcpu.pause_drains",
+		metric.WithDescription("MMIO drains this Firecracker process has done across all its pauses, as of the last operation"),
+		metric.WithUnit("1"),
+	))
+)
+
+// recordVcpuCounters meters what Firecracker reported about the vCPUs it
+// rewound. A Firecracker that does not report them records nothing at all:
+// an absent build must not push zeros into a series that is read as "this
+// never happens here".
+func recordVcpuCounters(ctx context.Context, operation string, c *sandbox.RollbackVcpuCounters) {
+	if c == nil {
+		return
+	}
+
+	events := []struct {
+		name  string
+		count uint64
+	}{
+		{"mmio_drained", c.MmioDrained},
+		{"mmio_drain_failed", c.MmioDrainFailed},
+		{"readback_mismatch", c.ReadbackMismatch},
+	}
+
+	for _, e := range events {
+		// Zeros are added too: the series has to exist before it can be
+		// alerted on, and an alert on "no data" is not the same alert.
+		checkpointVcpuEvents.Add(ctx, clampCount(e.count), metric.WithAttributes(
+			attribute.String("operation", operation),
+			attribute.String("event", e.name),
+		))
+	}
+
+	checkpointVcpuPauseDrains.Record(ctx, clampCount(c.MmioDrainedPauseTotal), metric.WithAttributes(
+		attribute.String("operation", operation),
+	))
+}
+
+// clampCount carries a count across the unsigned/signed border the metrics
+// API draws. A value that does not fit is nonsense from a counter of vCPU
+// events, and saturating says so more honestly than wrapping to a negative.
+func clampCount(n uint64) int64 {
+	if n > math.MaxInt64 {
+		return math.MaxInt64
+	}
+
+	return int64(n)
+}
+
+// vcpuCounterFields renders the counters for the structured log, under the
+// contract's own names so a log search and the Firecracker response use the
+// same words. Nil counters add no fields: the absence of `fc_vcpu_*` on a
+// restore line is how "this Firecracker does not report them" reads.
+func vcpuCounterFields(c *sandbox.RollbackVcpuCounters) []zap.Field {
+	if c == nil {
+		return nil
+	}
+
+	return []zap.Field{
+		zap.Uint64("fc_vcpu_mmio_drained", c.MmioDrained),
+		zap.Uint64("fc_vcpu_mmio_drain_failed", c.MmioDrainFailed),
+		zap.Uint64("fc_vcpu_readback_mismatch", c.ReadbackMismatch),
+		zap.Uint64("fc_vcpu_mmio_drained_pause_total", c.MmioDrainedPauseTotal),
+	}
+}
+
+// vcpuCountersNeedAttention: a drain that failed or a register that read back
+// wrong means the guest was resumed onto a vCPU state nobody verified. The
+// restore still succeeded and still answers 200 -- there is nothing to undo
+// by then -- so the log level is the only place this can be said, and it is
+// worth saying loudly enough to be found afterwards.
+func vcpuCountersNeedAttention(c *sandbox.RollbackVcpuCounters) bool {
+	return c != nil && (c.MmioDrainFailed > 0 || c.ReadbackMismatch > 0)
+}
+
+// callStats carries what only the handler knows about how an operation went,
+// so the caller that times it can report it in the same place.
+//
+// It exists for the degradation paths. A checkpoint that had to capture full
+// memory, or a clone that fell back to copying the base byte by byte, costs
+// orders of magnitude more than the intended path while still succeeding —
+// exactly the kind of regression that hides in a latency average until
+// somebody reads the logs. Reporting it as an attribute makes it answerable
+// from a dashboard.
+type callStats struct {
+	attrs []attribute.KeyValue
+}
+
+func (c *callStats) set(key string, value string) {
+	c.attrs = append(c.attrs, attribute.String(key, value))
+}
+
+func (c *callStats) setBool(key string, value bool) {
+	c.attrs = append(c.attrs, attribute.Bool(key, value))
+}
+
+// record reports the outcome and cost of one checkpoint operation.
+func record(ctx context.Context, operation string, start time.Time, err error, stats *callStats) {
+	attrs := make([]attribute.KeyValue, 0, len(stats.attrs)+2)
+	attrs = append(attrs,
+		attribute.String("operation", operation),
+		attribute.Bool("success", err == nil),
+	)
+	attrs = append(attrs, stats.attrs...)
+
+	set := metric.WithAttributes(attrs...)
+
+	checkpointCalls.Add(ctx, 1, set)
+	checkpointDuration.Record(ctx, time.Since(start).Milliseconds(), set)
+}
+
+// recordCompaction meters one fold: whether it took effect and what it copied.
+func recordCompaction(ok bool, bytes int64) {
+	outcome := metric.WithAttributes(attribute.Bool("success", ok))
+
+	checkpointCompactions.Add(context.Background(), 1, outcome)
+	checkpointCompactBytes.Add(context.Background(), bytes, outcome)
+}
diff --git a/packages/orchestrator/internal/checkpoint/quota.go b/packages/orchestrator/internal/checkpoint/quota.go
new file mode 100644
index 000000000..fff5a5486
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/quota.go
@@ -0,0 +1,393 @@
+package checkpoint
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// A per-sandbox limit on the bytes its checkpoints occupy.
+//
+// CHECKPOINT_MAX_PER_SANDBOX caps how many checkpoints a sandbox holds, but a
+// count says little about the disk: a full root is the size of guest memory,
+// an increment can be a few pages or most of it, and a sandbox writing to its
+// disk seals layers of any size. CHECKPOINT_MAX_BYTES_PER_SANDBOX caps what
+// they add up to, measured the way the disk measures it -- allocated blocks,
+// so a sparse diff counts for the pages it holds -- over everything the store
+// keeps for the sandbox's checkpoints: each entry's diff, sidecar, snapshot
+// file and rootfs header, and each sealed layer with its sidecar. Manifests
+// are left out: a few KiB each, rewritten after the fact, and debugging aids.
+//
+// The count is kept up to date where the files come and go, all under the
+// store lock and from sizes measured outside it:
+//
+//	publishLocked       + the entry's files, + its own layer the first time a
+//	                    layer is charged (Commit measures both before the lock)
+//	deleteLocked        - the snapshot file and header of an entry it hides,
+//	                    - every file of an entry it removes
+//	pruneLocked         - every file of each entry it removes
+//	unrefLayersLocked   - a layer whose last reference went
+//	switchFoldLocked    - the folded entry, C's memory files and the rewritten
+//	                    headers at their new sizes, the merged layer in place
+//	                    of the pair
+//	dropStateLocked     the count goes with the sandbox
+//
+// What it does not count: a layer the bookkeeping never recorded (a failed
+// seal, see rootfsState.unrecorded) and a layer recorded by a create that
+// then failed and was rescued hidden -- no view names it as its own, so
+// nothing charges it; both are rare and go with the next restore or the
+// sandbox. Also the transient files of a restore in progress.
+//
+// The limit is checked where the entry is reserved (Prepare), before anything
+// is written, and refuses with 429 reason checkpoint_bytes_limit: the sandbox
+// keeps running, and deleting checkpoints brings it back under -- but only
+// the right ones. Deleting the base (the checkpoint the sandbox runs from) or
+// a fork point with more than one child only hides it and gives back its
+// snapshot file and header, a few tens of KiB: its diff stays, because the
+// sandbox or the children still resolve pages through it. Deleting an older
+// checkpoint folds it into its only child (compact.go), which frees the pages
+// the child overwrote -- nothing when two increments touch disjoint pages,
+// most of a guest memory when the oldest is a full root under a busy child.
+// So what frees space is deleting from the oldest end, or restoring to an
+// earlier checkpoint and deleting the branch after it. Deleting everything
+// but the base leaves the base as a full root, about one guest memory plus
+// its disk layers and headers: the floor a sandbox cannot go below while it
+// runs (floorBytesLocked), and why a limit under that can never be cleared.
+//
+// A checkpoint is admitted while the sandbox is below the limit, so the limit
+// can be overshot by one checkpoint's worth -- the size of the next checkpoint
+// is not known until it is taken. Restores are never refused by it.
+const maxBytesPerSandboxEnv = "CHECKPOINT_MAX_BYTES_PER_SANDBOX"
+
+// byteLimitOverhead is what a sandbox's checkpoints hold on top of their
+// memory images, as the thresholds of warnIfByteLimitTooSmall count it: the
+// sealed rootfs layers and their sidecars, the rootfs headers, snapshot files
+// and dirty-page sidecars. Measured at about 61 MiB on the development node
+// (quota experiment, 2026-09-28); 256 MiB leaves room for a guest that writes
+// more to its disk than that one did, and is a round number to add to a
+// limit by hand.
+//
+// With M a full capture (about guest memory) and eps this overhead, the same
+// experiment and the fold arithmetic give the two thresholds:
+//
+//   - limit > M + eps: the sandbox can never get stuck. Deleting the non-base
+//     checkpoints from the oldest folds them all into the base, which ends as
+//     a full root occupying about M + eps.
+//   - limit > 2M + eps: even under the worst load (every checkpoint rewrites
+//     all of memory) the sandbox can keep one earlier restore point and go on
+//     taking checkpoints.
+//
+// The earlier warning used 2 x guest memory, which sat about 66 MB below
+// 2M + eps on that node: a limit it accepted could still get stuck.
+const byteLimitOverhead int64 = 256 << 20
+
+// Where CheckpointBytesLimitError.FloorBytes came from.
+const (
+	// floorFromFullRoot: the diff and sidecar of the full root the base's
+	// ancestor chain ends at -- the memory image the base resolves through.
+	floorFromFullRoot = "full_root"
+	// floorFromGuestMemory: the chain has no full root (the sandbox's tree is
+	// rooted in the start memory source, or its chain is broken), and the
+	// guest's memory size stands in for it.
+	floorFromGuestMemory = "guest_memory"
+)
+
+// MaxBytesPerSandbox is the per-sandbox byte limit in force, 0 for none (the
+// default), with the value's provenance for the startup line.
+func MaxBytesPerSandbox() (int64, string) {
+	raw := os.Getenv(maxBytesPerSandboxEnv)
+	if raw == "" {
+		return 0, sourceDefault
+	}
+
+	n, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil || n < 0 {
+		logger.L().Warn(context.Background(), "ignoring unusable checkpoint byte limit in the environment",
+			zap.String("env", maxBytesPerSandboxEnv),
+			zap.String("value", raw))
+
+		return 0, sourceDefault
+	}
+
+	return n, sourceEnv
+}
+
+// ErrCheckpointBytesLimit marks a create refused because the sandbox's
+// checkpoints already occupy as many bytes as this node allows one sandbox.
+// Like ErrTooManyCheckpoints it is a fact about the request: deleting the
+// oldest checkpoints brings the sandbox back under the limit, as long as the
+// limit is above the sandbox's floor (see the package comment above).
+var ErrCheckpointBytesLimit = errors.New("the sandbox is at its checkpoint storage limit")
+
+// CheckpointBytesLimitError carries the two numbers the limit was decided on,
+// for the node's log, and what the caller needs to get back under it.
+type CheckpointBytesLimitError struct {
+	SandboxID string
+	// Used is what the sandbox's checkpoints occupy on disk, hidden entries
+	// and shared layers included.
+	Used  int64
+	Limit int64
+
+	// BaseID is the checkpoint the sandbox runs from, "" when it has none
+	// (a broken chain). Deleting it frees almost nothing.
+	BaseID string
+	// FloorBytes estimates the least the sandbox's checkpoints can occupy
+	// while it runs, one memory image, and FloorSource says how it was
+	// taken (floorFromFullRoot, floorFromGuestMemory). 0 when unknown.
+	FloorBytes  int64
+	FloorSource string
+	// Folds is whether deleting a checkpoint with one child folds it into
+	// that child (CHECKPOINT_COMPACT). Without folding, deleting the oldest
+	// checkpoints only hides them and frees nothing but their snapshot files.
+	Folds bool
+}
+
+func (e *CheckpointBytesLimitError) Error() string {
+	var b strings.Builder
+
+	fmt.Fprintf(&b, "%s: the checkpoints of sandbox %s occupy %d bytes, at or over the limit of %d bytes. ",
+		ErrCheckpointBytesLimit, e.SandboxID, e.Used, e.Limit)
+
+	if e.BaseID != "" {
+		fmt.Fprintf(&b, "Deleting %s, the checkpoint the sandbox runs from, frees almost nothing; ", e.BaseID)
+	}
+
+	var advice string
+	if e.Folds {
+		advice = "delete the oldest checkpoints first (each folds into the next, freeing the pages it overwrote), or restore to an earlier checkpoint and delete those after it"
+	} else {
+		advice = "restore to an earlier checkpoint and delete those after it"
+	}
+
+	if e.BaseID == "" {
+		advice = strings.ToUpper(advice[:1]) + advice[1:]
+	}
+
+	b.WriteString(advice)
+	b.WriteString("; restores are never refused by this limit")
+
+	if e.FloorBytes > 0 {
+		fmt.Fprintf(&b, ", and the sandbox always needs about %d bytes (one full memory image)", e.FloorBytes)
+	}
+
+	b.WriteString(".")
+
+	return b.String()
+}
+
+func (e *CheckpointBytesLimitError) Unwrap() error { return ErrCheckpointBytesLimit }
+
+// atByteLimitLocked reports whether the sandbox may take another checkpoint
+// under the byte limit. The caller holds the store lock.
+func (s *Store) atByteLimitLocked(sandboxID string) error {
+	if s.maxBytesPerSandbox <= 0 {
+		return nil
+	}
+
+	used := s.usedBytes[sandboxID]
+	if used < s.maxBytesPerSandbox {
+		return nil
+	}
+
+	baseID := s.bases[sandboxID].entryID
+
+	err := &CheckpointBytesLimitError{
+		SandboxID: sandboxID,
+		Used:      used,
+		Limit:     s.maxBytesPerSandbox,
+		BaseID:    baseID,
+		Folds:     s.compact,
+	}
+
+	if floor := s.floorBytesLocked(sandboxID, baseID); floor > 0 {
+		err.FloorBytes, err.FloorSource = floor, floorFromFullRoot
+	}
+
+	return err
+}
+
+// floorBytesLocked is the memory image the base resolves through: the diff
+// and sidecar of the first full entry on its ancestor chain, 0 when the
+// chain has none. Deleting every other checkpoint folds the chain into the
+// base and leaves it that size, so it is what the sandbox occupies at least
+// while it runs from there (plus its disk layers and headers, which this
+// leaves out). The caller holds the store lock.
+func (s *Store) floorBytesLocked(sandboxID string, baseID string) int64 {
+	entries := s.bySandbox[sandboxID]
+
+	// Bounded by the entry count, so a cycle the bookkeeping should never
+	// have cannot hang the lock holder.
+	id := baseID
+	for range len(entries) {
+		e, ok := entries[id]
+		if !ok {
+			return 0
+		}
+
+		if e.MemMode == MemModeFull {
+			return e.bytes.mem
+		}
+
+		if e.ParentID == "" {
+			return 0
+		}
+
+		id = e.ParentID
+	}
+
+	return 0
+}
+
+// UsedBytes is what a sandbox's checkpoints occupy on disk, as the store
+// counts it.
+func (s *Store) UsedBytes(sandboxID string) int64 {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.usedBytes[sandboxID]
+}
+
+// entryBytes is what one entry's own files occupy, by file, so hiding it can
+// give back exactly the files it drops.
+type entryBytes struct {
+	mem    int64 // diff and sidecar
+	snap   int64 // snapshot file
+	header int64 // rootfs header
+}
+
+func (b entryBytes) total() int64 {
+	return b.mem + b.snap + b.header
+}
+
+// allocatedBytes is the disk space a file occupies: its allocated blocks, so
+// a sparse file counts for what it holds. A missing file is 0.
+func allocatedBytes(path string) int64 {
+	if path == "" {
+		return 0
+	}
+
+	info, err := os.Stat(path)
+	if err != nil {
+		return 0
+	}
+
+	if st, ok := info.Sys().(*syscall.Stat_t); ok {
+		return st.Blocks * 512
+	}
+
+	return info.Size()
+}
+
+// measureEntry measures an entry's files, outside the store lock.
+func measureEntry(e *Entry) entryBytes {
+	b := entryBytes{
+		mem:  allocatedBytes(e.MemDiff) + allocatedBytes(e.MemBitmap),
+		snap: allocatedBytes(e.Snapfile),
+	}
+
+	if e.Rootfs != nil {
+		b.header = allocatedBytes(e.Rootfs.HeaderPath)
+	}
+
+	return b
+}
+
+// layerBytesOf measures a sealed layer and its sidecar.
+func layerBytesOf(path string) int64 {
+	return allocatedBytes(path) + allocatedBytes(path+layerMetaSuffix)
+}
+
+// chargeLocked adds delta to a sandbox's count.
+func (s *Store) chargeLocked(sandboxID string, delta int64) {
+	if delta == 0 {
+		return
+	}
+
+	used := s.usedBytes[sandboxID] + delta
+	if used <= 0 {
+		delete(s.usedBytes, sandboxID)
+
+		return
+	}
+
+	s.usedBytes[sandboxID] = used
+}
+
+// chargeLayerLocked charges a layer the first time it is seen, if it is
+// counted at all (a layer nobody references is on its way out).
+func (s *Store) chargeLayerLocked(sandboxID string, path string, bytes int64) {
+	if path == "" || s.layerRefs[sandboxID][path] == 0 {
+		return
+	}
+
+	charged, ok := s.layerBytes[sandboxID]
+	if !ok {
+		charged = make(map[string]int64)
+		s.layerBytes[sandboxID] = charged
+	}
+
+	if _, done := charged[path]; done {
+		return
+	}
+
+	charged[path] = bytes
+	s.chargeLocked(sandboxID, bytes)
+}
+
+// releaseLayerLocked gives back what a reclaimed layer was charged.
+func (s *Store) releaseLayerLocked(sandboxID string, path string) {
+	charged, ok := s.layerBytes[sandboxID]
+	if !ok {
+		return
+	}
+
+	bytes, ok := charged[path]
+	if !ok {
+		return
+	}
+
+	delete(charged, path)
+
+	if len(charged) == 0 {
+		delete(s.layerBytes, sandboxID)
+	}
+
+	s.chargeLocked(sandboxID, -bytes)
+}
+
+// checkUsedBytes recounts a sandbox's bytes from what the bookkeeping points
+// at -- every entry's files, every charged layer -- and reports how it
+// differs from the count, or nil. A debugging assertion for the tests. It
+// also checks that every charged layer is still referenced.
+func (s *Store) checkUsedBytes(sandboxID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	var want int64
+
+	for _, e := range s.bySandbox[sandboxID] {
+		want += measureEntry(e).total()
+	}
+
+	for path := range s.layerBytes[sandboxID] {
+		if s.layerRefs[sandboxID][path] == 0 {
+			return fmt.Errorf("sandbox %s: layer %s is charged and referenced by nothing", sandboxID, path)
+		}
+
+		want += layerBytesOf(path)
+	}
+
+	if got := s.usedBytes[sandboxID]; got != want {
+		return fmt.Errorf("sandbox %s: counted %d bytes, its files occupy %d", sandboxID, got, want)
+	}
+
+	return nil
+}
diff --git a/packages/orchestrator/internal/checkpoint/rootfs.go b/packages/orchestrator/internal/checkpoint/rootfs.go
new file mode 100644
index 000000000..d252064cc
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/rootfs.go
@@ -0,0 +1,423 @@
+package checkpoint
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"os"
+	"time"
+
+	"github.com/google/uuid"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// ErrRootfsPoisoned marks the refusal to record a view that cannot be proven
+// to describe the live layer stack. It is a sentinel because the handler
+// answers it differently from every other create failure: a restore repairs
+// it, so the caller has a move.
+var ErrRootfsPoisoned = errors.New("rootfs bookkeeping is poisoned")
+
+// rootfsState is the sandbox's live disk-view bookkeeping: the merged header
+// describing "template base + every sealed layer so far" and the layer files
+// backing it. It is the disk-side sibling of the memory base — internal,
+// per-sandbox, and reset by restores.
+type rootfsState struct {
+	meta    *header.Metadata
+	mapping []*header.BuildMap
+	layers  []RootfsLayer
+
+	// poisoned is set when the in-memory stack and the bookkeeping can no
+	// longer be proven to agree (a merge failed validation). Further
+	// checkpoints must fail loudly rather than record wrong views.
+	poisoned bool
+
+	// unrecorded are layers sealed into the live stack that the bookkeeping
+	// never took: a seal whose layer did not reach the store or whose create
+	// failed before AppendLayer (Service.failCreate), and an AppendLayer that
+	// refused or failed before it appended. Such a layer is in no view -- a
+	// view is only ever a copy of layers -- so nothing counts it, but the
+	// sandbox is reading it. It is reclaimed when the live stack is replaced
+	// by a restore (SetRootfsToEntry), the one event after which the sandbox
+	// provably no longer reads it; if no restore comes, it goes with the
+	// sandbox. Every such failure also poisons the state, so no checkpoint
+	// can be taken on top of it in between.
+	unrecorded []string
+}
+
+// AppendLayer folds a sealed write layer into the sandbox's disk view and
+// writes the merged header for the checkpoint being created. base seeds the
+// bookkeeping on the first layer — it is the template rootfs header the
+// sandbox started on.
+//
+// Only the bookkeeping update runs under the store's global lock. The
+// serialization and the two file writes run outside it, off the snapshot the
+// locked part returns. That is where the time goes — they wait on ext4 —
+// and the lock is the one every other sandbox queues on, including a restore
+// whose guest is frozen while it waits.
+//
+// The in-memory view advances even if writing the header file fails: the
+// layer is part of the live stack the moment it was sealed, and bookkeeping
+// must follow the stack, not the RPC's fate.
+func (s *Store) AppendLayer(sandboxID string, base *header.Header, layerID uuid.UUID, layer *rootfs.SealedLayer, headerOutPath string, timings sandbox.PhaseTimings) (view *RootfsView, err error) {
+	snap, err := s.appendLocked(sandboxID, base, layerID, layer, timings)
+	if err != nil {
+		return nil, err
+	}
+
+	// The bookkeeping already advanced under the lock, so the same rule that
+	// governs a failure inside it governs one out here: if this checkpoint's
+	// header cannot be written, the recorded view cannot be proven to
+	// describe the live stack, and every later view built from it would be
+	// missing this layer. Poisoning takes the lock again — the point of
+	// being out here is that the writes do not hold it, not that failures
+	// stay out of the state.
+	defer func() {
+		if err != nil {
+			s.PoisonRootfs(sandboxID)
+		}
+	}()
+
+	// The sidecar records which blocks the layer holds, so a restore can
+	// reopen the raw layer file with the same knowledge the live cache had.
+	if err := timings.Timed("append_meta_write", func() error {
+		return writeLayerMeta(layer.Path, layer.DirtyOffsets)
+	}); err != nil {
+		return nil, fmt.Errorf("failed to write layer sidecar: %w", err)
+	}
+
+	serializeStart := time.Now()
+	data, serializeErr := header.Serialize(snap.meta, snap.mapping)
+	timings.Mark("append_serialize", serializeStart)
+
+	if serializeErr != nil {
+		return nil, fmt.Errorf("failed to serialize rootfs header: %w", serializeErr)
+	}
+
+	headerStart := time.Now()
+
+	// Not fsynced, and no longer under the store lock either: an ext4
+	// journal commit waited for here is this sandbox's own create paying for
+	// it, which is what it was always meant to be.
+	if err := os.WriteFile(headerOutPath, data, 0o644); err != nil {
+		return nil, fmt.Errorf("failed to write rootfs header: %w", err)
+	}
+
+	timings.Mark("append_header_write", headerStart)
+
+	return &RootfsView{
+		HeaderPath: headerOutPath,
+		Layers:     snap.layers,
+	}, nil
+}
+
+// rootfsSnapshot is the sandbox's disk view as of the moment the store lock
+// was released: the merged header to write for this checkpoint and the layer
+// list to record with it. Everything in it is owned by the caller — the
+// slices are copies and the metadata is replaced rather than mutated — so a
+// later AppendLayer for the same sandbox cannot change what this one writes.
+type rootfsSnapshot struct {
+	meta    *header.Metadata
+	mapping []*header.BuildMap
+	layers  []RootfsLayer
+}
+
+// appendLocked is the part of AppendLayer that has to be serialized against
+// every other sandbox: the read-modify-write of this sandbox's bookkeeping.
+// It does no file I/O.
+func (s *Store) appendLocked(sandboxID string, base *header.Header, layerID uuid.UUID, layer *rootfs.SealedLayer, timings sandbox.PhaseTimings) (snap rootfsSnapshot, err error) {
+	// This is the only part that holds the store's global lock, so the wait
+	// for it is this sandbox's create paying for another sandbox's
+	// bookkeeping -- no longer for another sandbox's disk.
+	lockStart := time.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	timings.Mark("append_lock_wait", lockStart)
+
+	st, ok := s.rootfs[sandboxID]
+	if !ok {
+		// The layer is already sealed into the live stack by the time this
+		// runs, so a sandbox whose stack cannot be described must be marked
+		// as such rather than left looking healthy.
+		st = &rootfsState{}
+		s.rootfs[sandboxID] = st
+	}
+
+	// Every way out that does not append leaves the layer in the live stack
+	// and out of the bookkeeping; remember it, so a restore that replaces the
+	// stack can reclaim it. See rootfsState.unrecorded.
+	recorded := false
+	defer func() {
+		if !recorded {
+			st.unrecorded = append(st.unrecorded, layer.Path)
+		}
+	}()
+
+	if !ok {
+		if base == nil {
+			st.poisoned = true
+
+			return snap, fmt.Errorf("no rootfs bookkeeping for sandbox %s and no base header to seed it", sandboxID)
+		}
+
+		st.meta = base.Metadata
+		st.mapping = base.Mapping
+	}
+
+	if st.poisoned {
+		return snap, fmt.Errorf("%w for sandbox %s; refusing to record a view that may be wrong (restoring any checkpoint reseeds it and re-enables checkpoints)", ErrRootfsPoisoned, sandboxID)
+	}
+
+	// Past this point the stack has advanced and the bookkeeping has to keep
+	// up with it. Any failure means it no longer can, and every later view
+	// built from it would be missing this layer — silently serving stale
+	// blocks. Refuse to be trusted again instead; a restore reseeds the
+	// bookkeeping from a checkpoint's own header and clears this.
+	defer func() {
+		if err != nil {
+			st.poisoned = true
+		}
+	}()
+
+	if int64(st.meta.Size) != layer.Size {
+		return snap, fmt.Errorf("sealed layer size %d does not match device size %d", layer.Size, st.meta.Size)
+	}
+
+	mergeStart := time.Now()
+
+	layerMaps := identityMappings(layerID, layer.DirtyOffsets, layer.BlockSize)
+	merged := header.NormalizeMappings(header.MergeMappings(st.mapping, layerMaps))
+
+	if err := header.ValidateMappings(merged, st.meta.Size, st.meta.BlockSize); err != nil {
+		return snap, fmt.Errorf("merged rootfs mappings failed validation: %w", err)
+	}
+
+	st.meta = st.meta.NextGeneration(layerID)
+	st.mapping = merged
+	st.layers = append(st.layers, RootfsLayer{BuildID: layerID.String(), Path: layer.Path})
+
+	// Layer references, source 2 of 2: the live bookkeeping holds every layer
+	// in st.layers, which is what the next view will be copied from. The
+	// layer is recorded from here on even if the writes after the lock fail:
+	// the state is poisoned then, and still holds it.
+	s.refLayersLocked(sandboxID, st.layers[len(st.layers)-1:])
+	recorded = true
+
+	timings.Mark("append_merge", mergeStart)
+
+	// Copies, because st.layers is appended to in place and st.mapping is
+	// what the next merge reads: the writes out of the lock must see this
+	// generation and no other.
+	mapping := make([]*header.BuildMap, len(st.mapping))
+	copy(mapping, st.mapping)
+
+	layers := make([]RootfsLayer, len(st.layers))
+	copy(layers, st.layers)
+
+	return rootfsSnapshot{meta: st.meta, mapping: mapping, layers: layers}, nil
+}
+
+// PoisonRootfs marks the sandbox's disk-view bookkeeping as no longer
+// provably describing the live layer stack, so the next checkpoint fails
+// loudly instead of recording a view that may be wrong.
+//
+// It is for the failures that happen outside AppendLayer, where the stack
+// moved but the bookkeeping could not follow: a sealed layer that never
+// reached the store, or a restore that switched the disk view under the live
+// mount and then could not reseed the bookkeeping from the checkpoint's
+// header. A later successful restore replaces the state wholesale and
+// clears this.
+//
+// unrecordedLayers names layers the live stack reads that never reached the
+// bookkeeping -- a sealed layer the failed create could not hand to
+// AppendLayer. They are kept for the restore that replaces the stack to
+// reclaim; see rootfsState.unrecorded.
+//
+// Poisoning keeps the layer references the state holds. The layers it lists
+// are still what the live stack reads -- a poisoned state is one that cannot
+// be proven complete, not one that is wrong about what it has -- so they stay
+// counted until a restore replaces the state or the sandbox goes. The same is
+// true of InvalidateBase, which breaks the memory chain and does not touch the
+// disk bookkeeping at all: the next capture is a new tree root, and its view
+// still stacks on every layer the state lists.
+func (s *Store) PoisonRootfs(sandboxID string, unrecordedLayers ...string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	st, ok := s.rootfs[sandboxID]
+	if !ok {
+		st = &rootfsState{}
+		s.rootfs[sandboxID] = st
+	}
+
+	st.poisoned = true
+
+	for _, p := range unrecordedLayers {
+		if p != "" {
+			st.unrecorded = append(st.unrecorded, p)
+		}
+	}
+}
+
+// SetRootfsToEntry resets the sandbox's disk-view bookkeeping to a restored
+// checkpoint's view: the next sealed layer stacks on top of exactly what the
+// sandbox now reads.
+//
+// It is also where the live stack's layer references move: the new state
+// takes a reference on every layer of the restored view and the replaced one
+// gives back its own, the new ones first so a layer both list never touches
+// zero. What the replaced state held and no view lists any more -- the layers
+// sealed since the restore target's moment on a branch nobody checkpointed,
+// and the layers it never recorded -- is reclaimed once the lock is released.
+// The caller has switched the live stack to the checkpoint's view by now,
+// which is what makes those layers unread.
+func (s *Store) SetRootfsToEntry(e *Entry) error {
+	if e.Rootfs == nil {
+		return fmt.Errorf("checkpoint %s has no rootfs view", e.ID)
+	}
+
+	data, err := os.ReadFile(e.Rootfs.HeaderPath)
+	if err != nil {
+		return fmt.Errorf("failed to read rootfs header: %w", err)
+	}
+
+	h, err := header.DeserializeBytes(data)
+	if err != nil {
+		return fmt.Errorf("failed to deserialize rootfs header: %w", err)
+	}
+
+	layers := make([]RootfsLayer, len(e.Rootfs.Layers))
+	copy(layers, e.Rootfs.Layers)
+
+	var rc reclaim
+
+	s.mu.Lock()
+
+	old := s.rootfs[e.SandboxID]
+
+	s.rootfs[e.SandboxID] = &rootfsState{
+		meta:    h.Metadata,
+		mapping: h.Mapping,
+		layers:  layers,
+	}
+
+	s.refLayersLocked(e.SandboxID, layers)
+
+	if old != nil {
+		s.unrefLayersLocked(e.SandboxID, old.layers, &rc)
+
+		for _, p := range old.unrecorded {
+			// Never in a view, so never counted -- unless a later seal reused
+			// the path, which uuids rule out; checked all the same, because a
+			// counted layer is not this code's to delete.
+			if s.layerRefs[e.SandboxID][p] == 0 {
+				rc.layer(p)
+			}
+		}
+	}
+
+	s.mu.Unlock()
+
+	rc.runLogged(e.SandboxID)
+
+	return nil
+}
+
+// DiskViewForEntry loads the restore-side disk view of a checkpoint: its
+// sealed layers bottom to top, each with the block offsets it holds (from the
+// layer sidecars written at seal time).
+func (s *Store) DiskViewForEntry(e *Entry) ([]sandbox.RestoreLayer, error) {
+	if e.Rootfs == nil {
+		return nil, nil
+	}
+
+	layers := make([]sandbox.RestoreLayer, 0, len(e.Rootfs.Layers))
+	for _, l := range e.Rootfs.Layers {
+		offsets, err := readLayerMeta(l.Path)
+		if err != nil {
+			return nil, fmt.Errorf("failed to read sidecar of layer %s: %w", l.Path, err)
+		}
+
+		layers = append(layers, sandbox.RestoreLayer{
+			Path:         l.Path,
+			DirtyOffsets: offsets,
+		})
+	}
+
+	return layers, nil
+}
+
+const layerMetaSuffix = ".meta"
+
+// writeLayerMeta persists a layer's block offsets next to it, 8 bytes
+// little-endian each, via temp file and atomic rename.
+func writeLayerMeta(layerPath string, offsets []int64) error {
+	data := make([]byte, 8*len(offsets))
+	for i, off := range offsets {
+		binary.LittleEndian.PutUint64(data[8*i:], uint64(off))
+	}
+
+	path := layerPath + layerMetaSuffix
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return err
+	}
+
+	return os.Rename(tmp, path)
+}
+
+func readLayerMeta(layerPath string) ([]int64, error) {
+	data, err := os.ReadFile(layerPath + layerMetaSuffix)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(data)%8 != 0 {
+		return nil, fmt.Errorf("sidecar has truncated content (%d bytes)", len(data))
+	}
+
+	offsets := make([]int64, len(data)/8)
+	for i := range offsets {
+		offsets[i] = int64(binary.LittleEndian.Uint64(data[8*i:]))
+	}
+
+	return offsets, nil
+}
+
+// identityMappings builds the header mappings a sealed layer contributes:
+// runs of consecutive dirty blocks, each mapping a device range to the same
+// offsets inside the layer file. Storage offset equals device offset because
+// the layer is the raw write-layer file, sealed in place — no compaction.
+func identityMappings(layerID uuid.UUID, dirtyOffsets []int64, blockSize int64) []*header.BuildMap {
+	var mappings []*header.BuildMap
+
+	var runStart, runLength int64
+	flush := func() {
+		if runLength == 0 {
+			return
+		}
+
+		mappings = append(mappings, &header.BuildMap{
+			Offset:             uint64(runStart),
+			Length:             uint64(runLength),
+			BuildId:            layerID,
+			BuildStorageOffset: uint64(runStart),
+		})
+	}
+
+	for _, off := range dirtyOffsets {
+		if runLength > 0 && off == runStart+runLength {
+			runLength += blockSize
+
+			continue
+		}
+
+		flush()
+		runStart, runLength = off, blockSize
+	}
+	flush()
+
+	return mappings
+}
