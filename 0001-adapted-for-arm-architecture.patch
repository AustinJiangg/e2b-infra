new file mode 100644
index 000000000..ee5961067
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/store.go
@@ -0,0 +1,797 @@
+// Package checkpoint implements the host side of sandbox checkpoint/rollback:
+// a flat store of self-contained checkpoint artifacts and the service that
+// answers the in-sandbox checkpoint port (49984) on the host.
+//
+// Checkpoints are host-local and live only as long as the sandbox does: the
+// files sit under the store root, and an orchestrator restart takes every
+// sandbox with it anyway. The on-disk index exists so a run can be inspected
+// after the fact, not to survive a restart.
+package checkpoint
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	indexFileName     = "index.json"
+	manifestFileName  = "manifest.json"
+	snapfileFileName  = "snapfile"
+	memFullFileName   = "mem_full"
+	memBitmapFileName = "mem_bitmap"
+	rootfsHeaderName  = "rootfs.header"
+
+	// layersDirName holds sealed rootfs write layers. They are sandbox-private
+	// bookkeeping, not checkpoint artifacts: several checkpoints' views can
+	// reference the same layer, so deleting a checkpoint never deletes layers.
+	// They are reclaimed with the sandbox.
+	layersDirName = "layers"
+
+	tempSuffix = ".tmp"
+)
+
+// State of a checkpoint. Only committed checkpoints are visible to Get/List;
+// a half-written snapshot must never be restorable.
+const (
+	StatePrepared  = "prepared"
+	StateCommitted = "committed"
+)
+
+// MemMode records how the memory file was produced. Both modes yield a
+// self-contained full view; the mode only matters for metrics and debugging.
+const (
+	// MemModeFull: Firecracker wrote the complete guest memory.
+	MemModeFull = "full"
+	// MemModeIncremental: the file is a copy/clone of the previous base with
+	// this epoch's dirty pages overwritten in place by a Diff snapshot.
+	MemModeIncremental = "incremental"
+)
+
+// RootfsLayer is one sealed write layer referenced by a checkpoint's rootfs
+// view. The path points into the sandbox's shared layers directory.
+type RootfsLayer struct {
+	BuildID string `json:"build_id"`
+	Path    string `json:"path"`
+}
+
+// RootfsView describes the disk state at checkpoint time: a serialized merged
+// header (template base plus every sealed layer up to this point) and the
+// local layer files the header's mappings resolve to.
+type RootfsView struct {
+	HeaderPath string        `json:"header_path"`
+	Layers     []RootfsLayer `json:"layers,omitempty"`
+}
+
+// Entry is one checkpoint of one sandbox. Every committed entry is
+// self-contained for restore: snapfile + mem_full + rootfs view bring the
+// moment back on their own. What entries share is the epoch ledger, a tree:
+// ParentID names the checkpoint this one's memory view was cloned from (the
+// base at creation time), and its sidecar records the pages dirtied between
+// that parent's moment and its own. An in-place rollback unions the sidecars
+// along the tree path from the current base to the target.
+type Entry struct {
+	ID        string    `json:"id"`
+	Name      string    `json:"name,omitempty"`
+	SandboxID string    `json:"sandbox_id"`
+	CreatedAt time.Time `json:"created_at"`
+	State     string    `json:"state"`
+
+	// ParentID is the checkpoint this entry's epoch counts from; "" for a
+	// root whose memory was captured in full.
+	ParentID string `json:"parent_id,omitempty"`
+
+	// Hidden marks an entry that is part of the tree but not of the API —
+	// deleted while something still depends on it, or a failed create whose
+	// Firecracker snapshot had already advanced the epoch. Its snapfile and
+	// rootfs view are gone, its sidecar still takes part in revert unions,
+	// and its memory file stays only while it is the base.
+	Hidden bool `json:"hidden,omitempty"`
+
+	Dir      string `json:"dir"`
+	Snapfile string `json:"snapfile,omitempty"`
+	MemFull  string `json:"mem_full"`
+	MemMode  string `json:"mem_mode,omitempty"`
+
+	// MemBitmap is the sidecar recording which pages this checkpoint's
+	// snapshot wrote — one epoch's dirty set. Unioned along a tree path it
+	// forms the revert set for an in-place rollback. Mandatory: an epoch
+	// whose dirty set is unknown could never be crossed by a rollback.
+	MemBitmap string `json:"mem_bitmap"`
+
+	Rootfs *RootfsView `json:"rootfs,omitempty"`
+}
+
+// TempSnapfile is where the snapshot is written before commit.
+func (e *Entry) TempSnapfile() string { return filepath.Join(e.Dir, snapfileFileName+tempSuffix) }
+
+// TempMemFull is where the memory view is written before commit.
+func (e *Entry) TempMemFull() string { return e.MemFull + tempSuffix }
+
+// TempMemBitmap is where the dirty bitmap sidecar is written before commit.
+func (e *Entry) TempMemBitmap() string { return e.MemBitmap + tempSuffix }
+
+// RootfsHeaderPath is where the merged rootfs header of this checkpoint goes.
+func (e *Entry) RootfsHeaderPath() string { return filepath.Join(e.Dir, rootfsHeaderName) }
+
+// baseRef records where the sandbox sits in its checkpoint tree: entryID is
+// the entry — visible or hidden — whose memory view the next checkpoint
+// clones, whose moment Firecracker's live dirty bitmap counts from, and
+// which becomes the next checkpoint's parent. The zero value is a sandbox
+// with no checkpoint yet. invalid marks a broken chain: an epoch advanced
+// but its file could not be kept, so the next checkpoint must capture full
+// memory as a new root and restores are refused until then.
+type baseRef struct {
+	entryID string
+	invalid bool
+}
+
+// Store holds the checkpoints of every sandbox on this node, plus per-sandbox
+// bookkeeping that is not part of any checkpoint: the memory clone source and
+// the per-sandbox operation lock.
+type Store struct {
+	root string
+
+	mu        sync.Mutex
+	bySandbox map[string]map[string]*Entry
+	bases     map[string]baseRef
+	rootfs    map[string]*rootfsState
+	opLocks   map[string]*sync.Mutex
+}
+
+func NewStore(root string) (*Store, error) {
+	if err := os.MkdirAll(root, 0o755); err != nil {
+		return nil, fmt.Errorf("failed to create checkpoint store root: %w", err)
+	}
+
+	return &Store{
+		root:      root,
+		bySandbox: make(map[string]map[string]*Entry),
+		bases:     make(map[string]baseRef),
+		rootfs:    make(map[string]*rootfsState),
+		opLocks:   make(map[string]*sync.Mutex),
+	}, nil
+}
+
+// Root is where the store keeps every sandbox's checkpoints.
+func (s *Store) Root() string {
+	return s.root
+}
+
+// LockSandbox serializes checkpoint operations on one sandbox. Create,
+// restore and delete each hold this for their full duration: the memory base
+// and the rootfs layer stack are per-sandbox state that two operations must
+// not advance concurrently.
+func (s *Store) LockSandbox(sandboxID string) func() {
+	s.mu.Lock()
+	l, ok := s.opLocks[sandboxID]
+	if !ok {
+		l = &sync.Mutex{}
+		s.opLocks[sandboxID] = l
+	}
+	s.mu.Unlock()
+
+	l.Lock()
+
+	return l.Unlock
+}
+
+// LayersDir returns (and creates) the sandbox's sealed-layer directory.
+func (s *Store) LayersDir(sandboxID string) (string, error) {
+	if err := validateID(sandboxID); err != nil {
+		return "", fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	dir := filepath.Join(s.root, sandboxID, layersDirName)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", fmt.Errorf("failed to create layers dir: %w", err)
+	}
+
+	return dir, nil
+}
+
+// BaseState reports the parent of the next checkpoint: the entry id ("" when
+// the sandbox has no checkpoint yet) and whether the chain is broken, in
+// which case the next checkpoint must capture full memory as a new root and
+// restores are refused until it does.
+func (s *Store) BaseState(sandboxID string) (parentID string, broken bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	b := s.bases[sandboxID]
+
+	return b.entryID, b.invalid
+}
+
+// MemSource returns the memory view an entry's file holds, which the next
+// checkpoint clones and overwrites its dirty pages into. Hidden entries
+// answer too: a hidden base is exactly the case of an epoch that survived a
+// failed create.
+func (s *Store) MemSource(sandboxID string, entryID string) (string, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	e, ok := s.bySandbox[sandboxID][entryID]
+	if !ok || e.MemFull == "" {
+		return "", false
+	}
+
+	return e.MemFull, true
+}
+
+// Prepare reserves an entry, creates its directory and journals it as
+// prepared, so the caller can write the snapshot into the temp files. The
+// entry is not visible to Get or List until Commit. parentID is the
+// checkpoint whose memory view this one is cloned from and whose moment its
+// epoch counts from — "" for a root capture.
+func (s *Store) Prepare(sandboxID string, name string, parentID string) (*Entry, error) {
+	if err := validateID(sandboxID); err != nil {
+		return nil, fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	id := fmt.Sprintf("ckpt_%d", time.Now().UnixNano())
+	dir := filepath.Join(s.root, sandboxID, id)
+
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return nil, fmt.Errorf("failed to create checkpoint dir: %w", err)
+	}
+
+	e := &Entry{
+		ID:        id,
+		Name:      name,
+		SandboxID: sandboxID,
+		CreatedAt: time.Now().UTC(),
+		State:     StatePrepared,
+		ParentID:  parentID,
+		Dir:       dir,
+		Snapfile:  filepath.Join(dir, snapfileFileName),
+		MemFull:   filepath.Join(dir, memFullFileName),
+		MemBitmap: filepath.Join(dir, memBitmapFileName),
+	}
+
+	if err := writeManifest(e); err != nil {
+		os.RemoveAll(dir)
+
+		return nil, err
+	}
+
+	return e, nil
+}
+
+// Commit publishes a prepared entry: temp files are fsynced and renamed into
+// place, the manifest flips to committed, and the sandbox's memory base
+// advances to the new view. The caller must have finished writing the temp
+// files, including having resumed the VM.
+func (s *Store) Commit(e *Entry, memMode string, rootfs *RootfsView) error {
+	e.MemMode = memMode
+	e.Rootfs = rootfs
+
+	if err := commitFiles(e, true); err != nil {
+		return err
+	}
+
+	e.State = StateCommitted
+	if err := writeManifest(e); err != nil {
+		return err
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.publishLocked(e)
+}
+
+// CommitHidden publishes a failed checkpoint's epoch as a hidden entry. Once
+// Firecracker has written the snapshot the epoch has advanced: the memory
+// file is the only continuation of the incremental chain and the sidecar the
+// only record of which pages the epoch dirtied. Kept hidden, the entry is a
+// sound node of the tree — clone source and parent of the next checkpoint,
+// its sidecar part of revert unions like any other's — that the API never
+// shows. The create RPC still fails.
+func (s *Store) CommitHidden(e *Entry, memMode string) error {
+	e.MemMode = memMode
+	e.Hidden = true
+	e.Rootfs = nil
+
+	if err := commitFiles(e, false); err != nil {
+		return err
+	}
+
+	os.Remove(e.RootfsHeaderPath())
+
+	e.State = StateCommitted
+	if err := writeManifest(e); err != nil {
+		return err
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	return s.publishLocked(e)
+}
+
+// commitFiles moves an entry's artifacts from their temp names into place,
+// fsynced, so the manifest can claim the checkpoint exists. The sidecar is
+// mandatory: a revert union could never cross an epoch whose dirty set is
+// unknown, so a checkpoint without one must not come into existence. Hidden
+// entries are never restored, so their snapfile is dropped instead of kept.
+func commitFiles(e *Entry, withSnapfile bool) error {
+	if _, err := os.Stat(e.TempMemBitmap()); err != nil {
+		return fmt.Errorf("snapshot produced no dirty-page sidecar: %w", err)
+	}
+
+	files := [][2]string{
+		{e.TempMemFull(), e.MemFull},
+		{e.TempMemBitmap(), e.MemBitmap},
+	}
+	if withSnapfile {
+		files = append(files, [2]string{e.TempSnapfile(), e.Snapfile})
+	} else {
+		os.Remove(e.TempSnapfile())
+		e.Snapfile = ""
+	}
+
+	for _, f := range files {
+		if err := syncFile(f[0]); err != nil {
+			return fmt.Errorf("failed to sync %s: %w", f[0], err)
+		}
+
+		if err := os.Rename(f[0], f[1]); err != nil {
+			return fmt.Errorf("failed to move %s into place: %w", f[0], err)
+		}
+	}
+
+	return syncDir(e.Dir)
+}
+
+// publishLocked records a committed entry and makes it the base: Firecracker
+// cleared its dirty bitmap when it wrote the snapshot, so from now on the
+// live set counts from this moment, and this memory view is what the next
+// checkpoint clones.
+func (s *Store) publishLocked(e *Entry) error {
+	entries, ok := s.bySandbox[e.SandboxID]
+	if !ok {
+		entries = make(map[string]*Entry)
+		s.bySandbox[e.SandboxID] = entries
+	}
+	entries[e.ID] = e
+
+	s.setBaseLocked(e.SandboxID, baseRef{entryID: e.ID})
+
+	return s.writeIndexLocked(e.SandboxID)
+}
+
+// InvalidateBase marks the sandbox's incremental chain broken: the epoch
+// advanced (Firecracker cleared its dirty bitmap) but the file it produced
+// could not be kept, so no future increment can account for that epoch's
+// pages. The next checkpoint must capture full memory and become a new
+// root, and until it does restores are refused — an incomplete revert would
+// be a silently corrupted guest, which is strictly worse than an error.
+func (s *Store) InvalidateBase(sandboxID string) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.setBaseLocked(sandboxID, baseRef{invalid: true})
+}
+
+// SetBaseToEntry makes a committed checkpoint the base. Called after a
+// restore: dirty tracking restarted from zero at rollback, so the next
+// increment is relative to exactly this entry — which is how a branch grows
+// from the restore target instead of the abandoned tip.
+func (s *Store) SetBaseToEntry(e *Entry) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.setBaseLocked(e.SandboxID, baseRef{entryID: e.ID})
+}
+
+// setBaseLocked moves the base. A hidden entry that stops being the base
+// loses its memory file — it was kept for that role alone — and is pruned
+// if nothing references it any more.
+func (s *Store) setBaseLocked(sandboxID string, b baseRef) {
+	prev := s.bases[sandboxID]
+	s.bases[sandboxID] = b
+
+	if prev.entryID == "" || prev.entryID == b.entryID {
+		return
+	}
+
+	prevEntry, ok := s.bySandbox[sandboxID][prev.entryID]
+	if !ok || !prevEntry.Hidden {
+		return
+	}
+
+	os.Remove(prevEntry.MemFull)
+	s.pruneLocked(sandboxID, prevEntry)
+}
+
+// pruneLocked removes e if it is hidden, has no children and is not the
+// base — nothing resolves a revert path through it any more — and then its
+// parent on the same terms, up the tree.
+func (s *Store) pruneLocked(sandboxID string, e *Entry) {
+	entries := s.bySandbox[sandboxID]
+	base := s.bases[sandboxID]
+
+	for cur := e; cur != nil && cur.Hidden && cur.ID != base.entryID && !hasChildLocked(entries, cur.ID); {
+		parentID := cur.ParentID
+
+		delete(entries, cur.ID)
+		os.RemoveAll(cur.Dir)
+
+		cur = entries[parentID]
+	}
+}
+
+// hasChildLocked reports whether any entry's epoch counts from id.
+func hasChildLocked(entries map[string]*Entry, id string) bool {
+	for _, e := range entries {
+		if e.ParentID == id {
+			return true
+		}
+	}
+
+	return false
+}
+
+// ancestorChainLocked returns target and its ancestors, newest first,
+// ending at a root (ParentID ""). Every link must exist: the deletion rules
+// hide referenced entries instead of removing them, so a missing parent is
+// corruption, not a normal state.
+func ancestorChainLocked(entries map[string]*Entry, target *Entry) ([]*Entry, error) {
+	var chain []*Entry
+	for e := target; ; {
+		chain = append(chain, e)
+		if e.ParentID == "" {
+			break
+		}
+
+		p, ok := entries[e.ParentID]
+		if !ok {
+			return nil, fmt.Errorf("checkpoint %s references missing parent %s", e.ID, e.ParentID)
+		}
+		e = p
+	}
+
+	return chain, nil
+}
+
+// revertPathLocked returns the checkpoints whose epoch bitmaps cover every
+// page that may differ between the current base moment and the target
+// moment: both tree branches walked down to (and excluding) their lowest
+// common ancestor. A page in neither branch was written on neither side of
+// the fork, so both moments inherited it unchanged from the common ancestor
+// and it needs no revert. A time-ordered interval would get this wrong as
+// soon as a checkpoint is taken after going back: the epochs of the
+// abandoned branch are neither before nor after the new one, they are
+// beside it. targetChain is target's ancestor chain.
+func revertPathLocked(entries map[string]*Entry, baseID string, targetChain []*Entry) ([]*Entry, error) {
+	inTargetChain := map[string]bool{"": true}
+	for _, e := range targetChain {
+		inTargetChain[e.ID] = true
+	}
+
+	var path []*Entry
+
+	lca := baseID
+	for !inTargetChain[lca] {
+		e, ok := entries[lca]
+		if !ok {
+			return nil, fmt.Errorf("current base %s is missing from the store", lca)
+		}
+
+		path = append(path, e)
+		lca = e.ParentID
+	}
+
+	for _, e := range targetChain {
+		if e.ID == lca {
+			break
+		}
+
+		path = append(path, e)
+	}
+
+	return path, nil
+}
+
+// RevertBitmapForTarget writes the revert set for an in-place rollback to
+// the target checkpoint: the union of the epoch bitmaps along the tree path
+// from the current base to the target, hidden epochs included.
+//
+// The sandbox's memory is the base moment plus the live dirty set
+// (Firecracker resets its bitmap on every snapshot and rollback, and folds
+// the live set into the revert on its own). Any page where the base and
+// target moments differ was written in some epoch on the path between them
+// through their common ancestor, so the path union covers exactly what the
+// live set cannot. Epochs off the path — including a Full root's all-ones
+// sidecar, unless the path crosses it — contribute nothing and are not
+// read; this is what keeps the revert set proportional to actual divergence
+// instead of guest size.
+//
+// wroteFile=false means the path is empty — the base is the target — and
+// the live dirty set alone is the revert set, so there is no file to pass.
+// An error means the set cannot be computed and the restore must not
+// proceed: an incomplete revert would be a silently corrupted guest.
+func (s *Store) RevertBitmapForTarget(sandboxID, targetID, path string) (wroteFile bool, err error) {
+	s.mu.Lock()
+	entries := s.bySandbox[sandboxID]
+	target, ok := entries[targetID]
+	if !ok || target.Hidden {
+		s.mu.Unlock()
+
+		return false, fmt.Errorf("checkpoint %s not found", targetID)
+	}
+
+	b := s.bases[sandboxID]
+	if b.invalid {
+		s.mu.Unlock()
+
+		return false, fmt.Errorf("the incremental chain is broken (a failed checkpoint lost an epoch); take a new checkpoint first")
+	}
+	if b.entryID == "" {
+		s.mu.Unlock()
+
+		return false, fmt.Errorf("the sandbox has no memory base")
+	}
+
+	if b.entryID == target.ID {
+		s.mu.Unlock()
+
+		return false, nil
+	}
+
+	targetChain, err := ancestorChainLocked(entries, target)
+	if err != nil {
+		s.mu.Unlock()
+
+		return false, err
+	}
+
+	revertPath, err := revertPathLocked(entries, b.entryID, targetChain)
+	if err != nil {
+		s.mu.Unlock()
+
+		return false, err
+	}
+
+	var sidecars []string
+	for _, e := range revertPath {
+		if e.MemBitmap == "" {
+			s.mu.Unlock()
+
+			return false, fmt.Errorf("checkpoint %s on the revert path has no dirty-page sidecar", e.ID)
+		}
+		sidecars = append(sidecars, e.MemBitmap)
+	}
+	s.mu.Unlock()
+
+	var union *dirtyBitmap
+	for _, sc := range sidecars {
+		epoch, err := readDirtyBitmap(sc)
+		if err != nil {
+			return false, fmt.Errorf("failed to read epoch sidecar: %w", err)
+		}
+		if union == nil {
+			union = epoch
+
+			continue
+		}
+		if err := union.merge(epoch); err != nil {
+			return false, fmt.Errorf("failed to union epoch sidecars: %w", err)
+		}
+	}
+
+	if union == nil {
+		// Unreachable — a path between two distinct nodes has at least one
+		// edge — but an empty union must never pass for "live set only".
+		return false, fmt.Errorf("revert path from %s to %s holds no epoch", b.entryID, target.ID)
+	}
+
+	if err := union.writeTo(path); err != nil {
+		return false, fmt.Errorf("failed to write revert bitmap: %w", err)
+	}
+
+	return true, nil
+}
+
+// Discard removes a prepared entry's directory. It is for cleaning up after a
+// failed snapshot whose epoch did not advance (or could not be kept).
+func (s *Store) Discard(e *Entry) {
+	if e == nil || e.Dir == "" || e.State != StatePrepared {
+		return
+	}
+
+	os.RemoveAll(e.Dir)
+}
+
+// Get returns a committed, visible checkpoint.
+func (s *Store) Get(sandboxID string, id string) (*Entry, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	e, ok := s.bySandbox[sandboxID][id]
+	if !ok || e.Hidden {
+		return nil, false
+	}
+
+	return e, true
+}
+
+// List returns a sandbox's visible checkpoints, oldest first.
+func (s *Store) List(sandboxID string) []*Entry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	entries := make([]*Entry, 0, len(s.bySandbox[sandboxID]))
+	for _, e := range s.bySandbox[sandboxID] {
+		if e.Hidden {
+			continue
+		}
+		entries = append(entries, e)
+	}
+
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].CreatedAt.Before(entries[j].CreatedAt)
+	})
+
+	return entries
+}
+
+// Delete removes a checkpoint from the API. An entry that revert paths still
+// run through — one with children, or the base — is hidden instead of
+// removed: its snapfile and rootfs view go, its memory file stays only while
+// it is the base, and its sidecar stays because every rollback across this
+// epoch needs it (dropping it would make those rollbacks silently skip the
+// pages this epoch dirtied). A leaf is removed physically, and hidden
+// ancestors that just lost their last child go with it. Layer files are
+// untouched — they are sandbox-private, not checkpoint-owned.
+func (s *Store) Delete(sandboxID string, id string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	entries, ok := s.bySandbox[sandboxID]
+	if !ok {
+		return fmt.Errorf("sandbox %s has no checkpoints", sandboxID)
+	}
+
+	e, ok := entries[id]
+	if !ok || e.Hidden {
+		return fmt.Errorf("checkpoint %s not found", id)
+	}
+
+	base := s.bases[sandboxID]
+
+	if hasChildLocked(entries, id) || base.entryID == id {
+		e.Hidden = true
+		e.Rootfs = nil
+		os.Remove(e.Snapfile)
+		os.Remove(e.RootfsHeaderPath())
+		e.Snapfile = ""
+
+		if base.entryID != id {
+			os.Remove(e.MemFull)
+		}
+
+		if err := writeManifest(e); err != nil {
+			return err
+		}
+
+		return s.writeIndexLocked(sandboxID)
+	}
+
+	parentID := e.ParentID
+	delete(entries, id)
+	if err := os.RemoveAll(e.Dir); err != nil {
+		return fmt.Errorf("failed to remove checkpoint dir: %w", err)
+	}
+
+	s.pruneLocked(sandboxID, entries[parentID])
+
+	return s.writeIndexLocked(sandboxID)
+}
+
+// RemoveSandbox drops every checkpoint, layer and base of a sandbox, for when
+// it goes away.
+func (s *Store) RemoveSandbox(sandboxID string) error {
+	if err := validateID(sandboxID); err != nil {
+		return fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	delete(s.bySandbox, sandboxID)
+	delete(s.bases, sandboxID)
+	delete(s.rootfs, sandboxID)
+	delete(s.opLocks, sandboxID)
+
+	if err := os.RemoveAll(filepath.Join(s.root, sandboxID)); err != nil {
+		return fmt.Errorf("failed to remove sandbox checkpoints: %w", err)
+	}
+
+	return nil
+}
+
+func writeManifest(e *Entry) error {
+	data, err := json.MarshalIndent(e, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal manifest: %w", err)
+	}
+
+	path := filepath.Join(e.Dir, manifestFileName)
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return fmt.Errorf("failed to write manifest: %w", err)
+	}
+
+	if err := syncFile(tmp); err != nil {
+		return fmt.Errorf("failed to sync manifest: %w", err)
+	}
+
+	if err := os.Rename(tmp, path); err != nil {
+		return fmt.Errorf("failed to replace manifest: %w", err)
+	}
+
+	return syncDir(e.Dir)
+}
+
+func (s *Store) writeIndexLocked(sandboxID string) error {
+	entries := make([]*Entry, 0, len(s.bySandbox[sandboxID]))
+	for _, e := range s.bySandbox[sandboxID] {
+		entries = append(entries, e)
+	}
+
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].CreatedAt.Before(entries[j].CreatedAt)
+	})
+
+	data, err := json.MarshalIndent(entries, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal checkpoint index: %w", err)
+	}
+
+	path := filepath.Join(s.root, sandboxID, indexFileName)
+
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return fmt.Errorf("failed to write checkpoint index: %w", err)
+	}
+
+	if err := os.Rename(tmp, path); err != nil {
+		return fmt.Errorf("failed to replace checkpoint index: %w", err)
+	}
+
+	return nil
+}
+
+func syncFile(path string) error {
+	f, err := os.Open(path)
+	if err != nil {
+		return err
+	}
+	defer f.Close()
+
+	return f.Sync()
+}
+
+func syncDir(path string) error {
+	return syncFile(path)
+}
+
+// validateID rejects anything that would let an id escape the store root.
+func validateID(id string) error {
+	if id == "" {
+		return fmt.Errorf("empty id")
+	}
+
+	if strings.ContainsAny(id, "/\\") || strings.Contains(id, "..") {
+		return fmt.Errorf("id %q contains path separators", id)
+	}
+
+	return nil
+}
diff --git a/packages/orchestrator/internal/checkpoint/store_test.go b/packages/orchestrator/internal/checkpoint/store_test.go
new file mode 100644
index 000000000..1a31bb769
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/store_test.go
@@ -0,0 +1,372 @@
+package checkpoint
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func newTestStore(t *testing.T) *Store {
+	t.Helper()
+
+	s, err := NewStore(filepath.Join(t.TempDir(), "checkpoints"))
+	require.NoError(t, err)
+
+	return s
+}
+
+var testStamp = time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
+
+// prepareWithFiles prepares an entry with every temp artifact a Firecracker
+// snapshot produces, including a sidecar, stamped seq seconds into the test
+// epoch so listing order never depends on the clock.
+func prepareWithFiles(t *testing.T, s *Store, sandboxID, name string, seq int) *Entry {
+	t.Helper()
+
+	parentID, _ := s.BaseState(sandboxID)
+	e, err := s.Prepare(sandboxID, name, parentID)
+	require.NoError(t, err)
+	e.CreatedAt = testStamp.Add(time.Duration(seq) * time.Second)
+	require.NoError(t, os.WriteFile(e.TempSnapfile(), []byte("snapfile-"+e.ID), 0o644))
+	require.NoError(t, os.WriteFile(e.TempMemFull(), []byte("memory-"+e.ID), 0o644))
+	writeEpoch(t, e, []uint64{0})
+
+	return e
+}
+
+func writeEpoch(t *testing.T, e *Entry, words []uint64) {
+	t.Helper()
+
+	b := &dirtyBitmap{pageSize: 4096, numPages: 64, words: words}
+	require.NoError(t, b.writeTo(e.TempMemBitmap()))
+}
+
+// baseMem is the clone source of the next checkpoint: what the old Base()
+// returned, now assembled from the two calls that replaced it.
+func baseMem(t *testing.T, s *Store, sandboxID string) (string, bool) {
+	t.Helper()
+
+	parentID, broken := s.BaseState(sandboxID)
+	if broken || parentID == "" {
+		return "", false
+	}
+
