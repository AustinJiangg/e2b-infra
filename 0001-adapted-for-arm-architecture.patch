diff --git a/packages/orchestrator/internal/runtimemetrics/runtimemetrics.go b/packages/orchestrator/internal/runtimemetrics/runtimemetrics.go
new file mode 100644
index 000000000..7d902843e
--- /dev/null
+++ b/packages/orchestrator/internal/runtimemetrics/runtimemetrics.go
@@ -0,0 +1,245 @@
+// Package runtimemetrics logs the Go runtime's own stop-the-world pause
+// histograms, for telling apart the two ways a GC pause gets long.
+//
+// A stop-the-world pause is two things back to back: getting every P to stop
+// (the "stopping" part -- a goroutine that does not reach a preemption point,
+// a thread stuck in a syscall that has not handed its P back, an overloaded
+// host that does not schedule the threads that have to acknowledge) and the
+// work the collector does once they have. The GC's pause total alone cannot
+// say which of the two a 600 ms pause was, and they are fixed in entirely
+// different places. The runtime keeps both as histograms; this reads them.
+// They count stop-the-world pauses, not collections: a GC cycle stops the
+// world twice (sweep termination and mark termination), so a line's pause
+// counts run at about twice its gc_cycles.
+//
+// It is forensics, off by default, and costs nothing while it is.
+package runtimemetrics
+
+import (
+	"context"
+	"math"
+	"os"
+	"runtime/metrics"
+	"strconv"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// Env turns the log line on. It is read with strconv.ParseBool, like
+// FC_TRACK_DIRTY_PAGES: 1/t/T/TRUE/true/True is on, 0/f/F/FALSE/false/False
+// is off, and anything else is reported and ignored.
+const Env = "CHECKPOINT_RUNTIME_METRICS"
+
+// interval is how often a line is logged. Each line covers the interval
+// since the previous one. A variable so the tests can wait less.
+var interval = 10 * time.Second
+
+const (
+	stoppingGC = "/sched/pauses/stopping/gc:seconds"
+	totalGC    = "/sched/pauses/total/gc:seconds"
+	gcCycles   = "/gc/cycles/total:gc-cycles"
+)
+
+// Start logs the pause histograms every interval until ctx is done, if Env
+// says so. It returns at once either way.
+func Start(ctx context.Context) {
+	raw, set := os.LookupEnv(Env)
+	if !set {
+		return
+	}
+
+	enabled, err := strconv.ParseBool(raw)
+	if err != nil {
+		logger.L().Warn(ctx, "ignoring a runtime metrics setting that is not a boolean",
+			zap.String("env", Env),
+			zap.String("value", raw))
+
+		return
+	}
+
+	if !enabled {
+		return
+	}
+
+	logger.L().Info(ctx, "logging runtime GC pause histograms",
+		zap.String("env", Env),
+		zap.Duration("interval", interval))
+
+	go run(ctx)
+}
+
+func run(ctx context.Context) {
+	samples := []metrics.Sample{{Name: stoppingGC}, {Name: totalGC}, {Name: gcCycles}}
+
+	metrics.Read(samples)
+	prevStopping := copyCounts(samples[0])
+	prevTotal := copyCounts(samples[1])
+	prevCycles := cycles(samples[2])
+
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+
+		metrics.Read(samples)
+
+		stopping := histogram(samples[0])
+		total := histogram(samples[1])
+		nowCycles := cycles(samples[2])
+
+		fields := []zap.Field{
+			zap.Uint64("gc_cycles", nowCycles-prevCycles),
+			zap.Uint64("gc_cycles_cumulative", nowCycles),
+		}
+		fields = append(fields, pauseFields("stw_stopping", stopping, prevStopping)...)
+		fields = append(fields, pauseFields("stw_total", total, prevTotal)...)
+
+		logger.L().Info(ctx, "runtime GC pauses", fields...)
