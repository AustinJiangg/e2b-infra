+import (
+	"fmt"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The tests here lock down the disk semantics of a rollback at the layer that
+// implements them, against the behaviour the in-guest scheme's kernel patch
+// demonstrated: a restore drops the write layer and the content falls back to
+// the topmost layer below it, any past checkpoint stays restorable, and a
+// checkpoint taken after a restore stacks on the restored view rather than on
+// the timeline that was discarded.
+//
+// They are the reason the layer stack can be trusted without a VM: everything
+// above this file — the store's bookkeeping, the merged headers — only decides
+// which layers make up a view, while what a view then *reads* is decided here.
+
+// stack is the disk half of a sandbox as the orchestrator runs it: a template
+// base, the layers sealed by past checkpoints, and the write layer the guest
+// is currently writing into.
+type stack struct {
+	t       *testing.T
+	dir     string
+	overlay *Overlay
+	sealed  []layerRef
+	gen     int
+}
+
+// layerRef is what a checkpoint records about one sealed layer: the file and
+// the blocks it holds. It is the test's stand-in for checkpoint.RootfsLayer
+// plus its sidecar.
+type layerRef struct {
+	path    string
+	offsets []int64
+}
+
+func newStack(t *testing.T) *stack {
+	t.Helper()
+
+	dir := t.TempDir()
+	write, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(dir, "write-0"), false)
+	require.NoError(t, err)
+
+	s := &stack{t: t, dir: dir, overlay: NewOverlay(baseStub{}, write)}
+	t.Cleanup(func() { _ = s.overlay.Close() })
+
+	return s
+}
+
+func (s *stack) write(blockIdx int64, fill byte) {
+	s.t.Helper()
+
+	writeBlock(s.t, s.overlay, blockIdx, fill)
+}
+
+func (s *stack) read(blockIdx int64) byte {
+	s.t.Helper()
+
+	return readBlock(s.t, s.overlay, blockIdx)
+}
+
+// checkpoint seals the write layer and returns the view of the disk at this
+// moment: every layer from the bottom up.
+func (s *stack) checkpoint() []layerRef {
+	s.t.Helper()
+
+	s.gen++
+
+	next, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(s.dir, fmt.Sprintf("write-%d", s.gen)), false)
+	require.NoError(s.t, err)
+
+	sealed, err := s.overlay.Seal(next)
+	require.NoError(s.t, err)
+	require.NoError(s.t, sealed.Sync())
+
+	path := filepath.Join(s.dir, fmt.Sprintf("layer-%d", s.gen))
+	require.NoError(s.t, sealed.MoveFile(path))
+
+	s.sealed = append(s.sealed, layerRef{path: path, offsets: sealed.DirtyOffsets()})
+
+	return append([]layerRef(nil), s.sealed...)
+}
+
+// restore rebuilds the disk from a checkpoint's view: the base, that view's
+// layers, and a fresh write layer. Whatever the guest wrote since the last
+// checkpoint goes with the write layer that is dropped here.
+func (s *stack) restore(view []layerRef) {
+	s.t.Helper()
+
+	require.NoError(s.t, s.overlay.Close())
+
+	var device ReadonlyDevice = baseStub{}
+	for _, l := range view {
+		cache, err := NewCache(sealTestSize, sealTestBlockSize, l.path, false)
+		require.NoError(s.t, err)
+
+		cache.MarkCached(l.offsets)
+		device = NewSealedView(device, cache)
+	}
+
+	s.gen++
+
+	write, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(s.dir, fmt.Sprintf("write-%d", s.gen)), false)
+	require.NoError(s.t, err)
+
+	s.overlay = NewOverlay(device, write)
+	s.sealed = append([]layerRef(nil), view...)
+}
+
+func TestParityRestoreDropsWritesTakenAfterTheCheckpoint(t *testing.T) {
+	st := newStack(t)
+
+	st.write(0, 'X')
+	view := st.checkpoint()
+
+	st.write(0, 'Y')
+	st.write(1, 'Y')
+	require.Equal(t, byte('Y'), st.read(0))
+	require.Equal(t, byte('Y'), st.read(1))
+
+	st.restore(view)
+
+	assert.Equal(t, byte('X'), st.read(0), "a block overwritten after the checkpoint returns to its checkpointed content")
+	assert.Equal(t, byte('B'), st.read(1), "a block first written after the checkpoint falls back to the base")
+}
+
+func TestParityRepeatedRestoreIsDeterministic(t *testing.T) {
+	st := newStack(t)
+
+	st.write(0, 'X')
+	view := st.checkpoint()
+
+	for round := range 3 {
+		st.write(0, 'Y')
+		st.write(1, 'Y')
+
+		st.restore(view)
+
+		assert.Equal(t, byte('X'), st.read(0), "round %d", round)
+		assert.Equal(t, byte('B'), st.read(1), "round %d", round)
+	}
+}
+
+func TestParityCheckpointAfterRestoreStacksOnTheRestoredView(t *testing.T) {
+	st := newStack(t)
+
+	st.write(0, '1')
+	v1 := st.checkpoint()
+
+	st.write(0, '2')
+	v2 := st.checkpoint()
+	require.Len(t, v2, 2)
+
+	// Go back to the first checkpoint and carry on from there. The second
+	// checkpoint's layer is not part of this timeline any more.
+	st.restore(v1)
+	st.write(1, '3')
+	v3 := st.checkpoint()
+
+	require.Len(t, v3, 2, "the new layer stacks on v1, not on the discarded v2")
+	assert.Equal(t, v1[0].path, v3[0].path)
+	assert.NotEqual(t, v2[1].path, v3[1].path)
+
+	assert.Equal(t, byte('1'), st.read(0), "the discarded timeline's overwrite is gone")
+	assert.Equal(t, byte('3'), st.read(1))
+
+	// The branch that was left behind is still restorable: checkpoints are
+	// self-contained, so a restore is never a deletion.
+	st.restore(v2)
+
+	assert.Equal(t, byte('2'), st.read(0))
+	assert.Equal(t, byte('B'), st.read(1), "the other branch's write is not visible here")
+
+	// And back again, to show neither branch consumed the other.
+	st.restore(v3)
+
+	assert.Equal(t, byte('1'), st.read(0))
+	assert.Equal(t, byte('3'), st.read(1))
+}
+
+func TestParityLayersStayImmutableOnceSealed(t *testing.T) {
+	st := newStack(t)
+
+	st.write(0, 'X')
+	view := st.checkpoint()
+	sealedOffsets := append([]int64(nil), view[0].offsets...)
+
+	// Writing after the seal must land in the new write layer, leaving the
+	// sealed one exactly as the checkpoint recorded it — otherwise a restore
+	// would read data from after the checkpoint it is restoring.
+	st.write(1, 'Y')
+	st.write(0, 'Y')
+
+	after := st.checkpoint()
+
+	assert.Equal(t, sealedOffsets, after[0].offsets, "the first layer holds the same blocks it did when sealed")
+	assert.Equal(t, view[0].path, after[0].path)
+}
