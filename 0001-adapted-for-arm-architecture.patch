diff --git a/packages/shared/pkg/proxy/pool/trace.go b/packages/shared/pkg/proxy/pool/trace.go
new file mode 100644
index 000000000..6e8d40301
--- /dev/null
+++ b/packages/shared/pkg/proxy/pool/trace.go
@@ -0,0 +1,315 @@
+package pool
+
+import (
+	"bufio"
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"net/http/httptrace"
+	"os"
+	"strings"
+	"sync"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// TraceEnv turns the proxy's forensic trace on ("1", "true", "yes" or "on").
+//
+// It answers a question the ordinary logs cannot: when a stream through the
+// sandbox proxy ends early -- the caller reading an incomplete chunked body
+// -- which upstream connection was it on, and did something on this side
+// close that connection. The proxy's own error line names neither. It says a
+// read failed, on a request it cannot tie to a connection, at a moment it
+// cannot tie to the pool entry that was thrown away; and the pool throws
+// entries away on a restore, on a sandbox stopping and at the end of every
+// build layer, silently. Lining those two halves up after the fact is the
+// whole of this file.
+//
+// It is off by default and costs nothing while it is: every call site asks
+// TraceEnabled first and builds no fields when the answer is no. On, it puts
+// two lines and a handful of fields on every proxied request, which is why
+// it is a switch and not the default.
+const TraceEnv = "PROXY_TRACE"
+
+// The messages the trace writes. They are constants because what reads them
+// is a query, not a person.
+const (
+	TraceRequestStarted = "proxy trace: request started"
+	TraceRequestEnded   = "proxy trace: request ended"
+	TraceConnReset      = "proxy trace: upstream connection reset"
+	TracePoolEntryGone  = "proxy trace: proxy client removed from pool"
+)
+
+// Why a pool entry was thrown away. The pool cannot tell -- it is handed a
+// connection key and nothing else -- and "the connection died" reads very
+// differently depending on which of these was happening at the time.
+const (
+	// DropReasonUnspecified: a caller that has not been taught to say.
+	DropReasonUnspecified = "unspecified"
+	// DropReasonRestore: a checkpoint rollback is about to give the guest a
+	// TCP stack that has never heard of these connections.
+	DropReasonRestore = "restore"
+	// DropReasonSandboxStopped: the sandbox is gone.
+	DropReasonSandboxStopped = "sandbox_stopped"
+	// DropReasonEnvdRestarted: envd inside the sandbox was restarted, so
+	// every connection to it is stale.
+	DropReasonEnvdRestarted = "envd_restarted"
+	// DropReasonBuildDone: a template build finished with the sandbox it
+	// was building in.
+	DropReasonBuildDone = "build_done"
+)
+
+// traceEnabled resolves the switch once, on first use. It is a deployment
+// decision for the life of the process, and re-reading the environment would
+// put a getenv in front of every proxied request.
+//
+// It is a variable so that SetTraceEnabledForTest can stand in for it; a
+// test cannot arrange a once-per-process answer through the environment.
+var traceEnabled = sync.OnceValue(func() bool {
+	return traceEnabledFromEnv(os.Getenv(TraceEnv))
+})
+
+func traceEnabledFromEnv(raw string) bool {
+	switch strings.ToLower(raw) {
+	case "1", "true", "yes", "on":
+		return true
+	default:
+		return false
+	}
+}
+
+// TraceEnabled reports whether the forensic trace is on.
+func TraceEnabled() bool {
+	return traceEnabled()
+}
+
+// SetTraceEnabledForTest forces the switch and returns the call that puts it
+// back. It must not be used from a parallel test: the switch is one variable
+// for the process.
+func SetTraceEnabledForTest(on bool) func() {
+	previous := traceEnabled
+	traceEnabled = func() bool { return on }
+
+	return func() { traceEnabled = previous }
+}
+
+// traceLog writes one trace line.
+//
+// The lines go out at info, not debug. The orchestrator builds its logger at
+// zap.InfoLevel unless E2B_DEBUG=true, and the nomad job does not set it, so
+// a debug line would be dropped inside zap and never reach the node's logs
+// -- an instrument that is switched off exactly when someone goes looking
+// for it. Whether these lines exist at all is already decided by TraceEnv.
+func traceLog(ctx context.Context, l logger.Logger, msg string, fields ...zap.Field) {
+	if l == nil {
+		l = logger.L()
+	}
+
+	l.Info(ctx, msg, fields...)
+}
+
+type traceContextKey struct{}
+
+// traceRecord is what a traced request collects while it runs. Both halves
+// are known in places that cannot reach the line that reports them: the
+// upstream connection inside an httptrace hook, the transport error inside
+// the ReverseProxy's ErrorHandler. They are left here for the closing line.
+type traceRecord struct {
+	mu sync.Mutex
+
+	localAddr  string
+	remoteAddr string
+	reused     bool
+	wasIdle    bool
+	err        error
+}
+
+func (t *traceRecord) gotConn(info httptrace.GotConnInfo) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	if info.Conn != nil {
+		t.localAddr = addrString(info.Conn.LocalAddr())
+		t.remoteAddr = addrString(info.Conn.RemoteAddr())
+	}
+
+	t.reused = info.Reused
+	t.wasIdle = info.WasIdle
+}
+
+func (t *traceRecord) setError(err error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	t.err = err
+}
+
+func (t *traceRecord) fields() []zap.Field {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	fields := []zap.Field{
+		zap.String("upstream_local_addr", t.localAddr),
+		zap.String("upstream_remote_addr", t.remoteAddr),
+		zap.Bool("upstream_conn_reused", t.reused),
+		zap.Bool("upstream_conn_was_idle", t.wasIdle),
+	}
+
+	if t.err != nil {
+		fields = append(fields, zap.Error(t.err))
+	}
+
+	return fields
+}
+
+// RecordTraceError leaves a transport error on the traced request, for the
+// closing line to report. It is a no-op when the request is not traced.
+func RecordTraceError(ctx context.Context, err error) {
+	rec, ok := ctx.Value(traceContextKey{}).(*traceRecord)
+	if !ok || rec == nil {
+		return
+	}
+
+	rec.setError(err)
+}
+
+func addrString(a net.Addr) string {
+	if a == nil {
+		return ""
+	}
+
+	return a.String()
+}
+
+// traceResponseWriter records what actually reached the caller: the status,
+// whether the headers went out at all, how much body followed, and whether
+// anything was flushed -- which is what tells a stream from a response that
+// was written in one piece.
+type traceResponseWriter struct {
+	http.ResponseWriter
+
+	status      int
+	wroteHeader bool
+	bytes       int64
+	flushes     int
+}
+
+func (w *traceResponseWriter) WriteHeader(status int) {
+	if !w.wroteHeader {
+		w.status = status
+		w.wroteHeader = true
+	}
+
+	w.ResponseWriter.WriteHeader(status)
+}
+
+func (w *traceResponseWriter) Write(b []byte) (int, error) {
+	if !w.wroteHeader {
+		w.status = http.StatusOK
+		w.wroteHeader = true
+	}
+
+	n, err := w.ResponseWriter.Write(b)
+	w.bytes += int64(n)
+
+	return n, err
+}
+
+// Flush keeps streaming responses streaming: httputil.ReverseProxy flushes
+// as it copies, and a wrapper that swallowed Flush would turn every stream
+// into a buffered response -- the trace would have changed the behaviour it
+// was added to watch.
+func (w *traceResponseWriter) Flush() {
+	w.flushes++
+
+	if f, ok := w.ResponseWriter.(http.Flusher); ok {
+		f.Flush()
+	}
+}
+
+// Hijack keeps connection upgrades working through the wrapper.
+func (w *traceResponseWriter) Hijack() (net.Conn, *bufio.ReadWriter, error) {
+	h, ok := w.ResponseWriter.(http.Hijacker)
+	if !ok {
+		return nil, nil, errors.New("the underlying response writer does not support hijacking")
+	}
+
+	return h.Hijack()
+}
+
+// Unwrap lets http.ResponseController reach the writer underneath.
+func (w *traceResponseWriter) Unwrap() http.ResponseWriter {
+	return w.ResponseWriter
+}
+
+// TraceRequest opens a traced request: it writes the opening line and
+// returns the response writer to proxy through, the context to carry, and
+// the call that writes the closing line.
+//
+// The closing call must be deferred. A streaming response that fails after
+// the headers have gone out ends in an http.ErrAbortHandler panic raised
+// inside ReverseProxy -- there is no way left to tell the caller, so the
+// connection is aborted, which is what an incomplete chunked read looks like
+// from the other end. That is the failure this trace exists for, and a
+// deferred call is the only thing that still runs to record it. The panic is
+// re-raised unchanged.
+func TraceRequest(ctx context.Context, w http.ResponseWriter, r *http.Request, d *Destination) (http.ResponseWriter, context.Context, func()) {
+	rec := &traceResponseWriter{ResponseWriter: w}
+	record := &traceRecord{}
+
+	ctx = context.WithValue(ctx, traceContextKey{}, record)
+	ctx = httptrace.WithClientTrace(ctx, &httptrace.ClientTrace{GotConn: record.gotConn})
+
+	var l logger.Logger
+	if d != nil {
+		l = d.RequestLogger
+	}
+
+	base := []zap.Field{
+		zap.String("method", r.Method),
+		zap.String("path", r.URL.Path),
+		zap.String("downstream_addr", r.RemoteAddr),
+	}
+
+	if d != nil {
+		base = append(base,
+			logger.WithSandboxID(d.SandboxId),
+			zap.String("connection_key", d.ConnectionKey),
+			zap.Uint64("sandbox_port", d.SandboxPort))
+	}
+
+	start := time.Now()
+
+	traceLog(ctx, l, TraceRequestStarted, base...)
+
+	return rec, ctx, func() {
+		panicked := recover()
+
+		fields := make([]zap.Field, 0, len(base)+11)
+		fields = append(fields, base...)
+		fields = append(fields,
+			zap.Float64("duration_ms", float64(time.Since(start).Microseconds())/1000),
+			zap.Int("status_code", rec.status),
+			zap.Bool("wrote_header", rec.wroteHeader),
+			zap.Int64("response_bytes", rec.bytes),
+			zap.Bool("streamed", rec.flushes > 0))
+		fields = append(fields, record.fields()...)
+
+		if panicked != nil {
+			fields = append(fields,
+				zap.Bool("aborted_after_headers", rec.wroteHeader),
+				zap.String("abort", fmt.Sprint(panicked)))
+		}
+
+		traceLog(ctx, l, TraceRequestEnded, fields...)
+
+		if panicked != nil {
+			panic(panicked)
+		}
+	}
+}
