diff --git a/packages/orchestrator/internal/sandbox/fc/dirtytracking.go b/packages/orchestrator/internal/sandbox/fc/dirtytracking.go
new file mode 100644
index 000000000..c72e6065e
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/fc/dirtytracking.go
@@ -0,0 +1,138 @@
+package fc
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+
+	"golang.org/x/sys/unix"
+)
+
+// KVM 的 arm64 硬件脏状态跟踪能力号。x/sys/unix 里没有这两个常量，而且
+// KVM_CHECK_EXTENSION 的参数是按值传的能力号，所以这里都写出来。
+const (
+	kvmCapArmHWDirtyStateTrack = 502
+	kvmCheckExtension          = 0xAE03 // _IO(KVMIO, 0x03)
+)
+
+// trackDirtyPagesEnabled decides whether every microVM this orchestrator
+// starts arms dirty page tracking. That is what lets Firecracker produce Diff
+// snapshots, and therefore what makes an incremental checkpoint incremental:
+// with it off every checkpoint silently copies all of guest memory instead,
+// which on a 2 GiB sandbox is the difference between 40 MiB and 2 GiB written,
+// and between tens of milliseconds and a second and a half.
+//
+// FC_TRACK_DIRTY_PAGES forces the answer either way. Left unset it follows the
+// hardware, because the cost does:
+//
+//   - where the CPU tracks dirty state itself (arm64 HDBSS, KVM capability
+//     502) arming it is close to free, so it defaults on and a host that can
+//     do incremental checkpoints does them without anyone having to know;
+//   - where it does not, the kernel write-protects every clean page and takes
+//     a VM exit on its first write, a pure loss for sandboxes that never
+//     checkpoint, so it defaults off.
+//
+// The variable is read the way Go reads booleans everywhere else
+// (strconv.ParseBool): 1/t/T/TRUE/true/True is on, 0/f/F/FALSE/false/False is
+// off. Anything else -- "yes", "on", an empty value, a typo -- is not an off
+// switch. It is remembered, reported at startup and then ignored, and the
+// host decides as if the variable had not been set at all. Reading an
+// unrecognised value as "off" is how a fleet loses incremental checkpoints
+// with nothing but a slowdown to show for it.
+const trackDirtyPagesEnv = "FC_TRACK_DIRTY_PAGES"
+
+// dirtyTrackingChoice is the decision together with what it takes to explain
+// it to whoever is reading a startup log.
+type dirtyTrackingChoice struct {
+	enabled bool
+	reason  string
+	// ignored says the environment held something that is not a boolean, and
+	// ignoredValue is what that was -- which can itself be the empty string,
+	// so the two cannot be folded into one field. Kept apart from reason so
+	// that startup can warn about it instead of only describing it.
+	ignored      bool
+	ignoredValue string
+}
+
+var dirtyTracking = resolveTrackDirtyPages()
+
+func resolveTrackDirtyPages() dirtyTrackingChoice {
+	raw, set := os.LookupEnv(trackDirtyPagesEnv)
+
+	return decideTrackDirtyPages(raw, set, hardwareDirtyTracking)
+}
+
+// decideTrackDirtyPages is resolveTrackDirtyPages with the environment and the
+// host handed to it, which is what lets both halves be tested on a machine
+// that is whatever it happens to be.
+func decideTrackDirtyPages(raw string, set bool, hardware func() bool) dirtyTrackingChoice {
+	if !set {
+		return hostDefaultTrackDirtyPages(hardware)
+	}
+
+	if enabled, err := strconv.ParseBool(raw); err == nil {
+		return dirtyTrackingChoice{
+			enabled: enabled,
+			reason:  fmt.Sprintf("%s=%q", trackDirtyPagesEnv, raw),
+		}
+	}
+
+	choice := hostDefaultTrackDirtyPages(hardware)
+	choice.ignored = true
+	choice.ignoredValue = raw
+	choice.reason = fmt.Sprintf(
+		"%s=%q is not a boolean and was ignored; %s",
+		trackDirtyPagesEnv, raw, choice.reason,
+	)
+
+	return choice
+}
+
+// hostDefaultTrackDirtyPages is the answer for a node that was not told one.
+func hostDefaultTrackDirtyPages(hardware func() bool) dirtyTrackingChoice {
+	if hardware() {
+		return dirtyTrackingChoice{
+			enabled: true,
+			reason:  "hardware dirty state tracking present (KVM capability 502)",
+		}
+	}
+
+	return dirtyTrackingChoice{
+		reason: "no hardware dirty state tracking; software tracking costs a VM exit per clean page",
+	}
+}
+
+// hardwareDirtyTracking asks KVM whether this host tracks guest dirty state in
+// hardware. KVM_CHECK_EXTENSION only queries: no VM is created and nothing is
+// enabled, so this is safe to run at startup anywhere, including on a host
+// with no /dev/kvm at all.
+func hardwareDirtyTracking() bool {
+	f, err := os.OpenFile("/dev/kvm", os.O_RDWR, 0)
+	if err != nil {
+		return false
+	}
+	defer f.Close()
+
+	ret, _, errno := unix.Syscall(unix.SYS_IOCTL, f.Fd(), kvmCheckExtension, kvmCapArmHWDirtyStateTrack)
+
+	return errno == 0 && ret > 0
+}
+
+// TrackDirtyPagesEnabled reports whether VMs on this orchestrator are started
+// with dirty page tracking armed, which is what makes incremental (Diff)
+// snapshots possible.
+func TrackDirtyPagesEnabled() bool { return dirtyTracking.enabled }
+
+// TrackDirtyPagesReason explains how TrackDirtyPagesEnabled got its value. A
+// deployment that quietly lost incremental checkpoints should be able to say
+// why from its logs, instead of only being slow.
+func TrackDirtyPagesReason() string { return dirtyTracking.reason }
+
+// TrackDirtyPagesIgnoredValue reports the value FC_TRACK_DIRTY_PAGES held when
+// it could not be read as a boolean, in which case the node decided as if the
+// variable had not been set. An operator who typed one of those values is
+// convinced they configured this node, so the startup log has to say plainly
+// that they did not.
+func TrackDirtyPagesIgnoredValue() (string, bool) {
+	return dirtyTracking.ignoredValue, dirtyTracking.ignored
+}
