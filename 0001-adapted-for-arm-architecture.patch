diff --git a/packages/orchestrator/internal/sandbox/conntrack_flush.go b/packages/orchestrator/internal/sandbox/conntrack_flush.go
new file mode 100644
index 000000000..260be7d4d
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/conntrack_flush.go
@@ -0,0 +1,172 @@
+package sandbox
+
+import (
+	"maps"
+	"sync"
+	"time"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/network"
+)
+
+// conntrackFlush is a rollback's connection-tracking flush, running beside
+// the rest of the freeze instead of in the middle of it.
+//
+// The flush has two halves that run side by side (network.Slot.FlushConntrack):
+// the sandbox's own table, flushed in its namespace, and the host's table,
+// where this slot's handful of entries sit among everyone else's. The host
+// half is the one that grows with the node. It goes through the sweeper
+// (network/conntrack_sweeper.go), which serves every slot waiting at once
+// with one pass, so a flush waits for the sweep in flight when it asked and
+// then for its own. A sweep is normally one raw dump of the whole table
+// (network/conntrack_scan.go) that reads each entry's two addresses in the
+// kernel's wire form: on a Kunpeng 920 host (kernel 6.6) about 4.6ms for
+// walking the 262144 buckets plus about 1us per entry in the table -- 5.3ms
+// at 1000 entries, 25ms at 20000, 44ms at 40000. sweepUsesFilter prices
+// that against the kernel's filtered dumps, two per address, which only
+// win for a lone address in a table of more than about 7000 entries (two
+// addresses cross at about 43000). The namespace half is a few
+// milliseconds under the kernel's conntrack mutex. The conntrack_* keys
+// (recordConntrackReport) say which half and which part a flush spent its
+// time in.
+//
+// None of that work depends on the rollback: it needs the VM to be
+// down, which it is from the pause onwards, and it needs the slot, which
+// nothing else in the freeze touches. So it starts at the pause and the
+// rollback joins it just before the resume, where the wait is normally zero.
+//
+// Starting at the pause rather than at the end widens the gap between "the
+// entries are gone" and "the guest is running again" from under a
+// millisecond to the length of the rollback, 15-30ms. What that gap risks is
+// a host-side packet arriving after the flush and re-creating an entry that
+// disagrees with the guest the rollback is about to restore. Three things
+// keep it small:
+//
+//   - The proxy's connections into this sandbox are already closed before the
+//     pause (Service.beginRestore drops the pool), and a request arriving
+//     while the restore window is open is refused rather than forwarded.
+//   - A conntrack entry is created by the host-side packet alone. Whether the
+//     VM is paused or running changes nothing about the entry that packet
+//     makes -- the guest cannot answer in either case, its reply is only
+//     delayed. So an entry this window lets through is one the same packet
+//     would have created a few milliseconds later anyway, past the resume,
+//     where the old ordering did not protect it either.
+//   - What the window really changes is the fate of packets that are never
+//     retransmitted. A bare ACK from a host-side keep-alive client (the
+//     health and metrics polls, which are not in the proxy's pool) used to be
+//     swept by the flush and now is not. That entry is a loose pickup for a
+//     connection the restored guest has forgotten; the guest answers it with
+//     a RST, which closes it.
+//
+// There is one deliberate change in behaviour: a restore that fails before
+// its commit point resumes the sandbox at its current state, and the flush
+// has by then already happened -- where before it never ran at all. Those
+// paths join before resuming, so the ordering still holds, but the surviving
+// sandbox pays a conntrack flush it did not need.
+type conntrackFlush struct {
+	done chan struct{}
+	err  error
+	took time.Duration
+
+	// own is the flush's breakdown of itself, written by the flush's
+	// goroutine alone and copied into the rollback's at the join.
+	own PhaseTimings
+
+	timings PhaseTimings
+	onErr   func(error)
+	once    sync.Once
+}
+
+// startConntrackFlush runs flush in a goroutine and times it. Everything the
+// goroutine learns -- the error, the duration and the flush's own breakdown
+// -- it leaves in the struct for join to publish; it touches no map but its
+// own. PhaseTimings is a bare map that the rollback is writing to
+// throughout, and a second writer would not be a race the detector shrugs at
+// but a `fatal error: concurrent map writes` that takes the whole
+// orchestrator down. So flush is handed a map of its own to record into,
+// and join copies it over once the flush is done.
+//
+// onErr, when non-nil, is called with the flush's error at the join point
+// instead of here, for the same reason and in the same spirit: a failure is
+// reported on the rollback's own thread of control and in its own order. A
+// failed flush does not fail the restore.
+func startConntrackFlush(timings PhaseTimings, flush func(own PhaseTimings) error, onErr func(error)) *conntrackFlush {
+	f := &conntrackFlush{
+		done:    make(chan struct{}),
+		own:     PhaseTimings{},
+		timings: timings,
+		onErr:   onErr,
+	}
+
+	go func() {
+		defer close(f.done)
+
+		start := time.Now()
+		f.err = flush(f.own)
+		f.took = time.Since(start)
+	}()
+
+	return f
+}
+
+// join waits for the flush to finish and reports its failure. It is safe to
+// call more than once and does its work exactly once, which is what lets the
+// rollback name the join where it matters and still keep a deferred one as a
+// backstop.
+//
+// Both phase keys are written here, on the caller's goroutine, and only
+// after the channel has closed: that is what keeps the one map the rollback
+// records into single-writer.
+//
+// `conntrack` keeps its place in the phase breakdown and its old meaning of
+// "what connection tracking cost the freeze" -- that is now the time spent
+// waiting here, close to zero when the flush fit inside the rollback.
+// `conntrack_bg` is the flush's own duration, which is the number to watch
+// for the host table growing; the `conntrack_*` keys the flush recorded
+// about itself (recordConntrackReport) say which part of it grew.
+func (f *conntrackFlush) join() {
+	f.once.Do(func() {
+		start := time.Now()
+		<-f.done
+		f.timings.Mark("conntrack", start)
+		f.timings.SetUs("conntrack_bg", uint64(f.took.Microseconds()))
+
+		if f.timings != nil {
+			maps.Copy(f.timings, f.own)
+		}
+
+		if f.err != nil && f.onErr != nil {
+			f.onErr(f.err)
+		}
+	})
+}
+
+// recordConntrackReport puts where a flush spent its time into the flush's
+// own breakdown:
+//
+//   - conntrack_ns: the flush of the sandbox's own table.
+//   - conntrack_host_queue: waiting for the host-side sweep in flight when
+//     this one asked to finish, so that a sweep covering it could start.
+//   - conntrack_host_sweep: that sweep, which is shared with everyone in its
+//     batch.
+//   - conntrack_host_batch_count: how many slots the sweep served.
+//   - conntrack_host_entries_count: the host's table size the sweep read.
+//
+// The two halves run side by side, so conntrack_bg is the longer of
+// conntrack_ns and queue plus sweep, not their sum. The host keys are left
+// out when there is no sweep to describe -- the caller gave up on it -- and
+// the entry count when the kernel's could not be read.
+func recordConntrackReport(t PhaseTimings, r network.ConntrackFlushReport) {
+	t.SetUs("conntrack_ns", uint64(r.Namespace.Microseconds()))
+
+	if r.Host.Batch == 0 {
+		return
+	}
+
+	t.SetUs("conntrack_host_queue", uint64(r.Host.Queued.Microseconds()))
+	t.SetUs("conntrack_host_sweep", uint64(r.Host.Sweep.Microseconds()))
+	t.SetCount("conntrack_host_batch_count", uint64(r.Host.Batch))
+
+	if r.Host.Entries >= 0 {
+		t.SetCount("conntrack_host_entries_count", uint64(r.Host.Entries))
+	}
+}
