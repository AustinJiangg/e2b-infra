+// pauseFields describes one pause histogram: what the interval since prev
+// added, and the whole process so far.
+func pauseFields(prefix string, h *metrics.Float64Histogram, prev []uint64) []zap.Field {
+	if h == nil {
+		return []zap.Field{zap.String(prefix, "unavailable")}
+	}
+
+	interval := deltaCounts(h.Counts, prev)
+
+	return []zap.Field{
+		zap.Uint64(prefix+"_count", sum(interval)),
+		zap.Duration(prefix+"_p50", seconds(quantile(interval, h.Buckets, 0.50))),
+		zap.Duration(prefix+"_p99", seconds(quantile(interval, h.Buckets, 0.99))),
+		zap.Duration(prefix+"_max", seconds(maximum(interval, h.Buckets))),
+		zap.Uint64(prefix+"_count_cumulative", sum(h.Counts)),
+		zap.Duration(prefix+"_p99_cumulative", seconds(quantile(h.Counts, h.Buckets, 0.99))),
+		zap.Duration(prefix+"_max_cumulative", seconds(maximum(h.Counts, h.Buckets))),
+	}
+}
+
+func histogram(s metrics.Sample) *metrics.Float64Histogram {
+	if s.Value.Kind() != metrics.KindFloat64Histogram {
+		return nil
+	}
+
+	return s.Value.Float64Histogram()
+}
+
+func cycles(s metrics.Sample) uint64 {
+	if s.Value.Kind() != metrics.KindUint64 {
+		return 0
+	}
+
+	return s.Value.Uint64()
+}
+
+// copyCounts keeps a histogram's counts past the next Read, which may reuse
+// the slice.
+func copyCounts(s metrics.Sample) []uint64 {
+	h := histogram(s)
+	if h == nil {
+		return nil
+	}
+
+	return append([]uint64(nil), h.Counts...)
+}
+
+// deltaCounts is what cur added to prev, bucket by bucket. The runtime keeps
+// a metric's buckets fixed for the life of the process, so the two line up; a
+// prev of a different length (none yet) counts as empty.
+func deltaCounts(cur []uint64, prev []uint64) []uint64 {
+	out := make([]uint64, len(cur))
+	for i, c := range cur {
+		if len(prev) == len(cur) && prev[i] <= c {
+			out[i] = c - prev[i]
+		} else {
+			out[i] = c
+		}
+	}
+
+	return out
+}
+
+func sum(counts []uint64) uint64 {
+	var n uint64
+	for _, c := range counts {
+		n += c
+	}
+
+	return n
+}
+
+// quantile estimates the q-quantile of a histogram, in the unit of its
+// buckets: the upper boundary of the bucket the q-th sample falls in, so the
+// answer is never below the real value. The runtime's time buckets are a
+// fifth of a power of two or finer, which is what the estimate can be off by.
+// A bucket open towards +Inf answers its lower boundary instead. An empty
+// histogram answers 0.
+//
+// buckets has one more element than counts: bucket i is
+// [buckets[i], buckets[i+1]).
+func quantile(counts []uint64, buckets []float64, q float64) float64 {
+	n := sum(counts)
+	if n == 0 || len(buckets) != len(counts)+1 {
+		return 0
+	}
+
+	rank := uint64(math.Ceil(q * float64(n)))
+	rank = max(rank, 1)
+	rank = min(rank, n)
+
+	var seen uint64
+	for i, c := range counts {
+		seen += c
+		if seen >= rank {
+			return bucketValue(buckets, i)
+		}
+	}
+
+	return bucketValue(buckets, len(counts)-1)
+}
+
+// maximum estimates the largest sample the same way quantile does.
+func maximum(counts []uint64, buckets []float64) float64 {
+	if len(buckets) != len(counts)+1 {
+		return 0
+	}
+
+	for i := len(counts) - 1; i >= 0; i-- {
+		if counts[i] > 0 {
+			return bucketValue(buckets, i)
+		}
+	}
+
+	return 0
+}
+
+func bucketValue(buckets []float64, i int) float64 {
+	upper := buckets[i+1]
+	if math.IsInf(upper, 1) {
+		return buckets[i]
+	}
+
+	return upper
+}
+
+func seconds(s float64) time.Duration {
+	if s <= 0 || math.IsInf(s, 0) || math.IsNaN(s) {
+		return 0
+	}
+
+	return time.Duration(s * float64(time.Second))
+}
