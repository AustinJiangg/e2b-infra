 package pool
 
-import "context"
+import (
+	"context"
+	"time"
+)
 
 type destinationContextKey struct{}
 
+type requestStartContextKey struct{}
+
+// WithRequestStart records when a request reached the proxy. The error path
+// needs it: whether an upstream failure is the sandbox's fault or something
+// that happened to the sandbox depends on when the request started, and
+// http.Request does not carry that.
+func WithRequestStart(ctx context.Context, t time.Time) context.Context {
+	return context.WithValue(ctx, requestStartContextKey{}, t)
+}
+
+// RequestStart returns what WithRequestStart recorded, or the zero time.
+func RequestStart(ctx context.Context) time.Time {
+	t, _ := ctx.Value(requestStartContextKey{}).(time.Time)
+
+	return t
+}
+
 func WithDestination(ctx context.Context, d *Destination) context.Context {
 	return context.WithValue(ctx, destinationContextKey{}, d)
 }
