+	// whenever the owner did something to the sandbox under the request, and
+	// the owner is the only one who knows. Returning nil keeps the default
+	// answer, and a nil hook is the old behaviour.
+	//
+	// reqStart is when the request reached the proxy, so the owner can tell
+	// a request that was in flight across such an event from one that came
+	// after it and failed on its own.
+	OnTransportError func(reqStart time.Time, err error) *ErrorAnswer
 }
