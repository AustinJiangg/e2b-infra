--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/blockset.go
@@ -0,0 +1,172 @@
+package block
+
+import (
+	"math/bits"
+	"sync/atomic"
+)
+
+// blockSet is the set of blocks a Cache holds: one bit per block of the
+// device, indexed by block number.
+//
+// It replaces a sync.Map keyed by block offset, which cost a hash insert and
+// an allocation per block and about 120 bytes of heap per block held. A
+// restore reopens every sealed layer of its view and marks every block the
+// layer's sidecar lists, and those lists only grow over a sandbox's life: the
+// guest's ext4 hands out fresh blocks on every rewrite, so the bottom layer of
+// a long-lived view ends up holding most of the device. In a 2 h run of 16
+// sandboxes the time to assemble a view rose with the view's block count at
+// 0.69 ms per thousand blocks (r = 0.995), and the heap the maps kept alive
+// with it. A bit per block is 30 KiB for a 940 MiB rootfs whatever the layer
+// holds, and marking a run of blocks is one atomic OR per 64 of them.
+//
+// Bits are only ever set, never cleared, so each operation is an atomic on
+// one word and nothing needs a lock. An OR that sets a bit is synchronized
+// before any Load that observes it, the same happens-before sync.Map's Store
+// and Load gave: bytes written into the mapping before a block's bit is set
+// are visible to whoever sees the bit (the chunk fetchers write and mark
+// without the cache lock while readers check).
+//
+// The zero value is the empty set over a device of no blocks.
+type blockSet struct {
+	words []atomic.Uint64
+	n     int64
+}
+
+func newBlockSet(n int64) blockSet {
+	if n <= 0 {
+		return blockSet{}
+	}
+
+	return blockSet{words: make([]atomic.Uint64, (n+63)/64), n: n}
+}
+
+// wordMask has bits [from, to) set, for 0 <= from < to <= 64.
+func wordMask(from, to int64) uint64 {
+	return (^uint64(0) >> uint(64-(to-from))) << uint(from)
+}
+
+// has reports whether block i is in the set. A block outside the device is
+// not.
+func (s *blockSet) has(i int64) bool {
+	if i < 0 || i >= s.n {
+		return false
+	}
+
+	return s.words[i/64].Load()&(uint64(1)<<uint(i%64)) != 0
+}
+
+// hasAll reports whether every block in [lo, hi) is in the set. An empty
+// range is; a range reaching outside the device is not.
+func (s *blockSet) hasAll(lo, hi int64) bool {
+	if lo >= hi {
+		return true
+	}
+
+	if lo < 0 || hi > s.n {
+		return false
+	}
+
+	for lo < hi {
+		w := lo / 64
+		end := min(hi, (w+1)*64)
+
+		mask := wordMask(lo-w*64, end-w*64)
+		if s.words[w].Load()&mask != mask {
+			return false
+		}
+
+		lo = end
+	}
+
+	return true
+}
+
+// addRange adds the blocks [lo, hi) to the set. Blocks outside the device
+// are left out: no read can ask about them.
+func (s *blockSet) addRange(lo, hi int64) {
+	lo, hi = max(lo, 0), min(hi, s.n)
+
+	for lo < hi {
+		w := lo / 64
+		end := min(hi, (w+1)*64)
+
+		s.words[w].Or(wordMask(lo-w*64, end-w*64))
+
+		lo = end
+	}
+}
+
+// batch returns a writer that adds ranges to the set with one atomic OR per
+// word it touches in a row, rather than one per range: a sorted block list of
+// scattered single blocks -- the worst case for ranges -- lands several of
+// them in each word, and the OR is what dominates adding one. Nothing added
+// through it is in the set before flush.
+func (s *blockSet) batch() blockSetBatch {
+	return blockSetBatch{s: s, word: -1}
+}
+
+// blockSetBatch accumulates the bits for one word until a range moves on to
+// another word or flush is called.
+type blockSetBatch struct {
+	s    *blockSet
+	word int64
+	mask uint64
+}
+
+// addRange is blockSet.addRange, deferred to the next flush.
+func (b *blockSetBatch) addRange(lo, hi int64) {
+	lo, hi = max(lo, 0), min(hi, b.s.n)
+
+	for lo < hi {
+		w := lo / 64
+		end := min(hi, (w+1)*64)
+
+		if w != b.word {
+			b.flush()
+			b.word = w
+		}
+		b.mask |= wordMask(lo-w*64, end-w*64)
+
+		lo = end
+	}
+}
+
+// flush puts what has been added so far into the set.
+func (b *blockSetBatch) flush() {
+	if b.mask == 0 {
+		return
+	}
+
+	b.s.words[b.word].Or(b.mask)
+	b.mask = 0
+}
+
+// forEach calls f with every block in the set, in ascending order.
+func (s *blockSet) forEach(f func(i int64)) {
+	for w := range s.words {
+		word := s.words[w].Load()
+		for word != 0 {
+			f(int64(w)*64 + int64(bits.TrailingZeros64(word)))
+			word &= word - 1
+		}
+	}
+}
+
+// forEachRun calls f once per run of consecutive blocks in offsets -- each
+// offset exactly blockSize past the one before it -- with the run's first
+// offset and its length in blocks. It is how a sidecar's block list, one
+// offset per block, becomes a few range operations: the lists are sorted and
+// mostly made of runs. Any order is correct; an unsorted list only splits
+// into more runs.
+func forEachRun(offsets []int64, blockSize int64, f func(start, n int64)) {
+	for i := 0; i < len(offsets); {
+		j := i + 1
+		for j < len(offsets) && offsets[j] == offsets[j-1]+blockSize {
+			j++
+		}
+
+		f(offsets[i], int64(j-i))
+
+		i = j
+	}
+}
