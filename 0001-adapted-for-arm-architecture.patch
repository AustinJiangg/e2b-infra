+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/fc"
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// Port is the in-sandbox port the checkpoint API is addressed on. Requests to
+// it are answered by this service on the host instead of being proxied into
+// the sandbox: a checkpoint pauses the VM and drives Firecracker's snapshot
+// API, neither of which anything inside the VM can do.
+const Port uint64 = 49984
+
+const (
+	rpcPrefix   = "/checkpoint.Checkpoint/"
+	healthRoute = "/health"
+
+	createMethod  = "CreateCheckpoint"
+	restoreMethod = "RestoreCheckpoint"
+	listMethod    = "ListCheckpoints"
+	deleteMethod  = "DeleteCheckpoint"
+
+	// trafficAccessTokenHeader mirrors the constant in internal/proxy. The
+	// proxy's own token check sits below the point where checkpoint requests
+	// are intercepted, so this service enforces it itself.
+	trafficAccessTokenHeader = "e2b-traffic-access-token"
+
+	// envdRestoreTimeout bounds waiting for the guest's envd to answer after
+	// a restore, same role as the resume path's envd timeout.
+	//
+	// It has to stay well under the SDK's default request timeout, which is
+	// also 60s. At equal budgets the client always gives up first, so the
+	// caller sees a bare "ReadTimeout: timed out" and the one line that says
+	// what actually happened -- the rollback succeeded, the guest did not come
+	// back -- never reaches them. That is exactly the case where the operator
+	// has the least to go on, and on 950 there is no one to read the logs.
+	//
+	// A healthy restore answers in ~2ms, so 45s is not a real constraint on
+	// the guest; it only decides who reports the failure.
+	envdRestoreTimeout = 45 * time.Second
+
+	// lockWaitEnv bounds how long a create, restore or delete queues behind
+	// another operation on the same sandbox before answering "busy".
+	lockWaitEnv     = "CHECKPOINT_LOCK_WAIT_TIMEOUT"
+	defaultLockWait = 60 * time.Second
+
+	// minFreeEnv overrides how much room the store's filesystem must still
+	// have before a checkpoint is allowed to write into it. 0 disables the
+	// check.
+	minFreeEnv = "CHECKPOINT_MIN_FREE_BYTES"
+	// defaultMinFreeFloor is the floor of the default threshold; the default
+	// is max(this, 2x the sandbox's guest memory). See minFreeBytes.
+	defaultMinFreeFloor int64 = 4 << 30
+)
+
+// lockWaitTimeout is how long an operation waits for the sandbox's lock. The
+// default sits just under the SDK's own request timeout for list and delete
+// so a queued caller hears "busy" from the server rather than timing out
+// with nothing to go on, and well over a healthy create or restore (~100ms),
+// so ordinary contention still just waits its turn.
+func lockWaitTimeout() time.Duration {
+	d, _ := LockWaitTimeout()
+
+	return d
+}
+
+// LockWaitTimeout is lockWaitTimeout with the value's provenance attached,
+// for the startup line that reports what this node is running with. It goes
+// through the same parse the operations do, so the two cannot disagree.
+func LockWaitTimeout() (time.Duration, string) {
+	return durationFromEnv(lockWaitEnv, defaultLockWait)
+}
+
+// durationFromEnv reads a Go duration ("90s", "2m") from the environment. An
+// unparsable value is a misconfiguration, not a reason to run without a
+// timeout, so it falls back and says so -- and reports sourceDefault, since
+// the default is what is in force.
+func durationFromEnv(name string, fallback time.Duration) (time.Duration, string) {
+	raw := os.Getenv(name)
+	if raw == "" {
+		return fallback, sourceDefault
+	}
+
+	d, err := time.ParseDuration(raw)
+	if err != nil || d <= 0 {
+		logger.L().Warn(context.Background(), "ignoring unusable duration in the environment",
+			zap.String("env", name),
+			zap.String("value", raw),
+			zap.Duration("using", fallback))
+
+		return fallback, sourceDefault
+	}
+
+	return d, sourceEnv
+}
+
+// writeBusy answers a caller that queued for the sandbox's lock longer than
+// it is worth queueing. Retry-After is a second: the holder is either about
+// to finish or stuck, and either way another minute of waiting on this
+// connection tells the caller nothing.
+func writeBusy(w http.ResponseWriter, sandboxID string, waited time.Duration) error {
+	w.Header().Set("Retry-After", "1")
+
+	return writeError(w, http.StatusServiceUnavailable, "unavailable", reasonBusy,
+		fmt.Sprintf("another checkpoint operation on sandbox %s is still running after %s; retry", sandboxID, waited))
+}
+
+// writeRestoreFailure answers a restore that failed before the commit point
+// -- the sandbox is still running at its current state -- with the reason
+// the caller can act on. A tree that cannot resolve the restore is the one
+// failure in here that is not the server having a bad day: retrying it costs
+// the caller the same failure and the log the same line, so it gets the same
+// 412 failed_precondition/chain_broken as a checkpoint with no disk view
+// rather than a 500 the caller is invited to retry.
+func writeRestoreFailure(w http.ResponseWriter, checkpointID string, err error) error {
+	if errors.Is(err, ErrChainBroken) {
+		return writeError(w, http.StatusPreconditionFailed, "failed_precondition", reasonChainBroken,
+			fmt.Sprintf("checkpoint %s cannot be restored (the sandbox keeps running at its current state): %s", checkpointID, err))
+	}
+
+	return writeError(w, http.StatusInternalServerError, "internal", reasonInternal,
+		fmt.Sprintf("failed to restore sandbox (it keeps running at its current state): %s", err))
+}
+
+// The reasons an operation can fail with. A Connect code says how the RPC
+// ended, not what the caller has to do next: internal alone covers a guest
+// that never came back, a store that cannot be read and a snapshot that
+// failed, and those call for three different moves. The reason names the
+// outcome, and it rides in the error body as an extra field rather than as a
+// new code because the SDK's decoder reads code and message and ignores what
+// it does not know -- an older SDK keeps working unchanged.
+const (
+	// reasonGuestUnresponsive: the host side of the restore completed and
+	// the guest's envd never answered. The sandbox is rolled back; only the
+	// guest is wedged.
+	reasonGuestUnresponsive = "guest_unresponsive"
+	// reasonTorn: the sandbox is between two moments in time and has to be
+	// destroyed and recreated.
+	reasonTorn = "torn"
+	// reasonChainBroken: the checkpoint tree cannot resolve this restore.
+	reasonChainBroken = "chain_broken"
+	// reasonRootfsPoisoned: the disk-view bookkeeping no longer provably
+	// describes the live stack; a restore repairs it.
+	reasonRootfsPoisoned = "rootfs_poisoned"
+	// reasonNotFound: the sandbox, the checkpoint or the method is not here.
+	reasonNotFound = "not_found"
+	// reasonUnauthenticated: the traffic access token is missing or wrong.
+	reasonUnauthenticated = "unauthenticated"
+	// reasonBusy: another operation holds the sandbox; the caller can retry.
+	reasonBusy = "busy"
+	// reasonInvalidArgument: the request itself is wrong.
+	reasonInvalidArgument = "invalid_argument"
+	// reasonInternal: everything else, and the one a caller cannot act on.
+	reasonInternal = "internal"
+	// reasonDiskFull: the filesystem holding the checkpoint store has less
+	// room left than a checkpoint may need. Deleting checkpoints or freeing
+	// the disk makes the operation possible again.
+	reasonDiskFull = "disk_full"
+	// reasonTooManyCheckpoints: this sandbox is at the per-sandbox limit;
+	// the caller has to delete one before taking another.
+	reasonTooManyCheckpoints = "too_many_checkpoints"
+	// reasonCheckpointBytesLimit: this sandbox's checkpoints occupy as many
+	// bytes as one sandbox may; deleting checkpoints brings it back under.
+	// Its own reason rather than too_many_checkpoints: the caller's move is
+	// the same, but an operator deciding which limit to raise is not.
+	reasonCheckpointBytesLimit = "checkpoint_bytes_limit"
+)
+
+// The two operations the quota gates stand in front of. They name the call
+// on the refusal's log line, where a phrase would be something to read
+// rather than something to count, and the message the caller gets is built
+// from them by operationPhrase.
+const (
+	opCreate  = "create"
+	opRestore = "restore"
+)
+
+// operationPhrase reads an operation name back as the verb phrase the
+// refusal message is written with.
+func operationPhrase(operation string) string {
+	if operation == opRestore {
+		return "restore a checkpoint"
+	}
+
+	return "take a checkpoint"
+}
+
+// refusedMessage is the one message every quota refusal is logged under.
+// The gates answer with an HTTP body and nothing else reaches the node's
+// logs -- writeError deliberately stays quiet, because the 4xx answers this
+// service gives on purpose (a busy sandbox, a checkpoint that is not there)
+// would drown the ones worth reading -- so the two gates that refuse work on
+// a resource the operator controls log it themselves, under one message with
+// a reason field, so a single query counts both.
+const refusedMessage = "refused a checkpoint operation"
+
+// errGuestUnresponsive marks the one restore failure that leaves the host
+// side done and the guest wedged, so the handler can report it as such.
+var errGuestUnresponsive = errors.New("the guest never answered after the rollback")
+
+type Service struct {
+	store     *Store
+	sandboxes *sandbox.Map
+
+	dropConnections func(connectionKey string) error
+
+	// torn maps a sandbox id to the generation a restore left between two
+	// moments in time. It is in memory only: a torn sandbox is going to be
+	// destroyed, and an orchestrator restart destroys it anyway.
+	//
+	// The generation is recorded rather than just the id because the id can
+	// come back: e2b's pause/resume gives the same sandbox a new Firecracker
+	// process, and a mark left by the process before it would refuse every
+	// checkpoint of a sandbox that has nothing wrong with it.
+	tornMu sync.Mutex
+	torn   map[string]string
+
+	// restoring is when each sandbox was last rolled back. The proxy reads
+	// it to tell a request that died because the guest it was talking to
+	// forgot the connection from one that died because the service inside
+	// the sandbox is broken -- indistinguishable from the transport error
+	// alone, and the two call for opposite reactions.
+	restoringMu sync.Mutex
+	restoring   map[string]restoreWindow
+
+	// smallByteLimitWarned records, per sandbox id, the generation already
+	// warned that the byte limit is too small for its guest (see
+	// warnIfByteLimitTooSmall), so the warning is said once per sandbox.
+	smallByteLimitWarned sync.Map
+}
+
+// restoreWindow is one sandbox's restore history, which is all the proxy
+// needs: whether a restore owns it right now, and when the last one ended.
+type restoreWindow struct {
+	active bool
+	since  time.Time
+	until  time.Time
+}
+
+func NewService(store *Store, sandboxes *sandbox.Map) *Service {
+	// Said once, loudly: a node running with faults armed fails checkpoints
+	// on purpose, and nothing else in the logs would explain why.
+	if faults := faultsEnabled(); len(faults.faults) > 0 {
+		logger.L().Warn(context.Background(), "checkpoint fault injection is armed; these operations will fail on purpose",
+			zap.String("env", faultEnv),
+			zap.Strings("faults", faults.armed()))
+
+		if len(faults.warnings) > 0 {
+			logger.L().Warn(context.Background(), "checkpoint fault injection could not read part of its spec",
+				zap.String("env", faultEnv),
+				zap.Strings("warnings", faults.warnings))
+		}
+	}
+
+	// The store decides who owns a sandbox id by asking which generation of
+	// it the node is running; this is where it is given something to ask.
+	// A nil map is a service assembled without one (tests), and a typed nil
+	// behind the interface would answer with a panic instead of a "no".
+	if sandboxes != nil {
+		store.SetGenerations(sandboxes)
+	}
+
+	return &Service{
+		store:     store,
+		sandboxes: sandboxes,
+		torn:      make(map[string]string),
+		restoring: make(map[string]restoreWindow),
+	}
+}
+
+// SetConnectionDropper hands the service a way to throw away pooled
+// connections to a sandbox. A restore rolls the guest's TCP state back, so
+// connections held open across it are talking to a peer that has forgotten
+// them and have to go -- as early as possible, see beginRestore.
+func (s *Service) SetConnectionDropper(drop func(connectionKey string) error) {
+	s.dropConnections = drop
+}
+
+// OnInsert implements sandbox.MapSubscriber. A sandbox arriving under an id
+// this node has seen before is e2b's pause/resume putting a new Firecracker
+// process behind an old id, and this hands the id to it: the previous
+// generation's checkpoints are dropped (they diff against memory and a disk
+// stack that no longer exist) and so are the marks left on the id -- a restore
+// window that belongs to a process that is gone, and a torn mark the new
+// sandbox did not earn.
+//
+// Nothing depends on this running before the new sandbox's first request:
+// inserts are announced on their own goroutine, so the store does the same
+// handover on its own when a request gets there first. What it adds is that
+// the old generation's files go even if the new sandbox never checkpoints.
+//
+// It takes the sandbox's operation lock for the same reason OnRemove does: the
+// files it drops are the ones an operation of the previous generation may
+// still be reading.
+func (s *Service) OnInsert(sbx *sandbox.Sandbox) {
+	if sbx == nil || sbx.LifecycleID == "" {
+		return
+	}
+
+	sandboxID := sbx.Runtime.SandboxID
+
+	unlock, locked := s.store.LockSandboxWithin(sandboxID, lockWaitTimeout())
+	if locked {
+		defer unlock()
+	} else {
+		logger.L().Warn(context.Background(), "a sandbox arrived while a checkpoint operation on its id was still running",
+			logger.WithSandboxID(sandboxID),
+			zap.Duration("waited", lockWaitTimeout()))
+	}
+
+	if !s.store.AdoptSandbox(sandboxID, sbx.LifecycleID) {
+		return
+	}
+
+	s.forgetMarks(sandboxID)
+}
+
+// OnRemove implements sandbox.MapSubscriber. Checkpoints are host-local state
+// with the Firecracker process's lifetime, so they go with it.
+//
+// It waits for whatever is in flight on the sandbox first. The removal is a
+// recursive delete of the very files a restore is reading: the snapshot, the
+// diffs of every checkpoint, the sealed layers. Pulling them out from under
+// a rollback that is past its commit point is how a kill turns into a torn
+// sandbox and a half-written guest. The wait is bounded like every other
+// one, and an operation that outlasts it is one nobody can wait for anyway
+// -- the sandbox is going away regardless.
+//
+// That wait is also why nothing is touched before it: a removal can be minutes
+// late, and by then a resume can have put a new generation behind the same id.
+// The store says whether the removal still applies, and everything this does
+// -- the files, the restore window, the torn mark -- hangs off that answer, so
+// a late removal cannot take the new sandbox's state down with the old one's.
+//
+// This runs on its own goroutine (sandbox.Map triggers subscribers with go),
+// so taking the lock here cannot deadlock the map.
+func (s *Service) OnRemove(sandboxID string) {
+	unlock, locked := s.store.LockSandboxWithin(sandboxID, lockWaitTimeout())
+	if locked {
+		defer unlock()
+	} else {
+		logger.L().Warn(context.Background(), "removing a sandbox whose checkpoint operation is still running",
+			logger.WithSandboxID(sandboxID),
+			zap.Duration("waited", lockWaitTimeout()))
+	}
+
+	applied, err := s.store.RemoveSandbox(sandboxID)
+	if err != nil {
+		logger.L().Warn(context.Background(), "failed to remove sandbox checkpoints",
+			logger.WithSandboxID(sandboxID),
+			zap.Error(err))
+	}
+
+	if !applied {
+		logger.L().Info(context.Background(), "a newer generation of this sandbox owns its checkpoints; leaving them alone",
+			logger.WithSandboxID(sandboxID))
+
+		return
+	}
+
+	s.forgetMarks(sandboxID)
+}
+
+// forgetMarks drops the in-memory marks a sandbox id carries: the restore
+// window the proxy reads and the torn mark that refuses checkpoints. Both
+// describe one Firecracker process, so they go when it does and again when
+// another one takes the id over.
+func (s *Service) forgetMarks(sandboxID string) {
+	s.smallByteLimitWarned.Delete(sandboxID)
+
+	s.tornMu.Lock()
+	delete(s.torn, sandboxID)
+	s.tornMu.Unlock()
+
+	s.restoringMu.Lock()
+	delete(s.restoring, sandboxID)
+	s.restoringMu.Unlock()
+}
+
+// Handles reports whether this service answers the request instead of the
+// sandbox behind it: the checkpoint RPCs and the daemon health probe the SDK
+// uses for is_running.
+func Handles(port uint64, path string) bool {
+	return port == Port && (path == healthRoute || strings.HasPrefix(path, rpcPrefix))
+}
+
+func (s *Service) ServeCheckpoint(w http.ResponseWriter, r *http.Request, sandboxID string) {
+	sbx, ok := s.sandboxes.Get(sandboxID)
+	if !ok {
+		writeError(w, http.StatusNotFound, "not_found", reasonNotFound, fmt.Sprintf("sandbox %s not found", sandboxID))
+
+		return
+	}
+
+	// The proxy validates the traffic access token below the point where this
+	// service intercepts, so the same check happens here.
+	if err := authorize(r, sbx); err != nil {
+		writeError(w, http.StatusUnauthorized, "unauthenticated", reasonUnauthenticated, err.Error())
+
+		return
+	}
+
+	if r.URL.Path == healthRoute {
+		writeJSON(w, map[string]any{"status": "ok"})
+
+		return
+	}
+
+	var (
+		err       error
+		stats     = &callStats{}
+		operation = r.URL.Path[len(rpcPrefix):]
+		start     = time.Now()
+	)
+
+	switch operation {
+	case createMethod:
+		operation = "create"
+		err = s.create(w, r, sbx, stats)
+	case restoreMethod:
+		operation = "restore"
+		err = s.restore(w, r, sbx, stats)
+	case listMethod:
+		operation = "list"
+		err = s.list(w, sbx)
+	case deleteMethod:
+		operation = "delete"
+		err = s.delete(w, r, sbx)
+	default:
+		writeError(w, http.StatusNotFound, "unimplemented", reasonNotFound, fmt.Sprintf("unknown method %s", r.URL.Path))
+
+		return
+	}
+
+	// The request context is gone by the time a create or restore finishes
+	// its own work, so the operation's own context carries the measurement.
+	record(context.WithoutCancel(r.Context()), operation, start, err, stats)
+}
+
+func authorize(r *http.Request, sbx *sandbox.Sandbox) error {
+	net := sbx.Config.Network
+	if net == nil || net.GetIngress() == nil || net.GetIngress().TrafficAccessToken == nil {
+		return nil
+	}
+
+	raw := r.Header.Get(trafficAccessTokenHeader)
+	if raw == "" {
+		return fmt.Errorf("missing %s header", trafficAccessTokenHeader)
+	}
+	if raw != *net.GetIngress().TrafficAccessToken {
+		return fmt.Errorf("invalid traffic access token")
+	}
+
+	return nil
+}
+
+// create takes a checkpoint: memory as a sparse diff holding only the pages
+// this epoch dirtied (Firecracker writes them straight into a fresh file —
+// no base is cloned, so the cost is O(dirty pages) on any filesystem), disk
+// as a sealed write layer, both under one pause of the VM.
+//
+// The checkpoint that roots a sandbox's tree captures full memory instead,
+// so the tree resolves every page from its own files. See fullRootEnabled.
+// fullRootEnabled reports whether the checkpoint that roots a sandbox's tree
+// captures full memory (the default). A full root makes the tree resolve
+// every page from its own files, at the cost of one full-memory write and
+// guest-memory-sized storage on the sandbox's first checkpoint.
+//
+// Turning it off (CHECKPOINT_FULL_ROOT=false) makes that first checkpoint as
+// cheap as every other one and saves the storage, but roots the tree on a
+// diff against the sandbox's start memory source: restores then resolve
+// pages that predate every checkpoint from the template memfile, which on a
+// cluster means reaching the object store during a rollback.
+func fullRootEnabled() bool {
+	switch os.Getenv("CHECKPOINT_FULL_ROOT") {
+	case "", "true", "1":
+		return true
+	default:
+		return false
+	}
+}
+
+func (s *Service) create(w http.ResponseWriter, r *http.Request, sbx *sandbox.Sandbox, stats *callStats) error {
+	// The VM is paused partway through. A client that gives up on the request
+	// must not leave it that way, so the work is not tied to the request.
+	ctx := context.WithoutCancel(r.Context())
+
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return writeError(w, http.StatusBadRequest, "invalid_argument", reasonInvalidArgument, fmt.Sprintf("failed to read request: %s", err))
+	}
+
+	var req struct {
+		Name string `json:"name"`
+	}
+	// An empty body is a valid request with no name set.
+	if len(body) > 0 {
+		if err := json.Unmarshal(body, &req); err != nil {
+			return writeError(w, http.StatusBadRequest, "invalid_argument", reasonInvalidArgument, fmt.Sprintf("failed to parse request: %s", err))
+		}
+	}
+
+	sandboxID := sbx.Runtime.SandboxID
+
+	if err := s.refuseIfTorn(w, sbx); err != nil {
+		return err
+	}
+
+	timings := sandbox.PhaseTimings{}
+	opStart := time.Now()
+
+	// The breakdown of a create that failed is the one worth having, and it
+	// used to be written only on the way out through success -- so the calls
+	// that took 45 seconds and then failed left no numbers at all. The
+	// entry's directory can already be gone by the time this runs (a
+	// discarded entry takes it with it), so the log carries the same numbers
+	// as the file.
+	var entry *Entry
+	succeeded := false
+
+	defer func() {
+		if succeeded {
+			return
+		}
+
+		timings.Mark("total", opStart)
+		if entry != nil {
+			writeTimings(filepath.Join(entry.Dir, "timings.json"), timings)
+		}
+
+		logger.L().Warn(ctx, "checkpoint create failed",
+			logger.WithSandboxID(sandboxID),
+			zap.Any("timings_ms", map[string]float64(timings)))
+	}()
+
+	unlock, locked := s.store.LockSandboxWithin(sandboxID, lockWaitTimeout())
+	if !locked {
+		return writeBusy(w, sandboxID, lockWaitTimeout())
+	}
+
+	defer unlock()
+
+	if err := s.refuseIfGone(w, sbx); err != nil {
+		return err
+	}
+
+	// Under the lock, so two creates on the same sandbox cannot both see the
+	// same free space and then both write into it.
+	if err := s.refuseIfDiskFull(ctx, w, sbx, opCreate); err != nil {
+		return err
+	}
+
+	// The diff is relative to the tree parent: the previous checkpoint, or
+	// the restore target after a rollback. A checkpoint with no parent roots
+	// a tree and captures full memory instead — as does any checkpoint taken
+	// without dirty tracking or on a broken chain, which roots a fresh
+	// subtree because nothing links it to what came before.
+	parentID, broken := s.store.BaseState(sandboxID)
+	rooting := parentID == "" && fullRootEnabled()
+	diff := fc.TrackDirtyPagesEnabled() && !broken && !rooting
+
+	if !fc.TrackDirtyPagesEnabled() {
+		logger.L().Warn(ctx, "dirty page tracking is off; every checkpoint captures full memory",
+			logger.WithSandboxID(sandboxID))
+	} else if broken {
+		logger.L().Warn(ctx, "incremental chain is broken; capturing full memory as a new root",
+			logger.WithSandboxID(sandboxID))
+	} else if rooting {
+		logger.L().Info(ctx, "rooting the checkpoint tree with a full memory capture",
+			logger.WithSandboxID(sandboxID))
+	}
+
+	memMode := MemModeIncremental
+	if !diff {
+		memMode = MemModeFull
+		parentID = ""
+	}
+	stats.set("mem_mode", memMode)
+
+	s.warnIfByteLimitTooSmall(ctx, sbx)
+
+	prepareStart := time.Now()
+	entry, err = s.store.Prepare(sandboxID, sbx.LifecycleID, req.Name, parentID, timings)
+	timings.Mark("prepare", prepareStart)
+	if err != nil {
+		if errors.Is(err, ErrSandboxRemoved) {
+			return writeError(w, http.StatusNotFound, "not_found", reasonNotFound, fmt.Sprintf("sandbox %s is gone: %s", sandboxID, err))
+		}
+
+		// 429 rather than 507: nothing is exhausted on the node, this
+		// sandbox has simply used up the allowance it was given.
+		if errors.Is(err, ErrTooManyCheckpoints) {
+			return refuseTooManyCheckpoints(ctx, w, sandboxID, err)
+		}
+
+		if errors.Is(err, ErrCheckpointBytesLimit) {
+			return refuseCheckpointBytesLimit(ctx, w, sandboxID, sbx.Config.RamMB<<20, err)
+		}
+
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to prepare checkpoint: %s", err))
+	}
+
+	layersDir, err := s.store.LayersDir(sandboxID, sbx.LifecycleID)
+	if err != nil {
+		s.store.Discard(entry)
+
+		if errors.Is(err, ErrSandboxRemoved) {
+			return writeError(w, http.StatusNotFound, "not_found", reasonNotFound, fmt.Sprintf("sandbox %s is gone: %s", sandboxID, err))
+		}
+
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to prepare layers dir: %s", err))
+	}
+
+	// The base header seeds the disk bookkeeping on the sandbox's first
+	// checkpoint; later ones ignore it.
+	headerStart := time.Now()
+	baseHeader, err := sbx.RootfsHeader()
+	timings.Mark("rootfs_header", headerStart)
+	if err != nil {
+		s.store.Discard(entry)
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to get rootfs header: %s", err))
+	}
+
+	layerID := uuid.New()
+	sealedLayerPath := filepath.Join(layersDir, "layer-"+layerID.String())
+
+	snapStart := time.Now()
+	epochAdvanced, sealed, err := sbx.CheckpointToFiles(ctx, entry.TempSnapfile(), entry.TempMemDiff(), entry.TempMemBitmap(), diff, sealedLayerPath, timings)
+	timings.Mark("checkpoint_to_files", snapStart)
+	if err == nil && faultInjected(faultSealMove) {
+		// Same post-condition as a real failed move: the snapshot is
+		// written, so the epoch advanced, and nothing has recorded the layer
+		// the live stack is already reading.
+		err = injectedError(faultSealMove, "the sealed layer never reached the store")
+	}
+	if err != nil {
+		// Nothing has recorded the layer yet: AppendLayer is the next call
+		// and this never reaches it.
+		s.failCreate(ctx, entry, memMode, epochAdvanced, false, sealedLayerPath, timings)
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to snapshot sandbox: %s", err))
+	}
+
+	appendStart := time.Now()
+	rootfsView, err := s.store.AppendLayer(sandboxID, baseHeader, layerID, sealed, entry.RootfsHeaderPath(), timings)
+	timings.Mark("append_layer", appendStart)
+	if err != nil {
+		s.failCreate(ctx, entry, memMode, epochAdvanced, true, "", timings)
+
+		// A poisoned rootfs is the one create failure a caller can do
+		// something about: a restore reseeds the bookkeeping and
+		// checkpoints work again.
+		reason := reasonInternal
+		if errors.Is(err, ErrRootfsPoisoned) {
+			reason = reasonRootfsPoisoned
+		}
+
+		return writeError(w, http.StatusInternalServerError, "internal", reason, fmt.Sprintf("failed to record rootfs layer: %s", err))
+	}
+
+	commitStart := time.Now()
+	err = s.store.Commit(entry, memMode, rootfsView, timings)
+	timings.Mark("commit", commitStart)
+	if err != nil {
+		s.failCreate(ctx, entry, memMode, epochAdvanced, true, "", timings)
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to record checkpoint: %s", err))
+	}
+
+	succeeded = true
+
+	timings.Mark("total", opStart)
+	writeTimings(filepath.Join(entry.Dir, "timings.json"), timings)
+
+	logger.L().Info(ctx, "created checkpoint",
+		logger.WithSandboxID(sandboxID),
+		zap.String("checkpoint_id", entry.ID),
+		zap.String("mem_mode", memMode),
+		zap.Any("timings_ms", map[string]float64(timings)),
+		zap.String("parent_id", entry.ParentID),
+		zap.Int64("sandbox_checkpoint_bytes", s.store.UsedBytes(sandboxID)))
+
+	// memMode is reported so a caller can tell an incremental checkpoint from
+	// a full one. A full checkpoint on anything but a sandbox's first is what
+	// happens when the host is not tracking dirty pages: it costs one guest
+	// memory copy every time and is otherwise completely silent.
+	writeJSON(w, map[string]any{"checkpointId": entry.ID, "memMode": memMode})
+
+	return nil
+}
+
+// failCreate cleans up a failed checkpoint. When the Firecracker snapshot
+// itself succeeded the epoch has advanced: the temp diff holds the only copy
+// of that epoch's pages, so the entry is committed hidden and the tree stays
+// sound. If even that fails, the chain is marked broken — the next
+// checkpoint captures full memory as a new root, and restores are refused
+// until it does, because an incomplete revert would be silent corruption.
+//
+// layerRecorded says whether AppendLayer got its chance at the sealed layer,
+// and with it the chance to poison itself. sealedLayerPath is where the layer
+// was to be sealed, for the case it did not: the live stack may be reading
+// it with nothing in the bookkeeping listing it, and it is left to the
+// restore that replaces the stack to reclaim (rootfsState.unrecorded). A seal
+// that never happened leaves nothing there, which costs nothing to try to
+// delete. timings is the failed create's
+// own breakdown: the rescue publishes under the global lock like any commit,
+// and a create that failed slowly is worth being able to read.
+func (s *Service) failCreate(ctx context.Context, entry *Entry, memMode string, epochAdvanced bool, layerRecorded bool, sealedLayerPath string, timings sandbox.PhaseTimings) {
+	if epochAdvanced && !layerRecorded {
+		// The snapshot was written, so the failure is at or after the seal --
+		// and sealing swaps the write cache into the live read stack before
+		// anything that can fail afterwards. Either the swap never happened
+		// or it happened and nothing recorded it; from here the two are
+		// indistinguishable, and if it is the second one the bookkeeping is
+		// missing a layer the sandbox is already reading. A later merged
+		// header would then resolve those blocks to the template and a
+		// restore would serve stale disk content without a word.
+		s.store.PoisonRootfs(entry.SandboxID, sealedLayerPath)
+
+		logger.L().Error(ctx, "sealing the write layer failed; checkpoints are refused until a restore reseeds the rootfs bookkeeping",
+			logger.WithSandboxID(entry.SandboxID),
+			zap.String("checkpoint_id", entry.ID))
+	}
+
+	if epochAdvanced {
+		if err := s.store.CommitHidden(entry, memMode, timings); err != nil {
+			s.store.InvalidateBase(entry.SandboxID)
+
+			logger.L().Error(ctx, "failed to keep the advanced epoch; chain broken until a full checkpoint",
+				logger.WithSandboxID(entry.SandboxID),
+				zap.Error(err))
+
+			s.store.Discard(entry)
+		}
+
+		return
+	}
+
+	s.store.Discard(entry)
+}
+
+// markTorn records that a restore left the sandbox between two moments in
+// time, and takes the checkpoint tree down with it: the memory base and the
+// disk bookkeeping both describe a state the guest has already left, and
+// nothing can tell how much of the target actually landed.
+//
+// The VM stays paused on purpose. It holds whatever the rollback managed to
+// write, which is the only material a post-mortem has; resuming it would let
+// a guest that is half at one moment and half at another write to its disk.
+// Destroying the sandbox is the caller's move, and until it happens this
+// service answers every create and restore for it with data_loss instead of
+// operating on state it cannot describe.
+func (s *Service) markTorn(ctx context.Context, sbx *sandbox.Sandbox) {
+	sandboxID := sbx.Runtime.SandboxID
+
+	s.store.InvalidateBase(sandboxID)
+	s.store.PoisonRootfs(sandboxID)
+
+	s.tornMu.Lock()
+	s.torn[sandboxID] = sbx.LifecycleID
+	s.tornMu.Unlock()
+
+	logger.L().Error(ctx, "restore failed past the commit point; the sandbox is torn and must be recreated",
+		logger.WithSandboxID(sandboxID))
+}
+
+// refuseIfGone answers a create or restore whose sandbox is no longer the
+// one this node is running, and reports whether it did.
+//
+// Admission happens before the lock: a request can queue for a minute behind
+// another operation, and in that time the sandbox can be killed, or paused
+// and resumed into a new Firecracker process that shares nothing with the
+// one this request was admitted for. Checking the map again under the lock
+// is what keeps the operation from being carried out on a sandbox that is
+// not there -- rebuilding its directories on the way, which nothing would
+// ever clean up.
+//
+// LifecycleID, not the id alone: it changes with every Firecracker process,
+// so it catches the replacement as well as the disappearance.
+func (s *Service) refuseIfGone(w http.ResponseWriter, sbx *sandbox.Sandbox) error {
+	if s.sandboxes == nil {
+		return nil
+	}
+
+	sandboxID := sbx.Runtime.SandboxID
+
+	current, ok := s.sandboxes.Get(sandboxID)
+	if ok && current.LifecycleID == sbx.LifecycleID {
+		return nil
+	}
+
+	return writeError(w, http.StatusNotFound, "not_found", reasonNotFound,
+		fmt.Sprintf("sandbox %s is no longer running on this node", sandboxID))
+}
+
+// diskFree reports the bytes still usable on the filesystem at path. It is a
+// variable so a test can put the store on a disk that is about to fill up
+// without having to fill one up.
+var diskFree = func(path string) (int64, error) {
+	var st unix.Statfs_t
+	if err := unix.Statfs(path, &st); err != nil {
+		return 0, fmt.Errorf("failed to stat the filesystem at %s: %w", path, err)
+	}
+
+	// Bavail, not Bfree: the reserved blocks are not ours to write into.
+	return int64(st.Bavail) * int64(st.Bsize), nil
+}
+
+// minFreeBytes is how much room the store's filesystem must still have for a
+// checkpoint to be allowed to start, with the value's provenance attached.
+//
+// The default is max(4 GiB, 2x guest memory). A checkpoint that roots a tree
+// writes the whole of guest memory, and a restore materializes a revert set
+// that can be just as large, so one operation can be the size of the guest;
+// twice that leaves room for the one after it and for the sandbox's own disk
+// writes, which land on the same filesystem. Sandboxes smaller than 2 GiB
+// get the 4 GiB floor instead, because the rootfs layers and the sandbox's
+// own writes do not shrink with guest memory.
+//
+// guestMemBytes is 0 when the caller has no sandbox to ask (the startup
+// capabilities line), which just leaves the floor.
+func minFreeBytes(guestMemBytes int64) (int64, string) {
+	if raw := os.Getenv(minFreeEnv); raw != "" {
+		v, err := strconv.ParseInt(raw, 10, 64)
+		if err != nil || v < 0 {
+			logger.L().Warn(context.Background(), "ignoring unusable byte count in the environment",
+				zap.String("env", minFreeEnv),
+				zap.String("value", raw))
+		} else {
+			return v, sourceEnv
+		}
+	}
+
+	return max(defaultMinFreeFloor, 2*guestMemBytes), sourceDefault
+}
+
+// refuseIfDiskFull answers a create or restore that the store's filesystem
+// has no room for, and reports whether it did.
+//
+// Refusing early is the difference between a failed call and a dead node.
+// Writing a snapshot into a filesystem with nothing left gives Firecracker
+// ENOSPC -- a checkpoint that fails, which is fine -- but it also gives
+// every sandbox on the node writes into sparse mappings the kernel cannot
+// back, which is a fault in an mmap (see block.guardMmapFault) and used to
+// be the end of the orchestrator. The floor is deliberately generous: this
+// is a resource the whole node shares, and the caller can act on the answer.
+//
+// A statfs that fails is not itself a reason to refuse work -- it says
+// nothing about the free space -- so it is logged and the operation runs.
+//
+// operation is opCreate or opRestore: it names the call in the log line and
+// picks the verb the message reads with.
+func (s *Service) refuseIfDiskFull(ctx context.Context, w http.ResponseWriter, sbx *sandbox.Sandbox, operation string) error {
+	var guestMem int64
+
+	var sandboxID string
+
+	if sbx != nil {
+		guestMem = sbx.Config.RamMB << 20
+		sandboxID = sbx.Runtime.SandboxID
+	}
+
+	need, source := minFreeBytes(guestMem)
+	if need == 0 {
+		return nil
+	}
+
+	free, err := diskFree(s.store.Root())
+	if err != nil {
+		logger.L().Warn(ctx, "could not measure the free space of the checkpoint store",
+			zap.String("store", s.store.Root()),
+			zap.Error(err))
+
+		return nil
+	}
+
+	if free >= need {
+		return nil
+	}
+
+	logger.L().Warn(ctx, refusedMessage,
+		logger.WithSandboxID(sandboxID),
+		zap.String("reason", reasonDiskFull),
+		zap.String("operation", operation),
+		zap.String("store", s.store.Root()),
+		zap.Int64("free_bytes", free),
+		zap.Int64("min_free_bytes", need),
+		zap.String("min_free_bytes_source", source))
+
+	return writeError(w, http.StatusInsufficientStorage, "resource_exhausted", reasonDiskFull,
+		fmt.Sprintf("refusing to %s: the checkpoint store at %s has %d bytes free, below the %d bytes this node keeps in reserve (%s); free disk space or delete checkpoints and retry",
+			operationPhrase(operation), s.store.Root(), free, need, source))
+}
+
+// refuseTooManyCheckpoints answers a create the sandbox has no allowance
+// left for, and logs the two numbers the limit was decided on. The store
+// reports the limit as an error because the caller's next move -- delete a
+// checkpoint -- is in the sentence; the node's own record of the refusal is
+// this line, and it carries the counts as fields so they can be counted
+// rather than read.
+func refuseTooManyCheckpoints(ctx context.Context, w http.ResponseWriter, sandboxID string, err error) error {
+	fields := []zap.Field{
+		logger.WithSandboxID(sandboxID),
+		zap.String("reason", reasonTooManyCheckpoints),
+		zap.String("operation", opCreate),
+	}
+
+	var limit *TooManyCheckpointsError
+	if errors.As(err, &limit) {
+		fields = append(fields,
+			zap.Int("checkpoints_held", limit.Held),
+			zap.Int("max_checkpoints_per_sandbox", limit.Limit))
+	}
+
+	logger.L().Warn(ctx, refusedMessage, fields...)
+
+	return writeError(w, http.StatusTooManyRequests, "resource_exhausted", reasonTooManyCheckpoints, err.Error())
+}
+
+// refuseCheckpointBytesLimit answers a create the sandbox has no room left
+// for under the byte limit, the same way refuseTooManyCheckpoints answers the
+// count: 429, a sentence that says which checkpoints to delete, and the
+// numbers on the node's own log line.
+//
+// guestMemBytes stands in for the sandbox's floor when the store could not
+// find a full root on the base's chain (see floorFromGuestMemory); 0 leaves
+// the floor unknown.
+func refuseCheckpointBytesLimit(ctx context.Context, w http.ResponseWriter, sandboxID string, guestMemBytes int64, err error) error {
+	fields := []zap.Field{
+		logger.WithSandboxID(sandboxID),
+		zap.String("reason", reasonCheckpointBytesLimit),
+		zap.String("operation", opCreate),
+	}
+
+	var limit *CheckpointBytesLimitError
+	if errors.As(err, &limit) {
+		if limit.FloorBytes <= 0 && guestMemBytes > 0 {
+			limit.FloorBytes, limit.FloorSource = guestMemBytes, floorFromGuestMemory
+		}
+
+		fields = append(fields,
+			zap.Int64("checkpoint_bytes_held", limit.Used),
+			zap.Int64("max_checkpoint_bytes_per_sandbox", limit.Limit),
+			zap.String("base_checkpoint_id", limit.BaseID),
+			zap.Int64("floor_bytes", limit.FloorBytes),
+			zap.String("floor_bytes_source", limit.FloorSource))
+	}
+
+	logger.L().Warn(ctx, refusedMessage, fields...)
+
+	return writeError(w, http.StatusTooManyRequests, "resource_exhausted", reasonCheckpointBytesLimit, err.Error())
+}
+
+// The two things warnIfByteLimitTooSmall says, by how bad the limit is.
+const (
+	// byteLimitStuckMessage: limit < guest memory + byteLimitOverhead.
+	byteLimitStuckMessage = "the checkpoint byte limit is below this sandbox's guest memory plus overhead; " +
+		"it cannot hold even the one checkpoint the sandbox runs from, and once at the limit no delete brings it back under"
+	// byteLimitTightMessage: limit < 2 x guest memory + byteLimitOverhead.
+	byteLimitTightMessage = "the checkpoint byte limit is below twice this sandbox's guest memory plus overhead; " +
+		"under a worst-case load (every checkpoint rewriting all of memory) keeping one earlier restore point can leave it stuck at the limit"
+)
+
+// warnIfByteLimitTooSmall says, once per sandbox generation, that the byte
+// limit is too small for the sandbox's guest, at one of two levels (the
+// thresholds are derived at byteLimitOverhead):
+//
+//   - an error under guest memory + overhead: the base alone, folded into a
+//     full root, does not fit, so a sandbox that reaches the limit stays
+//     refused whatever it deletes;
+//   - a warning under 2 x guest memory + overhead: under a worst-case load a
+//     sandbox that keeps one earlier restore point can get stuck.
+//
+// Both are configuration mistakes the refusals alone would not explain. It
+// cannot be said at startup: the limit is per node, the guest size per
+// sandbox.
+func (s *Service) warnIfByteLimitTooSmall(ctx context.Context, sbx *sandbox.Sandbox) {
+	limit := s.store.maxBytesPerSandbox
+	if limit <= 0 || sbx == nil {
+		return
+	}
+
+	guestMem := sbx.Config.RamMB << 20
+	if guestMem <= 0 || limit >= 2*guestMem+byteLimitOverhead {
+		return
+	}
+
+	if prev, seen := s.smallByteLimitWarned.Swap(sbx.Runtime.SandboxID, sbx.LifecycleID); seen && prev == sbx.LifecycleID {
+		return
+	}
+
+	fields := []zap.Field{
+		logger.WithSandboxID(sbx.Runtime.SandboxID),
+		zap.String("env", maxBytesPerSandboxEnv),
+		zap.Int64("max_checkpoint_bytes_per_sandbox", limit),
+		zap.Int64("guest_memory_bytes", guestMem),
+		zap.Int64("overhead_bytes", byteLimitOverhead),
+		zap.Int64("recommended_min_bytes", 2*guestMem+byteLimitOverhead),
+	}
+
+	if limit < guestMem+byteLimitOverhead {
+		logger.L().Error(ctx, byteLimitStuckMessage, fields...)
+
+		return
+	}
+
+	logger.L().Warn(ctx, byteLimitTightMessage, fields...)
+}
+
+// refuseIfTorn answers a create or restore on a torn sandbox, and reports
+// whether it did. Listing and deleting checkpoints stay available: they only
+// read the tree, which is what an operator has left to look at.
+//
+// The mark is matched against the caller's generation: a torn Firecracker
+// process condemns itself, not the sandbox id, and a process that replaced it
+// starts clean.
+func (s *Service) refuseIfTorn(w http.ResponseWriter, sbx *sandbox.Sandbox) error {
+	sandboxID := sbx.Runtime.SandboxID
+
+	s.tornMu.Lock()
+	marked, torn := s.torn[sandboxID]
+	s.tornMu.Unlock()
+
+	if !torn || marked != sbx.LifecycleID {
+		return nil
+	}
+
+	return writeError(w, http.StatusInternalServerError, "data_loss", reasonTorn,
+		fmt.Sprintf("sandbox %s was left torn between two moments by a failed restore; it cannot be checkpointed or restored and must be destroyed and recreated", sandboxID))
+}
+
+// beginRestore opens the sandbox's restore window and throws away the
+// connections into it, returning the function that closes the window.
+//
+// Dropping here rather than after the rollback is the difference between a
+// caller learning in milliseconds and hanging for the length of the restore
+// (up to the 45s envd wait) on a connection whose peer is about to forget it
+// ever existed. The guest's TCP state goes back to checkpoint time: every
+// connection open across the rollback is already dead, it just does not know
+// it yet. A restore that fails before its commit point costs those callers a
+// reconnect, which is the cheaper mistake.
+func (s *Service) beginRestore(ctx context.Context, sandboxID string, connectionKey string) func() {
+	s.restoringMu.Lock()
+	s.restoring[sandboxID] = restoreWindow{active: true, since: time.Now()}
+	s.restoringMu.Unlock()
+
+	if s.dropConnections != nil {
+		if err := s.dropConnections(connectionKey); err != nil {
+			logger.L().Warn(ctx, "failed to drop connections to restored sandbox",
+				logger.WithSandboxID(sandboxID),
+				zap.Error(err))
+		}
+	}
+
+	return func() {
+		s.restoringMu.Lock()
+		w := s.restoring[sandboxID]
+		w.active = false
+		w.until = time.Now()
+		s.restoring[sandboxID] = w
+		s.restoringMu.Unlock()
+	}
+}
+
+// RestoreInProgress reports whether a restore currently owns the sandbox.
+// A request arriving now would be talking to a guest that is paused and
+// about to lose the connection anyway.
+func (s *Service) RestoreInProgress(sandboxID string) bool {
+	s.restoringMu.Lock()
+	defer s.restoringMu.Unlock()
+
+	return s.restoring[sandboxID].active
+}
+
+// RestoredSince reports whether a request that started at reqStart was still
+// in flight while the sandbox was rolled back -- which is why its transport
+// died, whatever the transport error says.
+//
+// The question is asked with the request's start time rather than the time
+// of the failure so that a request made after the restore, which then failed
+// on its own, is not blamed on the rollback.
+func (s *Service) RestoredSince(sandboxID string, reqStart time.Time) bool {
+	s.restoringMu.Lock()
+	defer s.restoringMu.Unlock()
+
+	w, ok := s.restoring[sandboxID]
+	if !ok {
+		return false
+	}
+
+	if w.active || reqStart.IsZero() {
+		return w.active
+	}
+
+	return reqStart.Before(w.until)
+}
+
+// The answer a request gets when a restore is what ended it. aborted is the
+// Connect code for "the operation was cancelled by something other than
+// you", and the reason names the something.
+const (
+	restoredAnswerCode   = "aborted"
+	restoredAnswerReason = "sandbox_restored"
+)
+
+// RestoredAnswer is the response for a request a restore cut short: the
+// status, its content type and its body.
+//
+// 409 rather than the proxy's usual "port is not open": the port is open,
+// the guest is simply at an earlier moment in time and has never heard of
+// this connection. The caller's move is to reconnect and retry, which is
+// what a conflict says and what a closed port does not.
+func RestoredAnswer(sandboxID string) (int, string, []byte) {
+	body, err := json.Marshal(map[string]any{
+		"code":   restoredAnswerCode,
+		"reason": restoredAnswerReason,
+		"message": fmt.Sprintf(
+			"sandbox %s was rolled back to a checkpoint; connections held across a restore are talking to a guest that has forgotten them and have to be remade",
+			sandboxID),
+	})
+	if err != nil {
+		// The body is built from constants and one id; this cannot fail.
+		body = []byte(`{"code":"aborted","reason":"sandbox_restored"}`)
+	}
+
+	return http.StatusConflict, "application/json", body
+}
+
+// restore rolls the sandbox back onto a checkpoint in place: Firecracker
+// writes the revert set back onto the live VM and the disk view is switched
+// under the live NBD mount, all in one pause. This is the only route — the
+// scenarios a rebuild would serve (a dead process, a torn VM) are explicitly
+// outside what checkpoint restore promises and belong to e2b's own snapshot
+// machinery.
+func (s *Service) restore(w http.ResponseWriter, r *http.Request, sbx *sandbox.Sandbox, stats *callStats) error {
+	// Same as create: a restore must not be abandoned mid-flight because the
+	// client gave up.
+	ctx := context.WithoutCancel(r.Context())
+
+	id, err := checkpointIDFrom(r)
+	if err != nil {
+		return writeError(w, http.StatusBadRequest, "invalid_argument", reasonInvalidArgument, err.Error())
+	}
+
+	sandboxID := sbx.Runtime.SandboxID
+
+	if err := s.refuseIfTorn(w, sbx); err != nil {
+		return err
+	}
+
+	timings := sandbox.PhaseTimings{}
+	opStart := time.Now()
+
+	// Same as create: the failed restores are the ones whose breakdown is
+	// worth keeping.
+	succeeded := false
+
+	// Filled in once Firecracker has answered, and read again from the defer
+	// below: a restore that fails after the rollback -- a guest that never
+	// came back, say -- is exactly the one whose vCPU counters are worth
+	// having, so they must not hang off the success path alone.
+	var vcpu *sandbox.RollbackVcpuCounters
+
+	defer func() {
+		if succeeded {
+			return
+		}
+
+		timings.Mark("total", opStart)
+		writeTimings(filepath.Join(s.store.Root(), sandboxID, lastRestoreTimingsName), timings)
+
+		fields := []zap.Field{
+			logger.WithSandboxID(sandboxID),
+			zap.String("checkpoint_id", id),
+			zap.Any("timings_ms", map[string]float64(timings)),
+		}
+
+		logger.L().Warn(ctx, "checkpoint restore failed", append(fields, vcpuCounterFields(vcpu)...)...)
+	}()
+
+	unlock, locked := s.store.LockSandboxWithin(sandboxID, lockWaitTimeout())
+	if !locked {
+		return writeBusy(w, sandboxID, lockWaitTimeout())
+	}
+
+	defer unlock()
+
+	if err := s.refuseIfGone(w, sbx); err != nil {
+		return err
+	}
+
+	entry, ok := s.store.Get(sandboxID, sbx.LifecycleID, id)
+	if !ok {
+		return writeError(w, http.StatusNotFound, "not_found", reasonNotFound, fmt.Sprintf("checkpoint %s not found", id))
+	}
+
+	// Every layer's sidecar is read and decoded here, 8 bytes per block the
+	// layer holds, so this grows with the view like assemble_view_pre does.
+	diskViewStart := time.Now()
+	layers, err := s.store.DiskViewForEntry(entry)
+	timings.Mark("disk_view_read", diskViewStart)
+	if err != nil {
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to load checkpoint disk view: %s", err))
+	}
+	if layers == nil {
+		// 412: the checkpoint tree, not the request, is what makes this
+		// restore impossible. The SDK reads the code out of the body, so the
+		// status only has to stop saying "the server broke".
+		return writeError(w, http.StatusPreconditionFailed, "failed_precondition", reasonChainBroken, fmt.Sprintf("checkpoint %s has no disk view and cannot be restored", id))
+	}
+
+	// MaterializeRevert writes the revert set next to the target checkpoint,
+	// and a revert set can be the size of guest memory. Checked here, before
+	// the pause: a rollback that runs out of disk halfway is past the point
+	// where anything can be put back.
+	if err := s.refuseIfDiskFull(ctx, w, sbx, opRestore); err != nil {
+		return err
+	}
+
+	// Pages older than every checkpoint on the target's ancestor chain
+	// resolve to the memory the sandbox started from.
+	baseDev, err := sbx.Template.Memfile(ctx)
+	if err != nil {
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to open start memory source: %s", err))
+	}
+
+	var afterCommit func() error
+	if faultInjected(faultTornAssemble) {
+		// The disk view is assembled before the pause now, so a layer that
+		// cannot be opened no longer reaches the state this fault is for.
+		// What it stands for is the class, not the one call: a disk step
+		// that fails past the memory rollback's commit point, with the VM
+		// paused at the target moment and nothing left that can put it back.
+		afterCommit = func() error {
+			return injectedError(faultTornAssemble, "the checkpoint's disk view could not be installed past the commit point")
+		}
+	}
+
+	// The layer stack is mapped here, outside the pause: the files are
+	// sealed and this sandbox's operations are serialized, so the view built
+	// now is the view the rollback would have built while the guest was
+	// stopped. A failure is an ordinary failed restore -- the sandbox has
+	// not been touched -- instead of the torn sandbox it used to be.
+	assembleStart := time.Now()
+	device, err := sbx.AssembleView(ctx, layers)
+	timings.Mark("assemble_view_pre", assembleStart)
+	if err != nil {
+		return writeError(w, http.StatusInternalServerError, "internal", reasonInternal, fmt.Sprintf("failed to assemble checkpoint disk view (the sandbox keeps running at its current state): %s", err))
+	}
+
+	// From here until the window closes the sandbox belongs to this restore:
+	// connections into it are dropped now, and anything that arrives while
+	// it runs is told to come back rather than left to die on a paused VM.
+	endRestore := s.beginRestore(ctx, sandboxID, sbx.LifecycleID)
+	defer endRestore()
+
+	rollbackStart := time.Now()
+	vcpu, err = sbx.RollbackInPlace(ctx, entry.Snapfile, func(liveBitmapPath string) (string, string, func(), error) {
+		return s.store.MaterializeRevert(ctx, sandboxID, entry.ID, liveBitmapPath, baseDev, timings)
+	}, device, afterCommit, timings)
+	timings.Mark("rollback_in_place", rollbackStart)
+
+	// Metered whatever happens next: the vCPUs were rewound by then, so the
+	// work these count is done and paid for even if the restore is about to
+	// be called a failure for another reason.
+	recordVcpuCounters(ctx, "restore", vcpu)
+
+	if err != nil {
+		var torn sandbox.RollbackTornError
+		if errors.As(err, &torn) {
+			// Past the point of no return the guest is between two moments in
+			// time; only recreating the sandbox helps. The view is left
+			// mapped: the swap may already have happened, and unmapping
+			// something the guest reads through would be worse than the
+			// mappings a sandbox that is about to be destroyed holds on to.
+			s.markTorn(ctx, sbx)
+
+			return writeError(w, http.StatusInternalServerError, "data_loss", reasonTorn, fmt.Sprintf("restore failed past the commit point; the sandbox must be recreated: %s", err))
+		}
+
+		// Before that point the VM was resumed untouched: the sandbox keeps
+		// running at its pre-restore state, still reading through its own
+		// stack, so the view assembled for the checkpoint is ours to unmap.
+		if releaseErr := sandbox.ReleaseView(device); releaseErr != nil {
+			logger.L().Warn(ctx, "failed to release the disk view of a restore that did not happen",
+				logger.WithSandboxID(sandboxID),
+				zap.String("checkpoint_id", entry.ID),
+				zap.Error(releaseErr))
+		}
+
+		return writeRestoreFailure(w, entry.ID, err)
+	}
+
+	if err := s.finishRestore(ctx, entry, func(ctx context.Context) error {
+		if faultInjected(faultEnvdTimeout) {
+			return injectedError(faultEnvdTimeout, "the guest never answered after the rollback")
+		}
+
+		return sbx.WaitForEnvdAfterRestore(ctx, envdRestoreTimeout)
+	}, timings); err != nil {
+		// The rollback itself succeeded: the sandbox is at the target
+		// moment, the guest is the part that did not come back.
+		reason := reasonInternal
+		if errors.Is(err, errGuestUnresponsive) {
+			reason = reasonGuestUnresponsive
+		}
+
+		return writeError(w, http.StatusInternalServerError, "internal", reason, err.Error())
+	}
+
+	succeeded = true
+
+	timings.Mark("total", opStart)
+	writeTimings(filepath.Join(s.store.Root(), sandboxID, lastRestoreTimingsName), timings)
+
+	logRestored(ctx, sandboxID, entry.ID, timings, vcpu)
+
+	writeJSON(w, map[string]any{"success": true})
+
+	return nil
+}
+
+// finishRestore records what a completed rollback already did and then waits
+// for the guest to come back.
+//
+// The order matters and is the opposite of the obvious one: the rollback's
+// commit point is behind us, so the memory base and the disk-view bookkeeping
+// describe facts about the hypervisor and the disk, not about whether this
+// RPC succeeds. Leaving them behind because the guest failed to answer is how
+// the next checkpoint ends up diffing against a parent the guest has already
+// left -- silent corruption with no error anywhere. Bookkeeping follows the
+// state, not the RPC.
+func (s *Service) finishRestore(
+	ctx context.Context,
+	entry *Entry,
+	waitForEnvd func(context.Context) error,
+	timings sandbox.PhaseTimings,
+) error {
+	sandboxID := entry.SandboxID
+
+	// Dirty tracking restarted from zero at rollback, so the next diff is
+	// relative to exactly this entry: the tree grows a branch from here, and
+	// the checkpoints newer than the target stay restorable on theirs.
+	s.store.SetBaseToEntry(entry)
+
+	// The disk view was switched to the checkpoint's header; the next sealed
+	// layer stacks on top of exactly what the sandbox now reads.
+	if err := s.store.SetRootfsToEntry(entry); err != nil {
+		// The live stack is the checkpoint's, the bookkeeping still describes
+		// the pre-restore one, and nothing can reconcile them from here. The
+		// next checkpoint has to fail loudly instead of merging a layer into
+		// a mapping that resolves blocks to layers the sandbox no longer
+		// reads. Restores stay available and a successful one repairs this.
+		s.store.PoisonRootfs(sandboxID)
+
+		logger.L().Error(ctx, "failed to reset rootfs bookkeeping after restore; checkpoints are refused until a restore repairs it",
+			logger.WithSandboxID(sandboxID),
+			zap.String("checkpoint_id", entry.ID),
+			zap.Error(err))
+	}
+
+	// The guest woke up with the clock of checkpoint time; envd init brings
+	// the wall clock back to now, same as the pause/resume path. Monotonic
+	// time staying rolled back is part of restore semantics.
+	envdStart := time.Now()
+	err := waitForEnvd(ctx)
+	timings.Mark("wait_envd", envdStart)
+	if err != nil {
+		// The hypervisor half succeeded and the guest is the part that is
+		// wedged, which is not visible from the error the caller gets. Say so
+		// here, with the timings, so a rare recurrence leaves a trail even if
+		// the client already walked away.
+		logger.L().Error(ctx, "rollback succeeded but the guest's envd never answered",
+			logger.WithSandboxID(sandboxID),
+			zap.String("checkpoint_id", entry.ID),
+			zap.Duration("waited", envdRestoreTimeout),
+			zap.Any("timings_ms", map[string]float64(timings)),
+			zap.Error(err))
+
+		return errors.Join(errGuestUnresponsive, fmt.Errorf("sandbox restored but envd did not come back after %s: %w", envdRestoreTimeout, err))
+	}
+
+	return nil
+}
+
+func (s *Service) list(w http.ResponseWriter, sbx *sandbox.Sandbox) error {
+	entries := s.store.List(sbx.Runtime.SandboxID, sbx.LifecycleID)
+
+	infos := make([]map[string]any, 0, len(entries))
+	for _, e := range entries {
+		info := map[string]any{
+			"checkpointId": e.ID,
+			// protojson encodes int64 as a string.
+			"createdAt": fmt.Sprintf("%d", e.CreatedAt.Unix()),
+		}
+		if e.Name != "" {
+			info["name"] = e.Name
+		}
+		if mode := e.listedMemMode(); mode != "" {
+			info["memMode"] = mode
+		}
+
+		infos = append(infos, info)
+	}
+
+	writeJSON(w, map[string]any{"checkpoints": infos})
+
+	return nil
+}
+
+func (s *Service) delete(w http.ResponseWriter, r *http.Request, sbx *sandbox.Sandbox) error {
+	id, err := checkpointIDFrom(r)
+	if err != nil {
+		return writeError(w, http.StatusBadRequest, "invalid_argument", reasonInvalidArgument, err.Error())
+	}
+
+	sandboxID := sbx.Runtime.SandboxID
+
+	unlock, locked := s.store.LockSandboxWithin(sandboxID, lockWaitTimeout())
+	if !locked {
+		return writeBusy(w, sandboxID, lockWaitTimeout())
+	}
+
+	defer unlock()
+
+	opStart := time.Now()
+	timings := sandbox.PhaseTimings{}
+
+	// Measured around the whole delete, folds included, under the sandbox's
+	// gate so nothing else of this sandbox moves the count in between. It is
+	// what the delete gave back to the byte limit, which timings' compact_mb
+	// is not: that is what the folds wrote.
+	usedBefore := s.store.UsedBytes(sandboxID)
+
+	if err := deleteFailure(r.Context(), w, sandboxID, id, s.store.Delete(sandboxID, sbx.LifecycleID, id, timings)); err != nil {
+		return err
+	}
+
+	timings.Mark("total", opStart)
+
+	usedAfter := s.store.UsedBytes(sandboxID)
+
+	logger.L().Info(r.Context(), "deleted checkpoint",
+		logger.WithSandboxID(sandboxID),
+		zap.String("checkpoint_id", id),
+		zap.Any("timings_ms", map[string]float64(timings)),
+		zap.Int64("sandbox_checkpoint_bytes", usedAfter),
+		zap.Int64("freed_bytes", usedBefore-usedAfter))
+
+	writeJSON(w, map[string]any{"success": true})
+
+	return nil
+}
+
+// deleteFailure answers a Store.Delete that did not simply succeed, and
+// returns nil when the delete is to be reported as done.
+//
+// An id that names nothing is the caller's 404. A delete that took effect
+// and only failed to remove its files is done as far as the caller is
+// concerned -- the checkpoint is gone from the API and a retry would only
+// be told it is not found -- so it is answered as a success and the
+// leftovers are logged; they are reclaimed with the sandbox (see
+// DeleteCleanupError). Anything else failed before the bookkeeping changed,
+// and nothing was deleted: a 500 the caller may retry, not a 404 that tells
+// it the checkpoint is already gone.
+func deleteFailure(ctx context.Context, w http.ResponseWriter, sandboxID string, id string, err error) error {
+	if err == nil {
+		return nil
+	}
+
+	if errors.Is(err, ErrCheckpointNotFound) {
+		return writeError(w, http.StatusNotFound, "not_found", reasonNotFound, err.Error())
+	}
+
+	var cleanup *DeleteCleanupError
+	if errors.As(err, &cleanup) {
+		logger.L().Warn(ctx, "deleted checkpoint but could not remove all of its files; "+
+			"the leftovers are reclaimed when the sandbox is removed",
+			logger.WithSandboxID(sandboxID),
+			zap.String("checkpoint_id", id),
+			zap.Error(cleanup.Err))
+
+		return nil
+	}
+
+	return writeError(w, http.StatusInternalServerError, "internal", reasonInternal,
+		fmt.Sprintf("failed to delete checkpoint %s: %s", id, err))
+}
+
+func checkpointIDFrom(r *http.Request) (string, error) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		return "", fmt.Errorf("failed to read request: %w", err)
+	}
+
+	// protojson emits lowerCamelCase, but accepts the proto field name too, so
+	// both spellings have to be understood here.
+	var req struct {
+		CheckpointID      string `json:"checkpointId"`
+		CheckpointIDSnake string `json:"checkpoint_id"`
+	}
+	if err := json.Unmarshal(body, &req); err != nil {
+		return "", fmt.Errorf("failed to parse request: %w", err)
+	}
+
+	id := req.CheckpointID
+	if id == "" {
+		id = req.CheckpointIDSnake
+	}
+
+	if id == "" {
+		return "", fmt.Errorf("checkpoint_id is required")
+	}
+
+	if err := validateID(id); err != nil {
+		return "", fmt.Errorf("invalid checkpoint id: %w", err)
+	}
+
+	return id, nil
+}
+
+func writeJSON(w http.ResponseWriter, body map[string]any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusOK)
+
+	_ = json.NewEncoder(w).Encode(body)
+}
+
+// writeError replies in the shape Connect defines for errors, which is what
+// the SDK turns back into an exception. It returns what it reported, so a
+// handler can answer the client and hand the outcome to its caller in one
+// statement.
+//
+// reason rides alongside the code and says what the caller has to do next
+// (see the reason constants). The SDK's decoder builds its exception from
+// code and message and drops every other field, so adding one is invisible
+// to a client that does not know about it.
+func writeError(w http.ResponseWriter, status int, code string, reason string, message string) error {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+
+	_ = json.NewEncoder(w).Encode(map[string]any{
+		"code":    code,
+		"reason":  reason,
+		"message": message,
+	})
+
+	return errors.New(message)
+}
+
+// logRestored writes the one line a finished restore leaves behind: the phase
+// breakdown, and what Firecracker counted on the vCPU side.
+//
+// It is a function rather than three lines in the handler because the level
+// is a decision, not a constant. A restore that had to give up on draining an
+// MMIO access, or that read a core register back as something else, resumed a
+// guest whose vCPU state nobody could confirm; that is a warning even though
+// the call succeeded, and it is the only warning anyone will get.
+func logRestored(ctx context.Context, sandboxID string, checkpointID string, timings sandbox.PhaseTimings, vcpu *sandbox.RollbackVcpuCounters) {
+	fields := []zap.Field{
+		logger.WithSandboxID(sandboxID),
+		zap.String("checkpoint_id", checkpointID),
+		zap.Any("timings_ms", map[string]float64(timings)),
+	}
+	fields = append(fields, vcpuCounterFields(vcpu)...)
+
+	if vcpuCountersNeedAttention(vcpu) {
+		logger.L().Warn(ctx, "restored checkpoint", fields...)
+
+		return
+	}
+
+	logger.L().Info(ctx, "restored checkpoint", fields...)
+}
+
+// lastRestoreTimingsName is where a sandbox's most recent restore leaves its
+// host-side phase breakdown. Restores repeat and overwrite; a checkpoint's own
+// timings.json is written once and stays.
+const lastRestoreTimingsName = "last-restore-timings.json"
+
+// writeTimings drops a host-side phase breakdown next to what it describes.
+//
+// It goes in a file rather than only into the log because that is what a
+// benchmark can read: the client wall clock and the guest freeze window are
+// both measurable from outside, but where the time went inside the host is
+// not, and scraping it back out of log lines is a worse contract than a small
+// JSON file. Failure to write it is not worth failing an otherwise good
+// checkpoint over.
+func writeTimings(path string, t sandbox.PhaseTimings) {
+	blob, err := json.Marshal(t)
+	if err != nil {
+		return
+	}
+
+	_ = os.WriteFile(path, blob, 0o644)
+}
diff --git a/packages/orchestrator/internal/checkpoint/store.go b/packages/orchestrator/internal/checkpoint/store.go
new file mode 100644
index 000000000..b747d5ac4
--- /dev/null
+++ b/packages/orchestrator/internal/checkpoint/store.go
@@ -0,0 +1,2377 @@
+// Package checkpoint implements the host side of sandbox checkpoint/rollback:
+// a per-sandbox tree of diff checkpoints and the service that answers the
+// in-sandbox checkpoint port (49984) on the host.
+//
+// Each checkpoint stores only the pages its epoch dirtied (a sparse diff
+// file plus a bitmap sidecar), except the one that roots a tree. By default
+// (CHECKPOINT_FULL_ROOT unset or true, see fullRootEnabled) a sandbox's first
+// checkpoint captures full guest memory and is that root: content resolution
+// ends at it, and restores never read the sandbox's start memory source.
+// With CHECKPOINT_FULL_ROOT=false the first checkpoint is a diff like the
+// rest and the tree roots at the start memory source (the template
+// memfile), which resolution falls through to for pages no checkpoint holds.
+// Either way a checkpoint taken without dirty tracking or on a broken chain
+// is a full capture that roots a fresh subtree. A restore never
+// re-materializes a full image on disk — the revert set is resolved
+// page-by-page through the target's ancestor chain. This is what makes
+// checkpoints O(dirty pages) on any filesystem: nothing here depends on
+// reflink.
+//
+// Restoring rolls the live Firecracker process back in place; there is no
+// rebuild route. Rolling back does not prune: checkpoints newer than the
+// target stay restorable as branches (the next checkpoint's parent is the
+// restore target), and deletion is an explicit API that hides entries still
+// referenced by descendants instead of breaking their chains.
+//
+// Checkpoints are host-local and live only as long as the Firecracker process
+// does: the files sit under the store root, and an orchestrator restart takes
+// every sandbox with it anyway. The bookkeeping lives in this process memory
+// and nowhere else. Each checkpoint directory carries a manifest, and with
+// CHECKPOINT_DEBUG_INDEX on each sandbox directory also carries an index of
+// its entries, but both exist so a run can be inspected after the fact: the
+// store never reads either back, and neither survives a restart.
+//
+// "As long as the process" is narrower than "as long as the sandbox id", and
+// the difference is e2b's own pause/resume: it stops the VM, drops the sandbox
+// from the node and later resumes it under the same id as a new Firecracker
+// process with new memory and a new disk stack. The diff chain of the earlier
+// process cannot be rolled back onto that, so the checkpoints go with the
+// process -- but the id comes back, and everything in here that is keyed by
+// sandbox id has to tell the two apart. That is what a generation is: one
+// sandbox's Sandbox.LifecycleID, which changes with every Firecracker process.
+// The store records which generation owns the state under a sandbox id, and a
+// later generation takes the id over (dropping what the earlier one left)
+// rather than inheriting it or being locked out by it.
+package checkpoint
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"io/fs"
+	"math/bits"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox"
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+const (
+	indexFileName     = "index.json"
+	manifestFileName  = "manifest.json"
+	snapfileFileName  = "snapfile"
+	memDiffFileName   = "mem_diff"
+	memBitmapFileName = "mem_bitmap"
+	rootfsHeaderName  = "rootfs.header"
+
+	// Materialized rollback inputs, written next to the target checkpoint
+	// for the duration of one restore.
+	revertMemFileName    = "revert_mem"
+	revertBitmapFileName = "revert_bitmap"
+
+	// layersDirName holds sealed rootfs write layers. They are sandbox-private
+	// bookkeeping, not checkpoint artifacts: several checkpoints' views can
+	// reference the same layer, so a layer is not owned by any one checkpoint.
+	// It is reclaimed, with its sidecar, when the last reference to it goes:
+	// the last committed view that lists it and the live bookkeeping
+	// (rootfsState) both count, see layerRefs. Whatever is left goes with the
+	// sandbox.
+	//
+	// Counting views rather than walking the checkpoint tree is deliberate.
+	// The layer stack is not the checkpoint tree: a full-memory capture is a
+	// tree root (ParentID "") -- every checkpoint when dirty tracking is off,
+	// the first one after the chain broke otherwise -- yet its view carries
+	// every layer sealed before it. A leaf of the tree can therefore own a
+	// layer that a checkpoint outside its subtree still reads.
+	layersDirName = "layers"
+
+	tempSuffix = ".tmp"
+
+	// trashPrefix names a dropped sandbox's directory once it has been moved
+	// aside for deletion; see dropStateLocked. It sits in the store root,
+	// which NewStore empties, so a removal cut short by a crash is finished
+	// by the next start.
+	trashPrefix = ".trash-"
+
+	// maxPerSandboxEnv caps how many checkpoints one sandbox may hold at
+	// once. 0 (the default) does not cap it.
+	maxPerSandboxEnv = "CHECKPOINT_MAX_PER_SANDBOX"
+
+	// debugIndexEnv turns on the per-sandbox index.json; see DebugIndex.
+	debugIndexEnv = "CHECKPOINT_DEBUG_INDEX"
+)
+
+// debugIndexInterval is how often the debug index of a sandbox that changed
+// is rewritten: at most once per interval per sandbox, however many
+// checkpoints it took in between. A variable so the tests can wait less.
+var debugIndexInterval = 5 * time.Second
+
+// writeIndexFile writes one sandbox's debug index. A variable so the tests can
+// count the writes and make them fail.
+var writeIndexFile = writeIndex
+
+// removeAll deletes what the store has dropped: checkpoint directories and
+// whole sandbox trees. A variable so the tests can make a deletion slow and
+// show that it holds up nobody but its own caller.
+var removeAll = os.RemoveAll
+
+// removeLayerFile deletes a reclaimed layer file or its sidecar. A variable
+// for the same reason as removeAll, and so the tests can make it fail.
+var removeLayerFile = os.Remove
+
+// reclaim is what a section under the store lock unlinked from the
+// bookkeeping and left for its caller to delete once the lock is released.
+//
+// Deleting under the global lock charged the cost of one sandbox's disk to
+// every other sandbox on the node -- including a restore of another sandbox
+// that is waiting for the lock inside its guest's freeze (materialize_lock_wait)
+// -- and a recursive delete of a checkpoint directory, let alone of a whole
+// sandbox tree, is not small. Nothing about the deletion needs the lock:
+//
+//   - what is collected here has already left the maps, so no lookup can
+//     hand it to anybody again;
+//   - checkpoint directories are named after the time they were prepared,
+//     and a sandbox's whole tree is renamed to a unique name in the store
+//     root before it is collected (dropStateLocked), so nothing created
+//     after the lock is released can be caught by the deletion;
+//   - the only readers of a dropped checkpoint's files are operations on the
+//     same sandbox, and every such operation holds the sandbox's gate
+//     (LockSandbox) for its whole duration, deleting caller included. The
+//     caller runs the deletion before it returns, so by the time the gate
+//     is released it is done, exactly as it was when it happened under the
+//     lock.
+//   - a sealed layer is collected only once its reference count is zero (see
+//     layerRefs), and a count never comes back from zero: references are
+//     taken only by publishing a view, which lists layers some reference
+//     already held, by restoring onto a view that is still counted, or by
+//     sealing a brand-new layer. The live stack reads its layers through
+//     mappings made when each layer joined it, which an unlink does not
+//     disturb.
+//
+// The exception to the last point is a removal or adoption whose wait for the
+// gate timed out (Service.OnRemove, Service.OnInsert); it deletes files an
+// operation may still be using whether it does so under the store lock or
+// not, and moving it out changes nothing about that.
+type reclaim struct {
+	// dirs are removed with removeAll, files with os.Remove.
+	dirs  []string
+	files []string
+
+	// layers are sealed rootfs layers whose last reference went (see
+	// layerRefs); each is removed with its sidecar through removeLayerFile.
+	layers []string
+}
+
+func (r *reclaim) dir(path string) { r.dirs = append(r.dirs, path) }
+
+func (r *reclaim) layer(path string) {
+	if path != "" {
+		r.layers = append(r.layers, path)
+	}
+}
+
+func (r *reclaim) file(path string) {
+	if path != "" {
+		r.files = append(r.files, path)
+	}
+}
+
+// run deletes everything collected. It must be called without the store
+// lock. It reports the first directory or layer that could not be removed; a
+// loose file (a hidden entry's snapfile or header) that could not be is not an
+// error, as it never was. A layer is treated like a directory because it is
+// what the space goes to -- a few MiB each, one per checkpoint -- and a
+// failure to give it back is worth a line in the log.
+func (r *reclaim) run() error {
+	for _, f := range r.files {
+		os.Remove(f)
+	}
+
+	var first error
+	for _, d := range r.dirs {
+		if err := removeAll(d); err != nil && first == nil {
+			first = err
+		}
+	}
+
+	for _, l := range r.layers {
+		// A layer that was never sealed into place (see rootfsState.unrecorded)
+		// has no file, and a recorded one whose sidecar write failed has no
+		// sidecar; neither is a failure to reclaim anything.
+		for _, p := range []string{l, l + layerMetaSuffix} {
+			if err := removeLayerFile(p); err != nil && !errors.Is(err, fs.ErrNotExist) && first == nil {
+				first = err
+			}
+		}
+	}
+
+	r.dirs, r.files, r.layers = nil, nil, nil
+
+	return first
+}
+
+// runLogged is run for callers that have nobody to return the error to: it
+// can only mean disk space held by files nothing references any more.
+func (r *reclaim) runLogged(sandboxID string) {
+	if err := r.run(); err != nil {
+		logger.L().Warn(context.Background(), "failed to delete dropped checkpoint files",
+			logger.WithSandboxID(sandboxID),
+			zap.Error(err))
+	}
+}
+
+// DebugIndex reports whether the store keeps an index.json per sandbox, with
+// the value's provenance attached for the startup line.
+//
+// The index is a debugging aid and nothing reads it back (see the package
+// comment). It used to be rewritten in full on every checkpoint and every
+// delete, which made each of them allocate and write the whole sandbox's
+// bookkeeping -- megabytes per operation at the depths a client in a loop
+// reaches, and the single largest source of garbage the collector had to
+// keep up with, with its stop-the-world pauses landing in other sandboxes'
+// restore windows. Off, which is the default, nothing writes it. On, a
+// background writer rewrites a changed sandbox's index at most once every
+// few seconds, plus once at shutdown.
+//
+// The variable is read the way FC_TRACK_DIRTY_PAGES is (strconv.ParseBool):
+// 1/t/T/TRUE/true/True is on, 0/f/F/FALSE/false/False is off, and anything
+// else is reported and ignored.
+func DebugIndex() (bool, string) {
+	raw, set := os.LookupEnv(debugIndexEnv)
+	if !set {
+		return false, sourceDefault
+	}
+
+	enabled, err := strconv.ParseBool(raw)
+	if err != nil {
+		logger.L().Warn(context.Background(), "ignoring a checkpoint debug index setting that is not a boolean",
+			zap.String("env", debugIndexEnv),
+			zap.String("value", raw))
+
+		return false, sourceDefault
+	}
+
+	return enabled, sourceEnv
+}
+
+// MaxPerSandbox is the per-sandbox checkpoint limit in force, with the
+// value's provenance attached for the startup line.
+//
+// Checkpoints are host-local and live as long as the sandbox: nothing ages
+// them out, so a client in a loop can hold as many of them as it likes, each
+// one holding its diff, its snapshot and a sealed rootfs layer on the node's
+// artifact disk. A cap turns that into an answer the caller can act on
+// instead of a node that fills up. It is off by default because the right
+// number is a property of the deployment, not of this code.
+func MaxPerSandbox() (int, string) {
+	raw := os.Getenv(maxPerSandboxEnv)
+	if raw == "" {
+		return 0, sourceDefault
+	}
+
+	n, err := strconv.Atoi(raw)
+	if err != nil || n < 0 {
+		logger.L().Warn(context.Background(), "ignoring unusable checkpoint limit in the environment",
+			zap.String("env", maxPerSandboxEnv),
+			zap.String("value", raw))
+
+		return 0, sourceDefault
+	}
+
+	return n, sourceEnv
+}
+
+// State of a checkpoint. Only committed checkpoints are visible to Get/List;
+// a half-written snapshot must never be restorable.
+const (
+	StatePrepared  = "prepared"
+	StateCommitted = "committed"
+)
+
+// MemMode records what the memory file holds.
+const (
+	// MemModeFull: Firecracker wrote the complete guest memory. A full
+	// checkpoint is a self-sufficient tree root: content resolution
+	// terminates at it and never consults anything older. Taken for a
+	// sandbox's first checkpoint unless CHECKPOINT_FULL_ROOT=false, and
+	// whenever the incremental chain is unavailable (dirty tracking off) or
+	// broken (an epoch was lost).
+	MemModeFull = "full"
+	// MemModeIncremental: the file holds only the pages dirtied since the
+	// parent checkpoint (or since the sandbox started, for a first
+	// checkpoint), each at its guest-physical offset, holes elsewhere. Same
+	// name as on the reflink branch, where the increment is written into a
+	// clone of the parent instead of into a sparse file.
+	MemModeIncremental = "incremental"
+)
+
+// RootfsLayer is one sealed write layer referenced by a checkpoint's rootfs
+// view. The path points into the sandbox's shared layers directory.
+type RootfsLayer struct {
+	BuildID string `json:"build_id"`
+	Path    string `json:"path"`
+}
+
+// RootfsView describes the disk state at checkpoint time: a serialized merged
+// header (template base plus every sealed layer up to this point) and the
+// local layer files the header's mappings resolve to.
+type RootfsView struct {
+	HeaderPath string        `json:"header_path"`
+	Layers     []RootfsLayer `json:"layers,omitempty"`
+}
+
+// Entry is one checkpoint of one sandbox — one node of the sandbox's
+// checkpoint tree. ParentID names the checkpoint its diff is relative to;
+// "" means the entry roots a tree: a full capture (the default for a
+// sandbox's first checkpoint), or with CHECKPOINT_FULL_ROOT=false a diff
+// against the sandbox's start memory source. The tree shape
+// follows use: checkpoints chain linearly until a restore, after which the
+// next checkpoint's parent is the restore target and the newer checkpoints
+// remain as a branch.
+type Entry struct {
+	ID        string    `json:"id"`
+	Name      string    `json:"name,omitempty"`
+	SandboxID string    `json:"sandbox_id"`
+	CreatedAt time.Time `json:"created_at"`
+	State     string    `json:"state"`
+
+	// ParentID is the checkpoint this entry's diff is relative to; "" for a
+	// root (diff against the start memory source, or a full capture).
+	ParentID string `json:"parent_id,omitempty"`
+
+	// Hidden marks an entry that is part of the tree but not of the API:
+	// deleted while descendants still resolve pages through it, or the
+	// rescued epoch of a failed create. List never shows it and Get never
+	// returns it; content resolution and revert unions use it like any
+	// other committed entry.
+	Hidden bool `json:"hidden,omitempty"`
+
+	Dir      string `json:"dir"`
+	Snapfile string `json:"snapfile"`
+	MemDiff  string `json:"mem_diff"`
+	MemMode  string `json:"mem_mode,omitempty"`
+
+	// ListedMemMode is the mode List reports when it is not MemMode. A fold
+	// (compact.go) can make a checkpoint that was taken as an increment hold
+	// every page -- it absorbed a full root -- and MemMode has to say so,
+	// because content resolution stops at a full entry. What the caller was
+	// told when it took the checkpoint does not change with it. Empty for
+	// every entry no fold has changed the mode of.
+	ListedMemMode string `json:"listed_mem_mode,omitempty"`
+
+	// MemBitmap is the sidecar recording which pages this checkpoint's
+	// snapshot wrote — one epoch's dirty set. For a diff checkpoint it is
+	// both the revert-set ingredient and the page index of MemDiff; a diff
+	// checkpoint without one is unusable. A full checkpoint may omit it, and
+	// one it has takes no part in a restore: a full checkpoint's revert
+	// factor and its content are both every page (entryBitmap,
+	// entryContentBitmap).
+	MemBitmap string `json:"mem_bitmap,omitempty"`
+
+	Rootfs *RootfsView `json:"rootfs,omitempty"`
+
+	// bytes is what the entry's own files occupy, as the byte limit counts
+	// them (quota.go).
+	bytes entryBytes
+
+	// layer is the rootfs layer this checkpoint sealed -- the top of its
+	// view when it was published -- which it keeps knowing after it is
+	// hidden and has no view. A fold uses it to find the layer pair to merge
+	// (compact_layers.go). "" for an entry published without a view.
+	layer string
+}
+
+// listedMemMode is the memory mode the API shows for the entry; see
+// ListedMemMode.
+func (e *Entry) listedMemMode() string {
+	if e.ListedMemMode != "" {
+		return e.ListedMemMode
+	}
+
+	return e.MemMode
+}
+
+// TempSnapfile is where the snapshot is written before commit.
+func (e *Entry) TempSnapfile() string { return e.Snapfile + tempSuffix }
+
+// TempMemDiff is where the memory diff is written before commit.
+func (e *Entry) TempMemDiff() string { return e.MemDiff + tempSuffix }
+
+// TempMemBitmap is where the dirty bitmap sidecar is written before commit.
+func (e *Entry) TempMemBitmap() string { return e.MemBitmap + tempSuffix }
+
+// RootfsHeaderPath is where the merged rootfs header of this checkpoint goes.
+func (e *Entry) RootfsHeaderPath() string { return filepath.Join(e.Dir, rootfsHeaderName) }
+
+// baseRef records what the next checkpoint's diff is relative to — its
+// parent-to-be in the tree. Absent from the map: the sandbox has no
+// checkpoints yet, so the next diff is relative to the start memory source
+// (the root). invalid: an epoch was lost and the chain is broken — the next
+// checkpoint must capture full memory and become a new self-sufficient root,
+// and until it does the sandbox cannot roll back.
+type baseRef struct {
+	entryID string
+	invalid bool
+}
+
+// ownerRef says which generation of a sandbox owns the state filed under its
+// id, and whether that generation is gone.
+//
+// removed is the tombstone: a create admitted before the generation was torn
+// down can reach Prepare after it, and MkdirAll would then rebuild a directory
+// tree nobody is ever going to clean up again. It is a fact about one
+// generation, not about the id -- a later generation of the same id is a
+// running sandbox with every right to take checkpoints, and the tombstone must
+// not answer for it.
+//
+// lifecycleID is "" for state claimed by a caller that named no generation.
+// Such a caller matches only other callers that name none, so the tombstone
+// keeps its original meaning for them.
+type ownerRef struct {
+	lifecycleID string
+	removed     bool
+}
+
+// generations reports which generation of a sandbox this node is running right
+// now. *sandbox.Map satisfies it; it is an interface so the store can be
+// exercised without a sandbox map, and so nothing here depends on how the
+// orchestrator assembles the two.
+type generations interface {
+	Get(sandboxID string) (*sandbox.Sandbox, bool)
+}
+
+// Store holds the checkpoints of every sandbox on this node, plus per-sandbox
+// bookkeeping that is not part of any checkpoint: the parent-to-be of the
+// next checkpoint and the per-sandbox operation lock.
+type Store struct {
+	root string
+
+	// maxPerSandbox is the per-sandbox checkpoint limit, 0 for none. Read
+	// once at startup so every sandbox on the node is held to the same
+	// number whatever the environment does later.
+	maxPerSandbox int
+
+	// maxBytesPerSandbox is the per-sandbox limit on the bytes checkpoints
+	// occupy, 0 for none; read once at startup like maxPerSandbox. usedBytes
+	// is each sandbox's count and layerBytes what each sealed layer was
+	// charged when it was first counted. See quota.go.
+	maxBytesPerSandbox int64
+
+	mu        sync.Mutex
+	bySandbox map[string]map[string]*Entry
+	bases     map[string]baseRef
+	rootfs    map[string]*rootfsState
+
+	// layerRefs counts, per sandbox and per sealed layer path, the references
+	// that keep a layer file alive; a layer whose count drops to zero is
+	// reclaimed. See layer_refs.go for where each reference is taken and
+	// given back.
+	layerRefs map[string]map[string]int
+
+	// children counts, per sandbox and per entry id, the committed entries
+	// whose ParentID is that entry, so whether an entry has children is a
+	// lookup rather than a walk over every entry of the sandbox. Maintained
+	// wherever an entry enters or leaves bySandbox: publishLocked adds one to
+	// the new entry's parent, deleteLocked and pruneLocked take one off the
+	// parent of each entry they remove, and dropStateLocked drops the lot.
+	children map[string]map[string]int
+
+	// usedBytes and layerBytes: see maxBytesPerSandbox.
+	usedBytes  map[string]int64
+	layerBytes map[string]map[string]int64
+
+	// owners records, per sandbox id, the generation the state belongs to.
+	// Everything that creates state on disk goes through it, and so does
+	// every read: a generation must never be shown, or roll back onto, what
+	// the generation before it left under the same id.
+	owners map[string]ownerRef
+
+	// gens answers "which generation is live on this node", which is what
+	// decides a handover: the one the node is running may take the id over
+	// from an earlier one, and a request that was overtaken may not.
+	gens generations
+
+	// opLocks is a gate per sandbox rather than a mutex: a caller has to be
+	// able to give up on the wait (see LockSandboxWithin), and sync.Mutex
+	// cannot be acquired with a deadline.
+	opLocks map[string]chan struct{}
+
+	// compact, compactMaxPerOp and compactPending run the folding of hidden
+	// entries into their only child; see compact.go. The two settings are
+	// read once at startup. compactPending holds, per sandbox, the entries
+	// that became candidates and have not been folded yet.
+	compact         bool
+	compactMaxPerOp int
+	compactPending  map[string]*compactQueue
+
+	// indexDirty names the sandboxes whose debug index is behind their
+	// entries. nil unless CHECKPOINT_DEBUG_INDEX is on; guarded by mu.
+	indexDirty map[string]struct{}
+
+	// indexStop and indexDone run the debug index writer, nil when it is
+	// off. closeOnce makes Close safe to call more than once.
+	indexStop chan struct{}
+	indexDone chan struct{}
+	closeOnce sync.Once
+}
+
+// NewStore opens the checkpoint store at root, which it owns exclusively and
+// empties: checkpoints live only as long as the process that indexed them
+// (see the package comment), so whatever an earlier run left there is
+// referenced by nobody and will never be reclaimed by anybody. root is the
+// store's own directory, not a shared one -- main.go passes
+// DefaultCacheDir/checkpoints, a subdirectory nothing else writes to.
+func NewStore(root string) (*Store, error) {
+	if err := os.RemoveAll(root); err != nil {
+		return nil, fmt.Errorf("failed to clear checkpoint store root: %w", err)
+	}
+
+	if err := os.MkdirAll(root, 0o755); err != nil {
+		return nil, fmt.Errorf("failed to create checkpoint store root: %w", err)
+	}
+
+	limit, _ := MaxPerSandbox()
+	maxBytes, _ := MaxBytesPerSandbox()
+	compact, _ := Compaction()
+	compactMaxPerOp, _ := CompactMaxPerOp()
+
+	s := &Store{
+		root:               root,
+		maxPerSandbox:      limit,
+		maxBytesPerSandbox: maxBytes,
+		usedBytes:          make(map[string]int64),
+		layerBytes:         make(map[string]map[string]int64),
+		compact:            compact,
+		compactMaxPerOp:    compactMaxPerOp,
+		compactPending:     make(map[string]*compactQueue),
+		bySandbox:          make(map[string]map[string]*Entry),
+		bases:              make(map[string]baseRef),
+		rootfs:             make(map[string]*rootfsState),
+		layerRefs:          make(map[string]map[string]int),
+		children:           make(map[string]map[string]int),
+		owners:             make(map[string]ownerRef),
+		opLocks:            make(map[string]chan struct{}),
+	}
+
+	if debugIndex, _ := DebugIndex(); debugIndex {
+		s.indexDirty = make(map[string]struct{})
+		s.indexStop = make(chan struct{})
+		s.indexDone = make(chan struct{})
+
+		go s.runIndexWriter(debugIndexInterval)
+	}
+
+	return s, nil
+}
+
+// Close stops the debug index writer, writing whatever it had not written
+// yet. The store itself needs no closing: its files are cleared by the next
+// NewStore. Safe to call more than once, and a no-op with the index off.
+func (s *Store) Close(context.Context) error {
+	if s.indexStop == nil {
+		return nil
+	}
+
+	s.closeOnce.Do(func() {
+		close(s.indexStop)
+		<-s.indexDone
+	})
+
+	return nil
+}
+
+// SetGenerations tells the store where to ask which generation of a sandbox is
+// live. Without it the store still refuses everything it refused before; it
+// just cannot let a new generation take an id over, because it has no way to
+// tell one from a request that was overtaken.
+func (s *Store) SetGenerations(g generations) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	s.gens = g
+}
+
+// Root is where the store keeps every sandbox's checkpoints.
+func (s *Store) Root() string {
+	return s.root
+}
+
+// LockSandbox serializes checkpoint operations on one sandbox. Create,
+// restore and delete each hold this for their full duration: the memory base
+// and the rootfs layer stack are per-sandbox state that two operations must
+// not advance concurrently.
+//
+// It waits for as long as it takes. Every caller that answers a client uses
+// LockSandboxWithin instead.
+func (s *Store) LockSandbox(sandboxID string) func() {
+	gate := s.gate(sandboxID)
+
+	gate <- struct{}{}
+
+	return func() { <-gate }
+}
+
+// LockSandboxWithin is LockSandbox with a ceiling on the wait, and reports
+// whether it got the lock.
+//
+// The wait is unbounded by nature: the holder is a create or a restore, and
+// either can be stuck on something that never returns (an NBD flush, a
+// Firecracker that stopped answering). Queueing behind it forever costs a
+// goroutine and a held client connection per waiter and gives the caller a
+// bare read timeout with nothing to act on. Giving up says "busy, try again"
+// while the sandbox is still there to try again on.
+func (s *Store) LockSandboxWithin(sandboxID string, wait time.Duration) (func(), bool) {
+	gate := s.gate(sandboxID)
+
+	select {
+	case gate <- struct{}{}:
+		return func() { <-gate }, true
+	default:
+	}
+
+	timer := time.NewTimer(wait)
+	defer timer.Stop()
+
+	select {
+	case gate <- struct{}{}:
+		return func() { <-gate }, true
+	case <-timer.C:
+		return nil, false
+	}
+}
+
+// gate returns the sandbox's operation gate, creating it on first use. A
+// buffered channel of one: holding the lock is a value in it.
+func (s *Store) gate(sandboxID string) chan struct{} {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	g, ok := s.opLocks[sandboxID]
+	if !ok {
+		g = make(chan struct{}, 1)
+		s.opLocks[sandboxID] = g
+	}
+
+	return g
+}
+
+// ErrSandboxRemoved marks work for a sandbox this node has already finished
+// with. It is a sentinel because the answer is 404 rather than a server
+// error: the sandbox is gone, which is a fact about the request, not a
+// failure of the store.
+var ErrSandboxRemoved = errors.New("sandbox has been removed from this node")
+
+// ErrChainBroken marks a restore the checkpoint tree cannot resolve: a link
+// the entries no longer have. The deletion rules hide referenced entries
+// instead of removing them, so this is corruption of the tree rather than a
+// state a caller can retry out of -- and the caller has to be told that,
+// because a retry costs it the same failure again.
+var ErrChainBroken = errors.New("the checkpoint chain is broken")
+
+// ErrTooManyCheckpoints marks a create refused because the sandbox already
+// holds as many checkpoints as this node allows it. Like ErrSandboxRemoved
+// it is a fact about the request rather than a failure of the store: the
+// caller deletes a checkpoint and the next create works.
+var ErrTooManyCheckpoints = errors.New("the sandbox is at its checkpoint limit")
+
+// ErrCheckpointNotFound marks a Delete of an id that names nothing the
+// caller may delete: no such entry, an entry that is already hidden (it is
+// no API object any more), or a sandbox id whose tree belongs to another
+// generation. A fact about the request, answered 404, like
+// ErrSandboxRemoved.
+var ErrCheckpointNotFound = errors.New("checkpoint not found")
+
+// checkpointNotFoundError is ErrCheckpointNotFound under the message the
+// API has always answered with ("checkpoint <id> not found"), which callers
+// and test suites match on.
+type checkpointNotFoundError struct {
+	msg string
+}
+
+func notFound(format string, args ...any) error {
+	return &checkpointNotFoundError{msg: fmt.Sprintf(format, args...)}
+}
+
+func (e *checkpointNotFoundError) Error() string { return e.msg }
+
+func (e *checkpointNotFoundError) Is(target error) bool { return target == ErrCheckpointNotFound }
+
+// DeleteCleanupError is a Delete that took effect but did not finish with
+// its files: the entry is already out of the bookkeeping -- gone from List,
+// no longer a restore target, its bytes no longer charged -- when removing
+// its directory or rewriting the manifest of the entry it hid failed. What
+// is left sits under the sandbox's directory in the store root and goes
+// with it: RemoveSandbox when the sandbox is removed, a new generation
+// taking the id over, or the next orchestrator start (NewStore clears the
+// root). So the delete is answered as done; the error is for the log.
+type DeleteCleanupError struct {
+	Err error
+}
+
+func (e *DeleteCleanupError) Error() string { return e.Err.Error() }
+
+func (e *DeleteCleanupError) Unwrap() error { return e.Err }
+
+// TooManyCheckpointsError carries the two numbers the limit was decided on.
+// The sentence alone is enough for the caller, who only has to delete a
+// checkpoint; an operator reading the node's logs is asking a different
+// question -- whether the limit is too low for what this node is being used
+// for -- and that is answered by the counts, as fields, not by parsing the
+// message back apart.
+type TooManyCheckpointsError struct {
+	SandboxID string
+	// Held is the number of checkpoints the caller can see and delete.
+	// Hidden entries are not counted; see atCheckpointLimitLocked.
+	Held  int
+	Limit int
+}
+
+func (e *TooManyCheckpointsError) Error() string {
+	return fmt.Sprintf("%s: sandbox %s holds %d of %d allowed checkpoints; delete one before taking another",
+		ErrTooManyCheckpoints, e.SandboxID, e.Held, e.Limit)
+}
+
+func (e *TooManyCheckpointsError) Unwrap() error { return ErrTooManyCheckpoints }
+
+// atCheckpointLimitLocked reports whether the sandbox may take another
+// checkpoint. Hidden entries do not count: the caller cannot see them and
+// cannot delete them, so charging for them would be a limit nobody can get
+// back under. The caller holds the store lock.
+func (s *Store) atCheckpointLimitLocked(sandboxID string) error {
+	if s.maxPerSandbox <= 0 {
+		return nil
+	}
+
+	visible := 0
+	for _, e := range s.bySandbox[sandboxID] {
+		if !e.Hidden {
+			visible++
+		}
+	}
+
+	if visible < s.maxPerSandbox {
+		return nil
+	}
+
+	return &TooManyCheckpointsError{SandboxID: sandboxID, Held: visible, Limit: s.maxPerSandbox}
+}
+
+// liveGenerationLocked reports the generation of the sandbox this node is
+// running right now, if any. The caller holds the store lock; the sandbox map
+// takes only its own and never calls back into the store while holding it
+// (subscribers are triggered on their own goroutines), so this cannot invert.
+func (s *Store) liveGenerationLocked(sandboxID string) (string, bool) {
+	if s.gens == nil {
+		return "", false
+	}
+
+	sbx, ok := s.gens.Get(sandboxID)
+	if !ok || sbx == nil {
+		return "", false
+	}
+
+	return sbx.LifecycleID, true
+}
+
+// ownsLocked reports whether the state filed under a sandbox id belongs to
+// this generation. It is the read side of the ownership rule and mutates
+// nothing: a generation that is not the owner sees no checkpoints rather than
+// having the previous generation's deleted out from under a list call.
+//
+// An unclaimed id is nobody's and holds nothing, so every caller "owns" it and
+// reads back the empty answer it deserves.
+func (s *Store) ownsLocked(sandboxID string, lifecycleID string) bool {
+	own, claimed := s.owners[sandboxID]
+	if !claimed {
+		return true
+	}
+
+	return own.lifecycleID == lifecycleID && !own.removed
+}
+
+// admitLocked decides whether a generation may create state under a sandbox
+// id, and hands the id over to it -- dropping what an earlier generation left
+// -- when it is the generation this node is running.
+//
+// The three answers it gives are the three things that can be true of a
+// caller: it is the owner (carry on), it is the live sandbox and something
+// older is in the way (take over), or it is neither, which is a request that
+// was admitted before its own sandbox went away and has since been overtaken
+// or outlived (ErrSandboxRemoved, exactly as before).
+//
+// Handing over drops the earlier generation's checkpoints deliberately: they
+// diff against a Firecracker process and a disk stack that no longer exist, so
+// there is nothing for them to roll back onto. Doing it here rather than at
+// insert time is what makes the drop safe -- the caller holds the sandbox's
+// operation gate, so no other operation on this id is running and the removal
+// cannot pull files out from under one. The files themselves are left in rc
+// for the caller to delete after releasing the store lock.
+func (s *Store) admitLocked(sandboxID string, lifecycleID string, rc *reclaim) error {
+	own, claimed := s.owners[sandboxID]
+
+	switch {
+	case !claimed:
+		// An unclaimed id is free unless the node is visibly running another
+		// generation of it -- in which case this caller is one that was
+		// overtaken before it ever wrote anything, and letting it claim the
+		// id would put a directory tree under a sandbox that has no idea it
+		// is there.
+		if live, ok := s.liveGenerationLocked(sandboxID); ok && live != lifecycleID {
+			return ErrSandboxRemoved
+		}
+
+		s.owners[sandboxID] = ownerRef{lifecycleID: lifecycleID}
+
+		return nil
+	case own.lifecycleID == lifecycleID:
+		if own.removed {
+			return ErrSandboxRemoved
+		}
+
+		return nil
+	}
+
+	live, ok := s.liveGenerationLocked(sandboxID)
+	if !ok || lifecycleID == "" || live != lifecycleID {
+		return ErrSandboxRemoved
+	}
+
+	s.handOverLocked(sandboxID, lifecycleID, rc)
+
+	return nil
+}
+
+// handOverLocked makes a generation the owner of a sandbox id and throws away
+// what was filed under it before. The caller has established that the id is
+// this generation's to take. It does no deletion itself: the earlier
+// generation's tree is moved aside into rc.
+func (s *Store) handOverLocked(sandboxID string, lifecycleID string, rc *reclaim) {
+	if err := s.dropStateLocked(sandboxID, rc); err != nil {
+		logger.L().Warn(context.Background(), "failed to drop the checkpoints of an earlier sandbox generation",
+			logger.WithSandboxID(sandboxID),
+			zap.Error(err))
+	}
+
+	s.owners[sandboxID] = ownerRef{lifecycleID: lifecycleID}
+}
+
+// dropStateLocked removes every trace of a sandbox id from the store: the
+// entries, the memory base, the disk-view bookkeeping and the directory tree.
+// It says nothing about ownership; the caller records that.
+//
+// The tree is not deleted here but renamed to a unique name in the store root
+// and left in rc: one rename, O(1) however many checkpoints it holds, and
+// the id's path is free the moment the lock is released. Deleting the tree in
+// place after the lock would race the next generation of the same id, which
+// can be admitted as soon as the lock is free and MkdirAll a tree at the very
+// path the deletion is walking. If the rename fails the tree is deleted in
+// place, under the lock, as it always was -- slow is better than racing.
+func (s *Store) dropStateLocked(sandboxID string, rc *reclaim) error {
+	delete(s.bySandbox, sandboxID)
+	delete(s.bases, sandboxID)
+	delete(s.rootfs, sandboxID)
+	// The counts go without releasing anything one by one: every layer they
+	// describe lives in the tree that is moved aside below.
+	delete(s.layerRefs, sandboxID)
+	delete(s.children, sandboxID)
+	delete(s.usedBytes, sandboxID)
+	delete(s.layerBytes, sandboxID)
+	delete(s.compactPending, sandboxID)
+	delete(s.indexDirty, sandboxID)
+
+	dir := filepath.Join(s.root, sandboxID)
+	trash := filepath.Join(s.root, trashPrefix+uuid.NewString())
+
+	err := os.Rename(dir, trash)
+	switch {
+	case err == nil:
+		rc.dir(trash)
+
+		return nil
+	case errors.Is(err, fs.ErrNotExist):
+		return nil
+	}
+
+	if err := removeAll(dir); err != nil {
+		return fmt.Errorf("failed to remove sandbox checkpoints: %w", err)
+	}
+
+	return nil
+}
+
+// LayersDir returns (and creates) the sandbox's sealed-layer directory.
+// lifecycleID is the calling generation; see admitLocked.
+func (s *Store) LayersDir(sandboxID string, lifecycleID string) (string, error) {
+	if err := validateID(sandboxID); err != nil {
+		return "", fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	var rc reclaim
+
+	s.mu.Lock()
+	admitErr := s.admitLocked(sandboxID, lifecycleID, &rc)
+	s.mu.Unlock()
+
+	rc.runLogged(sandboxID)
+
+	if admitErr != nil {
+		return "", fmt.Errorf("%w: refusing to recreate its layers dir", admitErr)
+	}
+
+	dir := filepath.Join(s.root, sandboxID, layersDirName)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return "", fmt.Errorf("failed to create layers dir: %w", err)
+	}
+
+	return dir, nil
+}
+
+// BaseState reports the parent of the next checkpoint: the entry id ("" for
+// the start-source root) and whether the chain is broken, in which case the
+// next checkpoint must capture full memory and restores are refused until
+// it does.
+func (s *Store) BaseState(sandboxID string) (parentID string, broken bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	b := s.bases[sandboxID]
+
+	return b.entryID, b.invalid
+}
+
+// Prepare reserves an entry, creates its directory and journals it as
+// prepared, so the caller can write the snapshot into the temp files. The
+// entry is not visible to Get or List until Commit. parentID is the
+// checkpoint the diff is taken against — "" for a root capture, and
+// lifecycleID is the calling generation (see admitLocked).
+func (s *Store) Prepare(sandboxID string, lifecycleID string, name string, parentID string, timings sandbox.PhaseTimings) (*Entry, error) {
+	if err := validateID(sandboxID); err != nil {
+		return nil, fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	// Both admission checks read the store's maps, so they take the lock
+	// once between them: two acquisitions would be two waits to explain, and
+	// the pair reads the same state either way. The wait is timed because
+	// this is the create's first encounter with the global lock -- a create
+	// can be behind another sandbox before it has done anything at all.
+	var rc reclaim
+
+	lockStart := time.Now()
+	s.mu.Lock()
+	timings.Mark("prepare_lock_wait", lockStart)
+
+	admitErr := s.admitLocked(sandboxID, lifecycleID, &rc)
+
+	// The two limits are independent, and each answers with its own reason:
+	// the count first, as it always did, then the bytes.
+	var limitErr error
+	if admitErr == nil {
+		limitErr = s.atCheckpointLimitLocked(sandboxID)
+	}
+
+	if admitErr == nil && limitErr == nil {
+		limitErr = s.atByteLimitLocked(sandboxID)
+	}
+
+	s.mu.Unlock()
+
+	rc.runLogged(sandboxID)
+
+	if admitErr != nil {
+		return nil, fmt.Errorf("%w: refusing to recreate its checkpoint directory", admitErr)
+	}
+
+	if limitErr != nil {
+		return nil, limitErr
+	}
+
+	id := fmt.Sprintf("ckpt_%d", time.Now().UnixNano())
+	dir := filepath.Join(s.root, sandboxID, id)
+
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return nil, fmt.Errorf("failed to create checkpoint dir: %w", err)
+	}
+
+	e := &Entry{
+		ID:        id,
+		Name:      name,
+		SandboxID: sandboxID,
+		CreatedAt: time.Now().UTC(),
+		State:     StatePrepared,
+		ParentID:  parentID,
+		Dir:       dir,
+		Snapfile:  filepath.Join(dir, snapfileFileName),
+		MemDiff:   filepath.Join(dir, memDiffFileName),
+		MemBitmap: filepath.Join(dir, memBitmapFileName),
+	}
+
+	if err := timings.Timed("prepare_manifest", func() error { return writeManifest(e) }); err != nil {
+		os.RemoveAll(dir)
+
+		return nil, err
+	}
+
+	return e, nil
+}
+
+// commitFiles moves the temp artifacts into their final names, durably. A
+// diff checkpoint must have its sidecar: it is the only record of which
+// pages the diff file holds, so without it neither content resolution nor
+// revert sets can ever use the entry.
+func commitFiles(e *Entry, memMode string, withSnapfile bool) error {
+	files := [][2]string{
+		{e.TempMemDiff(), e.MemDiff},
+	}
+	if withSnapfile {
+		files = append(files, [2]string{e.TempSnapfile(), e.Snapfile})
+	} else {
+		// A hidden entry is never a restore target: only its diff and
+		// sidecar take part in resolution and revert unions. On a second
+		// commit the temp file is already in its final place, so that is the
+		// copy to drop -- otherwise a full snapshot file stays on disk with
+		// nothing in the bookkeeping pointing at it.
+		if _, err := os.Stat(e.TempSnapfile()); err == nil {
+			os.Remove(e.TempSnapfile())
+		} else if e.Snapfile != "" {
+			os.Remove(e.Snapfile)
+		}
+		e.Snapfile = ""
+	}
+	if _, err := os.Stat(e.TempMemBitmap()); err == nil {
+		files = append(files, [2]string{e.TempMemBitmap(), e.MemBitmap})
+	} else if _, err := os.Stat(e.MemBitmap); err == nil {
+		// Already moved into place by an earlier commit of this entry.
+	} else if memMode == MemModeIncremental {
+		return fmt.Errorf("firecracker wrote no dirty bitmap sidecar; diff checkpoints need one")
+	} else {
+		e.MemBitmap = ""
+	}
+
+	for _, f := range files {
+		// Committing an entry twice is a normal path, not an error: a create
+		// whose Commit failed after the renames is rescued as a hidden entry,
+		// and the artifacts it is being rescued for are exactly the ones
+		// already in place. Treating the missing temp file as a failure used
+		// to break the chain over data that was completely intact.
+		if _, err := os.Stat(f[1]); err == nil {
+			continue
+		}
+
+		// Deliberately no fsync before the rename. The rename is what makes
+		// the artifact visible under its final name, and every later reader
+		// -- this process resolving pages, Firecracker reading the file back
+		// -- goes through the same page cache the writer used, so
+		// consistency owes nothing to a flush. What an fsync would buy is
+		// survival of a host crash, and these checkpoints do not reach that
+		// far: the index that references them lives in this process memory
+		// and dies with it (see the package comment). It is the same
+		// argument the seal path already makes for the rootfs layer, and it
+		// is the fsync that made create scale with the number of sandboxes
+		// checkpointing at once -- ext4 serializes journal commits, so one
+		// sandbox waits for every other sandbox writeback.
+		if err := os.Rename(f[0], f[1]); err != nil {
+			return fmt.Errorf("failed to move %s into place: %w", f[0], err)
+		}
+	}
+
+	return nil
+}
+
+// Commit publishes a prepared entry: temp files are renamed into place (not
+// fsynced; see commitFiles), the manifest flips to committed, and the next
+// checkpoint's parent becomes this entry. The caller must have finished
+// writing the temp files, including having resumed the VM.
+//
+// The three phases are timed apart because they fail differently and cost
+// differently: moving the artifacts is per-file work on this sandbox's own
+// directory, the manifest is one small file, and publishing takes the store's
+// global lock to insert the entry. A single `commit` number cannot tell "the
+// disk was slow" from "another sandbox held the lock". Publishing is split
+// again for the same reason: commit_lock_wait is the queue in front of the
+// global lock and commit_index is the work done once it is held, and the two
+// are fixed in different places. commit_index keeps its name from when that
+// work included rewriting the sandbox's whole index; it now covers the locked
+// section alone, which is what makes a before/after comparison of it mean
+// something.
+func (s *Store) Commit(e *Entry, memMode string, rootfs *RootfsView, timings sandbox.PhaseTimings) error {
+	e.MemMode = memMode
+	e.Rootfs = rootfs
+
+	if err := timings.Timed("commit_files", func() error { return commitFiles(e, memMode, true) }); err != nil {
+		return err
+	}
+
+	if faultInjected(faultCommitLate) {
+		return injectedError(faultCommitLate, "commit failed after the artifacts were renamed into place")
+	}
+
+	e.State = StateCommitted
+	if err := timings.Timed("commit_manifest", func() error { return writeManifest(e) }); err != nil {
+		return err
+	}
+
+	// What the byte limit counts, measured before the lock: the entry's
+	// files and the layer it sealed.
+	e.bytes = measureEntry(e)
+
+	var ownLayerBytes int64
+	if rootfs != nil && len(rootfs.Layers) > 0 {
+		ownLayerBytes = layerBytesOf(rootfs.Layers[len(rootfs.Layers)-1].Path)
+	}
+
+	lockStart := time.Now()
+	s.mu.Lock()
+	timings.Mark("commit_lock_wait", lockStart)
+
+	indexStart := time.Now()
+
+	var rc reclaim
+
+	s.publishLocked(e, ownLayerBytes, &rc)
+	timings.Mark("commit_index", indexStart)
+	s.mu.Unlock()
+
+	rc.runLogged(e.SandboxID)
+
+	return nil
+}
+
+// CommitHidden publishes a failed checkpoint's artifacts as a hidden entry.
+// Once Firecracker has written the snapshot the epoch has advanced: the diff
+// file holds the only copy of that epoch's pages and the sidecar is the only
+// record of which pages those are. As a hidden committed entry the epoch
+// stays a sound part of the tree — content resolution and revert unions use
+// it like any other — while the API never shows it. The create RPC still
+// fails; only the epoch survives.
+//
+// It publishes the same way Commit does, so it reports the same two phases:
+// the rescue of a failed create still queues behind every other sandbox.
+func (s *Store) CommitHidden(e *Entry, memMode string, timings sandbox.PhaseTimings) error {
+	e.MemMode = memMode
+	e.Hidden = true
+	e.Rootfs = nil
+
+	if err := commitFiles(e, memMode, false); err != nil {
+		return err
+	}
+
+	os.Remove(e.RootfsHeaderPath())
+
+	e.State = StateCommitted
+	if err := writeManifest(e); err != nil {
+		return err
+	}
+
+	e.bytes = measureEntry(e)
+
+	lockStart := time.Now()
+	s.mu.Lock()
+	timings.Mark("commit_lock_wait", lockStart)
+
+	indexStart := time.Now()
+
+	var rc reclaim
+
+	s.publishLocked(e, 0, &rc)
+	timings.Mark("commit_index", indexStart)
+	s.mu.Unlock()
+
+	rc.runLogged(e.SandboxID)
+
+	return nil
+}
+
+// publishLocked records a committed entry and makes it the base: Firecracker
+// cleared its dirty bitmap when it wrote the snapshot, so from now on the
+// live set counts from this moment and the next increment is relative to it.
+//
+// It is O(1) in the number of entries the sandbox already has, apart from the
+// pruning a base move can do. It used to return a copy of the sandbox's whole
+// index for the caller to serialize and write, which made every checkpoint
+// cost as much as all the earlier ones together; see DebugIndex.
+//
+// ownLayerBytes is what the layer the entry sealed occupies, charged against
+// the sandbox's byte count along with the entry's own files.
+func (s *Store) publishLocked(e *Entry, ownLayerBytes int64, rc *reclaim) {
+	entries, ok := s.bySandbox[e.SandboxID]
+	if !ok {
+		entries = make(map[string]*Entry)
+		s.bySandbox[e.SandboxID] = entries
+	}
+	entries[e.ID] = e
+	s.addChildLocked(e.SandboxID, e.ParentID)
+
+	// Layer references, source 1 of 2: a published view holds every layer it
+	// lists. A hidden rescue (CommitHidden) has no view and holds none; its
+	// layer, if AppendLayer recorded one, is held by the live bookkeeping and
+	// by whatever is taken on top of it.
+	if e.Rootfs != nil {
+		s.refLayersLocked(e.SandboxID, e.Rootfs.Layers)
+
+		if n := len(e.Rootfs.Layers); n > 0 {
+			e.layer = e.Rootfs.Layers[n-1].Path
+		}
+	}
+
+	s.chargeLocked(e.SandboxID, e.bytes.total())
+	s.chargeLayerLocked(e.SandboxID, e.layer, ownLayerBytes)
+
+	s.setBaseLocked(e.SandboxID, baseRef{entryID: e.ID}, rc)
+	s.markIndexLocked(e.SandboxID)
+}
+
+// InvalidateBase marks the sandbox's incremental chain broken: the epoch
+// advanced (Firecracker cleared its dirty bitmap) but the file it produced
+// could not be kept, so no future diff can account for that epoch's pages.
+// The next checkpoint must capture full memory and become a new root, and
+// until it does restores are refused — an incomplete revert would be a
+// silently corrupted guest, which is strictly worse than an error.
+func (s *Store) InvalidateBase(sandboxID string) {
+	var rc reclaim
+
+	s.mu.Lock()
+	s.setBaseLocked(sandboxID, baseRef{invalid: true}, &rc)
+	s.mu.Unlock()
+
+	rc.runLogged(sandboxID)
+}
+
+// SetBaseToEntry makes a committed checkpoint the next checkpoint's parent.
+// Called after a restore: dirty tracking restarted from zero at rollback, so
+// the next diff is relative to exactly this entry — which is how a branch
+// grows from the restore target instead of the abandoned tip.
+func (s *Store) SetBaseToEntry(e *Entry) {
+	var rc reclaim
+
+	s.mu.Lock()
+	s.setBaseLocked(e.SandboxID, baseRef{entryID: e.ID}, &rc)
+	s.mu.Unlock()
+
+	rc.runLogged(e.SandboxID)
+}
+
+// setBaseLocked moves the base. A hidden entry that stops being the base was
+// kept only for that role plus whatever hangs off it, so it is pruned once
+// nothing resolves through it any more; its files go into rc.
+func (s *Store) setBaseLocked(sandboxID string, b baseRef, rc *reclaim) {
+	prev := s.bases[sandboxID]
+	s.bases[sandboxID] = b
+
+	if prev.entryID == "" || prev.entryID == b.entryID {
+		return
+	}
+
+	prevEntry, ok := s.bySandbox[sandboxID][prev.entryID]
+	if !ok || !prevEntry.Hidden {
+		return
+	}
+
+	s.pruneLocked(sandboxID, prevEntry, rc)
+}
+
+// pruneLocked removes e if it is hidden, has no children and is not the
+// base — no ancestor chain and no revert path runs through it any more —
+// and then its parent on the same terms, up the tree. It only unlinks them:
+// their directories go into rc, for the caller to delete without the lock.
+// The entry the climb stops at is queued for folding if it is a candidate.
+//
+// A hidden entry holds no layer references (it lost its view when it was
+// hidden, or never had one), so pruning it releases none; its layer, if any,
+// goes when the last view listing it does. The release below is for an entry
+// that somehow still carries a view, so its references cannot outlive it.
+func (s *Store) pruneLocked(sandboxID string, e *Entry, rc *reclaim) {
+	entries := s.bySandbox[sandboxID]
+	base := s.bases[sandboxID]
+
+	cur := e
+	for cur != nil && cur.Hidden && cur.ID != base.entryID && !s.hasChildLocked(sandboxID, cur.ID) {
+		parentID := cur.ParentID
+
+		delete(entries, cur.ID)
+		s.removeChildLocked(sandboxID, parentID)
+		s.chargeLocked(sandboxID, -cur.bytes.total())
+		rc.dir(cur.Dir)
+
+		if cur.Rootfs != nil {
+			s.unrefLayersLocked(sandboxID, cur.Rootfs.Layers, rc)
+		}
+		s.markIndexLocked(sandboxID)
+
+		cur = entries[parentID]
+	}
+
+	// Where the climb stopped is the one entry whose children just changed
+	// (or, for a base move, the entry that just stopped being the base): if
+	// it is hidden with a single child left, it can be folded into that
+	// child.
+	if cur != nil {
+		s.queueCompactLocked(sandboxID, cur.ID)
+	}
+}
+
+// ancestorChainLocked returns target and its ancestors, newest first,
+// ending at a root (ParentID ""). Every link must exist: the deletion rules
+// hide referenced entries instead of removing them, so a missing parent is
+// corruption, not a normal state.
+func ancestorChainLocked(entries map[string]*Entry, target *Entry) ([]*Entry, error) {
+	var chain []*Entry
+	for e := target; ; {
+		chain = append(chain, e)
+		if e.ParentID == "" {
+			break
+		}
+
+		p, ok := entries[e.ParentID]
+		if !ok {
+			return nil, fmt.Errorf("%w: checkpoint %s references missing parent %s", ErrChainBroken, e.ID, e.ParentID)
+		}
+		e = p
+	}
+
+	return chain, nil
+}
+
+// revertPathLocked returns the checkpoints whose epoch bitmaps cover every
+// page that may differ between the current base moment and the target
+// moment: both tree branches walked down to (and excluding) their lowest
+// common ancestor. A page in neither branch was written on neither side of
+// the fork, so both moments inherited it unchanged from the common ancestor
+// and it needs no revert. targetChain is target's ancestor chain; baseID ""
+// (no checkpoint yet) makes the whole target chain the path.
+func revertPathLocked(entries map[string]*Entry, baseID string, targetChain []*Entry) ([]*Entry, error) {
+	inTargetChain := map[string]bool{"": true}
+	for _, e := range targetChain {
+		inTargetChain[e.ID] = true
+	}
+
+	var path []*Entry
+
+	lca := baseID
+	for !inTargetChain[lca] {
+		e, ok := entries[lca]
+		if !ok {
+			return nil, fmt.Errorf("%w: current base %s is missing from the store", ErrChainBroken, lca)
+		}
+
+		path = append(path, e)
+		lca = e.ParentID
+	}
+
+	for _, e := range targetChain {
+		if e.ID == lca {
+			break
+		}
+
+		path = append(path, e)
+	}
+
+	return path, nil
+}
+
+// StartMemSource is the sandbox's start memory device — what resolution
+// falls through to below a tree that is not rooted by a full capture
+// (CHECKPOINT_FULL_ROOT=false). It mirrors the relevant part of block.ReadonlyDevice
+// without this package importing the sandbox packages. ReadAt only accepts
+// BlockSize()-aligned ranges (the template memfile is served by a chunker
+// with that contract), so the materializer reads aligned windows and slices.
+type StartMemSource interface {
+	ReadAt(ctx context.Context, b []byte, off int64) (int, error)
+	BlockSize() int64
+}
+
+// entryContentBitmap says which pages a checkpoint's memory file can serve
+// when resolving content for a restore. For a diff capture that is its epoch
+// sidecar; a full capture holds every page whatever its sidecar records, so
+// it terminates resolution and nothing below it is ever read.
+func entryContentBitmap(e *Entry, pageSize uint64, numPages uint64, reads *materializeReads) (*dirtyBitmap, error) {
+	if e.MemMode == MemModeFull {
+		return allOnesBitmap(pageSize, numPages), nil
+	}
+
+	return entryBitmap(e, pageSize, numPages, reads)
+}
+
+// entryBitmap is a checkpoint's factor in a revert set: the pages that may
+// differ between it and what lies below it on the path. For a diff
+// checkpoint that is its epoch sidecar. A diff checkpoint without a sidecar
+// is unusable — nothing records which pages its file holds — and poisons
+// any restore whose path or resolution reaches it.
+//
+// A full checkpoint's factor is every page, whatever its sidecar records.
+// A full checkpoint is always a tree root, so it is on a revert path only
+// when the path crosses between trees (no common ancestor). Its factor must
+// then cover every page that differs between its moment and the start
+// memory source, including the pages written in an epoch that was lost
+// before it: those are in no checkpoint's sidecar. Only all ones does that.
+// Firecracker writes an all-ones sidecar for a Full snapshot, so this costs
+// nothing; it only stops a cross-tree revert from depending on that.
+func entryBitmap(e *Entry, pageSize uint64, numPages uint64, reads *materializeReads) (*dirtyBitmap, error) {
+	if e.MemMode == MemModeFull {
+		return allOnesBitmap(pageSize, numPages), nil
+	}
+
+	if e.MemBitmap == "" {
+		return nil, fmt.Errorf("checkpoint %s has no dirty bitmap sidecar", e.ID)
+	}
+
+	bm, err := readDirtyBitmap(e.MemBitmap)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read sidecar of checkpoint %s: %w", e.ID, err)
+	}
+	reads.addBitmap(bm)
+
+	if bm.pageSize != pageSize || bm.numPages != numPages {
+		return nil, fmt.Errorf(
+			"sidecar of checkpoint %s describes %d pages of %d bytes, guest has %d pages of %d",
+			e.ID, bm.numPages, bm.pageSize, numPages, pageSize,
+		)
+	}
+
+	return bm, nil
+}
+
+// materializeReads counts what one MaterializeRevert read, in bytes, as it
+// reads it.
+//
+// The only other number about a restore's reads is materialize_disk_read_mb,
+// the orchestrator's read_bytes from /proc/self/io over the materialize
+// window. That one belongs to the process: restores run concurrently, and
+// every other sandbox's reads in the window land in it (the long runs showed
+// a p50 of 352 MB for restores that read about 40). Counting at the reads
+// themselves makes this restore's and nobody else's.
+//
+// These are the bytes the reads returned, page-cache hits included: what the
+// restore asked of its inputs, not what the disk had to supply. Whether they
+// came from the disk is still the process-level counter's question.
+type materializeReads struct {
+	// bitmaps is every bitmap file read: the live bitmap and each sidecar,
+	// at its size on disk.
+	bitmaps int64
+	// diffs is what was read out of the checkpoints' memory diff files.
+	diffs int64
+	// base is what was read from the start memory source, the template's
+	// memory file, which is not a checkpoint file and is counted apart.
+	base int64
+}
+
+// addBitmap counts a bitmap file that was read in full; readDirtyBitmap has
+// already checked that the file is exactly this long. A nil counter counts
+// nothing.
+func (r *materializeReads) addBitmap(bm *dirtyBitmap) {
+	if r == nil || bm == nil {
+		return
+	}
+
+	r.bitmaps += dirtyBitmapHeaderSize + 8*int64(len(bm.words))
+}
+
+// record puts the counts into timings:
+//
+//	materialize_read_mb       the checkpoint files this restore read:
+//	                          bitmaps and diffs
+//	materialize_base_read_mb  what it read from the start memory source
+func (r *materializeReads) record(timings sandbox.PhaseTimings) {
+	const mib = 1024 * 1024
+
+	timings.SetMB("materialize_read_mb", float64(r.bitmaps+r.diffs)/mib)
+	timings.SetMB("materialize_base_read_mb", float64(r.base)/mib)
+}
+
+// MaterializeRevert builds the two files an in-place rollback to target
+// needs: the revert bitmap — every page that may differ between the
+// sandbox's memory now and the target moment, i.e. the union of the epoch
+// bitmaps on the tree path from the current base to the target plus the
+// live dirty set Firecracker just exported — and a sparse memory file
+// holding the target-moment content of exactly those pages, each at its
+// guest-physical offset. Firecracker then writes back precisely these pages
+// and re-derives the same union itself, so nothing it touches can fall into
+// a file hole.
+//
+// Content is resolved per page through the target's ancestor chain: the
+// newest checkpoint at or before the target whose bitmap holds the page
+// provides it from its memory file. A full capture roots the chain and holds
+// every page, so resolution stops there; baseDev, the sandbox's start memory
+// source, is only reached by trees rooted on a diff (CHECKPOINT_FULL_ROOT
+// off, or checkpoints taken before it existed).
+//
+// The returned cleanup removes both files and is safe to call no matter how
+// the rollback went.
+func (s *Store) MaterializeRevert(ctx context.Context, sandboxID string, targetID string, liveBitmapPath string, baseDev StartMemSource, timings sandbox.PhaseTimings) (memPath string, bitmapPath string, cleanup func(), err error) {
+	// This runs inside the rollback's pause window, and the lock it takes is
+	// the store's global one: whatever another sandbox is doing under that
+	// lock is added to this guest's freeze. Time the wait separately, or the
+	// freeze looks like this sandbox's own work.
+	lockStart := time.Now()
+	s.mu.Lock()
+	timings.Mark("materialize_lock_wait", lockStart)
+
+	entries := s.bySandbox[sandboxID]
+	target, ok := entries[targetID]
+	if !ok || target.State != StateCommitted {
+		s.mu.Unlock()
+
+		return "", "", nil, fmt.Errorf("checkpoint %s not found", targetID)
+	}
+
+	base := s.bases[sandboxID]
+	if base.invalid {
+		s.mu.Unlock()
+
+		return "", "", nil, fmt.Errorf("%w: an epoch was lost; take a new checkpoint before restoring", ErrChainBroken)
+	}
+
+	chain, err := ancestorChainLocked(entries, target)
+	if err != nil {
+		s.mu.Unlock()
+
+		return "", "", nil, err
+	}
+
+	pathEntries, err := revertPathLocked(entries, base.entryID, chain)
+	if err != nil {
+		s.mu.Unlock()
+
+		return "", "", nil, err
+	}
+	s.mu.Unlock()
+
+	// Recorded however the materialize ends: a failed restore's reads are
+	// as much its own as a successful one's.
+	var reads materializeReads
+	defer reads.record(timings)
+
+	live, err := readDirtyBitmap(liveBitmapPath)
+	if err != nil {
+		return "", "", nil, fmt.Errorf("failed to read live dirty bitmap: %w", err)
+	}
+	reads.addBitmap(live)
+
+	revert := live.clone()
+	for _, e := range pathEntries {
+		epoch, err := entryBitmap(e, revert.pageSize, revert.numPages, &reads)
+		if err != nil {
+			return "", "", nil, err
+		}
+
+		if err := revert.merge(epoch); err != nil {
+			return "", "", nil, err
+		}
+	}
+
+	chainBitmaps := make([]*dirtyBitmap, len(chain))
+	for i, e := range chain {
+		bm, err := entryContentBitmap(e, revert.pageSize, revert.numPages, &reads)
+		if err != nil {
+			return "", "", nil, err
+		}
+
+		chainBitmaps[i] = bm
+	}
+
+	memPath = filepath.Join(target.Dir, revertMemFileName+tempSuffix)
+	bitmapPath = filepath.Join(target.Dir, revertBitmapFileName+tempSuffix)
+	cleanup = func() {
+		os.Remove(memPath)
+		os.Remove(bitmapPath)
+	}
+
+	if err := timings.Timed("revert_mem_write", func() error {
+		return writeRevertMem(ctx, memPath, revert, chain, chainBitmaps, baseDev, &reads)
+	}); err != nil {
+		cleanup()
+
+		return "", "", nil, err
+	}
+
+	if err := timings.Timed("revert_bitmap_write", func() error { return revert.writeTo(bitmapPath) }); err != nil {
+		cleanup()
+
+		return "", "", nil, fmt.Errorf("failed to write revert bitmap: %w", err)
+	}
+
+	return memPath, bitmapPath, cleanup, nil
+}
+
+// revertExtentPages caps how many pages one read/write covers, so a huge
+// revert run does not demand a huge buffer.
+const revertExtentPages = 1024
+
+// readAlignedFromBase fills b from the start memory source, whose ReadAt
+// contract is block-aligned offsets and lengths: the covering aligned window
+// is read block by block into a scratch buffer and the requested span copied
+// out. memSize clamps the window — the device ends with guest memory.
+func readAlignedFromBase(ctx context.Context, dev StartMemSource, b []byte, off int64, memSize int64) (int, error) {
+	bs := dev.BlockSize()
+	if bs <= 0 || (off%bs == 0 && int64(len(b))%bs == 0) {
+		return dev.ReadAt(ctx, b, off)
+	}
+
+	lo := off / bs * bs
+	hi := (off + int64(len(b)) + bs - 1) / bs * bs
+	if hi > memSize {
+		hi = memSize
+	}
+
+	scratch := make([]byte, hi-lo)
+	for blockOff := lo; blockOff < hi; blockOff += bs {
+		blockLen := min(bs, hi-blockOff)
+		if _, err := dev.ReadAt(ctx, scratch[blockOff-lo:blockOff-lo+blockLen], blockOff); err != nil {
+			return 0, err
+		}
+	}
+
+	return copy(b, scratch[off-lo:]), nil
+}
+
+// writeRevertMem writes the target-moment content of every page set in
+// revert into a sparse file at path, sized to the full guest memory (the
+// rollback endpoint validates the length). Runs of consecutive pages
+// resolved from the same source move as single extents.
+func writeRevertMem(ctx context.Context, path string, revert *dirtyBitmap, chain []*Entry, chainBitmaps []*dirtyBitmap, baseDev StartMemSource, reads *materializeReads) (e error) {
+	out, err := os.OpenFile(path, os.O_RDWR|os.O_CREATE|os.O_TRUNC, 0o644)
+	if err != nil {
+		return fmt.Errorf("failed to create revert memory file: %w", err)
+	}
+	defer func() {
+		if closeErr := out.Close(); e == nil && closeErr != nil {
+			e = fmt.Errorf("failed to close revert memory file: %w", closeErr)
+		}
+	}()
+
+	pageSize := revert.pageSize
+	if err := out.Truncate(int64(revert.numPages * pageSize)); err != nil {
+		return fmt.Errorf("failed to size revert memory file: %w", err)
+	}
+
+	diffFiles := make(map[int]*os.File)
+	defer func() {
+		for _, f := range diffFiles {
+			f.Close()
+		}
+	}()
+
+	buf := make([]byte, revertExtentPages*pageSize)
+
+	memSize := int64(revert.numPages * pageSize)
+
+	copyExtent := func(startPage uint64, endPage uint64, src int) error {
+		var (
+			readAt func(b []byte, off int64) (int, error)
+			diff   string
+		)
+
+		if src < 0 {
+			readAt = func(b []byte, off int64) (int, error) {
+				return readAlignedFromBase(ctx, baseDev, b, off, memSize)
+			}
+		} else {
+			f, ok := diffFiles[src]
+			if !ok {
+				var err error
+				f, err = os.Open(chain[src].MemDiff)
+				if err != nil {
+					return fmt.Errorf("failed to open diff of checkpoint %s: %w", chain[src].ID, err)
+				}
+				diffFiles[src] = f
+			}
+
+			readAt = f.ReadAt
+			diff = chain[src].MemDiff
+		}
+
+		for page := startPage; page < endPage; page += revertExtentPages {
+			pages := min(endPage-page, revertExtentPages)
+			b := buf[:pages*pageSize]
+			off := int64(page * pageSize)
+
+			n, err := readAt(b, off)
+
+			if src < 0 {
+				reads.base += int64(n)
+			} else {
+				reads.diffs += int64(n)
+			}
+
+			if err != nil && err != io.EOF {
+				return fmt.Errorf("failed to read revert content at offset %d: %w", off, err)
+			}
+
+			// Every page of this extent is claimed by the source's sidecar,
+			// so a diff file that does not reach the end of it disagrees
+			// with its own bitmap. This used to zero the rest of the buffer
+			// and carry on, which put zeroed pages into guest memory with
+			// nothing said anywhere -- a guest that wakes up with a zeroed
+			// page fails later, somewhere else, if it fails visibly at all.
+			// Refusing costs the restore and nothing more: materializing is
+			// still before the rollback's commit point, so the VM is paused
+			// but untouched and the caller gets it back running.
+			//
+			// A hole inside the file is not this case. A page written as
+			// zeros is a legal page: it reads back as zeros and the read is
+			// not short. Only the file being too short is an error.
+			if diff != "" && n < len(b) {
+				return fmt.Errorf("revert page %d: diff %s short read %d/%d", page+uint64(n)/pageSize, diff, n, len(b))
+			}
+
+			// The start memory source has no such promise to break: its read
+			// window is clamped to the end of guest memory, so the last
+			// extent can legitimately come back short of the block the
+			// buffer was sized to. The buffer is reused, so its tail has to
+			// be cleared rather than left holding the previous extent.
+			clear(b[n:])
+
+			if _, err := out.WriteAt(b, off); err != nil {
+				return fmt.Errorf("failed to write revert content at offset %d: %w", off, err)
+			}
+		}
+
+		return nil
+	}
+
+	return forEachRevertRun(revert, chainBitmaps, copyExtent)
+}
+
+// forEachRevertRun walks the revert set as the extents a rollback has to
+// write: maximal runs of consecutive pages whose target-moment content comes
+// from the same source, in page order. src indexes chainBitmaps, or is -1 for
+// the start memory source, which is what a page older than the whole chain
+// resolves to.
+//
+// It reads the bitmaps a 64-bit word at a time. Per page -- which is how this
+// used to be done -- resolving a page meant walking the ancestor chain until
+// a generation claimed it, so the work was pages times chain depth: 2 GiB of
+// guest memory is half a million pages, chains have been measured past a
+// thousand deep, and all of it is inside the guest's freeze. Per word the
+// same question is answered for 64 pages with one AND per generation, the
+// chain is left as soon as every page in the word has an owner, and a word
+// with nothing set costs a comparison -- which is nearly all of them, since a
+// revert set is a few percent of memory at most.
+func forEachRevertRun(revert *dirtyBitmap, chainBitmaps []*dirtyBitmap, emit func(startPage uint64, endPage uint64, src int) error) error {
+	var (
+		runStart uint64
+		runEnd   uint64
+		runSrc   int
+		inRun    bool
+	)
+
+	flush := func() error {
+		if !inRun {
+			return nil
+		}
+
+		inRun = false
+
+		return emit(runStart, runEnd, runSrc)
+	}
+
+	// Bits past the last page describe memory that does not exist. Reading
+	// the bitmap page by page ignored them for free; a word at a time they
+	// have to be masked off, or a sidecar carrying junk in its tail would
+	// turn into reads and writes past the end of guest memory.
+	tail := revert.numPages % 64
+
+	// Which generation provides each page of the word being walked. Only
+	// bits that are set in the word are ever written or read.
+	var srcAt [64]int
+
+	for w, word := range revert.words {
+		if tail != 0 && w == len(revert.words)-1 {
+			word &= (uint64(1) << tail) - 1
+		}
+
+		if word == 0 {
+			continue
+		}
+
+		remaining := word
+		for i, bm := range chainBitmaps {
+			if remaining == 0 {
+				break
+			}
+
+			hit := remaining & bm.words[w]
+			for m := hit; m != 0; m &= m - 1 {
+				srcAt[bits.TrailingZeros64(m)] = i
+			}
+
+			remaining &^= hit
+		}
+
+		// Whatever no generation on the chain claims predates all of them.
+		for m := remaining; m != 0; m &= m - 1 {
+			srcAt[bits.TrailingZeros64(m)] = -1
+		}
+
+		for m := word; m != 0; m &= m - 1 {
+			bit := bits.TrailingZeros64(m)
+			page := uint64(w)*64 + uint64(bit)
+
+			src := srcAt[bit]
+
+			if inRun && src == runSrc && page == runEnd {
+				runEnd = page + 1
+
+				continue
+			}
+
+			if err := flush(); err != nil {
+				return err
+			}
+
+			runStart, runEnd, runSrc, inRun = page, page+1, src, true
+		}
+	}
+
+	return flush()
+}
+
+// Discard removes a prepared entry's directory. It is for cleaning up after a
+// failed snapshot; any epoch rescue (CommitHidden) must happen before this.
+func (s *Store) Discard(e *Entry) {
+	if e == nil || e.Dir == "" || e.State != StatePrepared {
+		return
+	}
+
+	os.RemoveAll(e.Dir)
+}
+
+// Get returns a committed, visible checkpoint of the calling generation.
+// Hidden entries are tree bookkeeping, not API objects: they cannot be
+// restored to or deleted. A checkpoint of an earlier generation is not found
+// either -- it describes a Firecracker process that no longer exists, so
+// "not found" is the whole truth about it as far as this caller is concerned.
+func (s *Store) Get(sandboxID string, lifecycleID string, id string) (*Entry, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if !s.ownsLocked(sandboxID, lifecycleID) {
+		return nil, false
+	}
+
+	e, ok := s.bySandbox[sandboxID][id]
+	if !ok || e.Hidden {
+		return nil, false
+	}
+
+	return e, ok
+}
+
+// List returns the calling generation's visible checkpoints, oldest first, as
+// copies. A generation that has just come out of a pause has none: what is
+// still filed under the id belongs to the Firecracker process it replaced.
+func (s *Store) List(sandboxID string, lifecycleID string) []*Entry {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if !s.ownsLocked(sandboxID, lifecycleID) {
+		return nil
+	}
+
+	entries := make([]*Entry, 0, len(s.bySandbox[sandboxID]))
+	for _, e := range s.bySandbox[sandboxID] {
+		if e.Hidden {
+			continue
+		}
+
+		// A copy, taken under the lock: the caller reads the fields after it
+		// is released, and a fold changes a live entry's fields under the
+		// lock (compact.go).
+		entry := *e
+		entries = append(entries, &entry)
+	}
+
+	sort.Slice(entries, func(i, j int) bool {
+		return entries[i].CreatedAt.Before(entries[j].CreatedAt)
+	})
+
+	return entries
+}
+
+// hasChildLocked reports whether any entry's diff is relative to id.
+//
+// It used to walk every entry of the sandbox, and it runs once per delete
+// and once per step of every prune -- under the store's global lock, at the
+// sizes a client in a loop leaves behind. The children table answers it
+// directly.
+func (s *Store) hasChildLocked(sandboxID string, id string) bool {
+	return s.children[sandboxID][id] > 0
+}
+
+// addChildLocked records a published entry under its parent. A root has no
+// parent to record it under.
+func (s *Store) addChildLocked(sandboxID string, parentID string) {
+	if parentID == "" {
+		return
+	}
+
+	counts, ok := s.children[sandboxID]
+	if !ok {
+		counts = make(map[string]int)
+		s.children[sandboxID] = counts
+	}
+
+	counts[parentID]++
+}
+
+// removeChildLocked takes back what addChildLocked recorded for an entry
+// that left the sandbox's entries.
+func (s *Store) removeChildLocked(sandboxID string, parentID string) {
+	if parentID == "" {
+		return
+	}
+
+	counts := s.children[sandboxID]
+
+	switch n := counts[parentID]; {
+	case n > 1:
+		counts[parentID] = n - 1
+	case n == 1:
+		delete(counts, parentID)
+
+		if len(counts) == 0 {
+			delete(s.children, sandboxID)
+		}
+	}
+}
+
+// checkChildCounts recounts a sandbox's children table from its entries and
+// reports how it differs, or nil. A debugging assertion for the tests.
+func (s *Store) checkChildCounts(sandboxID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	want := make(map[string]int)
+	for _, e := range s.bySandbox[sandboxID] {
+		if e.ParentID != "" {
+			want[e.ParentID]++
+		}
+	}
+
+	got := s.children[sandboxID]
+
+	for id, n := range want {
+		if got[id] != n {
+			return fmt.Errorf("sandbox %s: entry %s has %d children, counted %d", sandboxID, id, n, got[id])
+		}
+	}
+
+	for id, n := range got {
+		if _, ok := want[id]; !ok {
+			return fmt.Errorf("sandbox %s: entry %s has no children, counted %d", sandboxID, id, n)
+		}
+	}
+
+	return nil
+}
+
+// Delete removes a checkpoint from the API. An entry that descendants still
+// resolve pages through — one with children, or the parent-to-be of the
+// next checkpoint — is hidden instead of removed: deleting its files would
+// silently break every chain through it (the gsd implementation does exactly
+// that). A leaf is removed physically, and hidden ancestors that just lost
+// their last child are reclaimed with it.
+//
+// Either way the entry's view goes, and a sealed layer that no remaining view
+// and not the live bookkeeping lists is reclaimed with its sidecar (see
+// layerRefs).
+//
+// Only the bookkeeping happens under the store lock. The files -- the removed
+// entry's directory, the directories of the hidden ancestors reclaimed with
+// it, a hidden entry's snapfile and header and its rewritten manifest, the
+// layers that lost their last reference -- are dealt with after it is
+// released; see reclaim for why that is safe.
+//
+// Last, hidden entries left with a single child are folded into it, a few
+// per call (compact.go). The caller holds the sandbox's gate, which the
+// folding relies on.
+//
+// The errors fall on either side of the bookkeeping change:
+//
+//   - ErrCheckpointNotFound (errors.Is): nothing was changed, the id names
+//     nothing this caller may delete.
+//   - *DeleteCleanupError (errors.As): the delete took effect and only the
+//     file work after it failed; see DeleteCleanupError.
+//
+// Anything else would be a failure before the bookkeeping changed. There
+// is none today -- deleteLocked only ever refuses an id -- and a caller
+// treats one as an internal error.
+func (s *Store) Delete(sandboxID string, lifecycleID string, id string, timings sandbox.PhaseTimings) error {
+	var rc reclaim
+
+	removed, hidden, err := s.deleteLocked(sandboxID, lifecycleID, id, timings, &rc)
+	if err != nil {
+		return err
+	}
+
+	// The ancestors pruned with a removed entry were always deleted on a
+	// best-effort basis; only the entry's own directory is the caller's
+	// business.
+	rc.runLogged(sandboxID)
+
+	if hidden != nil {
+		if mfErr := writeManifest(hidden); mfErr != nil {
+			err = &DeleteCleanupError{Err: mfErr}
+		}
+	} else if rmErr := removeAll(removed); rmErr != nil {
+		err = &DeleteCleanupError{Err: fmt.Errorf("failed to remove checkpoint dir: %w", rmErr)}
+	}
+
+	// Folding is the store's own housekeeping: it never fails the delete
+	// that triggered it, and a fold that cannot be done leaves the tree as it
+	// was. It runs last, after the entry this call was about has been dealt
+	// with.
+	s.runCompaction(sandboxID, timings)
+
+	return err
+}
+
+// deleteLocked is the bookkeeping half of Delete. It reports either the
+// directory of the entry it removed, or a copy of the entry it hid -- a copy,
+// so the manifest can be written from it without the lock while the entry
+// itself stays where other callers read it under the lock.
+func (s *Store) deleteLocked(sandboxID string, lifecycleID string, id string, timings sandbox.PhaseTimings, rc *reclaim) (removed string, hidden *Entry, err error) {
+	// A delete is small work behind a big queue: it rewrites the bookkeeping
+	// of one sandbox but takes the same global lock a create holds, so a
+	// slow delete is worth being able to read as somebody else's create.
+	lockStart := time.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	timings.Mark("delete_lock_wait", lockStart)
+
+	// Same rule as Get and List: an earlier generation's tree is not this
+	// caller's to delete from, and it is about to be dropped wholesale
+	// anyway.
+	if !s.ownsLocked(sandboxID, lifecycleID) {
+		return "", nil, notFound("checkpoint %s not found", id)
+	}
+
+	entries, ok := s.bySandbox[sandboxID]
+	if !ok {
+		return "", nil, notFound("checkpoint %s not found: sandbox %s has no checkpoints", id, sandboxID)
+	}
+
+	e, ok := entries[id]
+	if !ok || e.Hidden {
+		return "", nil, notFound("checkpoint %s not found", id)
+	}
+
+	base := s.bases[sandboxID]
+
+	if s.hasChildLocked(sandboxID, id) || base.entryID == id {
+		// Hidden entries are never restore targets, so the snapfile and the
+		// rootfs view go; the diff and its sidecar stay, because descendants
+		// resolve pages through them.
+		rc.file(e.Snapfile)
+		rc.file(e.RootfsHeaderPath())
+		if e.Rootfs != nil && e.Rootfs.HeaderPath != e.RootfsHeaderPath() {
+			// A fold that rewrote the view gave its header a new name.
+			rc.file(e.Rootfs.HeaderPath)
+		}
+
+		// Its view goes, and with it the references the view held. Its own
+		// layer normally survives this: every descendant's view lists it, and
+		// so does the live bookkeeping if this is the base.
+		if e.Rootfs != nil {
+			s.unrefLayersLocked(sandboxID, e.Rootfs.Layers, rc)
+		}
+
+		e.Hidden = true
+		e.Rootfs = nil
+		e.Snapfile = ""
+
+		s.chargeLocked(sandboxID, -(e.bytes.snap + e.bytes.header))
+		e.bytes.snap, e.bytes.header = 0, 0
+
+		s.markIndexLocked(sandboxID)
+
+		// Hidden with one child and not the base: the common case of a client
+		// that deletes its oldest checkpoint. It is folded into that child
+		// once the lock is released.
+		s.queueCompactLocked(sandboxID, id)
+
+		manifest := *e
+
+		return "", &manifest, nil
+	}
+
+	parentID := e.ParentID
+	delete(entries, id)
+	s.removeChildLocked(sandboxID, parentID)
+	s.chargeLocked(sandboxID, -e.bytes.total())
+	s.markIndexLocked(sandboxID)
+
+	// Removed outright: its view's references go. A layer whose count drops
+	// to zero here is in no other checkpoint's view and not in the live
+	// stack's bookkeeping -- typically this leaf's own layer, but not
+	// necessarily: a full-memory root can be a leaf whose layer is listed by
+	// a later root, and then the later root keeps it.
+	if e.Rootfs != nil {
+		s.unrefLayersLocked(sandboxID, e.Rootfs.Layers, rc)
+	}
+
+	s.pruneLocked(sandboxID, entries[parentID], rc)
+
+	return e.Dir, nil, nil
+}
+
+// RemoveSandbox drops every checkpoint, layer and base of a sandbox, for when
+// it goes away. The caller holds the sandbox's operation lock: the files
+// being deleted here are the ones a create or restore reads.
+//
+// What stays is a tombstone and the gate. The tombstone stops a request
+// admitted before the removal from rebuilding the directory tree afterwards
+// -- nothing would ever reclaim it, since the generation it belongs to is
+// gone. The gate stays because dropping it hands the next caller a fresh one:
+// whoever still holds the old gate would then be running alongside them on
+// the same sandbox id, which is exactly what the lock exists to prevent. With
+// pause/resume the id genuinely does come back, which makes keeping the one
+// gate the point rather than an economy: two generations of the same id share
+// the store's directory tree and must not operate on it at once.
+//
+// It reports whether the removal applied. It does not when the id has already
+// been taken over by the generation the node is running now: removals arrive
+// on their own goroutine and a resume can beat one to it, and what is filed
+// under the id then belongs to a live sandbox rather than to the one being
+// removed. The caller finds out so it can leave the rest of that generation's
+// state alone too.
+func (s *Store) RemoveSandbox(sandboxID string) (bool, error) {
+	if err := validateID(sandboxID); err != nil {
+		return false, fmt.Errorf("invalid sandbox id: %w", err)
+	}
+
+	var rc reclaim
+
+	s.mu.Lock()
+
+	own := s.owners[sandboxID]
+	if own.lifecycleID != "" && !own.removed {
+		if live, ok := s.liveGenerationLocked(sandboxID); ok && live == own.lifecycleID {
+			s.mu.Unlock()
+
+			return false, nil
+		}
+	}
+
+	err := s.dropStateLocked(sandboxID, &rc)
+
+	// The tombstone names the generation it buries, so that a later one is
+	// admitted on its own merits instead of inheriting this refusal.
+	s.owners[sandboxID] = ownerRef{lifecycleID: own.lifecycleID, removed: true}
+
+	s.mu.Unlock()
+
+	// The tree was moved aside under the lock; deleting it is this caller's
+	// time, not every other sandbox's.
+	if rmErr := rc.run(); rmErr != nil && err == nil {
+		err = fmt.Errorf("failed to remove sandbox checkpoints: %w", rmErr)
+	}
+
+	return true, err
+}
+
+// AdoptSandbox files a sandbox id under a newly inserted generation, dropping
+// what the generation before it left there. It reports whether it changed
+// anything.
+//
+// Nothing depends on it: a new generation's first checkpoint takes the id over
+// by itself (see admitLocked), because an insert is announced asynchronously
+// and can lose the race to the first request. What it buys is that the
+// previous generation's files are reclaimed promptly even if the new sandbox
+// never checkpoints at all, and that the ordinary case does not rest on a
+// liveness lookup at all.
+//
+// The caller holds the sandbox's operation lock, for the same reason a removal
+// does: this deletes files an operation of the previous generation may still
+// be reading.
+func (s *Store) AdoptSandbox(sandboxID string, lifecycleID string) bool {
+	if lifecycleID == "" {
+		return false
+	}
+
+	if err := validateID(sandboxID); err != nil {
+		return false
+	}
+
+	// Deferred ahead of the unlock, so it runs after it.
+	var rc reclaim
+	defer rc.runLogged(sandboxID)
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	own, claimed := s.owners[sandboxID]
+	if claimed && own.lifecycleID == lifecycleID && !own.removed {
+		return false
+	}
+
+	// A claimed id is only adoptable by the generation the node is running:
+	// an insert that is announced this late has already been overtaken, and
+	// taking the id from whoever holds it now would be the very bug this
+	// bookkeeping exists to stop.
+	if claimed {
+		if live, ok := s.liveGenerationLocked(sandboxID); !ok || live != lifecycleID {
+			return false
+		}
+	}
+
+	s.handOverLocked(sandboxID, lifecycleID, &rc)
+
+	return true
+}
+
+func writeManifest(e *Entry) error {
+	data, err := json.MarshalIndent(e, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal manifest: %w", err)
+	}
+
+	path := filepath.Join(e.Dir, manifestFileName)
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return fmt.Errorf("failed to write manifest: %w", err)
+	}
+
+	// Same as the artifacts: temp file plus rename for atomic replacement,
+	// no fsync for a durability this store does not claim.
+	if err := os.Rename(tmp, path); err != nil {
+		return fmt.Errorf("failed to replace manifest: %w", err)
+	}
+
+	return nil
+}
+
+// markIndexLocked records that a sandbox's debug index no longer matches its
+// entries. It costs a map insert with the index on and nothing with it off,
+// which is the whole of what the checkpoint path pays for the index now.
+func (s *Store) markIndexLocked(sandboxID string) {
+	if s.indexDirty == nil {
+		return
+	}
+
+	s.indexDirty[sandboxID] = struct{}{}
+}
+
+// snapshotIndexLocked copies the sandbox entries out of the store so the
+// index can be sorted, serialized and written without the lock. Entries are
+// copied by value: everything a manifest shows is a scalar, and the one
+// pointer (the rootfs view) is never mutated after the entry is published.
+func (s *Store) snapshotIndexLocked(sandboxID string) []Entry {
+	entries := make([]Entry, 0, len(s.bySandbox[sandboxID]))
+	for _, e := range s.bySandbox[sandboxID] {
+		entries = append(entries, *e)
+	}
+
+	return entries
+}
+
+// runIndexWriter rewrites the debug index of every sandbox that changed, once
+// per interval, until Close; then once more, so what a finished run leaves
+// on disk is its last state. A sandbox that takes a hundred checkpoints in an
+// interval costs one write, not a hundred.
+func (s *Store) runIndexWriter(interval time.Duration) {
+	defer close(s.indexDone)
+
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ticker.C:
+			s.flushDebugIndex()
+		case <-s.indexStop:
+			s.flushDebugIndex()
+
+			return
+		}
+	}
+}
+
+// flushDebugIndex writes the index of every sandbox marked since the last
+// flush. The store lock is taken once per sandbox and held only to copy that
+// sandbox's entries out; sorting, serializing and writing happen without it,
+// so the writer never holds the lock for longer than one copy. A sandbox that
+// was dropped in the meantime has nothing left to describe and is skipped;
+// its directory is gone with it.
+//
+// Failure is logged, not returned: the index is a debugging aid, and nothing
+// the store does depends on it.
+func (s *Store) flushDebugIndex() {
+	s.mu.Lock()
+	dirty := make([]string, 0, len(s.indexDirty))
+	for sandboxID := range s.indexDirty {
+		dirty = append(dirty, sandboxID)
+	}
+	s.mu.Unlock()
+
+	for _, sandboxID := range dirty {
+		s.mu.Lock()
+		_, marked := s.indexDirty[sandboxID]
+		_, exists := s.bySandbox[sandboxID]
+		delete(s.indexDirty, sandboxID)
+
+		var entries []Entry
+		if marked && exists {
+			entries = s.snapshotIndexLocked(sandboxID)
+		}
+		s.mu.Unlock()
+
+		if !marked || !exists {
+			continue
+		}
+
+		sort.Slice(entries, func(i, j int) bool {
+			return entries[i].CreatedAt.Before(entries[j].CreatedAt)
+		})
+
+		if err := writeIndexFile(filepath.Join(s.root, sandboxID, indexFileName), entries); err != nil {
+			logger.L().Warn(context.Background(), "failed to write checkpoint debug index",
+				logger.WithSandboxID(sandboxID),
+				zap.Error(err))
+		}
+	}
+}
+
+// writeIndex writes an index compactly: it is read by tools, not by people
+// scrolling it, and indenting a thousand-entry index doubles what has to be
+// built and written for nothing.
+func writeIndex(path string, entries []Entry) error {
+	data, err := json.Marshal(entries)
+	if err != nil {
+		return fmt.Errorf("failed to marshal checkpoint index: %w", err)
+	}
+
+	tmp := path + tempSuffix
+	if err := os.WriteFile(tmp, data, 0o644); err != nil {
+		return fmt.Errorf("failed to write checkpoint index: %w", err)
+	}
+
+	if err := os.Rename(tmp, path); err != nil {
+		return fmt.Errorf("failed to replace checkpoint index: %w", err)
+	}
+
+	return nil
+}
+
+// validateID rejects anything that would let an id escape the store root.
+func validateID(id string) error {
+	if id == "" {
+		return fmt.Errorf("empty id")
+	}
+
+	if strings.ContainsAny(id, "/\\") || strings.Contains(id, "..") {
+		return fmt.Errorf("id %q contains path separators", id)
+	}
+
+	return nil
+}
