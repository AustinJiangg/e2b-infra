+apiVersion: apps/v1
+kind: DaemonSet
+metadata:
+  name: template-manager
+  namespace: e2b
+spec:
+  selector:
+    matchLabels: { app: template-manager }
+  template:
+    metadata:
+      labels: { app: template-manager }
+    spec:
+      hostPID: true
+      hostNetwork: true
+      dnsPolicy: ClusterFirstWithHostNet
+      affinity:
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/{{ .Values.build.pool }}
+                operator: Exists
+      containers:
+      - name: template-manager
+        volumeMounts:
+        - name: hugepages
+          mountPath: /mnt/hugepages
+        - name: snapshot-cache
+          mountPath: /mnt/snapshot-cache
+        - name: host-dev
+          mountPath: /dev
+        - name: build-cache
+          mountPath: /orchestrator
+        - name: dev-net-tun
+          mountPath: /dev/net/tun
+        - name: fc-envd
+          mountPath: /fc-envd
+        - name: fc-kernels
+          mountPath: /fc-kernels
+        - name: fc-versions
+          mountPath: /fc-versions
+        - name: fc-vm
+          mountPath: /fc-vm
+        - name: tmp-templates
+          mountPath: /tmp/templates
+        securityContext:
+          privileged: true
