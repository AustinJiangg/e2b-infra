+  namespace: e2b
+spec:
+  selector:
+    matchLabels: { app: orchestrator }
+  template:
+    metadata:
+      labels: { app: orchestrator }
+    spec:
+      hostPID: true
+      hostNetwork: true
+      dnsPolicy: ClusterFirstWithHostNet
+      affinity:
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/{{ .Values.default.pool }}
+                operator: Exists
+      containers:
+      - name: orchestrator
+        volumeMounts:
+        - name: hugepages
+          mountPath: /mnt/hugepages
+        - name: snapshot-cache
+          mountPath: /mnt/snapshot-cache
+        - name: host-dev
+          mountPath: /dev
+        - name: build-cache
+          mountPath: /orchestrator
+        - name: dev-net-tun
+          mountPath: /dev/net/tun
+        - name: fc-envd
+          mountPath: /fc-envd
+        - name: fc-kernels
+          mountPath: /fc-kernels
+        - name: fc-versions
+          mountPath: /fc-versions
+        - name: fc-vm
+          mountPath: /fc-vm
+        - name: tmp-templates
+          mountPath: /tmp/templates
+        securityContext:
+          privileged: true
+        image: {{ .Values.registry }}/orchestrator
+        imagePullPolicy: IfNotPresent
+        command: ["/usr/bin/orchestrator"]
+        args: ["--port", "{{ .Values.orchestratorPort | int }}", "--proxy-port", "{{ .Values.orchestratorProxyPort | int }}"]
+        ports:
+        - containerPort: {{ .Values.orchestratorPort | int }}
+          name: grpc
+        env:
+        - name: NODE_ID
+          valueFrom: { fieldRef: { fieldPath: spec.nodeName } }
+        - name: OTEL_TRACING_PRINT
+          value: "{{ .Values.otelTracingPrint }}"
+        - name: ENVIRONMENT
+          value: "{{ .Values.environment }}"
+        - name: TEMPLATE_BUCKET_NAME
+          value: "{{ .Values.templateBucketName }}"
+        - name: OTEL_COLLECTOR_GRPC_ENDPOINT
+          value: "{{ .Values.otelCollectorGrpcEndpoint }}"
+        - name: LOGS_COLLECTOR_ADDRESS
+          value: "{{ .Values.logsCollectorAddress }}"
+        - name: ORCHESTRATOR_SERVICES
+          value: "orchestrator"
+        - name: LOGS_COLLECTOR_PUBLIC_IP
+          value: "{{ .Values.logsCollectorPublicIp }}"
+        - name: ALLOW_SANDBOX_INTERNET
+          value: "{{ .Values.allowSandboxInternet }}"
+        - name: SHARED_CHUNK_CACHE_PATH
+          value: "{{ .Values.sharedChunkCachePath }}"
+        - name: CLICKHOUSE_CONNECTION_STRING
+          value: "clickhouse://{{ .Values.clickhouseUsername }}:{{ .Values.clickhousePassword }}@127.0.0.1:{{ .Values.clickhouseServerPort | int }}/{{ .Values.clickhouseDatabase }}"
+        - name: REDIS_URL
+          value: "{{ .Values.redisUrl }}:{{ .Values.redisPort | int }}"
+        - name: REDIS_CLUSTER_URL
+          value: "{{ .Values.redisClusterUrl }}"
+        - name: STORAGE_PROVIDER
+          value: "{{ .Values.storageProvider }}"
+        - name: ARTIFACTS_REGISTRY_PROVIDER
+          value: "{{ .Values.artifactsRegistryProvider }}"
+        - name: MINIO_ENDPOINT
+          value: "{{ .Values.minioEndpoint }}"
+        - name: MINIO_ACCESS_KEY
+          value: "{{ .Values.minioAccessKey }}"
+        - name: GRPC_PORT
+          value: "{{ .Values.orchestratorPort }}"
+        - name: PROXY_PORT
+          value: "{{ .Values.orchestratorProxyPort }}"
+        - name: GIN_MODE
+          value: "release"
+        - name: DOMAIN_NAME
+          value: "{{ .Values.domainName }}"
+        resources:
+          requests:
+            cpu: 2
+            memory: 8Gi
+          limits:   { cpu: "2", memory: "8Gi" }
+        livenessProbe:
+          exec:
+            command: ["/bin/grpc_health_probe", "-addr=:{{ .Values.orchestratorPort | int }}"]
+          initialDelaySeconds: 10
+          periodSeconds: 10
+      volumes:
+      - name: hugepages
+        hostPath:
+          path: /mnt/hugepages
+          type: DirectoryOrCreate
+      - name: snapshot-cache
+        hostPath:
+          path: /mnt/snapshot-cache
+          type: DirectoryOrCreate
+      - name: host-dev
+        hostPath:
+          path: /dev
+          type: Directory
+      - name: build-cache
+        hostPath:
+          path: /orchestrator
+          type: DirectoryOrCreate
+      - name: dev-net-tun
+        hostPath:
+          path: /dev/net/tun
+          type: CharDevice
+      - name: fc-envd
+        hostPath:
+          path: /fc-envd
+          type: DirectoryOrCreate
+      - name: fc-kernels
+        hostPath:
+          path: /fc-kernels
+          type: DirectoryOrCreate
+      - name: fc-versions
+        hostPath:
+          path: /fc-versions
+          type: DirectoryOrCreate
+      - name: fc-vm
+        hostPath:
+          path: /fc-vm
+          type: DirectoryOrCreate
+      - name: tmp-templates
+        hostPath:
+          path: /tmp/templates
+          type: DirectoryOrCreate
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: orchestrator
+  namespace: e2b
+spec:
+  clusterIP: None
+  ports:
+  - port: {{ .Values.orchestratorPort | int }}
+    targetPort: grpc
+    name: grpc
+  selector: { app: orchestrator }
diff --git a/helm/templates/otel-collector.yaml b/helm/templates/otel-collector.yaml
new file mode 100644
index 000000000..4efa43b9c
--- /dev/null
+++ b/helm/templates/otel-collector.yaml
@@ -0,0 +1,244 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: otel-config
+  namespace: e2b
+data:
+  otel-collector-config.yaml: |
+    receivers:
+      otlp:
+        protocols:
+          grpc:
+            endpoint: 0.0.0.0:4317
+            max_recv_msg_size_mib: 100
+            read_buffer_size: 10943040
+            max_concurrent_streams: 200
+            write_buffer_size: 10943040
+      prometheus:
+        config:
+          scrape_configs:
+            - job_name: nomad
+              scrape_interval: 15s
+              scrape_timeout: 5s
+              metrics_path: '/v1/metrics'
+              static_configs:
+                - targets: ['localhost:4646']
+              params:
+                format: ['prometheus']
+    processors:
+      batch:
+        timeout: 5s
+      batch/clickhouse:
+        timeout: 5s
+        send_batch_size: 50000
+      filter/otlp:
+        metrics:
+          include:
+            match_type: regexp
+            metric_names:
+              - "orchestrator.*"
+              - "template.*"
+              - "api.*"
+              - "client_proxy.*"
+              - "Click*"
+              - "otelcol.*"
+      filter/prometheus:
+        metrics:
+          include:
+            match_type: strict
+            metric_names:
+              - "nomad_client.host_cpu_total_percent"
+              - "nomad_client_host_cpu_idle"
+              - "nomad_client_host_disk_available"
+              - "nomad_client_host_disk_size"
+              - "nomad_client_host_memory_available"
+              - "nomad_client_host_memory_total"
+              - "nomad_client_allocs_memory_usage"
+              - "nomad_client_allocs_memory_allocated"
+              - "nomad_client_allocs_cpu_total_percent"
+              - "nomad_client_allocs_cpu_allocated"
+      filter/external_metrics:
+        metrics:
+          include:
+            match_type: regexp
+            metric_names:
+              - "e2b.*"
+      metricstransform:
+        transforms:
+          - include: "nomad_client_host_cpu_idle"
+            match_type: strict
+            action: update
+            operations:
+              - action: aggregate_labels
+                aggregation_type: sum
+                label_set: [instance, node_id, node_status, node_pool]
+      resource/local:
+        attributes:
+          - action: upsert
+            key: host.name
+            value: "{{ .Values.nodeName }}"
+          - action: upsert
+            key: service.instance.id
+            value: "{{ .Values.nodeName }}"
+          - action: upsert
+            key: host.type
+            value: "local"
+          - action: upsert
+            key: host.id
+            value: "{{ .Values.nodeId }}"
+          - action: upsert
+            key: deployment.environment
+            value: "{{ .Values.environment }}"
+      transform/set-name:
+        metric_statements:
+          - delete_key(datapoint.attributes, "instance")
+          - delete_key(datapoint.attributes, "node_id")
+          - delete_key(datapoint.attributes, "node_scheduling_eligibility")
+          - delete_key(datapoint.attributes, "node_class")
+          - delete_key(datapoint.attributes, "node_status")
+          - delete_key(datapoint.attributes, "service_name")
+          - set(datapoint.attributes["service.instance.id"], resource.attributes["host.name"])
+      filter/rpc_duration_only:
+        metrics:
+          include:
+            match_type: regexp
+            metric_names:
+              - "rpc.server.duration.*"
+      resource/remove_instance:
+        attributes:
+          - action: delete
+            key: service.instance.id
+    extensions:
+      basicauth/grafana_cloud:
+        client_auth:
+          username: "{{ .Values.grafanaUsername }}"
+          password: "{{ .Values.grafanaOtelCollectorToken }}"
+      health_check:
+        endpoint: 0.0.0.0:13133
+    exporters:
+      debug:
+        verbosity: detailed
+      otlphttp/grafana_cloud:
+        endpoint: "{{ .Values.grafanaOtlpUrl }}/otlp"
