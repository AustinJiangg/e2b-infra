new file mode 100644
index 000000000..8a31f1fc2
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/layerstack.go
@@ -0,0 +1,210 @@
+package block
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// maxStackLayers is how many layers an owner entry can name: layer 0 is the
+// base, leaving 65535 sealed layers above it. A sandbox reaching that has
+// taken 65535 checkpoints without a single snapshot in between.
+const maxStackLayers = int(^uint16(0))
+
+// LayerStack is the read path under a sandbox's write layer: the template
+// base, the layers sealed by past checkpoints, and an index saying which of
+// them owns each block.
+//
+// The index is what makes it different from stacking the layers as a chain of
+// views, each asking the one below whenever it does not have the block. That
+// chain costs one lookup per layer per block read, so a sandbox's disk reads
+// got slower with every checkpoint it had ever taken -- a 128 MiB sequential
+// read measured 2909 MB/s with no layers, 277 MB/s with 20 and 171 MB/s with
+// 50, entirely out of the host page cache, entirely in walking the chain.
+// Here a read takes the block's owner out of an array and goes straight to
+// that layer, so it costs the same at any depth.
+//
+// The index costs one uint16 per block: 512 KiB per GiB of rootfs, per view.
+//
+// It does no locking of its own. Its synchronization is Overlay.mu, one level
+// up: Overlay.ReadAt holds it shared for the whole read and Overlay.Seal holds
+// it exclusively while it appends, so a read never sees a half-updated index,
+// and releasing it publishes the new entries to every later reader. That
+// ordering is what makes appending in place correct, rather than the caller's
+// promise to have paused the VM -- and appending in place is what keeps a
+// memcpy of the whole index out of the guest's freeze window. A restore does
+// not append at all: it builds a whole new stack, outside the freeze, and
+// swaps it in.
+type LayerStack struct {
+	base   ReadonlyDevice
+	layers []*Cache
+	// owner is indexed by block: 0 means the base has the block, k means
+	// layers[k-1] does. A layer sealed later overwrites the entries of the
+	// blocks it holds, which is exactly "the topmost layer wins".
+	owner     []uint16
+	size      int64
+	blockSize int64
+}
+
+var _ ReadonlyDevice = (*LayerStack)(nil)
+
+// NewLayerStack returns a stack of no layers: every block still reads from
+// base, which is what a sandbox that has never checkpointed sees.
+func NewLayerStack(base ReadonlyDevice, size int64) *LayerStack {
+	blockSize := base.BlockSize()
+
+	return &LayerStack{
+		base:      base,
+		owner:     make([]uint16, header.TotalBlocks(size, blockSize)),
+		size:      size,
+		blockSize: blockSize,
+	}
+}
+
+// AppendLayer puts c on top of the stack and gives it every block it holds.
+// It is what Seal does inside the freeze window, so it does no more than
+// write one index entry per block the layer actually has.
+func (s *LayerStack) AppendLayer(c *Cache) error {
+	owner, err := s.push(c)
+	if err != nil {
+		return err
+	}
+
+	c.rangeDirty(func(off int64) {
+		s.claim(off, owner)
+	})
+
+	return nil
+}
+
+// AppendLayerWithBlocks is AppendLayer for a layer reopened from the
+// checkpoint store, whose block list its sidecar already holds.
+//
+// The list is claimed a run of consecutive blocks at a time, each run one
+// fill of the index: a restore does this for every layer of its view, and the
+// bottom layer of a long-lived view holds most of the device.
+func (s *LayerStack) AppendLayerWithBlocks(c *Cache, offsets []int64) error {
+	owner, err := s.push(c)
+	if err != nil {
+		return err
+	}
+
+	forEachRun(offsets, s.blockSize, func(start, n int64) {
+		s.claimRun(start, n, owner)
+	})
+
+	return nil
+}
+
+// push adds the layer and returns its owner number. It checks the one thing
+// that can fail before touching anything, so a rejected layer leaves the
+// stack exactly as it was.
+func (s *LayerStack) push(c *Cache) (uint16, error) {
+	if len(s.layers) >= maxStackLayers {
+		return 0, fmt.Errorf("layer stack is full at %d layers", len(s.layers))
+	}
+
+	s.layers = append(s.layers, c)
+
+	return uint16(len(s.layers)), nil
+}
+
+func (s *LayerStack) claim(off int64, owner uint16) {
+	idx := header.BlockIdx(off, s.blockSize)
+	if idx < 0 || idx >= int64(len(s.owner)) {
+		return
+	}
+
+	s.owner[idx] = owner
+}
+
+// claimRun is claim for each of the n blocks at start, start+blockSize, ...,
+// done as one fill of the index entries they land on.
+//
+// From a start at or above zero the n offsets land on n consecutive entries,
+// whether or not start is on a block boundary, because claim rounds down. It
+// rounds toward zero, though, so below zero they do not: that run -- only a
+// corrupt sidecar has one -- goes through claim offset by offset.
+func (s *LayerStack) claimRun(start, n int64, owner uint16) {
+	if start < 0 {
+		for k := range n {
+			s.claim(start+k*s.blockSize, owner)
+		}
+
+		return
+	}
+
+	first := header.BlockIdx(start, s.blockSize)
+	last := min(first+n, int64(len(s.owner)))
+	if first >= last {
+		return
+	}
+
+	entries := s.owner[first:last]
+	for i := range entries {
+		entries[i] = owner
+	}
+}
+
+// Layers returns the stack's layers, bottom-most first.
+func (s *LayerStack) Layers() []*Cache {
+	return append([]*Cache(nil), s.layers...)
+}
+
+func (s *LayerStack) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	for blockOff := int64(0); blockOff < int64(len(p)); blockOff += s.blockSize {
+		blockStart := off + blockOff
+		b := p[blockOff : blockOff+s.blockSize]
+
+		var owner uint16
+		if idx := header.BlockIdx(blockStart, s.blockSize); idx >= 0 && idx < int64(len(s.owner)) {
+			owner = s.owner[idx]
+		}
+
+		if owner == 0 {
+			n, err := s.base.ReadAt(ctx, b, blockStart)
+			if err != nil {
+				return n, fmt.Errorf("error reading from the base under the layer stack: %w", err)
+			}
+
+			continue
+		}
+
+		n, err := s.layers[owner-1].ReadAt(b, blockStart)
+		if err != nil {
+			return n, fmt.Errorf("error reading from sealed layer %d: %w", owner-1, err)
+		}
+	}
+
+	return len(p), nil
+}
+
+func (s *LayerStack) Size(context.Context) (int64, error) {
+	return s.size, nil
+}
+
+func (s *LayerStack) BlockSize() int64 {
+	return s.blockSize
+}
+
+func (s *LayerStack) Slice(_ context.Context, _, _ int64) ([]byte, error) {
+	return nil, fmt.Errorf("not implemented")
+}
+
+func (s *LayerStack) Header() *header.Header {
+	return s.base.Header()
+}
+
+// Close unmaps the sealed layers, keeping their files, which belong to the
+// checkpoint store and which other views read. The base is not closed; its
+// lifecycle belongs to whoever built it (the template cache).
+func (s *LayerStack) Close() error {
+	var errs []error
+	for _, c := range s.layers {
+		errs = append(errs, c.CloseKeepFile())
+	}
+
+	return errors.Join(errs...)
+}
