+apiVersion: v1
+kind: Service
+metadata:
+  name: template-manager
+  namespace: e2b
+spec:
+  clusterIP: None
+  ports:
+  - port: {{ .Values.templateManagerPort | int }}
+    targetPort: grpc
+    name: grpc
+  selector: { app: template-manager }
