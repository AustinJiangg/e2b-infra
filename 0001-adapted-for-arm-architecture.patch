diff --git a/packages/orchestrator/internal/sandbox/block/seal_test.go b/packages/orchestrator/internal/sandbox/block/seal_test.go
new file mode 100644
index 000000000..3ae215992
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/seal_test.go
@@ -0,0 +1,187 @@
+package block
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+const (
+	sealTestBlockSize = int64(4096)
+	sealTestSize      = int64(16 * 4096)
+)
+
+// baseStub is a ReadonlyDevice whose every byte reads as 'B' — the template
+// base at the bottom of a layer stack.
+type baseStub struct{}
+
+func (baseStub) ReadAt(_ context.Context, p []byte, _ int64) (int, error) {
+	for i := range p {
+		p[i] = 'B'
+	}
+
+	return len(p), nil
+}
+
+func (baseStub) Size(_ context.Context) (int64, error)               { return sealTestSize, nil }
+func (baseStub) BlockSize() int64                                    { return sealTestBlockSize }
+func (baseStub) Slice(context.Context, int64, int64) ([]byte, error) { return nil, nil }
+func (baseStub) Header() *header.Header                              { return nil }
+func (baseStub) Close() error                                        { return nil }
+
+func newSealTestOverlay(t *testing.T) (*Overlay, string) {
+	t.Helper()
+
+	dir := t.TempDir()
+	cache, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(dir, "write-layer-0"), false)
+	require.NoError(t, err)
+
+	return NewOverlay(baseStub{}, cache), dir
+}
+
+func writeBlock(t *testing.T, o *Overlay, blockIdx int64, fill byte) {
+	t.Helper()
+
+	block := make([]byte, sealTestBlockSize)
+	for i := range block {
+		block[i] = fill
+	}
+
+	_, err := o.WriteAt(block, blockIdx*sealTestBlockSize)
+	require.NoError(t, err)
+}
+
+func readBlock(t *testing.T, o *Overlay, blockIdx int64) byte {
+	t.Helper()
+
+	block := make([]byte, sealTestBlockSize)
+	_, err := o.ReadAt(t.Context(), block, blockIdx*sealTestBlockSize)
+	require.NoError(t, err)
+
+	for _, b := range block[1:] {
+		require.Equal(t, block[0], b, "block %d is not uniform", blockIdx)
+	}
+
+	return block[0]
+}
+
+func sealOnce(t *testing.T, o *Overlay, dir string, generation int) *Cache {
+	t.Helper()
+
+	newCache, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(dir, "write-layer-"+string(rune('0'+generation))), false)
+	require.NoError(t, err)
+
+	sealed, err := o.Seal(newCache)
+	require.NoError(t, err)
+
+	return sealed
+}
+
+func TestSealKeepsPreSealWritesReadable(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, 'X')
+	sealOnce(t, o, dir, 1)
+	writeBlock(t, o, 1, 'Y')
+
+	assert.Equal(t, byte('X'), readBlock(t, o, 0), "pre-seal write reads through the sealed layer")
+	assert.Equal(t, byte('Y'), readBlock(t, o, 1), "post-seal write reads from the active layer")
+	assert.Equal(t, byte('B'), readBlock(t, o, 2), "untouched block reads from the base")
+}
+
+func TestSealNewestWriteWins(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, 'X')
+	sealOnce(t, o, dir, 1)
+	writeBlock(t, o, 0, 'Y')
+	sealOnce(t, o, dir, 2)
+	writeBlock(t, o, 0, 'Z')
+
+	assert.Equal(t, byte('Z'), readBlock(t, o, 0))
+}
+
+func TestSealChainAcrossGenerations(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, '1')
+	sealOnce(t, o, dir, 1)
+	writeBlock(t, o, 1, '2')
+	sealOnce(t, o, dir, 2)
+	writeBlock(t, o, 2, '3')
+
+	assert.Equal(t, byte('1'), readBlock(t, o, 0), "layer sealed two generations ago")
+	assert.Equal(t, byte('2'), readBlock(t, o, 1), "layer sealed one generation ago")
+	assert.Equal(t, byte('3'), readBlock(t, o, 2), "active layer")
+	assert.Equal(t, byte('B'), readBlock(t, o, 3), "base")
+}
+
+func TestSealedLayerReportsItsBlocks(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, 'X')
+	writeBlock(t, o, 5, 'X')
+	sealed := sealOnce(t, o, dir, 1)
+
+	assert.Equal(t, []int64{0, 5 * sealTestBlockSize}, sealed.DirtyOffsets())
+}
+
+func TestCloseKeepsSealedLayerFiles(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, 'X')
+	sealed := sealOnce(t, o, dir, 1)
+
+	sealedPath := filepath.Join(dir, "sealed-layer")
+	require.NoError(t, sealed.Sync())
+	require.NoError(t, sealed.MoveFile(sealedPath))
+
+	require.NoError(t, o.Close())
+
+	_, err := os.Stat(sealedPath)
+	assert.NoError(t, err, "the sealed layer file belongs to the store and survives Close")
+
+	_, err = os.Stat(filepath.Join(dir, "write-layer-1"))
+	assert.True(t, os.IsNotExist(err), "the active write layer file is removed with the overlay")
+}
+
+func TestMarkCachedReopensSealedLayer(t *testing.T) {
+	o, dir := newSealTestOverlay(t)
+
+	writeBlock(t, o, 0, 'X')
+	sealed := sealOnce(t, o, dir, 1)
+	offsets := sealed.DirtyOffsets()
+
+	sealedPath := filepath.Join(dir, "sealed-layer")
+	require.NoError(t, sealed.Sync())
+	require.NoError(t, sealed.MoveFile(sealedPath))
+	require.NoError(t, o.Close())
+
+	// A restore reopens the raw layer file and rebuilds the same view.
+	reopened, err := NewCache(sealTestSize, sealTestBlockSize, sealedPath, false)
+	require.NoError(t, err)
+	defer reopened.CloseKeepFile()
+
+	reopened.MarkCached(offsets)
+
+	view := NewOverlay(NewSealedView(baseStub{}, reopened), mustCache(t, dir, "write-layer-2"))
+	defer view.Close()
+
+	assert.Equal(t, byte('X'), readBlock(t, view, 0), "the reopened layer serves its block")
+	assert.Equal(t, byte('B'), readBlock(t, view, 1), "holes fall through to the base")
+}
+
+func mustCache(t *testing.T, dir, name string) *Cache {
+	t.Helper()
+
+	c, err := NewCache(sealTestSize, sealTestBlockSize, filepath.Join(dir, name), false)
+	require.NoError(t, err)
+
+	return c
+}
diff --git a/packages/orchestrator/internal/sandbox/block/sealed_view.go b/packages/orchestrator/internal/sandbox/block/sealed_view.go
new file mode 100644
index 000000000..ff32ab5d8
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/block/sealed_view.go
@@ -0,0 +1,85 @@
+package block
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+)
+
+// SealedView is what a write layer becomes after Overlay.Seal: a read-only
+// overlay of the sealed layer on top of the read path that was below it. The
+// running VM keeps reading its pre-seal writes through here, while new writes
+// go to the fresh layer above. Sealing k times yields a chain of k views —
+// the OverlayFS lower stack, transplanted to host block level.
+//
+// The chain is a read path for the running sandbox only; restores read
+// through a merged header instead, so chain depth never affects them.
+type SealedView struct {
+	device    ReadonlyDevice
+	cache     *Cache
+	blockSize int64
+}
+
+var _ ReadonlyDevice = (*SealedView)(nil)
+
+func NewSealedView(device ReadonlyDevice, cache *Cache) *SealedView {
+	return &SealedView{
+		device:    device,
+		cache:     cache,
+		blockSize: device.BlockSize(),
+	}
+}
+
+func (v *SealedView) ReadAt(ctx context.Context, p []byte, off int64) (int, error) {
+	blocks := header.BlocksOffsets(int64(len(p)), v.blockSize)
+
+	for _, blockOff := range blocks {
+		n, err := v.cache.ReadAt(p[blockOff:blockOff+v.blockSize], off+blockOff)
+		if err == nil {
+			continue
+		}
+
+		if !errors.As(err, &BytesNotAvailableError{}) {
+			return n, fmt.Errorf("error reading from sealed layer: %w", err)
+		}
+
+		n, err = v.device.ReadAt(ctx, p[blockOff:blockOff+v.blockSize], off+blockOff)
+		if err != nil {
+			return n, fmt.Errorf("error reading from device below sealed layer: %w", err)
+		}
+	}
+
+	return len(p), nil
+}
+
+func (v *SealedView) Size(ctx context.Context) (int64, error) {
+	return v.cache.Size()
+}
+
+func (v *SealedView) BlockSize() int64 {
+	return v.blockSize
+}
+
+func (v *SealedView) Slice(_ context.Context, _, _ int64) ([]byte, error) {
+	return nil, fmt.Errorf("not implemented")
+}
+
+func (v *SealedView) Header() *header.Header {
+	return v.device.Header()
+}
+
+// Close unmaps the sealed layer — keeping its file, which belongs to the
+// checkpoint store — and closes any sealed views below it. The device at the
+// bottom of the chain is not closed; its lifecycle belongs to whoever built
+// it (the template cache).
+func (v *SealedView) Close() error {
+	err := v.cache.CloseKeepFile()
+
+	if below, ok := v.device.(*SealedView); ok {
+		err = errors.Join(err, below.Close())
+	}
+
+	return err
+}
