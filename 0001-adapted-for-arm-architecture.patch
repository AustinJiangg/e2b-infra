+			Url:                backendURL,
+			SandboxId:          "test-sandbox",
+			DefaultToPortError: true,
+			RequestLogger:      logger.NewNopLogger(),
+			ConnectionKey:      "backend-1",
+			OnTransportError: func(reqStart time.Time, _ error) *pool.ErrorAnswer {
+				select {
+				case starts <- reqStart:
+				default:
+				}
+
+				return &pool.ErrorAnswer{
+					Status:      http.StatusConflict,
+					ContentType: "application/json",
+					Body:        []byte(`{"code":"aborted","reason":"sandbox_restored"}`),
+				}
+			},
+		}, nil
+	}
+
+	proxy, port, err := newTestProxy(t, getDestination)
+	require.NoError(t, err)
+
+	defer proxy.Close()
+
+	resp, err := httpGet(t, fmt.Sprintf("http://127.0.0.1:%d/hello", port))
+	require.NoError(t, err)
+
+	defer resp.Body.Close()
+
+	assert.Equal(t, http.StatusConflict, resp.StatusCode)
+
+	body, err := io.ReadAll(resp.Body)
+	require.NoError(t, err)
+	assert.Contains(t, string(body), "sandbox_restored")
+
+	select {
+	case start := <-starts:
+		assert.False(t, start.IsZero(), "the hook is told when the request reached the proxy")
+	default:
+		t.Fatal("the hook was never called")
+	}
+}
+
+// TestDestinationWithoutAHookKeepsTheOldAnswer: the field is optional and a
