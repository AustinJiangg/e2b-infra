diff --git a/packages/orchestrator/internal/sandbox/fc/rollback.go b/packages/orchestrator/internal/sandbox/fc/rollback.go
new file mode 100644
index 000000000..f3b172cc7
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/fc/rollback.go
@@ -0,0 +1,286 @@
+package fc
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strings"
+)
+
+// RollbackResult is the forked Firecracker's response to a successful
+// in-place rollback.
+type RollbackResult struct {
+	RestoredPages int64 `json:"restored_pages"`
+	RestoredBytes int64 `json:"restored_bytes"`
+	TimingsUs     struct {
+		Validate uint64 `json:"validate"`
+		Quiesce  uint64 `json:"quiesce"`
+		// Bitmap is the dirty-bitmap phase of the rollback. A Firecracker
+		// that predates the field simply leaves it at zero, which is how a
+		// phase that was not measured reads everywhere else in this map.
+		Bitmap  uint64 `json:"bitmap"`
+		Memory  uint64 `json:"memory"`
+		Vcpus   uint64 `json:"vcpus"`
+		Gic     uint64 `json:"gic"`
+		Devices uint64 `json:"devices"`
+		Total   uint64 `json:"total"`
+	} `json:"timings_us"`
+
+	// VcpuCounters is what the fork counted while it put the vCPUs back.
+	// It is a pointer because "this Firecracker does not report the
+	// counters" and "it reported zeros" are different answers and only one
+	// of them is good news: a build without the field must not be read as a
+	// rollback that drained nothing and mismatched nothing.
+	VcpuCounters *VcpuCounters `json:"vcpu_counters"`
+}
+
+// VcpuCounters is the forked Firecracker's account of the vCPU half of a
+// rollback: how often an in-flight MMIO access had to be drained before a
+// vCPU could be rewound, how often that draining failed, and how often a
+// core register read back as something other than what was written.
+//
+// The first three are increments for this one rollback; the last is the
+// count the Firecracker process has accumulated over every pause it has
+// done, which is what makes a rollback's own numbers readable against the
+// process's history.
+//
+// A field the fork does not send reads as zero, the same way a phase it did
+// not measure reads as zero in TimingsUs. Absence is only tellable for the
+// object as a whole, which is the distinction that matters: the fields are
+// added together or not at all.
+type VcpuCounters struct {
+	MmioDrained           uint64 `json:"mmio_drained"`
+	MmioDrainFailed       uint64 `json:"mmio_drain_failed"`
+	ReadbackMismatch      uint64 `json:"readback_mismatch"`
+	MmioDrainedPauseTotal uint64 `json:"mmio_drained_pause_total"`
+}
+
+// RollbackUnsupportedError marks a Firecracker that does not know the
+// rollback endpoint — an unmodified binary. The orchestrator and Firecracker
+// ship as a pair; mismatched binaries fail the restore rather than degrade.
+type RollbackUnsupportedError struct{}
+
+func (RollbackUnsupportedError) Error() string {
+	return "this firecracker does not support in-place rollback"
+}
+
+// RollbackFaultedError marks a rollback that failed past its commit point:
+// the VM is torn between two moments in time, refuses to resume, and must be
+// replaced. The caller's only move is the kill-and-rebuild fallback.
+type RollbackFaultedError struct {
+	Message string
+}
+
+func (e RollbackFaultedError) Error() string {
+	return fmt.Sprintf("rollback failed past the commit point, VM is faulted: %s", e.Message)
+}
+
+// rollbackSnapshot calls the forked Firecracker's PUT /snapshot/rollback.
+// The endpoint is not in the generated OpenAPI client (it exists only in the
+// fork), so this is a plain HTTP call over the same API socket.
+func (c *apiClient) rollbackSnapshot(
+	ctx context.Context,
+	socketPath string,
+	snapfilePath string,
+	memFilePath string,
+	revertBitmapPath string,
+) (*RollbackResult, error) {
+	body := map[string]any{
+		"snapshot_path": snapfilePath,
+		"mem_file_path": memFilePath,
+		// The VM is resumed by the orchestrator after the disk view has been
+		// switched, not by Firecracker.
+		"resume_vm": false,
+	}
+	if revertBitmapPath != "" {
+		body["revert_bitmap_path"] = revertBitmapPath
+	}
+
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return nil, fmt.Errorf("error encoding rollback request: %w", err)
+	}
+
+	httpClient := &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+				var d net.Dialer
+
+				return d.DialContext(ctx, "unix", socketPath)
+			},
+			// Firecracker's API server caps concurrent connections. This
+			// client is built per call, so a pooled connection would stay
+			// open until the transport is collected: a sandbox rolled back
+			// often enough exhausts the cap and every later rollback is
+			// refused with 503.
+			DisableKeepAlives: true,
+		},
+		// No ceiling here: the caller bounds the call with its own deadline
+		// (CHECKPOINT_FC_CALL_TIMEOUT), and a second, fixed one hidden in
+		// the transport would silently win whenever the two disagree.
+		Timeout: 0,
+	}
+	defer httpClient.CloseIdleConnections()
+
+	req, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodPut,
+		"http://localhost/snapshot/rollback",
+		bytes.NewReader(payload),
+	)
+	if err != nil {
+		return nil, fmt.Errorf("error building rollback request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	res, err := httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("error calling rollback: %w", err)
+	}
+	defer res.Body.Close()
+
+	resBody, err := io.ReadAll(io.LimitReader(res.Body, 1<<20))
+	if err != nil {
+		return nil, fmt.Errorf("error reading rollback response: %w", err)
+	}
+
+	if res.StatusCode == http.StatusOK || res.StatusCode == http.StatusNoContent {
+		result := &RollbackResult{}
+		if len(resBody) > 0 {
+			if err := json.Unmarshal(resBody, result); err != nil {
+				return nil, fmt.Errorf("error decoding rollback response: %w", err)
+			}
+		}
+
+		return result, nil
+	}
+
+	return nil, classifyRollbackFailure(res.StatusCode, resBody)
+}
+
+// fcErrorBody is Firecracker's error body. fault_message has always been
+// there and carries prose; fault is the fork's machine-readable answer to
+// the only question the caller has to decide on -- is this microVM still
+// there. It is a pointer so that "the field is absent" (a Firecracker from
+// before it existed) is tellable from "the field says false".
+type fcErrorBody struct {
+	FaultMessage string `json:"fault_message"`
+	Fault        *bool  `json:"fault"`
+}
+
+// classifyRollbackFailure turns a non-2xx rollback response into the error
+// the caller acts on, off the status and one field rather than off prose:
+// the fork answers 500 with "fault": true for a failure past the commit
+// point (the VM is branded Faulted, refuses to resume and has to be
+// replaced) and 400 for everything before it, which left the VM resumable.
+// Deciding this wrong is expensive in both directions -- a torn VM taken for
+// a resumable one is silent corruption, a resumable one taken for torn is a
+// sandbox killed for nothing -- and Firecracker is another repository that
+// rewords its errors whenever it likes.
+func classifyRollbackFailure(status int, body []byte) error {
+	var parsed fcErrorBody
+	_ = json.Unmarshal(body, &parsed)
+
+	message := string(body)
+	if parsed.FaultMessage != "" {
+		message = parsed.FaultMessage
+	}
+
+	// A Firecracker without the route at all: an unmodified binary answers
+	// 400 "Invalid request method and/or path" for a path it does not know,
+	// and anything else in front of the socket answers 404.
+	if status == http.StatusNotFound ||
+		(status == http.StatusBadRequest && strings.Contains(message, "Invalid request method and/or path")) {
+		return RollbackUnsupportedError{}
+	}
+
+	if parsed.Fault != nil {
+		// The field is the contract; the status only has to agree with it.
+		if *parsed.Fault {
+			return RollbackFaultedError{Message: message}
+		}
+
+		return fmt.Errorf("rollback failed with status %d: %s", status, message)
+	}
+
+	// Fallback for a Firecracker built before the fault field existed (fork
+	// commit b6dba4c): back then a post-commit failure was a 400 like any
+	// other and said "Faulted" only in the prose. Drop this branch once no
+	// such binary can be deployed.
+	if bytes.Contains(body, []byte("Faulted")) || bytes.Contains(body, []byte("faulted")) {
+		return RollbackFaultedError{Message: message}
+	}
+
+	return fmt.Errorf("rollback failed with status %d: %s", status, message)
+}
+
+// saveDirtyBitmap calls the forked Firecracker's PUT
+// /snapshot/save-dirty-bitmap: the live dirty bitmap is written to path in
+// the FCDB sidecar format. Requires the VM to be paused.
+func (c *apiClient) saveDirtyBitmap(ctx context.Context, socketPath string, path string) error {
+	payload, err := json.Marshal(map[string]any{"path": path})
+	if err != nil {
+		return fmt.Errorf("error encoding save-dirty-bitmap request: %w", err)
+	}
+
+	httpClient := &http.Client{
+		Transport: &http.Transport{
+			DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+				var d net.Dialer
+
+				return d.DialContext(ctx, "unix", socketPath)
+			},
+			// Same reason as rollbackSnapshot: this client lives for one
+			// call, and pooled connections would pile up against
+			// Firecracker's connection cap.
+			DisableKeepAlives: true,
+		},
+		// Same as rollbackSnapshot: the deadline comes from the caller.
+		Timeout: 0,
+	}
+	defer httpClient.CloseIdleConnections()
+
+	req, err := http.NewRequestWithContext(
+		ctx,
+		http.MethodPut,
+		"http://localhost/snapshot/save-dirty-bitmap",
+		bytes.NewReader(payload),
+	)
+	if err != nil {
+		return fmt.Errorf("error building save-dirty-bitmap request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	res, err := httpClient.Do(req)
+	if err != nil {
+		return fmt.Errorf("error calling save-dirty-bitmap: %w", err)
+	}
+	defer res.Body.Close()
+
+	resBody, _ := io.ReadAll(io.LimitReader(res.Body, 1<<20))
+	if res.StatusCode == http.StatusOK || res.StatusCode == http.StatusNoContent {
+		return nil
+	}
+
+	// An unpatched Firecracker answers 400 "Invalid request method and/or
+	// path" for routes it does not have.
+	if res.StatusCode == http.StatusNotFound ||
+		(res.StatusCode == http.StatusBadRequest && strings.Contains(string(resBody), "Invalid request method and/or path")) {
+		return fmt.Errorf("%w: save-dirty-bitmap: status %d: %s", errRouteMissing, res.StatusCode, string(resBody))
+	}
+
+	return fmt.Errorf("save-dirty-bitmap failed with status %d: %s", res.StatusCode, string(resBody))
+}
+
+// errRouteMissing marks a Firecracker API call the running binary does not
+// implement, as opposed to one it refused.
+var errRouteMissing = errors.New("firecracker route missing")
+
+func isMissingRoute(err error) bool {
+	return errors.Is(err, errRouteMissing)
+}
