+// TestDestinationAnswersItsOwnTransportFailures: "port is not open" is a
+// guess, and it is the wrong one whenever the owner of the sandbox did
+// something to it under the request -- a rollback, say, after which the
+// guest has never heard of the connection. The owner gets to answer.
+func TestDestinationAnswersItsOwnTransportFailures(t *testing.T) {
+	t.Parallel()
+
+	var lisCfg net.ListenConfig
+
+	listener, err := lisCfg.Listen(t.Context(), "tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+
+	backend, err := newTestBackend(listener, "backend-1")
+	require.NoError(t, err)
+
+	backendURL := backend.url
+
+	// Nothing is listening any more: every attempt to reach it fails in the
+	// transport, which is what a dropped connection looks like too.
+	require.NoError(t, backend.Close())
+
+	starts := make(chan time.Time, 1)
+
