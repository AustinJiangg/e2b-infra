diff --git a/packages/orchestrator/internal/sandbox/network/conntrack.go b/packages/orchestrator/internal/sandbox/network/conntrack.go
new file mode 100644
index 000000000..0bc27bdd2
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/network/conntrack.go
@@ -0,0 +1,194 @@
+package network
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/containernetworking/plugins/pkg/ns"
+	"github.com/vishvananda/netlink"
+	"go.opentelemetry.io/otel/attribute"
+	"go.opentelemetry.io/otel/trace"
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// FlushConntrack drops the kernel's connection tracking state for this slot's
+// sandbox, in the sandbox's own network namespace and in the host's.
+//
+// It exists for rollback. A restored guest has forgotten connections the
+// kernel still tracks, and its TCP sequence numbers have gone backwards.
+// Entries left behind make the kernel judge the guest's packets invalid and
+// drop them, so a connection that outlives a rollback hangs rather than
+// failing — the worst failure mode to debug. Dropping the state lets the
+// guest's packets start fresh flows, which is what the guest believes it is
+// doing anyway.
+//
+// Call it while the VM is down, between stopping the old Firecracker process
+// and resuming the restored one: no traffic exists then, so nothing can
+// re-create an entry that is about to be wrong.
+//
+// The two halves touch different tables and neither needs the other done
+// first, so the namespace is flushed while the host-side request waits for
+// its sweep rather than before the request is made. The flush is a few
+// milliseconds under the kernel's global conntrack mutex; the host side's
+// wait is the sweep already walking plus its own, which is the longer of
+// the two whenever restores come in faster than one per sweep.
+func (s *Slot) FlushConntrack(ctx context.Context) (ConntrackFlushReport, error) {
+	ctx, span := tracer.Start(ctx, "slot-conntrack-flush", trace.WithAttributes(
+		attribute.String("namespace_id", s.NamespaceID()),
+	))
+	defer span.End()
+
+	var (
+		report  ConntrackFlushReport
+		hostErr error
+	)
+
+	hostDone := make(chan struct{})
+
+	go func() {
+		defer close(hostDone)
+
+		report.Host, hostErr = s.deleteHostConntrack(ctx)
+	}()
+
+	start := time.Now()
+	nsErr := s.flushNamespaceConntrack(ctx)
+	report.Namespace = time.Since(start)
+
+	<-hostDone
+
+	return report, errors.Join(nsErr, hostErr)
+}
+
+// ConntrackFlushReport is where one FlushConntrack spent its time, for the
+// restore's phase breakdown. The flush's own wall clock is the longer of the
+// two halves, which run side by side.
+type ConntrackFlushReport struct {
+	// Namespace is the flush of the sandbox's own table.
+	Namespace time.Duration
+	// Host is the host-side delete, as the sweep that served it saw it.
+	Host HostSweepReport
+}
+
+// flushNamespaceConntrack empties the table inside the sandbox's namespace,
+// which tracks nothing but this sandbox's flows.
+//
+// It uses the socket the slot has held since its network was created.
+// Entering the namespace to make the call instead means a socket per flush,
+// and closing one of those is what put hundreds of milliseconds into
+// restores (see conntrack_handles.go). That way stays as the fallback, for
+// a slot that never got a socket and for one whose socket has just failed.
+func (s *Slot) flushNamespaceConntrack(ctx context.Context) error {
+	if h := s.conntrackHandle.Load(); h != nil {
+		err := flushViaHandle(h)
+		if err == nil {
+			return nil
+		}
+
+		// A failed request can leave an unread answer behind, and the next
+		// one would read it as its own. The slot goes on without a socket
+		// rather than with one that lies.
+		s.discardConntrackHandle()
+
+		if s.conntrackHandleWarned.CompareAndSwap(false, true) {
+			logger.L().Warn(ctx, "the slot's conntrack socket failed; entering its namespace for every flush from now on",
+				zap.String("namespace_id", s.NamespaceID()),
+				zap.Error(err))
+		}
+	}
+
+	return s.flushNamespaceConntrackBySetns()
+}
+
+// flushNamespaceConntrackBySetns is the fallback: enter the namespace and
+// let the library open a socket there for the one call.
+func (s *Slot) flushNamespaceConntrackBySetns() error {
+	n, err := ns.GetNS(filepath.Join(netNamespacesDir, s.NamespaceID()))
+	if err != nil {
+		return fmt.Errorf("failed to get slot network namespace '%s': %w", s.NamespaceID(), err)
+	}
+	defer n.Close()
+
+	err = n.Do(func(_ ns.NetNS) error {
+		// netlink opens a socket per request as long as the package handle
+		// owns none, so this lands in the namespace this callback runs in
+		// rather than in the host's.
+		return netlink.ConntrackTableFlush(netlink.ConntrackTable)
+	})
+	if err != nil {
+		return fmt.Errorf("failed to flush conntrack in namespace '%s': %w", s.NamespaceID(), err)
+	}
+
+	return nil
+}
+
+// deleteHostConntrack removes this slot's flows from the host's table,
+// which is shared with every other sandbox on the node and must not be
+// flushed wholesale. Guest traffic on its way out reaches the host already
+// SNATed to the slot's address, and traffic on its way in is addressed to
+// it, so matching that address in either direction covers both.
+//
+// The work itself is done by the sweeper, together with whatever other
+// slots are waiting: the kernel walks its whole table for any one of them
+// and will not do two such walks at once (conntrack_sweeper.go).
+func (s *Slot) deleteHostConntrack(ctx context.Context) (HostSweepReport, error) {
+	report, err := sweepHostConntrack(ctx, s.HostIP)
+	if err != nil {
+		return report, fmt.Errorf("failed to delete host conntrack entries for %s: %w", s.HostIPString(), err)
+	}
+
+	return report, nil
+}
+
+// conntrackFilterUnsupported remembers a kernel that refused the dump
+// filter, so the first restore pays one failed request and the rest go
+// straight to the fallback.
+var conntrackFilterUnsupported atomic.Bool
+
+// hostConntrackCountPath is where the kernel publishes the size of the
+// table the choice above turns on. A variable so a test can point it
+// somewhere it is allowed to write.
+var hostConntrackCountPath = "/proc/sys/net/netfilter/nf_conntrack_count"
+
+// hostConntrackCount reads how many entries the host's table holds, which
+// is what the choice between the two ways of deleting turns on.
+//
+// It costs one small read and it is what separates a node doing nothing (a
+// few hundred entries, where asking the kernel to filter is pure loss) from
+// one under load (tens of thousands, where a single address is cheaper to
+// filter for). A count that cannot be read means the node is not the one
+// this was measured on, and the answer is the whole-table pass, which is
+// right for any table a batch is likely to meet.
+func hostConntrackCount() (int, bool) {
+	raw, err := os.ReadFile(hostConntrackCountPath)
+	if err != nil {
+		if conntrackCountUnreadable.CompareAndSwap(false, true) {
+			logger.L().Warn(context.Background(),
+				"cannot read the host conntrack count; deleting entries by scanning the whole table",
+				zap.String("path", hostConntrackCountPath),
+				zap.Error(err))
+		}
+
+		return 0, false
+	}
+
+	count, err := strconv.Atoi(strings.TrimSpace(string(raw)))
+	if err != nil {
+		return 0, false
+	}
+
+	return count, true
+}
+
+// conntrackCountUnreadable keeps the warning above to one per process: this
+// runs on every restore and the answer will not change.
+var conntrackCountUnreadable atomic.Bool
diff --git a/packages/orchestrator/internal/sandbox/network/conntrack_filter.go b/packages/orchestrator/internal/sandbox/network/conntrack_filter.go
new file mode 100644
index 000000000..b037009b0
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/network/conntrack_filter.go
@@ -0,0 +1,293 @@
+package network
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"net"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+// Attribute numbers from include/uapi/linux/netfilter/nfnetlink_conntrack.h
+// that vishvananda/netlink does not name. CTA_FILTER is the one that matters:
+// it turns a conntrack dump from "send me everything" into "send me what
+// matches", which is the difference between carrying the whole host table
+// into user space and carrying this slot's handful of entries.
+const (
+	ctaTupleOrig = 1
+	ctaTupleIP   = 1
+	ctaIPV4Src   = 1
+	ctaIPV4Dst   = 2
+	ctaFilter    = 25
+
+	// enum ctattr_filter
+	ctaFilterOrigFlags = 1
+
+	// enum cta_filter_flags: which fields of the tuple the kernel is being
+	// asked to compare. One filter's conditions are ANDed, so matching an
+	// address in either direction takes two dumps.
+	ctaFilterFlagIPSrc = 1 << 0
+	ctaFilterFlagIPDst = 1 << 1
+
+	// The bits nla_type() masks off: NLA_F_NESTED and NLA_F_NET_BYTEORDER.
+	nlaTypeMask = 0x3fff
+)
+
+// errConntrackFilterUnsupported marks a kernel that will not take the dump
+// filter, so the caller can fall back instead of leaving the entries behind.
+var errConntrackFilterUnsupported = errors.New("kernel does not support filtered conntrack dumps")
+
+// ctDirection is which half of an entry's original tuple an address is
+// matched against. Both are needed: guest traffic leaves the host SNATed to
+// the slot's address and arriving traffic is addressed to it.
+type ctDirection int
+
+const (
+	ctOrigSrc ctDirection = iota
+	ctOrigDst
+)
+
+func (d ctDirection) attr() int {
+	if d == ctOrigSrc {
+		return ctaIPV4Src
+	}
+
+	return ctaIPV4Dst
+}
+
+func (d ctDirection) flag() uint32 {
+	if d == ctOrigSrc {
+		return ctaFilterFlagIPSrc
+	}
+
+	return ctaFilterFlagIPDst
+}
+
+// newFilteredDumpRequest builds the CTNETLINK dump that asks the kernel for
+// the IPv4 entries whose original tuple carries ip in the given position.
+//
+// The message is the one libnetfilter_conntrack sends: the tuple the
+// addresses live in, plus CTA_FILTER naming which of its fields the kernel
+// should actually compare. A kernel that predates CTA_FILTER parses the
+// attribute it knows and ignores the rest, which is why what comes back is
+// checked again before anything is deleted.
+func newFilteredDumpRequest(ip net.IP, direction ctDirection) (*nl.NetlinkRequest, error) {
+	v4 := ip.To4()
+	if v4 == nil {
+		return nil, fmt.Errorf("conntrack dump filter needs an IPv4 address, got %q", ip)
+	}
+
+	req := nl.NewNetlinkRequest((netlink.ConntrackTable<<8)|nl.IPCTNL_MSG_CT_GET, unix.NLM_F_DUMP)
+	req.AddData(&nl.Nfgenmsg{
+		NfgenFamily: unix.AF_INET,
+		Version:     nl.NFNETLINK_V0,
+		ResId:       0,
+	})
+
+	tuple := nl.NewRtAttr(unix.NLA_F_NESTED|ctaTupleOrig, nil)
+	tupleIP := nl.NewRtAttr(unix.NLA_F_NESTED|ctaTupleIP, nil)
+	tupleIP.AddChild(nl.NewRtAttr(direction.attr(), []byte(v4)))
+	tuple.AddChild(tupleIP)
+	req.AddData(tuple)
+
+	filter := nl.NewRtAttr(unix.NLA_F_NESTED|ctaFilter, nil)
+	filter.AddChild(nl.NewRtAttr(ctaFilterOrigFlags, nl.Uint32Attr(direction.flag())))
+	req.AddData(filter)
+
+	return req, nil
+}
+
+// dumpFilteredConntrack returns the raw messages the kernel answered the
+// filtered dump with, still in wire form because deleting an entry means
+// handing its own tuple back.
+func dumpFilteredConntrack(sock *nl.SocketHandle, ip net.IP, direction ctDirection) ([][]byte, error) {
+	req, err := newFilteredDumpRequest(ip, direction)
+	if err != nil {
+		return nil, err
+	}
+
+	useSocket(req, sock)
+
+	res, err := req.Execute(unix.NETLINK_NETFILTER, 0)
+	if err != nil {
+		if unsupportedFilterError(err) {
+			return nil, fmt.Errorf("%w: %w", errConntrackFilterUnsupported, err)
+		}
+
+		// A dump the kernel restarted may be short. Deleting what did come
+		// back is still right; the entries that were missed are the ones a
+		// full-table pass would have had to find anyway.
+		if !errors.Is(err, netlink.ErrDumpInterrupted) {
+			return nil, err
+		}
+	}
+
+	return res, nil
+}
+
+// unsupportedFilterError reports whether the kernel refused the request
+// because of the filter rather than because of the entries. EINVAL is what a
+// kernel that knows CTA_FILTER but not this shape of it answers, and
+// EOPNOTSUPP is what one answers to filter flags it cannot honour.
+func unsupportedFilterError(err error) bool {
+	return errors.Is(err, unix.EINVAL) ||
+		errors.Is(err, unix.EOPNOTSUPP) ||
+		errors.Is(err, unix.EAFNOSUPPORT) ||
+		errors.Is(err, unix.EPROTONOSUPPORT)
+}
+
+// useSocket points a request at a socket that outlives it. Without one the
+// library opens a socket for the request and closes it again afterwards,
+// and that close is what this package goes to such lengths to avoid; nil is
+// still allowed, because the pure unit tests have no kernel to open one on.
+func useSocket(req *nl.NetlinkRequest, sock *nl.SocketHandle) {
+	if sock == nil {
+		return
+	}
+
+	req.Sockets = map[int]*nl.SocketHandle{unix.NETLINK_NETFILTER: sock}
+}
+
+// deleteConntrackFlow removes the entry a dump message describes, by handing
+// the kernel the message's own attributes back. An entry that is already
+// gone -- it expired, or the other direction's dump got to it first -- is
+// not a failure.
+func deleteConntrackFlow(sock *nl.SocketHandle, raw []byte) error {
+	if len(raw) < nl.SizeofNfgenmsg {
+		return fmt.Errorf("conntrack entry is %d bytes, too short to hold a netfilter header", len(raw))
+	}
+
+	req := nl.NewNetlinkRequest((netlink.ConntrackTable<<8)|nl.IPCTNL_MSG_CT_DELETE, unix.NLM_F_ACK)
+	req.AddData(&nl.Nfgenmsg{
+		NfgenFamily: unix.AF_INET,
+		Version:     nl.NFNETLINK_V0,
+		ResId:       0,
+	})
+	// The netfilter header is added above, so the copy in the dump message
+	// is skipped rather than sent twice.
+	req.AddRawData(raw[nl.SizeofNfgenmsg:])
+	useSocket(req, sock)
+
+	if _, err := req.Execute(unix.NETLINK_NETFILTER, 0); err != nil && !errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+
+	return nil
+}
+
+// origTupleIPv4 pulls the original tuple's addresses out of one dump
+// message. It is how the kernel's answer is checked before anything is
+// deleted: an old kernel ignores the filter and sends the whole table, and
+// nothing in this package may delete another sandbox's entries.
+func origTupleIPv4(raw []byte) (src, dst net.IP, err error) {
+	if len(raw) < nl.SizeofNfgenmsg {
+		return nil, nil, fmt.Errorf("conntrack entry is %d bytes, too short to hold a netfilter header", len(raw))
+	}
+
+	attrs, err := nl.ParseRouteAttr(raw[nl.SizeofNfgenmsg:])
+	if err != nil {
+		return nil, nil, fmt.Errorf("failed to parse conntrack entry: %w", err)
+	}
+
+	for _, attr := range attrs {
+		if attr.Attr.Type&nlaTypeMask != ctaTupleOrig {
+			continue
+		}
+
+		tupleAttrs, err := nl.ParseRouteAttr(attr.Value)
+		if err != nil {
+			return nil, nil, fmt.Errorf("failed to parse conntrack original tuple: %w", err)
+		}
+
+		for _, tupleAttr := range tupleAttrs {
+			if tupleAttr.Attr.Type&nlaTypeMask != ctaTupleIP {
+				continue
+			}
+
+			ipAttrs, err := nl.ParseRouteAttr(tupleAttr.Value)
+			if err != nil {
+				return nil, nil, fmt.Errorf("failed to parse conntrack tuple addresses: %w", err)
+			}
+
+			for _, ipAttr := range ipAttrs {
+				if len(ipAttr.Value) != net.IPv4len {
+					continue
+				}
+
+				switch ipAttr.Attr.Type & nlaTypeMask {
+				case ctaIPV4Src:
+					src = net.IP(ipAttr.Value).To4()
+				case ctaIPV4Dst:
+					dst = net.IP(ipAttr.Value).To4()
+				}
+			}
+		}
+	}
+
+	if src == nil && dst == nil {
+		return nil, nil, errors.New("conntrack entry carries no IPv4 original tuple")
+	}
+
+	return src, dst, nil
+}
+
+// deleteFilteredHostConntrack deletes the host's entries for each of the
+// given addresses, asking the kernel to do the matching.
+//
+// It is the same set of entries as a full-table pass would delete: original
+// source or original destination equal to ip. The kernel ANDs the conditions
+// within one filter, so "either direction" is two dumps, and an entry that
+// somehow satisfies both is deleted by the first and reported gone by the
+// second.
+//
+// Every entry the kernel sends is checked here before it is deleted. That is
+// not belt and braces: a kernel without CTA_FILTER answers the same request
+// with its whole table, and deleting that would take down every other
+// sandbox on the node.
+func deleteFilteredHostConntrack(sock *nl.SocketHandle, addresses []net.IP) error {
+	var failed int
+
+	// One address at a time, and one dump at a time: the dumps are walks of
+	// the same table and the kernel runs them one after another anyway.
+	for _, ip := range addresses {
+		v4 := ip.To4()
+		if v4 == nil {
+			return fmt.Errorf("conntrack delete needs an IPv4 address, got %q", ip)
+		}
+
+		for _, direction := range []ctDirection{ctOrigSrc, ctOrigDst} {
+			entries, err := dumpFilteredConntrack(sock, v4, direction)
+			if err != nil {
+				return err
+			}
+
+			for _, raw := range entries {
+				src, dst, err := origTupleIPv4(raw)
+				if err != nil {
+					// An entry that cannot be read cannot be shown to be
+					// this slot's, so it stays.
+					failed++
+
+					continue
+				}
+
+				if !src.Equal(v4) && !dst.Equal(v4) {
+					continue
+				}
+
+				if err := deleteConntrackFlow(sock, raw); err != nil {
+					failed++
+				}
+			}
+		}
+	}
+
+	if failed > 0 {
+		return fmt.Errorf("failed to delete %d conntrack entries for %v", failed, addresses)
+	}
+
+	return nil
+}
diff --git a/packages/orchestrator/internal/sandbox/network/conntrack_handles.go b/packages/orchestrator/internal/sandbox/network/conntrack_handles.go
new file mode 100644
index 000000000..8d8059515
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/network/conntrack_handles.go
@@ -0,0 +1,164 @@
+package network
+
+import (
+	"context"
+	"fmt"
+	"sync"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netlink/nl"
+	"github.com/vishvananda/netns"
+	"go.uber.org/zap"
+	"golang.org/x/sys/unix"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// Netfilter netlink sockets are expensive to close, so this package opens
+// them once and keeps them.
+//
+// vishvananda/netlink opens a socket per request and closes it again
+// whenever the call it is serving owns no handle, and one FlushConntrack
+// made several such calls. Closing one is not the cheap syscall it looks
+// like: on a Kunpeng 920 host (kernel 6.6) the thread goes into D state
+// inside
+//
+//	close -> sock_close -> netlink_release -> blocking_notifier_call_chain
+//	      -> nft_rcv_nl_event [nf_tables] -> flush_work
+//
+// waiting for nf_tables' own work queue to drain, and that queue is busy
+// exactly when the node's network pool is installing rules for new
+// namespaces. Measured: 127ms at the fastest, 250ms median, 447ms at the
+// worst, and 87% of the restores that took longer than 150ms were explained
+// by one such close, which accounted for 90% of the restore's wall clock.
+// The close usually belonged to the *previous* restore's flush and was
+// still holding the socket layer when the next one arrived.
+//
+// So the restore path opens no netfilter socket and closes none. The
+// sockets it uses are opened once -- one per slot for the sandbox's
+// namespace, and one for the host's, owned by the sweeper -- and the rare
+// close that a broken socket needs is handed to a goroutine, off the path.
+
+// hostConntrack is the long-lived socket the host-side sweeps are made on,
+// both the whole-table pass and the filtered dumps. The sweeper owns it and
+// serializes everything through it, so there is nothing to share and
+// nothing to lock. (There used to be a second one, a library handle for the
+// library's whole-table pass; that pass is gone, see
+// deleteHostConntrackByRawScan.)
+//
+// sock may be nil, which means "no pooled socket, open one for the request
+// and close it again" -- the old behaviour, kept for the case where the
+// socket cannot be opened at all.
+type hostConntrack struct {
+	sock *nl.SocketHandle
+}
+
+func (e *hostConntrack) socket() *nl.SocketHandle {
+	if e == nil {
+		return nil
+	}
+
+	return e.sock
+}
+
+// hostNamespace is the namespace the host-side sockets are opened in.
+//
+// It is remembered during init, when this process is still one goroutine on
+// one thread and that thread is certainly the host's: later on, threads in
+// here get moved between namespaces (CreateNetwork, ns.Do), and a socket
+// opened on the wrong one would delete another namespace's entries. A
+// variable so a test can point it at a namespace of its own.
+var (
+	hostNamespace    netns.NsHandle
+	hostNamespaceErr error
+)
+
+func init() {
+	hostNamespace, hostNamespaceErr = netns.Get()
+}
+
+// openHostConntrack opens the host-side socket. A variable so the pool's
+// bookkeeping can be tested without a kernel.
+var openHostConntrack = func() (*hostConntrack, error) {
+	if hostNamespaceErr != nil {
+		return nil, fmt.Errorf("the host network namespace was not remembered at startup: %w", hostNamespaceErr)
+	}
+
+	sock, err := nl.GetNetlinkSocketAt(hostNamespace, netns.None(), unix.NETLINK_NETFILTER)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open a netfilter socket in the host namespace: %w", err)
+	}
+
+	return &hostConntrack{sock: &nl.SocketHandle{Socket: sock}}, nil
+}
+
+// hostConntrackWarned keeps a node that cannot hold sockets open from
+// saying so on every restore.
+var hostConntrackWarned sync.Once
+
+// discardHostConntrack gets rid of sockets that cannot be trusted any more.
+// The close is the slow part and runs on its own goroutine: it is the whole
+// reason these sockets are kept in the first place.
+var discardHostConntrack = func(e *hostConntrack) {
+	go func() {
+		if e.sock != nil {
+			e.sock.Close()
+		}
+	}()
+}
+
+func reportHostConntrackUnavailable(err error) {
+	hostConntrackWarned.Do(func() {
+		logger.L().Warn(context.Background(),
+			"could not keep a netfilter netlink socket open; conntrack will open and close one per request",
+			zap.Error(err))
+	})
+}
+
+// openConntrackHandle gives the slot a socket into its own namespace, held
+// for as long as the slot's network exists. Without it every flush would
+// enter the namespace with setns and leave a socket to close behind.
+//
+// A slot that cannot have one still works: the flush falls back to entering
+// the namespace, which is what it did before.
+func (s *Slot) openConntrackHandle(ctx context.Context) {
+	ns, err := netns.GetFromName(s.NamespaceID())
+	if err != nil {
+		logger.L().Warn(ctx, "failed to open the slot's network namespace for its conntrack socket",
+			zap.String("namespace_id", s.NamespaceID()),
+			zap.Error(err))
+
+		return
+	}
+
+	defer ns.Close()
+
+	h, err := netlink.NewHandleAt(ns, unix.NETLINK_NETFILTER)
+	if err != nil {
+		logger.L().Warn(ctx, "failed to open a conntrack socket in the slot's network namespace",
+			zap.String("namespace_id", s.NamespaceID()),
+			zap.Error(err))
+
+		return
+	}
+
+	s.discardConntrackHandle()
+	s.conntrackHandle.Store(h)
+}
+
+// flushViaHandle is the one call a slot's own socket is used for. A
+// variable so the path taken when it fails -- which needs a broken socket,
+// and a closed netlink handle is not broken but merely slower -- can be
+// tested.
+var flushViaHandle = func(h *netlink.Handle) error {
+	return h.ConntrackTableFlush(netlink.ConntrackTable)
+}
+
+// discardConntrackHandle drops the slot's socket, on a goroutine because of
+// what closing one costs. It is called when the slot's network goes away
+// and when a request on the socket failed.
+func (s *Slot) discardConntrackHandle() {
+	if h := s.conntrackHandle.Swap(nil); h != nil {
+		go h.Close()
+	}
+}
diff --git a/packages/orchestrator/internal/sandbox/network/conntrack_scan.go b/packages/orchestrator/internal/sandbox/network/conntrack_scan.go
new file mode 100644
index 000000000..5a107a5b9
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/network/conntrack_scan.go
@@ -0,0 +1,185 @@
+package network
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"net"
+	"slices"
+
+	"github.com/vishvananda/netlink"
+	"github.com/vishvananda/netlink/nl"
+	"golang.org/x/sys/unix"
+)
+
+// deleteHostConntrackByRawScan walks the host's table once for the whole
+// batch and deletes every entry with one of the batch's addresses at either
+// end of its original tuple -- the same set the library's whole-table pass
+// and the filtered dumps delete.
+//
+// It is that whole-table pass without the library's price. The library
+// turns every entry of the host's table into a ConntrackFlow before a
+// filter looks at it, and that parse, not the kernel, was most of the
+// 4.43us per entry the pass was measured at. Here an entry is looked at in
+// the wire form the kernel sent it in: the two addresses are read straight
+// out of the original tuple, nothing is allocated for an entry that is not
+// the batch's, and only the batch's own entries are copied and kept for the
+// delete.
+//
+// The deletes go after the dump rather than during it: the dump streams its
+// answer over the same socket, and a delete sent in the middle of it would
+// read part of the dump as its own reply.
+func deleteHostConntrackByRawScan(sock *nl.SocketHandle, addresses []net.IP) (scanned int, err error) {
+	wanted := make([][net.IPv4len]byte, 0, len(addresses))
+
+	for _, ip := range addresses {
+		v4 := ip.To4()
+		if v4 == nil {
+			return 0, fmt.Errorf("conntrack delete needs an IPv4 address, got %q", ip)
+		}
+
+		wanted = append(wanted, [net.IPv4len]byte(v4))
+	}
+
+	req := nl.NewNetlinkRequest((netlink.ConntrackTable<<8)|nl.IPCTNL_MSG_CT_GET, unix.NLM_F_DUMP)
+	req.AddData(&nl.Nfgenmsg{
+		NfgenFamily: unix.AF_INET,
+		Version:     nl.NFNETLINK_V0,
+		ResId:       0,
+	})
+	useSocket(req, sock)
+
+	var matched [][]byte
+
+	err = req.ExecuteIter(unix.NETLINK_NETFILTER, 0, func(msg []byte) bool {
+		scanned++
+
+		src, dst, ok := origTupleIPv4Raw(msg)
+		if !ok {
+			// Not an IPv4 entry this can read, so not one it can show to be
+			// the batch's. The library's pass skips these the same way.
+			return true
+		}
+
+		if slices.Contains(wanted, src) || slices.Contains(wanted, dst) {
+			// The receive buffer is the library's and is reused; the entry
+			// has to outlive the dump to be handed back for the delete.
+			matched = append(matched, slices.Clone(msg))
+		}
+
+		return true
+	})
+	if err != nil && !errors.Is(err, netlink.ErrDumpInterrupted) {
+		return scanned, fmt.Errorf("failed to dump the host conntrack table: %w", err)
+	}
+
+	// An interrupted dump may be short (see dumpFilteredConntrack). What did
+	// come back is still deleted; the rest is what the other ways of
+	// deleting would have missed too.
+	var failed int
+
+	for _, raw := range matched {
+		if err := deleteConntrackFlow(sock, raw); err != nil {
+			failed++
+		}
+	}
+
+	if failed > 0 {
+		return scanned, fmt.Errorf("failed to delete %d of the %d matching conntrack entries", failed, len(matched))
+	}
+
+	return scanned, nil
+}
+
+// origTupleIPv4Raw reads the two addresses of an entry's original tuple out
+// of one dump message, without building anything. It is origTupleIPv4 for
+// the hot loop: that one parses every attribute into its own slice, which is
+// fine for the handful of entries a filtered dump returns and is the very
+// cost being avoided for a whole table.
+//
+// ok is false for a message that carries no IPv4 original tuple or does not
+// hold together; a half tuple comes back with the missing end zero, which
+// matches no slot's address.
+func origTupleIPv4Raw(raw []byte) (src, dst [net.IPv4len]byte, ok bool) {
+	if len(raw) < nl.SizeofNfgenmsg {
+		return src, dst, false
+	}
+
+	tuple, found := findAttr(raw[nl.SizeofNfgenmsg:], ctaTupleOrig)
+	if !found {
+		return src, dst, false
+	}
+
+	addrs, found := findAttr(tuple, ctaTupleIP)
+	if !found {
+		return src, dst, false
+	}
+
+	var haveSrc, haveDst bool
+
+	for rest := addrs; ; {
+		typ, value, next, more := nextAttr(rest)
+		if !more {
+			break
+		}
+
+		rest = next
+
+		if len(value) != net.IPv4len {
+			continue
+		}
+
+		switch typ {
+		case ctaIPV4Src:
+			src, haveSrc = [net.IPv4len]byte(value), true
+		case ctaIPV4Dst:
+			dst, haveDst = [net.IPv4len]byte(value), true
+		}
+	}
+
+	return src, dst, haveSrc || haveDst
+}
+
+// findAttr returns the payload of the first attribute of the given type in
+// a run of netlink attributes.
+func findAttr(attrs []byte, want uint16) ([]byte, bool) {
+	for rest := attrs; ; {
+		typ, value, next, more := nextAttr(rest)
+		if !more {
+			return nil, false
+		}
+
+		if typ == want {
+			return value, true
+		}
+
+		rest = next
+	}
+}
+
+// nextAttr splits the first netlink attribute off a run of them: its type
+// with the nested and byte-order bits masked off, its payload, and what
+// follows it. more is false at the end of the run and for an attribute whose
+// length does not fit what is left, so a truncated message ends the walk
+// instead of reading past it.
+func nextAttr(attrs []byte) (typ uint16, value, rest []byte, more bool) {
+	if len(attrs) < unix.SizeofRtAttr {
+		return 0, nil, nil, false
+	}
+
+	// Netlink attribute headers are in the host's byte order.
+	length := int(binary.NativeEndian.Uint16(attrs[0:2]))
+	if length < unix.SizeofRtAttr || length > len(attrs) {
+		return 0, nil, nil, false
+	}
+
+	typ = binary.NativeEndian.Uint16(attrs[2:4]) & nlaTypeMask
+	value = attrs[unix.SizeofRtAttr:length]
+
+	aligned := (length + unix.NLA_ALIGNTO - 1) &^ (unix.NLA_ALIGNTO - 1)
+	if aligned > len(attrs) {
+		aligned = len(attrs)
+	}
+
+	return typ, value, attrs[aligned:], true
+}
diff --git a/packages/orchestrator/internal/sandbox/network/conntrack_sweeper.go b/packages/orchestrator/internal/sandbox/network/conntrack_sweeper.go
new file mode 100644
index 000000000..9c40a0b78
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/network/conntrack_sweeper.go
@@ -0,0 +1,318 @@
+package network
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"sync"
+	"time"
+
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+)
+
+// The host's table is swept for all the slots that are waiting at once,
+// because the kernel will not do it in parallel anyway.
+//
+// A conntrack dump walks all 262144 hash buckets whatever it carries back,
+// and while one dump is walking the others queue behind it. Measured on a
+// Kunpeng 920 host (kernel 6.6) with sixteen restores at a time: a dump's
+// sendto takes 5.48ms when it has the table to itself and 62.69ms when five
+// or more overlap -- the same syscall, eleven times slower. It is not the
+// number of open sockets: there were six, never more than five in flight,
+// and no request ever waited for one.
+//
+// Doing the flush beside the rollback made that worse rather than better.
+// Before, each restore dumped after its own rollback and they drifted apart
+// on their own; now sixteen of them start at their pause and collide, and
+// the pile-up outlasts the rollback it was supposed to hide behind: with
+// sixteen at a time the freeze went from a median of 94.4ms to 68.9ms but
+// its 90th percentile from 130.9ms to 189.1ms.
+//
+// One walk can answer for every address waiting on it, so that is what
+// happens here: requests are collected into a batch, the batch is swept
+// once, and everyone in it is told how it went. Sixteen restores cost two
+// walks instead of sixteen.
+//
+// A caller waits for the sweep in flight when it arrived and then for its
+// own, so what a sweep costs is paid up to twice by every restore behind it.
+// At 39 restores a second (16 sandboxes, 2026-09-28) the batches held
+// several addresses each and the way they were swept -- two filtered walks
+// per address -- made a sweep grow with its batch: conntrack_bg went from
+// 27ms at 16 restores a second to 156ms, and the freeze waited 74ms of it.
+// See sweepUsesFilter for what a batch is swept with now.
+
+// sweepRequest is one slot asking for its entries to be gone. done is
+// buffered so the sweeper can answer a caller that has already given up.
+type sweepRequest struct {
+	ip     net.IP
+	queued time.Time
+	done   chan sweepResult
+}
+
+// sweepResult is what a caller learns about the sweep that covered it:
+// whether it worked, and what it cost, for the restore's breakdown.
+type sweepResult struct {
+	err    error
+	report HostSweepReport
+}
+
+// HostSweepReport is where the host-side half of one slot's flush spent its
+// time. The two durations add up to what the slot waited: first for the
+// sweep that was already walking when it asked, then for its own.
+type HostSweepReport struct {
+	// Queued is from asking to the start of the sweep that covered it.
+	Queued time.Duration
+	// Sweep is that sweep's own duration.
+	Sweep time.Duration
+	// Batch is how many slots the sweep served.
+	Batch int
+	// Entries is the size of the host's table the sweep was chosen by, or
+	// -1 when it could not be read.
+	Entries int
+}
+
+// hostTableSize is the host's table size as read for one sweep: known is
+// false when the kernel's count could not be read.
+type hostTableSize struct {
+	count int
+	known bool
+}
+
+// sweepQueueDepth only has to hold the restores that can be in their freeze
+// at one moment; a node runs nothing like this many at once, and a full
+// queue would mean waiting for a slot in it, not losing a sweep.
+const sweepQueueDepth = 256
+
+// conntrackSweeper serializes and batches the host-side deletes. One
+// goroutine owns the queue and the socket, so nothing else has to be
+// locked.
+type conntrackSweeper struct {
+	queue chan *sweepRequest
+
+	// sweep is what a batch does; a field so the batching can be tested
+	// without a kernel.
+	sweep func(*hostConntrack, []net.IP, hostTableSize) error
+
+	// entry belongs to the loop goroutine alone and is reopened whenever a
+	// sweep leaves it in doubt.
+	entry *hostConntrack
+}
+
+func newConntrackSweeper(sweep func(*hostConntrack, []net.IP, hostTableSize) error) *conntrackSweeper {
+	s := &conntrackSweeper{queue: make(chan *sweepRequest, sweepQueueDepth), sweep: sweep}
+
+	go s.loop()
+
+	return s
+}
+
+// loop takes everything that is waiting, sweeps once for all of it, and
+// answers each request.
+//
+// What it must not do is let a request join a sweep that has already
+// started. A dump walks the table bucket by bucket and may be past the
+// bucket an arriving slot's entries live in, so a request is only served by
+// a walk that began after it was made. Requests that arrive during a sweep
+// stay in the queue and go into the next one: the worst a caller waits is
+// the sweep in flight plus its own.
+func (s *conntrackSweeper) loop() {
+	for first := range s.queue {
+		batch := []*sweepRequest{first}
+
+	drain:
+		for {
+			select {
+			case r := <-s.queue:
+				batch = append(batch, r)
+			default:
+				break drain
+			}
+		}
+
+		started := time.Now()
+		table, err := s.run(batch)
+		took := time.Since(started)
+
+		entries := -1
+		if table.known {
+			entries = table.count
+		}
+
+		for _, r := range batch {
+			r.done <- sweepResult{err: err, report: HostSweepReport{
+				Queued:  started.Sub(r.queued),
+				Sweep:   took,
+				Batch:   len(batch),
+				Entries: entries,
+			}}
+		}
+	}
+}
+
+// run sweeps for one batch, opening the socket it needs if the last sweep
+// had to throw one away. The table's size is read once, here, so the size
+// the sweep was chosen by is the size reported with it.
+func (s *conntrackSweeper) run(batch []*sweepRequest) (hostTableSize, error) {
+	addresses := make([]net.IP, 0, len(batch))
+	for _, r := range batch {
+		addresses = append(addresses, r.ip)
+	}
+
+	if s.entry == nil || s.entry.sock == nil {
+		entry, err := openHostConntrack()
+		if err != nil {
+			reportHostConntrackUnavailable(err)
+
+			// Without a socket of its own the sweep opens one per request,
+			// which is what the library does when it has no handle.
+			entry = &hostConntrack{}
+		}
+
+		s.entry = entry
+	}
+
+	var table hostTableSize
+	table.count, table.known = hostConntrackCount()
+
+	err := s.sweep(s.entry, addresses, table)
+	if err != nil && s.entry.sock != nil {
+		// A request that ended badly can leave part of an answer in the
+		// socket for the next sweep to read as its own.
+		discardHostConntrack(s.entry)
+
+		s.entry = nil
+	}
+
+	return table, err
+}
+
+var (
+	hostSweeperMu sync.Mutex
+	hostSweeper   *conntrackSweeper
+)
+
+func sweeper() *conntrackSweeper {
+	hostSweeperMu.Lock()
+	defer hostSweeperMu.Unlock()
+
+	if hostSweeper == nil {
+		hostSweeper = newConntrackSweeper(deleteHostConntrackBatch)
+	}
+
+	return hostSweeper
+}
+
+// sweepHostConntrack hands one address to the sweeper and waits for the
+// sweep that covers it.
+//
+// A caller whose context is done stops waiting; the sweep goes on, because
+// the entries still have to go and the next caller would only ask for the
+// same work again.
+func sweepHostConntrack(ctx context.Context, ip net.IP) (HostSweepReport, error) {
+	return sweeper().submit(ctx, ip)
+}
+
+// submit is sweepHostConntrack against one sweeper rather than the
+// package's. The report is empty when the caller gave up before its sweep
+// answered.
+func (s *conntrackSweeper) submit(ctx context.Context, ip net.IP) (HostSweepReport, error) {
+	request := &sweepRequest{ip: ip, queued: time.Now(), done: make(chan sweepResult, 1)}
+
+	select {
+	case s.queue <- request:
+	case <-ctx.Done():
+		return HostSweepReport{}, fmt.Errorf("gave up before the host conntrack sweep took the address: %w", ctx.Err())
+	}
+
+	select {
+	case result := <-request.done:
+		return result.report, result.err
+	case <-ctx.Done():
+		return HostSweepReport{}, fmt.Errorf("gave up waiting for the host conntrack sweep: %w", ctx.Err())
+	}
+}
+
+const (
+	// conntrackDumpWalkMs is what one dump costs before it carries
+	// anything: the kernel walks all of its hash buckets whether it
+	// answers with one entry or the whole table. Measured on a Kunpeng 920
+	// host (kernel 6.6, 262144 buckets), against an empty table: 4.6ms
+	// (2026-09-28), 5.0ms (2026-09-20).
+	conntrackDumpWalkMs = 4.6
+
+	// conntrackScanPerEntryMs is what the whole-table pass then pays for
+	// each entry in the table: the kernel writing it out and this package
+	// reading its two addresses (deleteHostConntrackByRawScan). Measured
+	// on the same host in a namespace of the test's own: 5.3ms at 1000
+	// entries, 9.2 at 5000, 25.2 at 20000, 44.4 at 40000, so 1.0us an entry.
+	// The library's pass it replaced paid 3.75-4.43us, most of it turning
+	// every entry into a Go struct.
+	conntrackScanPerEntryMs = 0.0010
+
+	// conntrackFilteredPerEntryMs is what a filtered dump pays for each
+	// entry in the table even though it carries none of them back: the
+	// kernel still visits every entry to compare it. Same host, same
+	// namespace: 4.6ms at 1000 entries, 5.2 at 5000, 7.1 at 20000, 11.3 at
+	// 40000. The model this replaced had no such term, and so thought a
+	// filtered walk of a busy table cost what a walk of an empty one does.
+	conntrackFilteredPerEntryMs = 0.00017
+)
+
+// sweepUsesFilter picks the cheaper of the two ways to delete a batch.
+//
+// Asking the kernel to match costs two walks per address, because a
+// filter's conditions are ANDed and "this address at either end" is two
+// filters, and every walk visits every entry. Walking the table once and
+// matching here costs one walk and every entry carried across -- but that
+// one walk serves the whole batch. So the kernel's filter only wins for a
+// single address in a big table (above about 7000 entries), and a batch of
+// two or more is swept whole until the table is far larger than a node
+// gets: two addresses cross at about 43000 entries.
+//
+// Getting this wrong is what the batches at 39 restores a second paid for.
+// The old model priced a filtered walk at 5ms flat and the whole-table
+// pass at the library's 4.43us an entry, so with a table in the tens of
+// thousands it sent batches of up to eight or nine addresses down the
+// filtered path, sixteen or more walks of the table where one would do.
+func sweepUsesFilter(addresses int, table hostTableSize) bool {
+	if !table.known || addresses < 1 {
+		return false
+	}
+
+	count := float64(table.count)
+
+	filtered := float64(addresses) * 2 * (conntrackDumpWalkMs + conntrackFilteredPerEntryMs*count)
+	whole := conntrackDumpWalkMs + conntrackScanPerEntryMs*count
+
+	return filtered < whole
+}
+
+// deleteHostConntrackBatch is one sweep: the addresses of everyone waiting,
+// gone from the host's table in as few walks of it as they can be done in.
+func deleteHostConntrackBatch(e *hostConntrack, addresses []net.IP, table hostTableSize) error {
+	if sweepUsesFilter(len(addresses), table) && !conntrackFilterUnsupported.Load() {
+		err := deleteFilteredHostConntrack(e.socket(), addresses)
+		if err == nil {
+			return nil
+		}
+
+		if !errors.Is(err, errConntrackFilterUnsupported) {
+			return fmt.Errorf("failed to delete host conntrack entries for %v: %w", addresses, err)
+		}
+
+		if conntrackFilterUnsupported.CompareAndSwap(false, true) {
+			logger.L().Warn(context.Background(),
+				"kernel will not filter conntrack dumps; sweeping the whole host table from now on",
+				zap.Error(err))
+		}
+	}
+
+	if _, err := deleteHostConntrackByRawScan(e.socket(), addresses); err != nil {
+		return fmt.Errorf("failed to delete host conntrack entries for %v: %w", addresses, err)
+	}
+
+	return nil
+}
