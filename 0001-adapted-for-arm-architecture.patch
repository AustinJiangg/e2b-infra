 }
 
+// ErrDirtyTrackingUnavailable is returned by TrackedDirtyMemory when the
+// Firecracker in use does not expose the write-tracking bitmap.
+var ErrDirtyTrackingUnavailable = errors.New("firecracker does not expose the dirty-tracking bitmap")
+
+// TrackedDirtyMemory returns the pages Firecracker has tracked as written,
+// taken from its write tracking (the KVM dirty log — HDBSS or write
+// protection — merged with Firecracker's own userspace bitmap), at the
+// tracking page size.
+//
+// Those are the pages written **since the last snapshot or rollback**, not
+// since the VM started: creating a snapshot clears the bitmap
+// (vstate/memory.rs, reset_dirty once dump_dirty has written the diff) and so
+// does an in-place rollback (rollback.rs, phase 9), whose own writes into
+// guest memory go through a VMM mapping that KVM does not log either. Each
+// clear is deliberate — the next Diff snapshot has to be relative to exactly
+// that moment — and each one leaves this answer smaller than the question a
+// caller diffing against the *template* memfile is asking.
+//
+// A caller who needs "since the VM started" must therefore accumulate the
+// bitmaps itself, at the moments they are cleared; uffd.DirtySinceBoot does
+// that, and uffd.Uffd.DiffMetadata adds it back in here. Exporting this
+// bitmap alone on a sandbox that has checkpointed produces a snapshot that
+// resumes into a guest built out of two different moments.
+//
+// DirtyMemory judges by residency plus the uffd write-protect bit; on hosts
+// without uffd-wp that bit is never set, so every page the guest so much as
+// read counts as dirty. The tracking bitmap only knows writes. Pages the
+// orchestrator itself faulted in over uffd are not writes and are absent —
+// correctly, their content is already in the parent chain.
+//
+// The VM must be paused. bitmapPath is a scratch file Firecracker writes and
+// this call removes.
+func (p *Process) TrackedDirtyMemory(ctx context.Context, bitmapPath string) (*header.DiffMetadata, error) {
+	if err := p.SaveDirtyBitmap(ctx, bitmapPath); err != nil {
+		if isMissingRoute(err) {
+			return nil, ErrDirtyTrackingUnavailable
+		}
+
+		return nil, err
+	}
+	defer os.Remove(bitmapPath)
+
+	dirty, pageSize, err := ReadDirtyBitmapFile(bitmapPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read dirty bitmap: %w", err)
+	}
+
+	return &header.DiffMetadata{
+		Dirty:     dirty,
+		Empty:     bitset.New(0),
+		BlockSize: pageSize,
+	}, nil
+}
+
+// ReadDirtyBitmapFile parses the FCDB sidecar (magic "FCDB", version u32 LE,
+// page_size u64 LE, num_pages u64 LE, then ceil(num_pages/64) u64 LE words,
+// bit i of word w covering page w*64+i) into a bitset over pages, and returns
+// the page size it was written at.
+//
+// It is exported because the sidecars Firecracker writes when it clears its
+// bitmap are read by the same callers that have to accumulate them.
+func ReadDirtyBitmapFile(path string) (*bitset.BitSet, int64, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, 0, err
+	}
+
+	if len(data) < 24 || string(data[0:4]) != "FCDB" {
+		return nil, 0, fmt.Errorf("malformed dirty bitmap file %s", path)
+	}
+	if v := binary.LittleEndian.Uint32(data[4:8]); v != 1 {
+		return nil, 0, fmt.Errorf("unsupported dirty bitmap version %d", v)
+	}
+
+	pageSize := binary.LittleEndian.Uint64(data[8:16])
+	numPages := binary.LittleEndian.Uint64(data[16:24])
+	numWords := (numPages + 63) / 64
+	if uint64(len(data)) != 24+numWords*8 {
+		return nil, 0, fmt.Errorf("truncated dirty bitmap file %s", path)
+	}
+
+	words := make([]uint64, numWords)
+	for i := range words {
+		words[i] = binary.LittleEndian.Uint64(data[24+i*8:])
+	}
+
+	return bitset.FromWithLength(uint(numPages), words), int64(pageSize), nil
+}
