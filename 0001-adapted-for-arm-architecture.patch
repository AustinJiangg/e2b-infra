diff --git a/helm/templates/logs-collector.yaml b/helm/templates/logs-collector.yaml
new file mode 100644
index 000000000..e838c99ad
--- /dev/null
+++ b/helm/templates/logs-collector.yaml
@@ -0,0 +1,148 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: logs-collector
+  namespace: e2b
+data:
+  vector.toml: |
+    data_dir = "/vector-data"
+
+    [api]
+    enabled = true
+    address = "0.0.0.0:{{ .Values.logsHealthProxyPort }}"
+
+    [sources.http_server]
+    type = "http_server"
+    address = "0.0.0.0:{{ .Values.logsProxyPort }}"
+    encoding = "ndjson"
+    path_key = "_path"
+
+    [transforms.add_source_http_server]
+    type = "remap"
+    inputs = ["http_server"]
+    source = """
+    del(."_path")
+    .sandboxID = .instanceID
+    .timestamp = parse_timestamp(.timestamp, format: "%+") ?? now()
+    if exists(.sandbox_id) { .sandboxID = .sandbox_id }
+    if exists(.build_id)   { .buildID   = .build_id   }
+    if exists(.env_id)     { .envID     = .env_id     }
+    if exists(.team_id)    { .teamID    = .team_id    }
+    if exists(."template.id") { .templateID = ."template.id"; del(."template.id") }
+    if exists(."sandbox.id")  { .sandboxID = ."sandbox.id";  del(."sandbox.id")  }
+    if exists(."build.id")    { .buildID   = ."build.id";    del(."build.id")    }
+    if exists(."env.id")      { .envID     = ."env.id";      del(."env.id")      }
+    if exists(."team.id")     { .teamID    = ."team.id";     del(."team.id")     }
+    if !exists(.envID)    { .envID    = "unknown" }
+    if !exists(.category) { .category = "default" }
+    if !exists(.teamID)   { .teamID   = "unknown" }
+    if !exists(.sandboxID){ .sandboxID= "unknown" }
+    if !exists(.buildID)  { .buildID  = "unknown" }
+    if !exists(.service)  { .service  = "envd"    }
+    """
+
+    [transforms.internal_routing]
+    type = "route"
+    inputs = ["add_source_http_server"]
+    [transforms.internal_routing.route]
+    internal = '.internal == true'
+
+    [transforms.remove_internal]
+    type = "remap"
+    inputs = ["internal_routing._unmatched"]
+    source = "del(.internal)"
+
+    [sinks.local_loki_logs]
+    type = "loki"
+    inputs = ["remove_internal"]
+    endpoint = "http://loki.e2b.svc.cluster.local:{{ .Values.lokiServicePort }}"
+    encoding.codec = "json"
+    out_of_order_action = "accept"
+    [sinks.local_loki_logs.labels]
+    source    = "logs-collector"
+    service   = "{{ `{{ service }}` }}"
+    teamID    = "{{ `{{ teamID }}` }}"
+    envID     = "{{ `{{ envID }}` }}"
+    buildID   = "{{ `{{ buildID }}` }}"
+    sandboxID = "{{ `{{ sandboxID }}` }}"
+    category  = "{{ `{{ category }}` }}"
+
+---
+apiVersion: apps/v1
+kind: DaemonSet
+metadata:
+  name: logs-collector
+  namespace: e2b
+spec:
+  selector:
+    matchLabels:
+      app: logs-collector
+  template:
+    metadata:
+      labels:
+        app: logs-collector
+    spec:
+      hostNetwork: true
+      dnsPolicy: ClusterFirstWithHostNet
+      initContainers:
+      - name: wait-loki
+        image: busybox:latest
+        imagePullPolicy: IfNotPresent
+        command:
+        - /bin/sh
+        - -c
+        - |
+          until wget -q -O /dev/null http://loki.e2b.svc.cluster.local:{{ .Values.lokiServicePort }}/ready; do
+            echo waiting for loki...
+            sleep 1
+          done
+      containers:
+        - name: vector
+          image: {{ .Values.registry }}/timberio/vector:0.50.0-alpine
+          imagePullPolicy: IfNotPresent
+          ports:
+            - containerPort: {{ .Values.logsHealthProxyPort }}
+              name: health
+            - containerPort: {{ .Values.logsProxyPort }}
+              name: logs
+          env:
+            - name: VECTOR_CONFIG
+              value: "/etc/vector/vector.toml"
+            - name: VECTOR_REQUIRE_HEALTHY
+              value: "true"
+            - name: VECTOR_LOG
+              value: "warn"
+          resources:
+            requests:
+              cpu: 500m
+              memory: 2Gi
+            limits:
+              memory: 4Gi
+          volumeMounts:
+            - name: config
+              mountPath: /etc/vector
+            - name: data
+              mountPath: /vector-data
+          livenessProbe:
+            httpGet:
+              path: /health
+              port: health
+            initialDelaySeconds: 10
+            periodSeconds: 20
+            timeoutSeconds: 5
+          readinessProbe:
+            httpGet:
+              path: /health
+              port: health
+            initialDelaySeconds: 5
+            periodSeconds: 10
+            timeoutSeconds: 5
+      volumes:
+        - name: config
+          configMap:
+            name: logs-collector
+        - name: data
+          emptyDir: {}
+      # 调度到全部节点（等效 Nomad node_pool = all）
+      tolerations:
+        - operator: Exists
diff --git a/helm/templates/loki.yaml b/helm/templates/loki.yaml
new file mode 100644
index 000000000..15051e6be
--- /dev/null
+++ b/helm/templates/loki.yaml
@@ -0,0 +1,152 @@
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: loki-config
+  namespace: e2b
+data:
+  loki-config.yml: |
+    auth_enabled: false
+
+    server:
+      http_listen_port: {{ .Values.lokiServicePort | int }}
+      log_level: "warn"
+      grpc_server_max_recv_msg_size: 104857600  # 100 Mb
+      grpc_server_max_send_msg_size: 104857600  # 100 Mb
+
+    common:
+      path_prefix: /loki
+      replication_factor: 1
+      ring:
+        kvstore:
+          store: inmemory
+
+    storage_config:
+      tsdb_shipper:
+        active_index_directory: /loki/tsdb-shipper-active
+        cache_location: /loki/tsdb-shipper-cache
+        cache_ttl: 1h
+      filesystem:
+        directory: /loki/chunks
+
+    chunk_store_config:
+      chunk_cache_config:
+        embedded_cache:
+          enabled: true
+          max_size_mb: 2048
+          ttl: 30m
+
+    query_range:
+      align_queries_with_step: true
+      cache_results: true
+      max_retries: 2
+      results_cache:
+        cache:
+          embedded_cache:
+            enabled: true
+            max_size_mb: 2048
+            ttl: 30m
+
+    ingester_client:
+      grpc_client_config:
+        max_recv_msg_size: 104857600  # 100 Mb
+        max_send_msg_size: 104857600  # 100 Mb
+
+    ingester:
+      chunk_idle_period: 10m
+      chunk_encoding: snappy
+      max_chunk_age: 15m
+      chunk_target_size: 1048576  # 1MB
+      wal:
+        dir: /loki/wal
+        enabled: false
+        flush_on_shutdown: true
+
+    schema_config:
+      configs:
+        - from: 2024-03-05
+          store: tsdb
+          object_store: filesystem
+          schema: v12
+          index:
+            prefix: loki_index_
+            period: 24h
+
+    compactor:
+      working_directory: /loki/compactor
+      compaction_interval: 10m
+      retention_enabled: true
+      retention_delete_delay: 2h
+      retention_delete_worker_count: 150
+
+    # The bucket lifecycle policy should be set to delete objects after MORE than the specified retention period
+    limits_config:
+      retention_period: 168h
+      ingestion_rate_mb: 100
+      ingestion_burst_size_mb: 500
+      per_stream_rate_limit: "80MB"
+      per_stream_rate_limit_burst: "240MB"
+      max_streams_per_user: 0
+      split_queries_by_interval: 30m
+      max_global_streams_per_user: 0
+      unordered_writes: true
+      reject_old_samples_max_age: 168h
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: loki
+  namespace: e2b
+spec:
+  replicas: 1
+  selector:
+    matchLabels: { app: loki }
+  template:
+    metadata:
+      labels: { app: loki }
+    spec:
+      hostNetwork: true
+      affinity:
+        nodeAffinity:
+          requiredDuringSchedulingIgnoredDuringExecution:
+            nodeSelectorTerms:
+            - matchExpressions:
+              - key: node-role.kubernetes.io/{{ .Values.api.pool }}
+                operator: Exists
+      containers:
+      - name: loki
+        image: {{ .Values.registry }}/grafana/loki:2.9.3
+        imagePullPolicy: IfNotPresent
+        args: ["-config.file=/etc/loki/loki-config.yml", "-config.expand-env=true"]
+        ports:
+        - containerPort: {{ .Values.lokiServicePort | int }}
+          name: loki
+        volumeMounts:
+        - name: config
+          mountPath: /etc/loki
+        resources:
+          requests:
+            cpu: {{ .Values.lokiResourcesCpuCount }}m
+            memory: {{ .Values.lokiProxyResourcesMemoryMb }}Mi
+          limits:
+            cpu: {{ .Values.lokiResourcesCpuCount }}m
+            memory: {{ .Values.lokiProxyMaxResourcesMemoryMb }}Mi
+        livenessProbe:
+          httpGet: { path: /ready, port: loki }
+          initialDelaySeconds: 60
+          periodSeconds: 10
+      volumes:
+      - name: config
+        configMap:
+          name: loki-config
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: loki
+  namespace: e2b
+spec:
+  clusterIP: None
+  ports:
+  - port: {{ .Values.lokiServicePort | int }}
+    targetPort: loki
+  selector: { app: loki }
