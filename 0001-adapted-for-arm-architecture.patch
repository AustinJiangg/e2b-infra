+            cpu: {{ .Values.clientProxyResourcesCpuCount }}m
+            memory: {{ .Values.clientProxyMaxResourcesMemoryMb }}Mi
+        livenessProbe:
+          httpGet: { path: /health/traffic, port: health }
+          initialDelaySeconds: 30
+          periodSeconds: 3
+          timeoutSeconds: 3
+        readinessProbe:
+          httpGet: { path: /health, port: health }
+          initialDelaySeconds: 30
+          periodSeconds: 3
+          timeoutSeconds: 3
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: edge-api
+  namespace: e2b
+spec:
+  clusterIP: None
+  ports:
+  - port: {{ .Values.edgeHealthPort | int }}
+    targetPort: health
+    name: health
+  - port: {{ .Values.edgeProxyPort | int }}
+    targetPort: proxy
+    name: proxy
