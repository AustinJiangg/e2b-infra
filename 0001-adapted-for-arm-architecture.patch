+	// writes, and exporting by it would lose guest pages.
+	if !trackingEnabled {
+		logger.L().Info(ctx, "dirty tracking is off, memfile diff uses the resident-page criterion",
+			zap.String("reason", fc.TrackDirtyPagesReason()))
+
+		return u.residentDiffMetadata(ctx, f, blockSize)
+	}
+
+	if !accumulated.Trusted {
+		logger.L().Warn(ctx, "the since-boot dirty set is incomplete, memfile diff uses the resident-page criterion",
+			zap.String("reason", accumulated.Reason),
+			zap.Int("merges", accumulated.Merges))
+
+		return u.residentDiffMetadata(ctx, f, blockSize)
+	}
+
+	dirty, err := f.TrackedDirtyMemory(ctx, u.socketPath+".dirty.fcdb")
+	if errors.Is(err, fc.ErrDirtyTrackingUnavailable) {
+		logger.L().Warn(ctx, "firecracker has no dirty-tracking bitmap, falling back to resident-page criterion")
+
+		return u.residentDiffMetadata(ctx, f, blockSize)
+	}
+
+	if err != nil {
+		return nil, err
+	}
+
+	source := diffSourceTracked
+	tracked := dirty.Dirty.Count()
+
+	if accumulated.Pages > 0 {
+		if err := u.sinceBoot.UnionInto(dirty.Dirty, dirty.BlockSize); err != nil {
+			logger.L().Warn(ctx, "the since-boot dirty set could not be added to the tracked one, memfile diff uses the resident-page criterion",
+				zap.Error(err))
+
+			return u.residentDiffMetadata(ctx, f, blockSize)
+		}
+
+		source = diffSourceAccumulated
+	}
+
+	exported := dirty.Dirty.Count()
+
+	logger.L().Info(ctx, "memfile diff page set for the native pause",
+		zap.String("source", source),
+		zap.Uint("pages", exported),
+		zap.Uint("tracked_pages", tracked),
+		zap.Uint("accumulated_pages", accumulated.Pages),
+		zap.Int("bitmap_merges", accumulated.Merges),
+		zap.Int64("page_size", dirty.BlockSize))
+
+	// Union cannot shrink a set, so this says the two bitmaps were counted
+	// against each other wrongly rather than that a page went missing. It is
+	// logged and not acted on: the diff about to be exported is a superset of
+	// the tracked one either way.
+	if exported < accumulated.Pages {
+		logger.L().Error(ctx, "the memfile diff names fewer pages than the since-boot set it contains",
+			zap.Uint("pages", exported),
+			zap.Uint("accumulated_pages", accumulated.Pages))
+	}
+
+	return dirty, nil
+}
+
+const (
+	diffSourceTracked     = "tracked"
+	diffSourceAccumulated = "tracked+accumulated"
+	diffSourceResident    = "resident"
+)
+
+// residentDiffMetadata is the criterion that predates the write tracking:
+// every page resident in the guest, read or written. It cannot miss a written
+// page, which is why every fallback lands here.
+func (u *Uffd) residentDiffMetadata(ctx context.Context, f dirtyReporter, blockSize int64) (*header.DiffMetadata, error) {
+	dirty, err := f.DirtyMemory(ctx, blockSize)
+	if err != nil {
+		return nil, err
+	}
+
+	logger.L().Info(ctx, "memfile diff page set for the native pause",
+		zap.String("source", diffSourceResident),
+		zap.Uint("pages", dirty.Dirty.Count()),
+		zap.Int64("page_size", dirty.BlockSize))
+
+	return dirty, nil
 }
 
