diff --git a/packages/orchestrator/internal/sandbox/checkpoint.go b/packages/orchestrator/internal/sandbox/checkpoint.go
new file mode 100644
index 000000000..2ad871ec6
--- /dev/null
+++ b/packages/orchestrator/internal/sandbox/checkpoint.go
@@ -0,0 +1,708 @@
+package sandbox
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/google/uuid"
+	"go.uber.org/zap"
+
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/block"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/fc"
+	"github.com/e2b-dev/infra/packages/orchestrator/internal/sandbox/rootfs"
+	"github.com/e2b-dev/infra/packages/shared/pkg/logger"
+	"github.com/e2b-dev/infra/packages/shared/pkg/storage/header"
+	"github.com/e2b-dev/infra/packages/shared/pkg/telemetry"
+)
+
+const (
+	// fcCallEnv bounds one Firecracker API call. Firecracker answers a
+	// healthy pause or resume in microseconds and a rollback in
+	// milliseconds to seconds; the point of the bound is the call that never
+	// answers at all, which used to freeze the sandbox and hold its
+	// operation lock forever.
+	fcCallEnv     = "CHECKPOINT_FC_CALL_TIMEOUT"
+	defaultFCCall = 2 * time.Minute
+)
+
+func fcCallTimeout() time.Duration {
+	d, _ := FCCallTimeout()
+
+	return d
+}
+
+// FCCallTimeout is fcCallTimeout with the value's provenance attached
+// ("env" or "default"), for the checkpoint capabilities line at startup: a
+// bound printed without its source cannot tell an operator whether their
+// setting was read at all. It is the same call the Firecracker path makes,
+// so what is reported is what will be waited out.
+func FCCallTimeout() (time.Duration, string) {
+	raw := os.Getenv(fcCallEnv)
+	if raw == "" {
+		return defaultFCCall, "default"
+	}
+
+	d, err := time.ParseDuration(raw)
+	if err != nil || d <= 0 {
+		logger.L().Warn(context.Background(), "ignoring unusable duration in the environment",
+			zap.String("env", fcCallEnv),
+			zap.String("value", raw),
+			zap.Duration("using", defaultFCCall))
+
+		return defaultFCCall, "default"
+	}
+
+	return d, "env"
+}
+
+// fcCall runs one Firecracker API call under a deadline of its own.
+//
+// The deadline belongs to the host, not to the client: the caller's context
+// is already detached from the request (a client that gives up must not
+// leave a VM paused), and this only adds a bound on Firecracker itself.
+func fcCall(ctx context.Context, call func(context.Context) error) error {
+	ctx, cancel := context.WithTimeout(ctx, fcCallTimeout())
+	defer cancel()
+
+	return call(ctx)
+}
+
+// pauseVM pauses the VM under a deadline. If the deadline is what ended the
+// call, the pause may still have landed on the other side, so a resume is
+// attempted before the failure is reported: a VM left paused while everyone
+// believes it is running is the worse of the two outcomes.
+func pauseVM(ctx context.Context, sandboxID string, process *fc.Process, timings PhaseTimings) error {
+	err := timings.Timed("pause", func() error { return fcCall(ctx, process.Pause) })
+	if err == nil {
+		return nil
+	}
+
+	if errors.Is(err, context.DeadlineExceeded) {
+		if resumeErr := fcCall(context.WithoutCancel(ctx), process.ResumeVM); resumeErr != nil {
+			logger.L().Warn(ctx, "pause timed out and the VM could not be resumed either",
+				logger.WithSandboxID(sandboxID),
+				zap.Error(resumeErr))
+		}
+	}
+
+	return err
+}
+
+// dirtyAccumulator is the part of the sandbox's memory backend the checkpoint
+// path feeds: the set of pages written since the VM started, which only this
+// package is in a position to keep up to date.
+type dirtyAccumulator interface {
+	AccumulateDirtyBitmap(ctx context.Context, path string) error
+}
+
+// accumulateDirtyBitmap folds a bitmap Firecracker wrote, at a point where it
+// cleared its own, into the since-boot dirty set, and reports whether it
+// landed.
+//
+// A failure is not fatal to the operation in progress — nothing about the
+// checkpoint depends on this — but it does cost the next native pause its
+// cheap diff, so it is said out loud rather than swallowed.
+func accumulateDirtyBitmap(ctx context.Context, acc dirtyAccumulator, sandboxID string, path string, at string) bool {
+	if err := acc.AccumulateDirtyBitmap(ctx, path); err != nil {
+		logger.L().Warn(ctx, "failed to accumulate a dirty bitmap; a native pause of this sandbox will export by residency instead",
+			logger.WithSandboxID(sandboxID),
+			zap.String("at", at),
+			zap.String("bitmap_path", path),
+			zap.Error(err))
+
+		return false
+	}
+
+	return true
+}
+
+func (s *Sandbox) accumulateDirtyBitmap(ctx context.Context, path string, at string) bool {
+	return accumulateDirtyBitmap(ctx, s.Resources.memory, s.Runtime.SandboxID, path, at)
+}
+
+// createEpoch takes, into the since-boot dirty set, the pages one checkpoint
+// create is about to make Firecracker forget.
+//
+// An incremental create is simple: the sidecar Firecracker writes with the
+// snapshot names exactly the pages it then drops from its bitmap.
+//
+// A full create is not. Its sidecar says "every page", which is true of what
+// the memory file holds and useless as an account of what the guest has
+// written since it booted — taking it would make every later native pause
+// export the whole of guest memory, and a sandbox's *first* checkpoint is
+// always a full one. So the live bitmap is asked for before the snapshot
+// instead: the VM is paused, save-dirty-bitmap folds the KVM log into
+// Firecracker's userspace bitmap without clearing it (rollback.rs,
+// save_dirty_bitmap), and for a first capture that bitmap is precisely the
+// pages written since boot. Later full captures — a tree that could not be
+// resolved, an unarmed host, an explicit full root — are covered by the same
+// call plus what earlier creates already accumulated.
+//
+// Where that call is not available or fails, the all-ones sidecar is taken
+// after the snapshot instead: far more than necessary, never less.
+type createEpoch struct {
+	acc       dirtyAccumulator
+	sandboxID string
+	diff      bool
+
+	// liveTaken says the pages of a full capture are already accounted for,
+	// so its sidecar has nothing to add.
+	liveTaken bool
+}
+
+// beforeSnapshot runs inside the freeze, between the pause and the snapshot.
+// It costs one bitmap export — 32 KiB per GiB of guest memory — and only on
+// full captures.
+func (c *createEpoch) beforeSnapshot(ctx context.Context, saveLive func(context.Context, string) error, path string, timings PhaseTimings) {
+	if c.diff {
+		return
+	}
+
+	if err := timings.Timed("save_live_bitmap", func() error { return saveLive(ctx, path) }); err != nil {
+		logger.L().Warn(ctx, "failed to export the live dirty bitmap before a full capture; the since-boot set will take the whole guest instead",
+			logger.WithSandboxID(c.sandboxID),
+			zap.Error(err))
+
+		return
+	}
+
+	defer os.Remove(path)
+
+	c.liveTaken = accumulateDirtyBitmap(ctx, c.acc, c.sandboxID, path, "full capture live bitmap")
+}
+
+// afterSnapshot takes the snapshot's own sidecar, unless a full capture's
+// live bitmap already said the same thing more precisely.
+func (c *createEpoch) afterSnapshot(ctx context.Context, path string, at string) {
+	if c.liveTaken {
+		return
+	}
+
+	accumulateDirtyBitmap(ctx, c.acc, c.sandboxID, path, at)
+}
+
+// CheckpointToFiles pauses the VM, has Firecracker write a snapshot of it to
+// snapfilePath and memfilePath, and resumes it.
+//
+// This is not Pause: nothing is exported into a template and the sandbox keeps
+// running afterwards. The files are Firecracker's own snapshot output, so they
+// can be handed straight back to it later.
+//
+// With diff set, the memory file only holds the pages dirtied since the
+// previous snapshot, written at their original offsets. The caller passes a
+// file that already holds the previous full view, so the overwrite yields the
+// full view of this moment. Dirty page tracking has to have been armed when
+// the VM was started or loaded.
+//
+// epochAdvanced reports whether Firecracker wrote the snapshot: doing so
+// clears its dirty-page bitmap, so from that point on the memory file is the
+// only valid base for the next Diff and must be preserved even if a later
+// step fails.
+func (s *Sandbox) CheckpointToFiles(ctx context.Context, snapfilePath string, memfilePath string, dirtyBitmapPath string, diff bool, sealedLayerPath string, timings PhaseTimings) (epochAdvanced bool, layer *rootfs.SealedLayer, e error) {
+	ctx, span := tracer.Start(ctx, "sandbox-checkpoint-to-files")
+	defer span.End()
+
+	provider := s.Rootfs()
+
+	sealer, ok := provider.(rootfs.LayerSealer)
+	if !ok {
+		return false, nil, fmt.Errorf("rootfs provider %T cannot seal write layers", provider)
+	}
+
+	process := s.process
+
+	// How long the sandbox is frozen is the cost that matters here — not how
+	// long the whole operation takes — so it is measured on its own.
+	pausedAt := time.Now()
+
+	if err := pauseVM(ctx, s.Runtime.SandboxID, process, timings); err != nil {
+		return false, nil, fmt.Errorf("failed to pause VM: %w", err)
+	}
+
+	// Registered before the resume below, so it runs after it: the sealed
+	// layer file is moved into the checkpoint store with the guest already
+	// running again. Within one filesystem that is a rename, but across two
+	// it is a copy of everything the guest wrote since the last checkpoint,
+	// and the freeze must not scale with that. Nothing has recorded the
+	// layer yet -- the store reads Path when it does -- so this is the last
+	// moment the file can move.
+	defer func() {
+		if layer == nil {
+			return
+		}
+
+		if err := timings.Timed("seal_move", func() error { return layer.MoveInto(sealedLayerPath) }); err != nil {
+			layer = nil
+			e = errors.Join(e, fmt.Errorf("failed to move sealed layer into the store: %w", err))
+		}
+	}()
+
+	// Resume even if the snapshot fails, and even if the caller gave up on us
+	// meanwhile — a paused VM everyone believes is running is worse than a
+	// missing snapshot.
+	defer func() {
+		if err := timings.Timed("resume", func() error {
+			return fcCall(context.WithoutCancel(ctx), process.ResumeVM)
+		}); err != nil {
+			e = errors.Join(e, fmt.Errorf("failed to resume VM after snapshot: %w", err))
+		}
+
+		timings.Mark("frozen", pausedAt)
+		checkpointPausedHistogram.Record(ctx, time.Since(pausedAt).Milliseconds())
+	}()
+
+	epoch := &createEpoch{acc: s.Resources.memory, sandboxID: s.Runtime.SandboxID, diff: diff}
+	epoch.beforeSnapshot(ctx, func(ctx context.Context, path string) error {
+		return fcCall(ctx, func(ctx context.Context) error { return process.SaveDirtyBitmap(ctx, path) })
+	}, dirtyBitmapPath+".live", timings)
+
+	if err := timings.Timed("snapshot", func() error {
+		return fcCall(ctx, func(ctx context.Context) error {
+			return process.CreateSnapshotWithMemFile(ctx, snapfilePath, memfilePath, dirtyBitmapPath, diff)
+		})
+	}); err != nil {
+		// A snapshot the host gave up waiting for may still have been
+		// written, and writing it clears Firecracker's dirty bitmap: the
+		// temp diff would then hold the only copy of an epoch nobody knows
+		// about. Report the epoch as advanced, which keeps that file, over
+		// discarding pages that exist nowhere else.
+		if errors.Is(err, context.DeadlineExceeded) {
+			// Same uncertainty, for the pause path: the bitmap may have been
+			// cleared. If Firecracker got as far as the sidecar, that is the
+			// epoch, and it is taken; if it did not, the since-boot set has a
+			// hole in it and says so.
+			epoch.afterSnapshot(ctx, dirtyBitmapPath, "checkpoint create (timed out)")
+		}
+
+		return errors.Is(err, context.DeadlineExceeded), nil, fmt.Errorf("failed to create snapshot: %w", err)
+	}
+
+	// Firecracker has just cleared its dirty bitmap, having written the pages
+	// it held into the checkpoint's memory file and named them in the sidecar.
+	// From here on its bitmap answers "since this checkpoint", so the epoch
+	// that is no longer in it is taken into the since-boot set — the native
+	// pause exports against the template memfile and still needs it.
+	epoch.afterSnapshot(ctx, dirtyBitmapPath, "checkpoint create")
+
+	// The disk is sealed inside the same pause window, so the layer and the
+	// memory file are images of the same instant — anything the guest had not
+	// flushed to disk yet is in the memory image, exactly as it was.
+	newCachePath := filepath.Join(
+		filepath.Dir(s.files.SandboxCacheRootfsPath(s.config.StorageConfig)),
+		fmt.Sprintf("rootfs-%s-%s.cow", s.Runtime.SandboxID, uuid.NewString()),
+	)
+
+	sealStart := time.Now()
+	sealed, err := sealer.SealLayer(ctx, newCachePath)
+	timings.Mark("seal", sealStart)
+	if err != nil {
+		// The snapshot exists, so the epoch has advanced regardless.
+		return true, nil, fmt.Errorf("failed to seal rootfs write layer: %w", err)
+	}
+
+	layer = sealed
+
+	return true, layer, nil
+}
+
+// RootfsHeader returns the header describing the sandbox's template rootfs —
+// the base of its layer stack.
+func (s *Sandbox) RootfsHeader() (*header.Header, error) {
+	device, err := s.Template.Rootfs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get template rootfs: %w", err)
+	}
+
+	return device.Header(), nil
+}
+
+// AssembleView builds the read path of a checkpoint's disk view: the template
+// base with the checkpoint's sealed layers stacked on top, each reopened from
+// its raw layer file with the block knowledge from its sidecar, and the
+// stack's block-to-layer index built from the same sidecars.
+//
+// It runs before the guest is paused, and deliberately so. Everything it
+// reads is immutable -- sealed layer files and their sidecars -- and the
+// sandbox's checkpoint operations are serialized, so no one can seal another
+// layer underneath it meanwhile. Building the view outside the freeze keeps k
+// mappings of a whole rootfs out of the guest's downtime, and takes the
+// failure out with it: a view that cannot be assembled now leaves the sandbox
+// running at its current state, where it used to leave it torn between two
+// moments with the memory rollback already committed.
+//
+// The view belongs to the caller until it reaches the live stack; a view that
+// never gets there is released with ReleaseView.
+func (s *Sandbox) AssembleView(ctx context.Context, layers []RestoreLayer) (_ block.ReadonlyDevice, e error) {
+	base, err := s.Template.Rootfs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get template rootfs: %w", err)
+	}
+
+	size, err := base.Size(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get rootfs size: %w", err)
+	}
+	blockSize := base.BlockSize()
+
+	stack := block.NewLayerStack(base, size)
+
+	// A layer that cannot be reopened halfway up the stack leaves the ones
+	// below it mapped, and a restore that keeps failing would leak a whole
+	// rootfs worth of address space per attempt.
+	defer func() {
+		if e == nil {
+			return
+		}
+
+		if err := ReleaseView(stack); err != nil {
+			logger.L().Warn(ctx, "failed to release a disk view that could not be assembled",
+				logger.WithSandboxID(s.Runtime.SandboxID),
+				zap.Error(err))
+		}
+	}()
+
+	for _, layer := range layers {
+		cache, err := block.NewCache(size, blockSize, layer.Path, false)
+		if err != nil {
+			return nil, fmt.Errorf("failed to reopen sealed layer %s: %w", layer.Path, err)
+		}
+
+		cache.MarkCached(layer.DirtyOffsets)
+
+		if err := stack.AppendLayerWithBlocks(cache, layer.DirtyOffsets); err != nil {
+			return nil, errors.Join(
+				fmt.Errorf("failed to stack sealed layer %s: %w", layer.Path, err),
+				cache.CloseKeepFile(),
+			)
+		}
+	}
+
+	return stack, nil
+}
+
+// ReleaseView unmaps a view AssembleView built that never reached the live
+// stack. Only the reopened sealed layers are unmapped: their files belong to
+// the checkpoint store and other views read them, and the template base at
+// the bottom of the chain belongs to the sandbox.
+//
+// It must not be called on a view a rollback installed -- the guest reads
+// through those mappings.
+func ReleaseView(device block.ReadonlyDevice) error {
+	stack, ok := device.(*block.LayerStack)
+	if !ok {
+		return nil
+	}
+
+	return stack.Close()
+}
+
+// newCowPath returns a fresh, unique path for a write layer file.
+func (s *Sandbox) newCowPath() string {
+	return filepath.Join(
+		filepath.Dir(s.files.SandboxCacheRootfsPath(s.config.StorageConfig)),
+		fmt.Sprintf("rootfs-%s-%s.cow", s.Runtime.SandboxID, uuid.NewString()),
+	)
+}
+
+// RevertMaterializer builds the two files an in-place rollback needs, given
+// the live dirty bitmap Firecracker just exported: the revert bitmap and a
+// sparse memory file holding the target-moment content of exactly those
+// pages. cleanup removes them and runs however the rollback ends.
+type RevertMaterializer func(liveBitmapPath string) (memPath string, revertBitmapPath string, cleanup func(), err error)
+
+// RollbackTornError marks a rollback that failed after guest state had
+// already moved: memory is (partly) at the target but the disk view or the
+// resume is not. The sandbox cannot continue and must be recreated.
+type RollbackTornError struct{ Err error }
+
+func (e RollbackTornError) Error() string {
+	return fmt.Sprintf("rollback left the sandbox torn between two moments: %s", e.Err)
+}
+
+func (e RollbackTornError) Unwrap() error { return e.Err }
+
+// RollbackVcpuCounters is Firecracker's vCPU account of one rollback. It is
+// an alias rather than a copy so the value the HTTP client decoded is the
+// value the restore handler logs, with nothing in between that could drop a
+// field the fork adds later.
+type RollbackVcpuCounters = fc.VcpuCounters
+
+// RollbackInPlace rewinds the sandbox to a checkpoint without replacing the
+// Firecracker process: FC writes back the revert set onto its live objects
+// (cost proportional to the set), and the disk view is swapped underneath
+// the live NBD mount inside the same pause window. All host resources —
+// process, KVM fds, tap, network slot, NBD device — stay.
+//
+// The live dirty bitmap is exported and the revert files are materialized
+// only after the pause: paused, the live set cannot grow, so the
+// materialized content covers everything Firecracker will write back.
+//
+// device is the checkpoint's disk view, already assembled by the caller
+// (AssembleView) outside the freeze; only the swap itself happens here.
+//
+// afterCommit, when non-nil, runs inside the window immediately past the
+// rollback's commit point and is torn by construction if it fails. Nothing
+// in production passes one: it exists so that the torn path, otherwise
+// reachable only by a disk failing in a window of a few milliseconds, has a
+// trigger.
+//
+// Failures before the rollback's commit point resume the VM: the sandbox
+// keeps running at its current state. Failures past it come back as
+// RollbackTornError and only recreating the sandbox helps.
+//
+// The first result is what Firecracker counted about the vCPUs it rewound,
+// or nil when the running Firecracker does not report it. It is returned
+// rather than folded into timings because these are counts, not durations,
+// and because two of them are the caller's cue to raise its voice.
+func (s *Sandbox) RollbackInPlace(
+	ctx context.Context,
+	snapfilePath string,
+	materialize RevertMaterializer,
+	device block.ReadonlyDevice,
+	afterCommit func() error,
+	timings PhaseTimings,
+) (counters *RollbackVcpuCounters, e error) {
+	ctx, span := tracer.Start(ctx, "sandbox-rollback-in-place")
+	defer span.End()
+
+	// Both checked before the pause: a rollback that cannot finish is a
+	// failed restore here and a torn sandbox a few milliseconds later.
+	if device == nil {
+		return nil, fmt.Errorf("rollback needs the checkpoint's disk view, assembled before the pause")
+	}
+
+	resetter, ok := s.Rootfs().(rootfs.ViewResetter)
+	if !ok {
+		return nil, fmt.Errorf("rootfs provider %T cannot reset its view", s.Rootfs())
+	}
+
+	process := s.process
+
+	rollbackPausedAt := time.Now()
+
+	if err := pauseVM(ctx, s.Runtime.SandboxID, process, timings); err != nil {
+		return nil, fmt.Errorf("failed to pause VM: %w", err)
+	}
+
+	// Connection tracking is flushed beside the rollback, not inside it. The
+	// flush needs the VM to be down, which it is from here on; it does not
+	// need the rollback to have happened. See conntrackFlush for what that
+	// buys and for why the earlier start is safe.
+	conntrack := startConntrackFlush(timings, func(own PhaseTimings) error {
+		report, err := s.Slot.FlushConntrack(ctx)
+		recordConntrackReport(own, report)
+
+		return err
+	}, func(err error) {
+		logger.L().Warn(ctx, "failed to flush conntrack during in-place rollback",
+			logger.WithSandboxID(s.Runtime.SandboxID),
+			zap.Error(err))
+	})
+
+	// The backstop for every way out of this function, including the torn
+	// ones and a panic: nothing may still be talking to the slot once the
+	// rollback has returned. The paths that matter join earlier and by name,
+	// so this one normally finds the flush long done.
+	defer conntrack.join()
+
+	// resumeOnError puts the VM back as it was, for failures that have not
+	// touched guest state yet.
+	resumeOnError := func(err error) error {
+		// Before the resume, always: letting traffic back in while entries
+		// are still being dropped is the one ordering the flush was written
+		// to avoid.
+		conntrack.join()
+
+		if resumeErr := fcCall(context.WithoutCancel(ctx), process.ResumeVM); resumeErr != nil {
+			err = errors.Join(err, fmt.Errorf("failed to resume VM: %w", resumeErr))
+		}
+
+		return err
+	}
+
+	liveBitmapPath := filepath.Join(filepath.Dir(snapfilePath), "live_bitmap.tmp")
+	if err := timings.Timed("save_live_bitmap", func() error {
+		return fcCall(ctx, func(ctx context.Context) error { return process.SaveDirtyBitmap(ctx, liveBitmapPath) })
+	}); err != nil {
+		return nil, resumeOnError(fmt.Errorf("failed to export live dirty bitmap: %w", err))
+	}
+	defer os.Remove(liveBitmapPath)
+
+	// The pages written since the last checkpoint, which the rollback is about
+	// to undo and Firecracker is about to forget (it resets the dirty baseline
+	// so the next Diff is relative to the restored state). They were written
+	// since the VM started too, so the native pause has to export them.
+	s.accumulateDirtyBitmap(ctx, liveBitmapPath, "restore live bitmap")
+
+	// Where the restore's inputs came from — page cache or the disk. Both
+	// halves read files with ordinary buffered reads: this process resolves
+	// the revert set out of the ancestor chain's diff files, and Firecracker
+	// then reads the materialized file back into guest memory. A warm cache
+	// makes both nearly free, which is the normal case and also the reason
+	// the numbers need a witness: a restore that quietly went to disk looks
+	// exactly like one that did not, only slower. Without this counter
+	// "recovery cost does not grow with chain depth" cannot be told apart
+	// from "the chain happened to still be cached".
+	//
+	// This counter belongs to the whole orchestrator process, not to this
+	// restore: when restores of several sandboxes run at once, their reads
+	// in the window land in it too, so only a single-sandbox run can read it
+	// as "this restore went to the disk". What this restore itself read is
+	// counted by the materialize as it reads (materialize_read_mb and
+	// materialize_base_read_mb, set there).
+	selfBefore, selfOK := diskReadBytes(os.Getpid())
+
+	materializeStart := time.Now()
+	memfilePath, revertBitmapPath, cleanup, err := materialize(liveBitmapPath)
+	timings.Mark("materialize", materializeStart)
+
+	if mb, ok := diskReadSince(os.Getpid(), selfBefore, selfOK); ok {
+		timings.SetMB("materialize_disk_read_mb", mb)
+	}
+
+	if err != nil {
+		return nil, resumeOnError(fmt.Errorf("failed to materialize revert files: %w", err))
+	}
+	defer cleanup()
+
+	// Every page Firecracker is about to write back, and the second half of
+	// what the since-boot set would otherwise lose: those writes go into guest
+	// memory through a mapping of the VMM's address space, which KVM does not
+	// log, so they appear in no bitmap Firecracker will ever produce.
+	//
+	// The revert set is the live set unioned with the epoch bitmaps on the
+	// tree path to the target (Store.MaterializeRevert), and those epoch
+	// bitmaps are the sidecars already taken at each create — so in principle
+	// only the live half is new here. It is merged whole regardless: the
+	// implicit all-ones bitmap of a full capture has no sidecar behind it, and
+	// an epoch that was taken while the set was untrusted is not in it. The
+	// union is idempotent and pages cost nothing to name twice.
+	s.accumulateDirtyBitmap(ctx, revertBitmapPath, "restore revert bitmap")
+
+	// Firecracker is a separate process, so its reads of the materialized
+	// file are charged to its own pid, not ours. This file was written
+	// moments ago and is never fsynced — it is removed again by cleanup — so
+	// a non-zero reading here means writeback beat the rollback to it.
+	fcPid, fcPidErr := process.Pid()
+
+	var (
+		fcBefore uint64
+		fcOK     bool
+	)
+
+	if fcPidErr == nil {
+		fcBefore, fcOK = diskReadBytes(fcPid)
+	}
+
+	// The rollback endpoint distinguishes failures before its commit point
+	// (VM untouched, resumable) from after (VM faulted).
+	fcStart := time.Now()
+
+	var result *fc.RollbackResult
+
+	err = fcCall(ctx, func(ctx context.Context) error {
+		var rollbackErr error
+		result, rollbackErr = process.RollbackSnapshot(ctx, snapfilePath, memfilePath, revertBitmapPath)
+
+		return rollbackErr
+	})
+	timings.Mark("fc_rollback", fcStart)
+
+	if mb, ok := diskReadSince(fcPid, fcBefore, fcOK); ok {
+		timings.SetMB("fc_rollback_disk_read_mb", mb)
+	}
+
+	if err != nil {
+		var faulted fc.RollbackFaultedError
+		if errors.As(err, &faulted) {
+			return nil, RollbackTornError{Err: fmt.Errorf("in-place rollback failed: %w", err)}
+		}
+
+		// A rollback the host gave up waiting for says nothing about which
+		// side of its commit point Firecracker is on: it may have written
+		// half the revert set into live guest memory. Resuming that guest
+		// would let it write a state nobody can describe to its disk, so an
+		// expired deadline counts as torn.
+		if errors.Is(err, context.DeadlineExceeded) {
+			return nil, RollbackTornError{Err: fmt.Errorf("in-place rollback did not answer within %s; the VM may be between two moments: %w", fcCallTimeout(), err)}
+		}
+
+		return nil, resumeOnError(fmt.Errorf("in-place rollback failed: %w", err))
+	}
+
+	// Firecracker measures its own half of the rollback and reports it. That
+	// half is the bulk of the downtime, so surface the breakdown instead of
+	// leaving the biggest phase as one opaque number.
+	timings.SetUs("fc_validate", result.TimingsUs.Validate)
+	timings.SetUs("fc_quiesce", result.TimingsUs.Quiesce)
+	timings.SetUs("fc_bitmap", result.TimingsUs.Bitmap)
+	timings.SetUs("fc_memory", result.TimingsUs.Memory)
+	timings.SetUs("fc_vcpus", result.TimingsUs.Vcpus)
+	timings.SetUs("fc_gic", result.TimingsUs.Gic)
+	timings.SetUs("fc_devices", result.TimingsUs.Devices)
+	timings.SetUs("fc_total", result.TimingsUs.Total)
+
+	// The vCPU counters travel two ways on purpose. The caller gets all four
+	// back to log and to meter them; the drained count also joins the phase
+	// breakdown, which is the channel the acceptance suite already reads the
+	// Firecracker-side numbers out of (last-restore-timings.json), so a run
+	// that needed draining can be told from one that did not without adding
+	// a second place to look. The key is left out entirely when Firecracker
+	// says nothing, so "not reported" stays tellable from "none".
+	counters = result.VcpuCounters
+	if counters != nil {
+		timings.SetCount("fc_vcpu_mmio_drained_count", counters.MmioDrained)
+	}
+
+	telemetry.ReportEvent(ctx, fmt.Sprintf(
+		"rolled back memory in place: %d pages, fc total %dus",
+		result.RestoredPages, result.TimingsUs.Total,
+	))
+
+	// Past this point the counters are reported even when the restore is
+	// about to be called torn: the vCPUs were rewound, and a sandbox that has
+	// to be destroyed is the one whose numbers someone will want afterwards.
+	if afterCommit != nil {
+		if err := afterCommit(); err != nil {
+			return counters, RollbackTornError{Err: err}
+		}
+	}
+
+	// assemble_view stays in the breakdown, at zero, so a restore's phases
+	// can still be lined up against the ones recorded before the view moved
+	// out of the freeze. What it used to measure is assemble_view_pre now.
+	timings.Mark("assemble_view", time.Now())
+
+	// Disk view switch, inside the same pause window so disk and memory are
+	// of the same instant. A failure here is past the memory rollback: the
+	// guest is already at the target moment while the disk is not, so the
+	// sandbox is torn and no resume happens.
+	if err := timings.Timed("reset_view", func() error { return resetter.ResetView(ctx, device, s.newCowPath()) }); err != nil {
+		return counters, RollbackTornError{Err: fmt.Errorf("failed to reset rootfs view: %w", err)}
+	}
+
+	// The flush started at the pause is joined here, where it used to run:
+	// the resume is what lets traffic back in, so the entries have to be
+	// gone before it. `conntrack` now measures the wait, which is normally
+	// nothing because the flush had the whole rollback to finish in.
+	conntrack.join()
+
+	if err := timings.Timed("resume", func() error { return fcCall(ctx, process.ResumeVM) }); err != nil {
+		return counters, RollbackTornError{Err: fmt.Errorf("failed to resume VM after rollback: %w", err)}
+	}
+
+	timings.Mark("frozen", rollbackPausedAt)
+
+	return counters, nil
+}
+
+// RestoreLayer is one sealed rootfs layer of the disk view a restore brings
+// back, bottom to top: the file and the block offsets it holds.
+type RestoreLayer struct {
+	Path         string
+	DirtyOffsets []int64
+}
