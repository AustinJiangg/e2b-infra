From 462ccb90fc40bff3a40994f8f542399345558327 Mon Sep 17 00:00:00 2001
From: jll <jianglulu001@gmail.com>
Date: Mon, 23 Nov 2026 11:47:09 +0800
Subject: [PATCH] arm64: soft-dirty: record writes with hardware DBM instead of
 write faults

clear_refs=4 used to write-protect every pte (pte_wrprotect also clears
PTE_WRITE, which is the DBM bit on arm64), so the first write to each page
after a CRIU checkpoint took a write-protect fault. In a 2-vCPU Firecracker
guest on Kunpeng 920B that costs about 1.0-1.2 us per page, 0.25-0.31 ms
per MiB written.

With soft_dirty_dbm on (the default), clearing leaves writable ptes
writable-clean instead: hardware dirtiness is folded into the software
PTE_DIRTY bit (the kernel's own dirty state is kept), PTE_RDONLY is set and
PTE_WRITE/DBM is kept, so the next write is recorded by the hardware
without a fault. To make that sound:

- pte_soft_dirty() also returns true for a hardware-dirty pte, so pagemap,
  swap-out (try_to_unmap) and migration see the write;
- pte_mkclean() marks the pte soft-dirty before dropping hardware
  dirtiness (MADV_FREE, shared mappings in fork, mapping_dirty_helpers);
- pte_wrprotect() and pte_modify() already fold hardware dirtiness through
  pte_mkdirty(), which sets soft-dirty.

Without hardware DBM a write to such a pte faults and handle_pte_fault()
marks it dirty, so the behaviour is the old one. Runtime switch:
/sys/module/kernel/parameters/soft_dirty_dbm.

Tested in a standalone Firecracker VM: no missed write over basic writes,
fork (exit / COW), mprotect, MADV_FREE, threads, mremap, swap out / in,
compaction (1629 pages migrated) and 200 random cycles; the write cost
after a clear drops to 0.009-0.023 ms per MiB. KSM merging drops
soft-dirty with or without this change (replace_page() builds a fresh pte).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/include/asm/pgtable.h | 25 ++++++++++++++++++++++++-
 fs/proc/task_mmu.c               | 19 +++++++++++++++++--
 2 files changed, 41 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/include/asm/pgtable.h b/arch/arm64/include/asm/pgtable.h
index 8ef888ce5..e13c3853e 100644
--- a/arch/arm64/include/asm/pgtable.h
+++ b/arch/arm64/include/asm/pgtable.h
@@ -169,9 +169,15 @@ static inline pte_t set_pte_bit(pte_t pte, pgprot_t prot)
 }
 
 #ifdef CONFIG_HAVE_ARCH_SOFT_DIRTY
+/*
+ * With soft_dirty_dbm on, clear_refs leaves writable ptes writable-clean
+ * (PTE_WRITE/DBM set, PTE_RDONLY set): the next write is recorded by the
+ * hardware (PTE_RDONLY cleared) without a fault.  A hardware-dirty pte
+ * therefore counts as written since the last clear.
+ */
 static inline bool pte_soft_dirty(pte_t pte)
 {
-	return pte_val(pte) & PTE_SOFT_DIRTY;
+	return (pte_val(pte) & PTE_SOFT_DIRTY) || pte_hw_dirty(pte);
 }
 
 static inline pte_t pte_mksoft_dirty(pte_t pte)
@@ -183,6 +189,20 @@ static inline pte_t pte_clear_soft_dirty(pte_t pte)
 {
 	return clear_pte_bit(pte, __pgprot(PTE_SOFT_DIRTY));
 }
+
+/*
+ * Soft-dirty clear that keeps the pte writable for DBM: move hardware
+ * dirtiness into the software PTE_DIRTY bit (the kernel's own dirty state is
+ * kept, soft-dirty is not set) and make the pte hardware-clean again.
+ */
+#define pte_clear_soft_dirty_keep_write pte_clear_soft_dirty_keep_write
+static inline pte_t pte_clear_soft_dirty_keep_write(pte_t pte)
+{
+	if (pte_hw_dirty(pte))
+		pte = set_pte_bit(pte, __pgprot(PTE_DIRTY));
+	pte = set_pte_bit(pte, __pgprot(PTE_RDONLY));
+	return clear_pte_bit(pte, __pgprot(PTE_SOFT_DIRTY));
+}
 #endif /* CONFIG_HAVE_ARCH_SOFT_DIRTY */
 
 static inline pmd_t clear_pmd_bit(pmd_t pmd, pgprot_t prot)
@@ -207,6 +227,9 @@ static inline pte_t pte_mkwrite(pte_t pte)
 
 static inline pte_t pte_mkclean(pte_t pte)
 {
+	/* Do not lose a write the soft-dirty tracker has not seen yet. */
+	if (pte_hw_dirty(pte))
+		pte = set_pte_bit(pte, __pgprot(PTE_SOFT_DIRTY));
 	pte = clear_pte_bit(pte, __pgprot(PTE_DIRTY));
 	pte = set_pte_bit(pte, __pgprot(PTE_RDONLY));
 
diff --git a/fs/proc/task_mmu.c b/fs/proc/task_mmu.c
index 484886cdd..6c8580ce3 100644
--- a/fs/proc/task_mmu.c
+++ b/fs/proc/task_mmu.c
@@ -1077,6 +1077,14 @@ struct clear_refs_private {
 
 #ifdef CONFIG_MEM_SOFT_DIRTY
 
+/*
+ * soft_dirty_dbm (default on): on arm64 with hardware DBM, clear soft-dirty without
+ * write-protecting the pte, so writes after a clear do not fault.
+ * Runtime switch: /sys/module/kernel/parameters/soft_dirty_dbm
+ */
+static bool soft_dirty_dbm = true;
+core_param(soft_dirty_dbm, soft_dirty_dbm, bool, 0644);
+
 static inline bool pte_is_pinned(struct vm_area_struct *vma, unsigned long addr, pte_t pte)
 {
 	struct page *page;
@@ -1110,8 +1118,15 @@ static inline void clear_soft_dirty(struct vm_area_struct *vma,
 		if (pte_is_pinned(vma, addr, ptent))
 			return;
 		old_pte = ptep_modify_prot_start(vma, addr, pte);
-		ptent = pte_wrprotect(old_pte);
-		ptent = pte_clear_soft_dirty(ptent);
+#ifdef pte_clear_soft_dirty_keep_write
+		if (READ_ONCE(soft_dirty_dbm) && pte_write(old_pte)) {
+			ptent = pte_clear_soft_dirty_keep_write(old_pte);
+		} else
+#endif
+		{
+			ptent = pte_wrprotect(old_pte);
+			ptent = pte_clear_soft_dirty(ptent);
+		}
 		ptep_modify_prot_commit(vma, addr, pte, old_pte, ptent);
 	} else if (is_swap_pte(ptent)) {
 		ptent = pte_swp_clear_soft_dirty(ptent);
-- 
2.54.0

