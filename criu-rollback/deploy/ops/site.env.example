# 仅填写与默认部署不同时的值。复制成 site.env 后修改，不填写客户端密钥。
GSD_JOB=template-manager-system
GSD_PORT=5008
GSD_STATE_DIR=/var/lib/gsd-950-offline
E2B_INFRA_ENV=/opt/e2b-infra/.env
# 客户端 conda 环境：名字或绝对路径（路径的最后一级目录名也必须是 jll-e2b-gsd）
# GSD_CONDA_ENV=jll-e2b-gsd
# SANDBOX_CONDA_ENV=jll-e2b
# conda 不在 /root/miniforge3、/root/miniconda3 等常见位置时：
# CONDA_EXE=/opt/xxx/bin/conda
# 镜像已在别的机器导入 Harbor、本机没有 Docker 时：
# GSD_SKIP_IMAGE_IMPORT=1
# 镜像仓库引用与默认不同时：
# GSD_TEMPLATE_IMAGE=harbor:443/e2b-orchestration/ubuntu:22.04-custom-criu421
